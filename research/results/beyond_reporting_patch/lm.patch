+def final_loss_statistics(cfg, params, bx, by, batch_size, *, reduction="positions"):
+    """One final-evaluation pass, preserving legacy scalar reduction order.
+
+    Sequence losses are per-token means, in the input sample order. Their
+    float64 host mean may differ from the legacy scalar by FP32 reduction
+    rounding. No token sampling, parameter update, or model setting changes.
+    ``positions`` matches val_big; ``all`` matches historical ablations.
+    """
+    if reduction not in ("positions", "all"):
+        raise ValueError("final loss reduction must be positions or all")
+    if batch_size < 1 or len(bx) == 0 or bx.shape != by.shape:
+        raise ValueError("final evaluation requires matching nonempty batches")
+
+    @jax.jit
+    def score(p, x, y):
+        logits = forward(cfg, p, x)
+        losses = optax.softmax_cross_entropy_with_integer_labels(logits, y)
+        legacy = losses.sum(0) if reduction == "positions" else losses.sum()
+        return legacy, losses.mean(-1)
+
+    total, sequences = 0.0, []
+    for start in range(0, len(bx), batch_size):
+        legacy, per_sequence = score(params, bx[start:start + batch_size], by[start:start + batch_size])
+        total += float(np.asarray(legacy).sum())
+        sequences.append(np.asarray(per_sequence, dtype=np.float64))
+    sequence_losses = np.concatenate(sequences)
+    value = total / (len(bx) * bx.shape[1])
+    if not math.isfinite(value) or not np.isfinite(sequence_losses).all():
+        raise FloatingPointError("nonfinite final held-out loss")
+    return {"loss": round(value, 5), "loss_raw": value,
+            "sequence_losses": sequence_losses.tolist(),
+            "sequence_mean_raw": float(sequence_losses.mean())}
+
+
