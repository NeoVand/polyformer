"""Job lists for METRIC.md (the Nerode metric loss L_M of EXACTNESS section 8); writes JSON for `metric_modal.py plan`.
Never launches anything. Lean jobs are lean_run.py on LEAN_S1's registered configuration (position-wise linear head,
d 128, 4 ticks, batch 64, lr 1e-3, 12,000 steps; the invariance term at mu 1 with random certified partners, delay 0.2,
ramp 0.1) with `--outdir metric` and XLA's Triton GEMM fusion off for every arm (LEAN_H: it miscompiles NextLat's step on
the H100; one flag for every arm keeps the arms on one compiler path). Dilution jobs are para_run.py on PARA_INVARIANCE's
configuration (the harness's softmax arm: 2 layers, d 64; 1,500 steps, batch 64, lr 2e-3) with `--outdir metric`. The
seeds of one arm run in one process (one job). Pilots use seeds 10, 11 and the tag `pilot`; registered runs seeds 0, 1, 2.

    python research/metric_jobs.py t81_pilot                 # T8.1 pilot: R+M at gamma 0.5 / 0.9 on a4x, seeds 10, 11, evaluation to 256
    python research/metric_jobs.py t81 --gamma 0.9           # T8.1: R+M on a4x, seeds 0-2, evaluation to 4,096
    python research/metric_jobs.py t82 --gamma 0.9           # T8.2: R+I, R+NL, R+NL+I, R+M on t2m5, seeds 0-2, evaluation to 256
    python research/metric_jobs.py t83_pilot                 # T8.3 pilot: (b) at gamma 0.5 / 0.9, seeds 10, 11
    python research/metric_jobs.py t83 --gamma 0.9           # T8.3: (a) unweighted, (b) L_M + paraphrases, (c) L_M pairs only, seeds 0-2
    python research/metric_jobs.py t83m_pilot                # T8.3' pilot (matched pairs): (b') at gamma 0.9 / 0.95, seeds 10, 11
    python research/metric_jobs.py t83m --gamma 0.9          # T8.3': (b') matched + paraphrases, (c') matched without, seeds 0-2
    python research/metric_jobs.py t82_24k --gamma 0.5       # section 5.2: R+NL+I and R+M on t2m5 at 24,000 steps, seeds 0, 1
"""

import argparse
import json

BASE = ["--head", "pos", "--outdir", "metric", "--steps", 12000, "--model", "rec", "--xla_flags=--xla_gpu_enable_triton_gemm=false"]
RI = ["--mu", "1", "--pair", "random"]
NL = ["--nextlat", "1"]
PILOT_SEEDS = "10,11"
SEEDS = "0,1,2"


def job(test, jid, script, argv, max_seconds, gpu="H100"):
    return {"id": jid, "test": test, "script": script, "argv": ["run", *[str(a) for a in argv]], "gpu": gpu, "max_seconds": max_seconds}


def M(g):
    return ["--metric", "1", "--gamma", g]


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("stage", choices=("t81_pilot", "t81", "t82", "t83_pilot", "t83", "t83m_pilot", "t83m", "t82_24k"))
    ap.add_argument("--gamma", type=float, default=0.9, help="the discount chosen by the stage's pilot rule (METRIC.md)")
    a = ap.parse_args()
    g = f"{a.gamma:g}"
    out = []
    if a.stage == "t81_pilot":
        for gp in ("0.5", "0.9"):
            out.append(job("METRIC_PILOT", f"t81pilot_RMg{gp}_a4x", "lean_run.py", ["--data", "a4x", *BASE, *M(gp), "--seeds", PILOT_SEEDS, "--eval_max", 256,
                                                                                      "--tag", "pilot"], 900))
    elif a.stage == "t81":
        out.append(job("METRIC_T81", f"t81_RMg{g}_a4x", "lean_run.py", ["--data", "a4x", *BASE, *M(g), "--seeds", SEEDS], 1500))
    elif a.stage == "t82":
        arms = {"RI": RI, "RNL": NL, "RINL": [*RI, *NL], f"RMg{g}": M(g)}
        caps = {"RI": 1300, "RNL": 1100, "RINL": 1500, f"RMg{g}": 1300}
        for name, extra in arms.items():
            out.append(job("METRIC_T82", f"t82_{name}_t2m5", "lean_run.py", ["--data", "t2m5", *BASE, *extra, "--seeds", SEEDS, "--eval_max", 256], caps[name]))
    elif a.stage == "t83_pilot":
        for gp in ("0.5", "0.9"):
            out.append(job("METRIC_PILOT", f"t83pilot_M_para_g{gp}", "para_run.py", ["--metric", "1", "--gamma", gp, "--m_equiv", "para", "--seeds", PILOT_SEEDS,
                                                                                    "--outdir", "metric", "--tag", "pilot"], 900))
    elif a.stage == "t82_24k":
        base24 = [x if x != 12000 else 24000 for x in BASE]
        for name, extra, cap in (("RINL", [*RI, *NL], 1400), (f"RMg{g}", M(g), 1300)):
            out.append(job("METRIC_T82", f"t82_24k_{name}_t2m5", "lean_run.py", ["--data", "t2m5", *base24, *extra, "--seeds", "0,1", "--eval_max", 256], cap))
    elif a.stage == "t83m_pilot":
        for gp in ("0.9", "0.95"):
            out.append(job("METRIC_PILOT", f"t83mpilot_Mm_para_g{gp}", "para_run.py", ["--metric", "1", "--gamma", gp, "--m_form", "matched", "--m_equiv", "para",
                                                                                      "--seeds", PILOT_SEEDS, "--outdir", "metric", "--tag", "pilot"], 900))
    elif a.stage == "t83m":
        for eq, nm in (("para", "para"), ("none", "pairs")):
            out.append(job("METRIC_T83", f"t83m_Mm_{nm}_g{g}", "para_run.py", ["--metric", "1", "--gamma", g, "--m_form", "matched", "--m_equiv", eq, "--seeds", SEEDS,
                                                                               "--outdir", "metric"], 1000))
    else:
        out.append(job("METRIC_T83", "t83_unw", "para_run.py", ["--weight", "none", "--seeds", SEEDS, "--outdir", "metric"], 900))
        out.append(job("METRIC_T83", f"t83_M_para_g{g}", "para_run.py", ["--metric", "1", "--gamma", g, "--m_equiv", "para", "--seeds", SEEDS, "--outdir", "metric"], 1200))
        out.append(job("METRIC_T83", f"t83_M_pairs_g{g}", "para_run.py", ["--metric", "1", "--gamma", g, "--m_equiv", "none", "--seeds", SEEDS, "--outdir", "metric"], 1100))
    print(json.dumps(out, indent=1))


if __name__ == "__main__":
    main()

