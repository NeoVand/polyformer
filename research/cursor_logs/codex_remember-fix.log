"""
Local checks for the fair paired test. No model weights and no GPU.

    nice -n 19 uv run --no-project --with torch python3 research/remember/rf_selftest.py
"""

from __future__ import annotations

import csv
import json
import random
import subprocess
import sys
import tempfile
import pathlib

HERE = pathlib.Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))

import rf_cost  # noqa: E402
import rf_data  # noqa: E402
import rf_models as M  # noqa: E402
import rf_recount  # noqa: E402
import rf_report  # noqa: E402
import r2_modal  # noqa: E402


def fake_pool():
    names = [f"name{i:02d}" for i in range(40)]
    return {"train": list(names), "test": list(names), "id_of": {n: i + 1 for i, n in enumerate(names)}, "nl": 1000}


def cell(exact, n=4):
    return {"exact": exact, "n": n}


def pooled(pin, hist, hist_long, adv, tok):
    return {"qwen3-1.7b": {
        "pin": {"pin": {"256": cell(pin)}, "adv": {"256": cell(adv)}, "tok": {"256": cell(tok)}},
        "hist": {"remember": {"256": cell(hist), "4096": cell(hist_long)}},
    }}


def check_views():
    pool = fake_pool()
    def batches(seed):
        rng = random.Random(seed + M.DATA_SALT)
        return [rf_data.draw_batch(rng, pool, M.TRAIN_TABLES, 8) for _ in range(2)]
    assert rf_data.fingerprint(batches(1)) == rf_data.fingerprint(batches(1))
    assert rf_data.fingerprint(batches(1)) != rf_data.fingerprint(batches(2))
    for ex in batches(1)[0]:
        stat = rf_data.compare_views(ex, [7, 8])
        assert stat["labels"] == 8 and stat["causal_mismatches"] == 0
        assert stat["hist_seq"] == stat["pi_len"] + 16


def check_tables():
    pool = fake_pool()
    full = M.fresh_list(pool)
    assert M.fresh_list(pool) == full
    assert len(full) == 4
    assert [r["i"] for r in full] == sorted(r["i"] for r in full)
    assert [r["i"] for r in M.select_fresh(pool, 2)] == [r["i"] for r in full[:2]]
    assert all("pass" not in r for r in full)


def check_scores():
    hit = rf_report.score(pooled(4, 1, 0, 0, 0), ["qwen3-1.7b"])
    assert [p["outcome"] for p in hit["predictions"]] == ["hit", "hit", "hit", "hit", "hit", "hit"]
    void = rf_report.score(pooled(0, 0, 0, 0, 0), ["qwen3-1.7b"])
    assert [p["outcome"] for p in void["predictions"]] == ["miss", "hit", "miss", "hit", "void", "void"]
    tied = rf_report.score(pooled(3, 0, 0, 3, 3), ["qwen3-1.7b"])
    assert tied["predictions"][4]["outcome"] == "miss"
    assert tied["predictions"][5]["outcome"] == "miss"
    assert rf_recount.lower_median([3, 1, 8]) == rf_report.lower_median([3, 1, 8]) == 3


def check_recount_formula():
    with tempfile.TemporaryDirectory() as tmp:
        path = pathlib.Path(tmp) / "runs.csv"
        with path.open("w", newline="") as f:
            writer = csv.DictWriter(f, fieldnames=["model", "seed", "arm", "policy", "table", "tape", "length",
                                                   "T", "exact", "first_error_step", "bitwise", "ticks",
                                                   "rows", "bin", "shape"])
            writer.writeheader()
            writer.writerow({"model": "qwen3-1.7b", "seed": 1, "arm": "pin", "policy": "pin", "table": 2,
                             "tape": 0, "length": 2, "T": 4, "exact": 1, "first_error_step": 3,
                             "bitwise": "", "ticks": "", "rows": 4, "bin": "4-16", "shape": "perm"})
            writer.writerow({"model": "qwen3-1.7b", "seed": 1, "arm": "pin", "policy": "pin", "table": 2,
                             "tape": 0, "length": 4, "T": 4, "exact": 0, "first_error_step": 3,
                             "bitwise": 1, "ticks": 4, "rows": 4, "bin": "4-16", "shape": "perm"})
        digest = rf_recount.digest_csv(path)
        short = digest[("qwen3-1.7b", 1, "pin", "pin", 2, 0, 2)]
        full = digest[("qwen3-1.7b", 1, "pin", "pin", 2, 0, 4)]
        assert short[0] == 1 and short[1] == 2 and short[2] == ""
        assert full[0] == 0 and full[1] == 2 and full[2] == 1 and full[3] == 4


def check_cost():
    assert r2_modal.GPU_RATE == rf_cost.GPU_RATE
    assert r2_modal.rate("A10G") == rf_cost.rate("A10G")
    rf_cost.selftest()


def check_registration():
    text = (HERE / "REMEMBER2.md").read_text()
    for phrase in ("These fair-test paragraphs stay as written",
                   "Probability 0.75 that the pin arm",
                   "Probability 0.65 that the history arm",
                   "Probability 0.70 that, in every counted model, the pin arm",
                   "Probability 0.70 that, in every counted model, the history arm's remember fraction at 4096",
                   "Probability 0.55 that the pin arm under adv",
                   "Probability 0.55 that the pin arm under tok",
                   "keep the last step", "cap is $35", "<!-- FAIR-PLAN -->", "<!-- FAIR-RESULTS -->"):
        assert phrase in text, phrase
    audit = (HERE / "REMEMBER.md").read_text()
    assert "## Audit corrections" in audit and "## Audit corrections" in text


def check_smoke_refuses():
    proc = subprocess.run([sys.executable, str(HERE / "rf_smoke.py"), "--model", "qwen3-1.7b", "--seed", "1",
                           "--steps", "3", "--eval-length", "64", "--out", "/tmp/rf-smoke-refuse"],
                          capture_output=True, text=True)
    assert proc.returncode != 0
    assert "2 training steps" in (proc.stderr + proc.stdout)


def check_retries():
    argv = ["--model", "qwen3-1.7b", "--seed", "3"]
    runs = [{"arm": "pin", "policy": "pin", "table": 0, "first_error": None}]
    with tempfile.TemporaryDirectory() as tmp:
        root = pathlib.Path(tmp)
        for job, rs in (("e", runs), ("e-r1", runs + [{"arm": "hist", "policy": "tok", "table": 5}])):
            (root / job).mkdir()
            (root / job / "runs.json").write_text(json.dumps({"runs": rs}))
        ledger = {"jobs": {"e": {"status": "error", "error": "subprocess exceeded 6133 seconds", "argv": argv},
                           "e-r1": {"status": "complete", "argv": argv + ["--carry", "/vol/e/runs.json"]}}}
        (root / "retries.json").write_text(json.dumps({"e": {"retry": "e-r1", "carried_runs": 1}}))
        assert rf_report.retries(root, ledger) == {"e": "e-r1"}
        (root / "e-r1" / "runs.json").write_text(json.dumps({"runs": [dict(runs[0], first_error=3)]}))
        try:
            rf_report.retries(root, ledger)
        except SystemExit as exc:
            assert "changed a carried run" in str(exc)
        else:
            raise AssertionError("a changed carried run was accepted")
        ledger["jobs"]["e"]["error"] = "subprocess exit 1"
        try:
            rf_report.retries(root, ledger)
        except SystemExit as exc:
            assert "not a settled timeout" in str(exc)
        else:
            raise AssertionError("a non-timeout was retried")


def main():
    check_views()
    check_tables()
    check_scores()
    check_recount_formula()
    check_retries()
    check_cost()
    check_registration()
    check_smoke_refuses()
    print(json.dumps({"selftest": "ok"}))


if __name__ == "__main__":
    main()

