}"""
Modal launcher for the fair paired test. Own app `polyformer-remember-fair`, own volume
`polyformer-remember-fair-results`. Cap $35, recorded before any spend.

    python research/remember/rf_modal.py status
    uv run --no-project --with modal modal deploy research/remember/rf_modal.py
    uv run --no-project --with modal python research/remember/rf_modal.py spawn --manifest research/remember/manifests_fair/smoke.json
    uv run --no-project --with modal python research/remember/rf_modal.py collect --manifest research/remember/manifests_fair/smoke.json
"""

from __future__ import annotations

import contextlib
import datetime as dt
import fcntl
import hashlib
import json
import os
import pathlib
import signal
import subprocess
import sys
import time

ROOT = pathlib.Path(__file__).resolve().parent
PB_ROOT = ROOT.parent / "promptbox"
BI_ROOT = ROOT.parent / "bigidea"
UNI_ROOT = ROOT.parent / "universal"
REPO = ROOT.parent.parent
MANIFESTS = ROOT / "manifests_fair"
RESULTS = ROOT / "results_fair"
LEDGER = RESULTS / "modal_ledger.json"
LOCK = RESULTS / "modal_ledger.lock"
APP_NAME = "polyformer-remember-fair"
VOLUME_NAME = "polyformer-remember-fair-results"
HF_VOLUME = "polyformer-universal-hf"
UNI_VOLUME = "polyformer-universal-results"
BI_VOLUME = "polyformer-bigidea-results"
# Mirrored from rf_cost.py. The deployed module is imported from /root, and rf_cost is not
# in that image. Local commands check the mirror in main().
CAP_USD = 35.0
CPU_MAX = 8
RAM_GIB_MAX = 48
STARTUP_SECONDS = 240
PB_SOURCES = ("pb_common.py", "pb_pin.py", "pb_lit.py", "pb_lang.py", "pb_data.py", "pb_families.py")
OWN = ("rf_data.py", "rf_eval.py", "rf_models.py", "rf_smoke.py", "rf_train.py",
       "r2_data.py", "r2_load.py", "r2_models.py", "rem_job.py", "rem_models.py")


def stamp():
    return dt.datetime.now(dt.timezone.utc).isoformat()


def sha256_bytes(data):
    return hashlib.sha256(data).hexdigest()


def atomic_json(path, value):
    path = pathlib.Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + f".{os.getpid()}.tmp")
    tmp.write_text(json.dumps(value, indent=1, sort_keys=True, default=str))
    os.replace(tmp, path)


def source_files():
    own = [ROOT / n for n in OWN]
    bi = [BI_ROOT / "bi_stream.py", BI_ROOT / "bi_edit.py"]
    uni = [UNI_ROOT / "uni_models.py"]
    pb = [PB_ROOT / n for n in PB_SOURCES]
    files = own + bi + uni + pb
    missing = [str(p) for p in files if not p.is_file()]
    if missing:
        raise FileNotFoundError(f"source files missing: {missing}")
    return files


def remote_name(p):
    parent = p.parent
    if parent == ROOT:
        return "rem/" + p.name
    if parent == BI_ROOT:
        return "bi/" + p.name
    if parent == UNI_ROOT:
        return "uni/" + p.name
    return "pb/" + p.name


def sources():
    return {remote_name(p): sha256_bytes(p.read_bytes()) for p in source_files()}


def reservation(job):
    import rf_cost
    return rf_cost.reservation(job)


@contextlib.contextmanager
def locked_ledger():
    LOCK.parent.mkdir(parents=True, exist_ok=True)
    with LOCK.open("a+") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        ledger = json.loads(LEDGER.read_text()) if LEDGER.exists() else {
            "schema": 1, "app": APP_NAME, "volume": VOLUME_NAME, "cap_usd_total": CAP_USD, "cap_history": [
                {"at": stamp(), "cap_usd": CAP_USD, "why": "Fair paired test: cap $35 recorded before any spend"}],
            "jobs": {},
            "cost_basis": "upper-rate estimate (GPU + 8 CPU + 48 GiB at Modal list prices) from max_seconds at "
                          "reservation, actual wall plus startup at settlement; not an invoice"}
        yield ledger
        atomic_json(LEDGER, ledger)
        fcntl.flock(lock, fcntl.LOCK_UN)


def used(ledger):
    return sum(e.get("settled_usd", e["reserved_usd"]) for e in ledger["jobs"].values())


def normalize(raw, hashes):
    import rf_cost
    job = {"id": str(raw["id"]), "script": str(raw["script"]), "argv": [str(a) for a in raw.get("argv", [])],
           "gpu": str(raw.get("gpu", "A10G")), "max_seconds": int(raw["max_seconds"])}
    if job["gpu"] not in rf_cost.GPU_RATE or not (60 <= job["max_seconds"] <= 24000) or "rem/" + job["script"] not in hashes:
        raise ValueError(f"bad job {job}")
    job["reserved_usd"] = reservation(job)
    return job


def plan(name, jobs_path):
    hashes = sources()
    jobs = [normalize(j, hashes) for j in json.loads(pathlib.Path(jobs_path).read_text())]
    if len({j["id"] for j in jobs}) != len(jobs):
        raise ValueError("duplicate job ids")
    commit = subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=REPO, text=True).strip()
    paths = [str(p) for p in source_files()]
    dirty = subprocess.check_output(["git", "status", "--porcelain", "--", *paths], cwd=REPO, text=True)
    dirty = [line for line in dirty.splitlines() if line.strip()]
    manifest = {"name": name, "app": APP_NAME, "created_at": stamp(), "commit": commit,
                "uncommitted_sources": bool(dirty), "source_hashes": hashes, "jobs": jobs,
                "reserved_usd": round(sum(j["reserved_usd"] for j in jobs), 6)}
    MANIFESTS.mkdir(exist_ok=True)
    path = MANIFESTS / f"{name}.json"
    if path.exists():
        raise ValueError(f"manifest already exists: {path}")
    path.write_text(json.dumps(manifest, indent=1))
    print(json.dumps({"manifest": str(path), "jobs": len(jobs), "commit": commit,
                      "uncommitted_sources": bool(dirty), "reserved_usd": manifest["reserved_usd"]}, indent=1))
    return path


def reserve(job):
    with locked_ledger() as ledger:
        if job["id"] in ledger["jobs"]:
            return ledger["jobs"][job["id"]], False
        cap = ledger.get("cap_usd_total", CAP_USD)
        if used(ledger) + job["reserved_usd"] > cap + 1e-9:
            raise RuntimeError(f"cap: {used(ledger):.3f} USD reserved or settled; {job['id']} needs "
                               f"{job['reserved_usd']:.3f}; cap {cap}")
        entry = {"job_id": job["id"], "script": job["script"], "argv": job["argv"], "gpu": job["gpu"],
                 "reserved_usd": job["reserved_usd"], "max_seconds": job["max_seconds"], "status": "reserved",
                 "reserved_at": stamp()}
        ledger["jobs"][job["id"]] = entry
        return entry, True


def record_call(job_id, call_id):
    with locked_ledger() as ledger:
        ledger["jobs"][job_id].update({"call_id": call_id, "status": "running", "launched_at": stamp()})


def settle(job, result):
    import rf_cost
    wall = float(result.get("wall", job["max_seconds"]))
    amount = round(rf_cost.rate(job["gpu"]) * (min(wall, job["max_seconds"] + rf_cost.WRAPPER) + STARTUP_SECONDS), 6)
    out = RESULTS / job["id"]
    out.mkdir(parents=True, exist_ok=True)
    written = []
    for name, text in result.get("files", {}).items():
        target = out / name
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(text)
        written.append(name)
    with locked_ledger() as ledger:
        entry = ledger["jobs"][job["id"]]
        entry.update({"status": "error" if result.get("error") else "complete", "settled_usd": amount, "wall": wall,
                      "settled_at": stamp(), "files": written, "gpu_actual": result.get("gpu_actual"),
                      "cpu_actual": result.get("cpu_actual")})
        if result.get("error"):
            entry["error"] = str(result["error"])[-2000:]
    return amount, written


def worker(job, expected_sources, vol_commit):
    started = time.monotonic()
    remote_root = pathlib.Path("/root/src")
    actual = {str(p.relative_to(remote_root)): sha256_bytes(p.read_bytes())
              for p in sorted(remote_root.glob("*/*.py"))}
    if actual != expected_sources:
        diff = sorted(k for k in set(actual) | set(expected_sources) if actual.get(k) != expected_sources.get(k))
        return {"error": f"remote source hash mismatch: {diff}", "wall": round(time.monotonic() - started, 3)}
    out_dir = pathlib.Path("/vol") / job["id"]
    out_dir.mkdir(parents=True, exist_ok=True)
    log_path = out_dir / "job.log"
    command = [sys.executable, "-u", str(remote_root / "rem" / job["script"]), *job["argv"], "--out", str(out_dir)]
    env = os.environ.copy()
    for key in ("HF_TOKEN", "HF_HUB_TOKEN", "HUGGING_FACE_HUB_TOKEN"):
        env.pop(key, None)
    env.update({"REMEMBER_JOB_ID": job["id"], "TOKENIZERS_PARALLELISM": "false", "HF_HUB_OFFLINE": "1",
                "TRANSFORMERS_OFFLINE": "1", "HF_HOME": "/tmp/hf", "HF_HUB_CACHE": "/tmp/hf/hub",
                "HF_HUB_DISABLE_TELEMETRY": "1", "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True",
                "PYTHONPATH": ":".join(str(remote_root / n) for n in ("rem", "bi", "uni", "pb"))})
    timed_out, last_commit = False, time.monotonic()
    with log_path.open("w") as fout:
        process = subprocess.Popen(command, cwd=remote_root, stdout=fout, stderr=subprocess.STDOUT, text=True,
                                   start_new_session=True, env=env)
        deadline, offset = time.monotonic() + job["max_seconds"], 0
        while process.poll() is None:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                timed_out = True
                os.killpg(process.pid, signal.SIGKILL)
                process.wait()
                break
            try:
                process.wait(timeout=min(20, remaining))
            except subprocess.TimeoutExpired:
                pass
            with log_path.open() as f:
                f.seek(offset)
                new = f.read()
                offset = f.tell()
            if new.strip():
                print(f"[{job['id']}] {new.strip()[-3000:]}", flush=True)
            if time.monotonic() - last_commit > 300:
                with contextlib.suppress(Exception):
                    vol_commit()
                last_commit = time.monotonic()
    text = log_path.read_text()
    result = {"wall": round(time.monotonic() - started, 3), "log_tail": text[-12000:],
              "python_version": sys.version.split()[0], "remote_completed_at": stamp()}
    if timed_out:
        result["error"] = f"subprocess exceeded {job['max_seconds']} seconds"
    elif process.returncode != 0:
        result["error"] = f"subprocess exit {process.returncode}: {text[-4000:]}"
    files = {}
    for p in sorted(out_dir.rglob("*.json")):
        if p.name.startswith("_"):
            continue
        if p.stat().st_size < 2_000_000:
            files[str(p.relative_to(out_dir))] = p.read_text()
    csv_path = out_dir / "runs.csv"
    if csv_path.is_file() and csv_path.stat().st_size < 2_000_000:
        files["runs.csv"] = csv_path.read_text()
    files["job.log.json"] = json.dumps({"job_id": job["id"], "log": text[-300000:]})
    result["files"] = files
    try:
        result["gpu_actual"] = subprocess.check_output(
            ["nvidia-smi", "--query-gpu=name", "--format=csv,noheader"], text=True, timeout=5).strip()
    except Exception:
        result["gpu_actual"] = "none"
    try:
        info = pathlib.Path("/proc/cpuinfo").read_text()
        cpu = [line.split(":", 1)[1].strip() for line in info.splitlines()
               if line.lower().startswith(("model name", "vendor_id", "cpu family", "model\t"))]
        flags = next((line.split(":", 1)[1].split() for line in info.splitlines() if line.startswith("flags")), [])
        result["cpu_actual"] = " | ".join(cpu[:4]) + f" | avx512f={'avx512f' in flags}"
    except Exception:
        result["cpu_actual"] = "unknown"
    (out_dir / "_result.json").write_text(json.dumps({k: v for k, v in result.items() if k != "files"}
                                                     | {"file_names": list(files)}))
    return result


try:
    import modal
except ImportError:
    modal = None

if modal is not None:
    app = modal.App(APP_NAME)
    results_vol = modal.Volume.from_name(VOLUME_NAME, create_if_missing=True)
    hf_vol = modal.Volume.from_name(HF_VOLUME).read_only()
    uni_vol = modal.Volume.from_name(UNI_VOLUME).read_only()
    bi_vol = modal.Volume.from_name(BI_VOLUME).read_only()
    image = (modal.Image.debian_slim(python_version="3.12")
             .pip_install("torch==2.13.0", "transformers==5.19.0", "peft==0.21.2", "accelerate==1.15.0",
                          "numpy", "safetensors", "huggingface_hub")
             .env({"HF_HUB_OFFLINE": "1", "TRANSFORMERS_OFFLINE": "1", "HF_HOME": "/tmp/hf",
                   "HF_HUB_CACHE": "/tmp/hf/hub", "HF_HUB_DISABLE_TELEMETRY": "1",
                   "TOKENIZERS_PARALLELISM": "false"}))
    if (ROOT / "rf_train.py").is_file():
        for _src in source_files():
            image = image.add_local_file(_src, f"/root/src/{remote_name(_src)}")

    def _run(job, expected_sources):
        results_vol.reload()
        result = worker(job, expected_sources, results_vol.commit)
        with contextlib.suppress(Exception):
            results_vol.commit()
        return result

    _common = dict(image=image, timeout=30000, startup_timeout=STARTUP_SECONDS + 600, retries=0, scaledown_window=2,
                   volumes={"/vol": results_vol, "/hf": hf_vol, "/uni": uni_vol, "/bi": bi_vol},
                   cpu=(4.0, CPU_MAX), memory=(32768, RAM_GIB_MAX * 1024))

    @app.function(gpu="H100", **_common)
    def execute_h100(job, expected_sources):
        return _run(job, expected_sources)

    @app.function(gpu="A10", **_common)
    def execute_a10g(job, expected_sources):
        return _run(job, expected_sources)

    @app.function(gpu="L40S", **_common)
    def execute_l40s(job, expected_sources):
        return _run(job, expected_sources)


FN_OF = {"H100": "execute_h100", "A10G": "execute_a10g", "L40S": "execute_l40s"}


def spawn_deployed(manifest):
    spec = json.loads(pathlib.Path(manifest).read_text())
    if spec.get("uncommitted_sources"):
        raise RuntimeError("refusing to spawn: sources were dirty when the manifest was planned")
    if sources() != spec["source_hashes"]:
        raise ValueError("sources changed since planning; plan a new manifest and redeploy")
    for job in spec["jobs"]:
        fn = modal.Function.from_name(APP_NAME, FN_OF[job["gpu"]])
        entry, created = reserve(job)
        if not created or entry.get("call_id"):
            print(json.dumps({"job_id": job["id"], "status": "already_" + entry["status"]}))
            continue
        call = fn.spawn(job, spec["source_hashes"])
        record_call(job["id"], call.object_id)
        print(json.dumps({"job_id": job["id"], "status": "spawned", "call_id": call.object_id}), flush=True)


def collect(manifest):
    spec = json.loads(pathlib.Path(manifest).read_text())
    with locked_ledger() as ledger:
        known = dict(ledger["jobs"])
    vol = modal.Volume.from_name(VOLUME_NAME)
    for job in spec["jobs"]:
        entry = known.get(job["id"], {})
        if entry.get("status") != "running" or not entry.get("call_id"):
            print(json.dumps({"job_id": job["id"], "status": entry.get("status", "not launched")}))
            continue
        try:
            result = modal.FunctionCall.from_id(entry["call_id"]).get(timeout=0)
        except TimeoutError:
            print(json.dumps({"job_id": job["id"], "status": "still running"}))
            continue
        except Exception as exc:
            try:
                meta = json.loads(b"".join(vol.read_file(f"{job['id']}/_result.json")))
                files = {}
                for n in meta.get("file_names", []):
                    if n == "job.log.json":
                        files[n] = json.dumps({"log": b"".join(vol.read_file(f"{job['id']}/job.log")).decode()[-300000:]})
                    else:
                        files[n] = b"".join(vol.read_file(f"{job['id']}/{n}")).decode()
                result = dict(meta, files=files)
            except Exception:
                files = {}
                for name in ("runs.json", "runs.csv", "train.json", "timing.json", "job.log"):
                    try:
                        raw = b"".join(vol.read_file(f"{job['id']}/{name}"))
                    except Exception:
                        continue
                    if name == "job.log":
                        files["job.log.json"] = json.dumps({"log": raw.decode(errors="replace")[-300000:]})
                    else:
                        files[name] = raw.decode()
                if not files:
                    print(json.dumps({"job_id": job["id"], "status": "unresolved",
                                      "error": f"{type(exc).__name__}: {str(exc)[:300]}"}))
                    continue
                result = {"error": f"{type(exc).__name__}: {str(exc)[:300]}", "files": files,
                          "wall": job["max_seconds"], "gpu_actual": None, "cpu_actual": None}
        amount, written = settle(job, result)
        print(json.dumps({"job_id": job["id"], "status": "error" if result.get("error") else "complete",
                          "usd": amount, "files": len(written), "gpu": result.get("gpu_actual"),
                          "cpu": result.get("cpu_actual"),
                          "error": (str(result.get("error"))[-800:] if result.get("error") else None)}), flush=True)


def status():
    with locked_ledger() as ledger:
        counts, open_jobs = {}, []
        for entry in ledger["jobs"].values():
            counts[entry["status"]] = counts.get(entry["status"], 0) + 1
            if entry["status"] in ("reserved", "running"):
                open_jobs.append(entry["job_id"])
        settled = sum(entry.get("settled_usd", 0.0) for entry in ledger["jobs"].values())
        print(json.dumps({"app": APP_NAME, "settled_usd": round(settled, 4),
                          "reserved_or_settled_usd": round(used(ledger), 4),
                          "cap_usd": ledger.get("cap_usd_total", CAP_USD), "jobs": counts, "open": open_jobs}, indent=1))


def main():
    import argparse
    import rf_cost
    if (CAP_USD, CPU_MAX, RAM_GIB_MAX, STARTUP_SECONDS) != (
            rf_cost.M.CAP_USD, rf_cost.CPU_MAX, rf_cost.RAM_GIB, rf_cost.STARTUP):
        raise SystemExit("rf_modal constants drifted from rf_cost")
    ap = argparse.ArgumentParser()
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("plan")
    p.add_argument("--name", required=True)
    p.add_argument("--jobs", required=True)
    sub.add_parser("status")
    sp = sub.add_parser("spawn")
    sp.add_argument("--manifest", required=True)
    co = sub.add_parser("collect")
    co.add_argument("--manifest", required=True)
    args = ap.parse_args()
    if args.cmd == "plan":
        plan(args.name, args.jobs)
    elif args.cmd == "spawn":
        spawn_deployed(args.manifest)
    elif args.cmd == "collect":
        collect(args.manifest)
    else:
        status()


if __name__ == "__main__":
    main()

