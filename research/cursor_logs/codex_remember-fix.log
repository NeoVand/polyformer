"""
Fair-test results, from the json records. Shells out to rf_recount.py and writes nothing
unless every per-run exact bit, first-error step and bitwise count agrees.

The results are labeled unaudited. This file does not edit the registered predictions.
"""

from __future__ import annotations

import json
import pathlib
import subprocess
import sys

import rf_models as M

HERE = pathlib.Path(__file__).resolve().parent
MD = HERE / "REMEMBER2.md"


def lower_median(values):
    xs = sorted(values)
    if not xs:
        return None
    return xs[(len(xs) - 1) // 2]


def _splice(marker, body):
    text = MD.read_text()
    start, end = f"<!-- {marker} -->", f"<!-- /{marker} -->"
    i, j = text.index(start), text.index(end)
    MD.write_text(text[:i] + start + "\n\n" + body.strip() + "\n\n" + text[j:])


def digest_payload(payload):
    out = {}
    lengths = [int(x) for x in payload["lengths"]]
    for run in payload["runs"]:
        first = run["first_error"]
        for length in lengths:
            exact = int(first is None or int(first) >= length)
            if bool(run["exact_at"][str(length)]) != bool(exact):
                raise SystemExit(f"exact_at disagrees with first_error in {payload['model']} seed {payload['seed']}")
            bit, ticks = "", ""
            if length == int(run["T"]) and run["bitwise"] is not None:
                bit, ticks = int(run["bitwise"]), int(run["ticks"])
            key = [payload["model"], int(payload["seed"]), run["arm"], run["policy"], int(run["table"]),
                   int(run["tape"]), length]
            out[json.dumps(key)] = [exact, "" if first is None else int(first), bit, ticks]
    return out


def recount(root):
    proc = subprocess.run([sys.executable, str(HERE / "rf_recount.py"), str(root)],
                          capture_output=True, text=True)
    if proc.returncode != 0:
        raise SystemExit(proc.stderr.strip() or proc.stdout.strip() or "rf_recount failed")
    raw = json.loads(proc.stdout)
    return {k: ["" if x == "" else int(x) for x in v] for k, v in raw.items()}


def _items(digest):
    for raw, value in digest.items():
        model, seed, arm, policy, table, tape, length = json.loads(raw)
        exact, first, bit, ticks = value
        yield {"model": model, "seed": int(seed), "arm": arm, "policy": policy, "table": int(table),
               "tape": int(tape), "length": int(length), "exact": int(exact),
               "first": None if first == "" else int(first), "bitwise": None if bit == "" else int(bit),
               "ticks": None if ticks == "" else int(ticks)}


def _cell(rows):
    return {"exact": sum(r["exact"] for r in rows), "n": len(rows)}


def _median_line(rows):
    steps = sorted(r["first"] + 1 for r in rows if r["exact"] == 0)
    excluded = sum(r["exact"] for r in rows)
    return {"median": lower_median(steps), "inexact": len(steps), "excluded": excluded, "n": len(rows),
            "steps": steps}


def retries(root, ledger):
    """Timeout retries from retries.json: plan job id -> the carry retry whose record replaces it.

    A retry counts only if the original settled as a timeout, the retry settled complete with the
    original's argv plus --carry of the original's runs.json, and every run in the original's
    record appears unchanged in the retry's record.
    """
    path = pathlib.Path(root) / "retries.json"
    if not path.exists():
        return {}
    out = {}
    for original, item in json.loads(path.read_text()).items():
        retry = item["retry"]
        first, second = ledger["jobs"].get(original, {}), ledger["jobs"].get(retry, {})
        if first.get("status") != "error" or "exceeded" not in str(first.get("error", "")):
            raise SystemExit(f"{original} is not a settled timeout")
        if second.get("status") != "complete":
            raise SystemExit(f"{retry} is not settled complete")
        if second.get("argv") != list(first.get("argv", [])) + ["--carry", f"/vol/{original}/runs.json"]:
            raise SystemExit(f"{retry} is not {original} with --carry of its runs")
        old = json.loads((pathlib.Path(root) / original / "runs.json").read_text())["runs"]
        new = json.loads((pathlib.Path(root) / retry / "runs.json").read_text())["runs"]
        if len(old) != int(item["carried_runs"]):
            raise SystemExit(f"{original} has {len(old)} runs, retries.json says {item['carried_runs']}")
        have = {json.dumps(r, sort_keys=True) for r in new}
        if any(json.dumps(r, sort_keys=True) not in have for r in old):
            raise SystemExit(f"{retry} changed a carried run")
        out[original] = retry
    return out


def build(root):
    root = pathlib.Path(root)
    plan = json.loads((root / "plan.json").read_text())
    ledger = json.loads((root / "modal_ledger.json").read_text())
    swap = retries(root, ledger)
    payloads = []
    trains = []
    for job in plan["jobs"]:
        path = root / swap.get(job["id"], job["id"])
        if job["kind"] == "train":
            trains.append(json.loads((path / "train.json").read_text()))
        else:
            payloads.append(json.loads((path / "runs.json").read_text()))
    digest = {}
    for payload in payloads:
        part = digest_payload(payload)
        if set(digest) & set(part):
            raise SystemExit("duplicate json cells")
        digest.update(part)
    other = recount(root)
    if other != digest:
        raise SystemExit(f"json and csv disagree on {len(set(digest) ^ set(other))} cells")
    _require(plan, payloads, trains, ledger, swap)
    rows = list(_items(digest))
    lengths = [int(x) for x in plan["lengths"]]
    pooled, per_seed, medians, bitwise = {}, {}, {}, {}
    for row in rows:
        pooled.setdefault(row["model"], {}).setdefault(row["arm"], {}).setdefault(row["policy"], {}).setdefault(
            row["length"], []).append(row)
        per_seed.setdefault((row["model"], row["seed"]), {}).setdefault(row["arm"], {}).setdefault(
            row["policy"], {}).setdefault(row["length"], []).append(row)
        if row["bitwise"] is not None:
            slot = bitwise.setdefault(row["model"], {}).setdefault(row["arm"], {}).setdefault(row["policy"], [0, 0])
            slot[0] += row["bitwise"]
            slot[1] += row["ticks"]
    def pack_cells(groups):
        return {model: {arm: {policy: {str(L): _cell(bucket[L]) for L in lengths}
                              for policy, bucket in arms.items()}
                        for arm, arms in model_arms.items()}
                for model, model_arms in groups.items()}
    # medians are pooled over seeds
    for model, arms in pooled.items():
        for arm, policies in arms.items():
            for policy, bucket in policies.items():
                medians.setdefault(model, {}).setdefault(arm, {})[policy] = {
                    str(L): _median_line(bucket[L]) for L in lengths}
    scores = score(pack_cells(pooled), plan["models"])
    return {"audit": "unaudited", "plan": {k: plan[k] for k in (
                "models", "seeds", "eval_tables", "tapes", "lengths", "key_length", "train_length",
                "train_tables", "supervised_per_step", "arms", "policies", "cuts")},
            "pooled": pack_cells(pooled), "per_seed": {
                f"{model} seed {seed}": pack_cells({model: arms})[model]
                for (model, seed), arms in per_seed.items()},
            "medians": medians, "bitwise": bitwise, "scores": scores,
            "checks": _check_lines(trains, payloads), "tables": _table_lines(payloads),
            "certs": _certs(payloads), "hosts": _hosts(payloads, ledger, swap), "spend": _spend(ledger),
            "retries": [{"job": k, "retry": v, "carried_runs": len(json.loads(
                (root / k / "runs.json").read_text())["runs"]), "error": ledger["jobs"][k].get("error")}
                        for k, v in sorted(swap.items())],
            "n_runs": len({(r["model"], r["seed"], r["arm"], r["policy"], r["table"], r["tape"]) for r in rows})}


def _require(plan, payloads, trains, ledger, swap=None):
    swap = swap or {}
    if plan.get("audit") != "unaudited":
        raise SystemExit("plan is not labeled unaudited")
    if [int(x) for x in plan["lengths"]] != list(M.LENGTHS):
        raise SystemExit("plan lengths are not 256, 1024, 4096")
    eval_jobs = [j for j in plan["jobs"] if j["kind"] == "eval"]
    train_jobs = [j for j in plan["jobs"] if j["kind"] == "train"]
    if len(payloads) != len(eval_jobs) or len(trains) != len(train_jobs):
        raise SystemExit("a plan job has no record")
    expect = len(plan["arms"]) * len(plan["policies"]) * int(plan["eval_tables"]) * int(plan["tapes"])
    indices = None
    for payload in payloads:
        if not payload.get("complete") or payload.get("audit") != "unaudited":
            raise SystemExit(f"{payload['model']} seed {payload['seed']} eval is not a complete unaudited record")
        if [int(x) for x in payload["lengths"]] != [int(x) for x in plan["lengths"]]:
            raise SystemExit(f"{payload['model']} seed {payload['seed']} lengths differ from the plan")
        if int(payload["tapes"]) != int(plan["tapes"]):
            raise SystemExit(f"{payload['model']} seed {payload['seed']} tapes differ from the plan")
        if len(payload["runs"]) != expect:
            raise SystemExit(f"{payload['model']} seed {payload['seed']} has {len(payload['runs'])} runs, expected {expect}")
        if payload["table_index"] != sorted(payload["table_index"]) or len(payload["table_index"]) != int(plan["eval_tables"]):
            raise SystemExit("table index list is not the plan prefix")
        if indices is None:
            indices = (payload["table_index"], [(t["i"], t["rows"], t["shape"], t["bin"])
                                                for t in payload["tables"] if t["arm"] == "pin"])
        else:
            got = (payload["table_index"], [(t["i"], t["rows"], t["shape"], t["bin"])
                                            for t in payload["tables"] if t["arm"] == "pin"])
            if got != indices:
                raise SystemExit(f"{payload['model']} seed {payload['seed']} tables differ from the first job")
    by_train = {(t["model"], int(t["seed"])): t for t in trains}
    for payload in payloads:
        train = by_train[(payload["model"], int(payload["seed"]))]
        if not train.get("complete") or int(train["steps"]) != M.STEPS:
            raise SystemExit(f"{payload['model']} seed {payload['seed']} train is not the 100-step edit")
        if train["fingerprint"] != payload["train_fingerprint"]:
            raise SystemExit("eval fingerprint does not match the train file")
        for arm in M.ARMS:
            if train["arms"][arm]["sha256"] != payload["edit_meta"][arm]["sha256"]:
                raise SystemExit(f"{arm} sha does not match the file the eval loaded")
        for run in payload["runs"]:
            if len(run["margin_trace"]) > 96:
                raise SystemExit("a counted trace exceeds 96 points")
    for job in plan["jobs"]:
        entry = ledger["jobs"].get(swap.get(job["id"], job["id"]))
        if not entry or entry.get("status") != "complete":
            raise SystemExit(f"{swap.get(job['id'], job['id'])} is not settled complete")


def _check_lines(trains, payloads):
    lines = []
    for train in trains:
        pin, hist = train["arms"]["pin"], train["arms"]["hist"]
        same_init = pin["init_sha256"] == hist["init_sha256"]
        same_data = pin["fingerprint"] == hist["fingerprint"] == train["fingerprint"]
        same_budget = (pin["trainable_params"] == hist["trainable_params"] and pin["lr"] == hist["lr"] == M.LR
                       and pin["rank"] == hist["rank"] == M.RANK and pin["steps"] == hist["steps"] == M.STEPS
                       and pin["chosen_step"] == M.STEPS and train["supervised_per_step"] == M.SUPERVISED
                       and train["selection"] == "last step")
        pres = train["presentation"]
        lines.append({
            "model": train["model"], "seed": train["seed"], "same_init": same_init, "same_data": same_data,
            "same_budget": same_budget, "labels": pres["labels"], "pi_len": pres["pi_len"],
            "causal_mismatches": pres["causal_mismatches"], "params": pin["trainable_params"],
            "acc_pin": pin["acc_last10"], "acc_hist": hist["acc_last10"],
            "wall_pin": pin["wall"], "wall_hist": hist["wall"], "diverged_pin": pin["diverged"],
            "diverged_hist": hist["diverged"],
        })
        if not (same_init and same_data and same_budget and pres["causal_mismatches"] == 0
                and pres["labels"] == M.TRAIN_LENGTH):
            raise SystemExit(f"paired-train check failed for {train['model']} seed {train['seed']}")
    if not lines:
        raise SystemExit("no training records")
    return lines


def _table_lines(payloads):
    tables = [t for t in payloads[0]["tables"] if t["arm"] == "pin"]
    return [{"i": t["i"], "rows": t["rows"], "shape": t["shape"], "bin": t["bin"]}
            for t in sorted(tables, key=lambda t: t["i"])]


def _certs(payloads):
    out = {}
    for payload in payloads:
        for table in payload["tables"]:
            slot = out.setdefault(payload["model"], {}).setdefault(table["arm"], {"pin": [0, 0], "tok": [0, 0]})
            slot["pin"][1] += 1
            slot["tok"][1] += 1
            slot["pin"][0] += int(bool(table["pin_pass"]))
            slot["tok"][0] += int(bool(table["tok_pass"]))
    return out


def _hosts(payloads, ledger, swap=None):
    swap = swap or {}
    lines = []
    for payload in payloads:
        job = f"eval-fair-{payload['model']}-s{payload['seed']}"
        entry = ledger["jobs"].get(swap.get(job, job), {})
        host = payload.get("host") or {}
        lines.append({"model": payload["model"], "seed": payload["seed"], "gpu": host.get("gpu"),
                      "cpu": host.get("cpu"), "gpu_actual": entry.get("gpu_actual"),
                      "cpu_actual": entry.get("cpu_actual")})
    return lines


def _spend(ledger):
    rows = []
    total = 0.0
    for entry in ledger["jobs"].values():
        usd = float(entry.get("settled_usd") or 0.0)
        total += usd
        rows.append({"id": entry["job_id"], "status": entry["status"], "settled_usd": usd,
                     "gpu": entry.get("gpu"), "gpu_actual": entry.get("gpu_actual")})
    return {"rows": rows, "settled_usd": round(total, 6), "cap_usd": ledger.get("cap_usd_total")}


def _frac(cell):
    if cell["n"] == 0:
        raise SystemExit("empty cell")
    return cell["exact"] / cell["n"]


def score(pooled, models):
    """The six registered fair-test predictions. Outcomes are hit, miss, or void."""
    detail = {name: {} for name in models}

    def grab(model, arm, policy, length):
        return _frac(pooled[model][arm][policy][str(length)])

    f5, f6 = [], []
    miss = {1: [], 2: [], 3: [], 4: []}
    for model in models:
        pin = grab(model, "pin", "pin", 256)
        hist = grab(model, "hist", "remember", 256)
        hist_long = grab(model, "hist", "remember", 4096)
        adv = grab(model, "pin", "adv", 256)
        tok = grab(model, "pin", "tok", 256)
        detail[model] = {"pin_pin_256": pin, "hist_remember_256": hist, "hist_remember_4096": hist_long,
                         "pin_adv_256": adv, "pin_tok_256": tok}
        if pin < 0.5:
            miss[1].append(model)
        if hist >= 0.5:
            miss[2].append(model)
        if not hist < pin:
            miss[3].append(model)
        if hist_long > hist:
            miss[4].append(model)
        if pin == 0:
            f5.append("void")
            f6.append("void")
        else:
            f5.append("hit" if adv < pin else "miss")
            f6.append("hit" if tok < pin else "miss")

    def join(marks):
        if any(m == "miss" for m in marks):
            return "miss"
        if marks and all(m == "void" for m in marks):
            return "void"
        return "hit"

    names = {
        1: "Pin arm under pin is exact at 256 on at least half its runs, in every counted model.",
        2: "History arm under remember is exact at 256 on fewer than half its runs, in every counted model.",
        3: "Pin-arm pin exact fraction at 256 is strictly above the history-arm remember fraction, in every counted model.",
        4: "History-arm remember exact fraction at 4096 is at most the fraction at 256, in every counted model.",
        5: "Pin arm under adv is strictly less exact at 256 than pin arm under pin, where the pin fraction is positive.",
        6: "Pin arm under tok is strictly less exact at 256 than pin arm under pin, where the pin fraction is positive.",
    }
    out = []
    for i in (1, 2, 3, 4):
        out.append({"id": i, "name": names[i], "outcome": "miss" if miss[i] else "hit", "models": miss[i]})
    out.append({"id": 5, "name": names[5], "outcome": join(f5), "models": []})
    out.append({"id": 6, "name": names[6], "outcome": join(f6), "models": []})
    return {"detail": detail, "predictions": out}


def _fmt_cell(cell):
    return f"{cell['exact']}/{cell['n']}"


def _fmt_median(item):
    if item["inexact"] == 0:
        return f"undefined (0 inexact, {item['excluded']} exact excluded, {item['n']} runs)"
    steps = ", ".join(str(s) for s in item["steps"])
    return (f"{item['median']} (steps {steps}; {item['excluded']} exact excluded, {item['n']} runs)")


def results_md(summary):
    plan = summary["plan"]
    lengths = [int(x) for x in plan["lengths"]]
    lines = [
        "Unaudited.",
        "",
        f"Seeds {plan['seeds']}. Eval tables {plan['eval_tables']}. Tapes {plan['tapes']}. "
        f"Lengths {lengths}. Key length {plan['key_length']}. "
        f"Train length {plan['train_length']}, {plan['train_tables']} tables, "
        f"{plan['supervised_per_step']} supervised positions a step. "
        "Each length cell is trace-exact runs over runs, pooled over seeds, tables and tapes. "
        "A shorter length is a prefix of the long tape.",
        "",
        "Tables, from the fresh-list prefix: " + "; ".join(
            f"index {t['i']} rows {t['rows']} {t['shape']} bin {t['bin']}" for t in summary["tables"]) + ".",
        "",
        "| model | arm | policy | " + " | ".join(str(L) for L in lengths) + " |",
        "| --- | --- | --- | " + " | ".join("---" for _ in lengths) + " |",
    ]
    for model in plan["models"]:
        for arm in plan["arms"]:
            for policy in plan["policies"]:
                cells = [model, arm, policy]
                for length in lengths:
                    cells.append(_fmt_cell(summary["pooled"][model][arm][policy][str(length)]))
                lines.append("| " + " | ".join(cells) + " |")
    lines += ["", "Lower median first-error step on the inexact runs.", ""]
    for model in plan["models"]:
        for arm in plan["arms"]:
            for policy in plan["policies"]:
                bits = [f"{L} {_fmt_median(summary['medians'][model][arm][policy][str(L)])}" for L in lengths]
                lines.append(f"{model} {arm} {policy}: " + "; ".join(bits) + ".")
    lines += ["", "Ticks whose logits equal that policy's row certificate. "
              "Pin uses the pin certificate. Tok uses the tok certificate. "
              "Adv and remember have no position-invariant row certificate.", ""]
    for model in plan["models"]:
        for arm in plan["arms"]:
            for policy in M.BITWISE_POLICIES:
                bit, ticks = summary["bitwise"].get(model, {}).get(arm, {}).get(policy, [0, 0])
                lines.append(f"{model} {arm} {policy}: {bit} of {ticks}.")
    lines += ["", "Per seed. Same exact/n cells.", ""]
    lines.append("| model | seed | arm | policy | " + " | ".join(str(L) for L in lengths) + " |")
    lines.append("| --- | --- | --- | --- | " + " | ".join("---" for _ in lengths) + " |")
    for model in plan["models"]:
        for seed in plan["seeds"]:
            block = summary["per_seed"][f"{model} seed {seed}"]
            for arm in plan["arms"]:
                for policy in plan["policies"]:
                    cells = [model, str(seed), arm, policy]
                    for length in lengths:
                        cells.append(_fmt_cell(block[arm][policy][str(length)]))
                    lines.append("| " + " | ".join(cells) + " |")
    lines += ["", "Row certificates. A pass is every row's argmax equal to the destination with positive margin. "
              "A failed certificate is a result; the tapes still ran.", ""]
    for model in plan["models"]:
        for arm in plan["arms"]:
            pin, tok = summary["certs"][model][arm]["pin"], summary["certs"][model][arm]["tok"]
            lines.append(f"{model} {arm}: pin certificate {pin[0]} of {pin[1]}, tok certificate {tok[0]} of {tok[1]}.")
    lines += ["", "Paired training. Both arms, one fingerprint, one init, last step kept.", ""]
    for row in summary["checks"]:
        lines.append(
            f"{row['model']} seed {row['seed']}: same_init {row['same_init']}, same_data {row['same_data']}, "
            f"same_budget {row['same_budget']}, first trajectory labels {row['labels']}, pi_len {row['pi_len']}, "
            f"causal_mismatches {row['causal_mismatches']}, params {row['params']}, "
            f"acc_last10 pin {row['acc_pin']} hist {row['acc_hist']}, "
            f"wall pin {row['wall_pin']} hist {row['wall_hist']}, "
            f"diverged pin {row['diverged_pin']} hist {row['diverged_hist']}.")
    lines += ["", "Registered predictions, scored from the pooled cells above.", ""]
    for pred in summary["scores"]["predictions"]:
        lines.append(f"F{pred['id']}. {pred['outcome']}. {pred['name']}")
    lines += ["", "Hosts. For a carry retry, the payload host is the retry's; the carried runs ran on the "
              "original job's host, listed under Retries.", ""]
    for row in summary["hosts"]:
        lines.append(f"{row['model']} seed {row['seed']}: gpu {row['gpu']}; cpu {row['cpu']}; "
                     f"ledger gpu {row['gpu_actual']}; ledger cpu {row['cpu_actual']}.")
    lines += ["", "Retries. A timeout is not a trace failure; the retry has a new job id and carries the "
              "finished runs unchanged.", ""]
    if not summary.get("retries"):
        lines.append("None.")
    for row in summary.get("retries", []):
        lines.append(f"`{row['job']}` ({row['error']}) is replaced by `{row['retry']}`, "
                     f"which carries its {row['carried_runs']} finished runs.")
    spend = summary["spend"]
    lines += ["", f"Settled {spend['settled_usd']} against cap {spend['cap_usd']}.", ""]
    for row in spend["rows"]:
        lines.append(f"- `{row['id']}` {row['status']} {row['settled_usd']} reserved-gpu {row['gpu']} "
                     f"actual {row['gpu_actual']}")
    lines.append("")
    lines.append(f"Runs in the pooled table: {summary['n_runs']}.")
    return "\n".join(lines)


def write(root):
    root = pathlib.Path(root)
    summary = build(root)
    (root / "summary.json").write_text(json.dumps(summary, indent=1, sort_keys=True))
    _splice("FAIR-RESULTS", results_md(summary))
    print(json.dumps({"wrote": str(MD), "runs": summary["n_runs"],
                      "scores": [p["outcome"] for p in summary["scores"]["predictions"]],
                      "settled_usd": summary["spend"]["settled_usd"]}))


def write_smoke(root):
    root = pathlib.Path(root)
    job = M.SMOKE["id"]
    train = json.loads((root / job / "train.json").read_text())
    payload = json.loads((root / job / "runs.json").read_text())
    timing = json.loads((root / job / "timing.json").read_text())
    problems = []
    if not train.get("complete") or int(train["steps"]) != 2:
        problems.append("train did not finish 2 steps")
    if train["arms"]["pin"]["fingerprint"] != train["arms"]["hist"]["fingerprint"]:
        problems.append("smoke arms saw different trajectories")
    if train["arms"]["pin"]["init_sha256"] != train["arms"]["hist"]["init_sha256"]:
        problems.append("smoke arms did not share an init")
    if train["presentation"]["causal_mismatches"] != 0 or train["presentation"]["labels"] != M.TRAIN_LENGTH:
        problems.append("smoke presentation failed")
    have = {(r["arm"], r["policy"]) for r in payload.get("runs", [])}
    for arm in M.ARMS:
        for policy in M.POLICIES:
            if (arm, policy) not in have:
                problems.append(f"missing {arm} {policy}")
    traces = [len(r["margin_trace"]) for r in payload.get("runs", [])]
    longest = max(traces) if traces else 0
    if longest > 96:
        problems.append(f"trace length {longest}")
    rates = timing["pin_seconds_per_tick"]
    body = [
        "Unaudited. The smoke is not a counted result. No change to the registered predictions.",
        "",
        f"Steps {train['steps']}. Eval length {payload['lengths']}. Runs {len(payload['runs'])}. "
        f"Max stored trace {longest}. Pin seconds per tick {rates}.",
        f"same_init {train['arms']['pin']['init_sha256'] == train['arms']['hist']['init_sha256']}. "
        f"same_data {train['arms']['pin']['fingerprint'] == train['fingerprint']}. "
        f"causal_mismatches {train['presentation']['causal_mismatches']}.",
    ]
    if problems:
        body.append("Problems: " + "; ".join(problems) + ".")
        _splice("FAIR-SMOKE", "\n".join(body))
        raise SystemExit("smoke failed: " + "; ".join(problems))
    _splice("FAIR-SMOKE", "\n".join(body))
    print(json.dumps({"pin_seconds_per_tick": rates, "max_trace": longest}))


if __name__ == "__main__":
    mode = sys.argv[1] if len(sys.argv) > 1 else "--write"
    root = pathlib.Path(sys.argv[2]) if len(sys.argv) > 2 else HERE / "results_fair"
    if mode == "--smoke":
        write_smoke(root)
    elif mode == "--write":
        write(root)
    else:
        raise SystemExit(f"unknown {mode}")
"""
Second count of the fair test, from runs.csv only.

Does not import the report. A run is exact at L when its first error is missing or at least L.
The lower median is the value at index (n-1)//2.
"""

from __future__ import annotations

import csv
import json
import pathlib
import sys


def lower_median(values):
    xs = sorted(values)
    if not xs:
        return None
    return xs[(len(xs) - 1) // 2]


def _blank(value):
    return value is None or value == ""


def digest_csv(path):
    out = {}
    with pathlib.Path(path).open() as f:
        for row in csv.DictReader(f):
            first = None if _blank(row["first_error_step"]) else int(row["first_error_step"]) - 1
            length = int(row["length"])
            exact = int(first is None or first >= length)
            if int(row["exact"]) != exact:
                raise SystemExit(f"{path} exact bit disagrees with first_error_step at {row}")
            bit = "" if _blank(row["bitwise"]) else int(row["bitwise"])
            ticks = "" if _blank(row["ticks"]) else int(row["ticks"])
            if bit != "" and ticks == "":
                raise SystemExit(f"{path} has bitwise ticks without a tick count")
            key = (row["model"], int(row["seed"]), row["arm"], row["policy"], int(row["table"]),
                   int(row["tape"]), length)
            if key in out:
                raise SystemExit(f"duplicate csv row {key}")
            out[key] = (exact, "" if first is None else first, bit, ticks)
    return out


def main():
    root = pathlib.Path(sys.argv[1])
    plan = json.loads((root / "plan.json").read_text())
    # A timed-out plan job is read from its carry retry; the report checks the retry's provenance.
    swap_path = root / "retries.json"
    swap = {k: v["retry"] for k, v in json.loads(swap_path.read_text()).items()} if swap_path.exists() else {}
    digest = {}
    for job in plan["jobs"]:
        if job["kind"] != "eval":
            continue
        part = digest_csv(root / swap.get(job["id"], job["id"]) / "runs.csv")
        overlap = set(digest) & set(part)
        if overlap:
            raise SystemExit(f"duplicate cells across jobs {list(overlap)[:3]}")
        digest.update(part)
    serial = {json.dumps(k): v for k, v in digest.items()}
    print(json.dumps(serial))


if __name__ == "__main__":
    main()

