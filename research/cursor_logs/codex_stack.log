QUERY_TOKENS = 4096
COSINE_MAX = 0.3
# How many cosine-ordered triples a job will certify before it stops looking.
# The first 200 were almost all the same K token, so the walk has to go much further.
SEARCH_LIMIT = 8000


def chunk_for(block_len):
    return max(1, QUERY_TOKENS // block_len)


