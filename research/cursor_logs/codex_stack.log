"""The canonical-KV pushdown executor on a merged Savant r3, the naive KV stack it is compared with, and the
plain-history decoder. Torch is imported inside the functions that need it. Nothing here launches a job.

Canonical step: one forward of the block [top][q][a] at positions |Π|, |Π|+1, |Π|+2 over a clone of Π's cache.
This is the pinned tick (scan_forward.single_lookup) with a 3-token block; the frame's KV is slot |Π| of that
forward, recomputed from (Π, top) every step.
"""

from __future__ import annotations

import copy
import random
import time

import stack_machine as M

SEED = M.SEED


# ---------------------------------------------------------------- symbols and Π


def assign(pool, name, roles, j):
    """Role -> name. j = 0 takes the test pool in order; j > 0 a seeded sample of it."""
    test = list(pool["test"])
    if len(test) < len(roles):
        raise RuntimeError("test pool too small")
    words = test[:len(roles)] if j == 0 else random.Random(f"{SEED}:{name}:assign:{j}").sample(test, len(roles))
    return {role: words[i] for i, role in enumerate(roles)}


def machine_spec(pool, name, j, records=None):
    program = M.programs()[name]
    records = records if records is not None else M.row_records(program)
    roles = M.roles_for(name, records)
    words = assign(pool, name, roles, j)
    ids = {r: int(pool["id_of"][w]) for r, w in words.items()}
    if len(set(ids.values())) != len(ids):
        raise RuntimeError("two roles share a token")
    nl = int(pool["nl"])
    pi = []
    for r in records:
        pi += [ids[r["top"]], ids[r["q"]], ids[r["a"]], ids[r["q2"]], nl]
    return {"name": name, "program": program, "records": records, "words": words, "ids": ids,
            "inv": {v: k for k, v in ids.items()}, "pi": pi, "P": len(pi), "assign": j}


# ---------------------------------------------------------------- caches


def _layers(cache):
    if hasattr(cache, "layers"):
        return [(layer.keys, layer.values) for layer in cache.layers]
    return list(zip(cache.key_cache, cache.value_cache))


def frame_at(cache, slot):
    """(L, 2, H, D) KV of one cache slot, all layers."""
    import torch
    return torch.stack([torch.stack([k[0, :, slot, :], v[0, :, slot, :]]) for k, v in _layers(cache)])


def with_frame(past, frame):
    """A new cache: Π's tensors followed by one frame slot. Π is not written."""
    import torch
    new = copy.copy(past)
    if hasattr(past, "layers"):
        new.layers = []
        for i, layer in enumerate(past.layers):
            c = copy.copy(layer)
            c.keys = torch.cat([layer.keys, frame[i, 0][None, :, None, :]], dim=-2)
            c.values = torch.cat([layer.values, frame[i, 1][None, :, None, :]], dim=-2)
            new.layers.append(c)
        return new
    new.key_cache = [torch.cat([k, frame[i, 0][None, :, None, :]], dim=-2) for i, k in enumerate(past.key_cache)]
    new.value_cache = [torch.cat([v, frame[i, 1][None, :, None, :]], dim=-2) for i, v in enumerate(past.value_cache)]
    return new


def crop(cache, n):
    if hasattr(cache, "layers"):
        for layer in cache.layers:
            layer.keys = layer.keys[:, :, :n, :]
            layer.values = layer.values[:, :, :n, :]
    else:
        cache.key_cache = [k[:, :, :n, :] for k in cache.key_cache]
        cache.value_cache = [v[:, :, :n, :] for v in cache.value_cache]


def seq_len(cache):
    return int(_layers(cache)[0][0].shape[-2])


def forward(model, cache, ids, positions, cache_index):
    import torch
    device = next(model.parameters()).device
    pos = torch.tensor([positions], device=device)
    cpos = torch.tensor(list(range(cache_index, cache_index + len(ids))), device=device)
    with torch.inference_mode():
        out = model(input_ids=torch.tensor([ids], device=device), position_ids=pos, cache_position=cpos,
                    past_key_values=cache, use_cache=True)
    return out.logits[0, -1]


# ---------------------------------------------------------------- the canonical step


def step(model, past, P, top_id, q_id, a_id):
    """Logits at the event and the frame's KV (slot P). Same call as scan_forward.single_lookup."""
    import pb_pin
    cache = pb_pin._clone(past)
    logit = forward(model, cache, [top_id, q_id, a_id], [P, P + 1, P + 2], P).clone()
    frame = frame_at(cache, P)
    del cache
    return logit, frame


def template(model, past, P, top_id):
    """The frame symbol alone at position P over Π: a 1-token forward."""
    import pb_pin
    cache = pb_pin._clone(past)
    forward(model, cache, [top_id], [P], P)
    frame = frame_at(cache, P)
    del cache
    return frame


def top2(logit):
    import torch
    v, i = torch.topk(logit.float(), 2)
    return int(i[0]), float(v[0] - v[1])


def certify(model, past, spec):
    """Every reachable row, one canonical step each. Keeps the logits and the frame KV per frame symbol."""
    import torch
    P, ids = spec["P"], spec["ids"]
    logits, frames, rows = {}, {}, []
    frame_equal = {}
    t0 = time.perf_counter()
    for r in spec["records"]:
        lg, fr = step(model, past, P, ids[r["top"]], ids[r["q"]], ids[r["a"]])
        arg, margin = top2(lg)
        target = ids[r["q2"]]
        ok = arg == target and margin > 0
        tgt_logit = float(lg[target].float())
        rows.append({"q": r["q"], "top": r["top"], "a": r["a"], "q2": r["q2"], "kind": r["kind"],
                     "argmax": arg, "argmax_role": spec["inv"].get(arg), "margin": margin, "ok": ok,
                     "target_logit": tgt_logit, "max_logit": float(lg.float().max())})
        logits[(r["top"], r["q"], r["a"])] = lg
        if r["top"] not in frames:
            frames[r["top"]] = fr
            frame_equal[r["top"]] = [0, 0]
        frame_equal[r["top"]][0] += 1
        frame_equal[r["top"]][1] += int(torch.equal(fr, frames[r["top"]]))
    seconds = time.perf_counter() - t0
    tmpl = {}
    tmpl_equal = {}
    for sym in frames:
        t = template(model, past, P, ids[sym])
        tmpl[sym] = t
        tmpl_equal[sym] = {"bitwise": bool(torch.equal(t, frames[sym])),
                           "max_abs": float((t.float() - frames[sym].float()).abs().max())}
    spec["templates"] = tmpl
    kinds = {}
    for row in rows:
        k = kinds.setdefault(row["kind"], {"n": 0, "ok": 0, "min_margin": None})
        k["n"] += 1
        k["ok"] += int(row["ok"])
        k["min_margin"] = row["margin"] if k["min_margin"] is None else min(k["min_margin"], row["margin"])
    rec = {"machine": spec["name"], "assign": spec["assign"], "words": spec["words"], "ids": spec["ids"],
           "P": P, "n_rows": len(rows), "n_ok": sum(r["ok"] for r in rows),
           "pass": all(r["ok"] for r in rows), "min_margin": min(r["margin"] for r in rows),
           "kinds": kinds, "seconds": seconds, "ms_per_row": 1000 * seconds / len(rows),
           "frame_slot_equal_across_rows": {k: {"n": v[0], "bitwise": v[1]} for k, v in frame_equal.items()},
           "frame_slot_vs_1token_template": tmpl_equal,
           "misses": [r for r in rows if not r["ok"]][:40], "rows": rows}
    return rec, logits, frames


# ---------------------------------------------------------------- runs


def run_canonical(model, past, spec, tokens, cert_logits, frames, stop_on_error=True):
    """The certified executor. Every step is real. Checks each step's logits and frame KV bitwise."""
    import torch
    program, ids, inv, P = spec["program"], spec["ids"], spec["inv"], spec["P"]
    delta = program["delta"]
    q = program["start_q"]
    stack = [program["start_top"]]
    n_bit_logit = n_bit_frame = n_cert = 0
    max_delta = 0.0
    max_frame_delta = 0.0
    min_margin = None
    first_error = None
    error = None
    depth_max = 0
    seen = {}
    t0 = time.perf_counter()
    n = 0
    for i, a in enumerate(tokens):
        top = stack[-1]
        lg, fr = step(model, past, P, ids[top], ids[q], ids[a])
        arg, margin = top2(lg)
        n += 1
        key = (top, q, a)
        ref = cert_logits.get(key)
        if ref is not None:
            n_cert += 1
            if torch.equal(lg, ref):
                n_bit_logit += 1
            else:
                max_delta = max(max_delta, float((lg.float() - ref.float()).abs().max()))
        if torch.equal(fr, frames[top]):
            n_bit_frame += 1
        else:
            max_frame_delta = max(max_frame_delta, float((fr.float() - frames[top].float()).abs().max()))
        min_margin = margin if min_margin is None else min(min_margin, margin)
        s = seen.setdefault(top, [10 ** 9, -1, 0])
        d = len(stack) - 1
        s[0], s[1], s[2] = min(s[0], d), max(s[1], d), s[2] + 1
        want_q2, op = delta(q, top, a)
        got = inv.get(arg)
        if got != want_q2:
            if first_error is None:
                first_error = i
                error = {"step": i, "q": q, "top": top, "a": a, "want": want_q2, "got": got, "argmax": arg,
                         "margin": margin, "depth": d}
            if stop_on_error:
                break
        if op[0] == "pop" and len(stack) < 2:
            first_error = i if first_error is None else first_error
            error = error or {"step": i, "why": "pop on BOT"}
            break
        stack = list(M.apply(tuple(stack), op)) if op[0] != "stay" else stack
        q = want_q2 if got == want_q2 else (got or q)
        depth_max = max(depth_max, len(stack) - 1)
    seconds = time.perf_counter() - t0
    final = q
    return {"n_steps": n, "n_tokens": len(tokens), "exact": first_error is None and n == len(tokens),
            "final_q": final, "value": M.value_of(program, final), "first_error": first_error, "error": error,
            "n_cert_rows": n_cert, "n_logits_bitwise": n_bit_logit, "n_frames_bitwise": n_bit_frame,
            "max_abs_delta": max_delta, "max_frame_delta": max_frame_delta, "min_margin": min_margin, "max_depth": depth_max,
            "frame_depths": {k: {"min_depth": v[0], "max_depth": v[1], "n": v[2]} for k, v in seen.items()},
            "seconds": seconds, "ms_per_step": 1000 * seconds / max(1, n)}


def run_history(model, spec, tokens, max_context=40960):
    """Plain decoding with history: Π, then the transcript ` top q a q2\\n`, positions not restarted. The host
    supplies top from its stack; q is the model's own previous output. Stops at the first wrong state."""
    import scan_forward as fwd
    program, ids, inv = spec["program"], spec["ids"], spec["inv"]
    delta = program["delta"]
    nl = spec["pi"][4]
    need = spec["P"] + 5 * len(tokens)
    if need > max_context:
        return {"runnable": False, "context_needed": need, "n_tokens": len(tokens)}
    cache = fwd.prefill(model, spec["pi"])
    L = spec["P"]
    q = program["start_q"]
    stack = [program["start_top"]]
    pending = []
    first_error = None
    error = None
    t0 = time.perf_counter()
    n = 0
    for i, a in enumerate(tokens):
        top = stack[-1]
        feed = pending + [ids[top], ids[q], ids[a]]
        lg = forward(model, cache, feed, list(range(L, L + len(feed))), L)
        L += len(feed)
        arg, margin = top2(lg)
        n += 1
        want_q2, op = delta(q, top, a)
        got = inv.get(arg)
        if got != want_q2:
            first_error = i
            error = {"step": i, "q": q, "top": top, "a": a, "want": want_q2, "got": got, "argmax": arg,
                     "margin": margin, "depth": len(stack) - 1}
            break
        stack = list(M.apply(tuple(stack), op)) if op[0] != "stay" else stack
        q = want_q2
        pending = [arg, nl]
    seconds = time.perf_counter() - t0
    del cache
    return {"runnable": True, "n_steps": n, "n_tokens": len(tokens), "exact": first_error is None,
            "first_error": first_error, "error": error, "final_q": q if first_error is None else None,
            "seconds": seconds, "ms_per_step": 1000 * seconds / max(1, n), "context_needed": need}


def naive_check(model, past, spec, tokens, frames, variant, every=1, max_steps=None):
    """Keep each frame's original KV: the stack is a cache Π ⊕ frames, a push runs the frame over Π and every frame
    below it (variant B at position P, variant A at P + depth), a pop crops. Templates are the 1-token forwards
    `certify` stores in spec["templates"]; `frames` is unused here and kept for the call signature. Each sampled step compares the stored
    top frame with the canonical template, and a 2-token step [q][a] over Π ⊕ stored frame with the same step over
    Π ⊕ template (the control). The trajectory is the reference one, so errors do not compound."""
    import pb_pin
    program, ids, P = spec["program"], spec["ids"], spec["P"]
    delta = program["delta"]
    cache = pb_pin._clone(past)

