"""One STACK GPU job: probe (certify, choose assignments, smoke every path), counted (one machine, everything),
l4 (certify and time on an L4), think (base Qwen3-4B with thinking, vLLM). Writes JSON under --out.
"""

from __future__ import annotations

import argparse
import json
import pathlib
import re
import sys
import time
import traceback

import stack_forward as sf
import stack_machine as M
from pb_common import atomic_json, host_record

BBH_PATH = "/opt/bbh/bbh/boolean_expressions.json"
N_ASSIGN = 16


def load(adapter2=None):
    import scan_forward as fwd
    t0 = time.perf_counter()
    tok = fwd.load_tokenizer()
    model = fwd.load_merged()
    if adapter2:
        from peft import PeftModel
        model = PeftModel.from_pretrained(model, adapter2).merge_and_unload().eval()
    import pb_pin
    pool = pb_pin.name_pool(tok)
    print(f"loaded in {time.perf_counter() - t0:.1f}s adapter2={adapter2}", flush=True)
    return model, tok, pool


def public_cert(rec):
    return {k: v for k, v in rec.items() if k != "rows"} | {"rows": rec["rows"]}


def cert_summary(rec):
    return {k: rec[k] for k in ("machine", "assign", "words", "P", "n_rows", "n_ok", "pass", "min_margin", "kinds",
                                "ms_per_row", "frame_slot_equal_across_rows", "frame_slot_vs_1token_template")} | {
        "misses": [{k: m[k] for k in ("q", "top", "a", "q2", "kind", "argmax_role", "argmax", "margin")}
                   for m in rec["misses"][:12]]}


def parse_assign(text):
    out = {}
    for part in filter(None, text.split(",")):
        k, v = part.split("=")
        out[k] = int(v)
    return out


def setup(model, pool, name, j):
    import scan_forward as fwd
    spec = sf.machine_spec(pool, name, j)
    past = fwd.prefill(model, spec["pi"])
    rec, logits, frames = sf.certify(model, past, spec)
    return spec, past, rec, logits, frames


# ---------------------------------------------------------------- probe


def probe(out, assign_text):
    import scan_forward as fwd
    model, tok, pool = load()
    host = host_record()
    fixed = parse_assign(assign_text)
    res = {"seed": M.SEED, "host": host, "machines": {}}
    for name in ("dyck2", "dyck4", "bool"):
        tries = []
        chosen = None
        for j in ([fixed[name]] if name in fixed else range(N_ASSIGN)):
            spec, past, rec, logits, frames = setup(model, pool, name, j)
            tries.append(cert_summary(rec))
            print(f"probe {name} assign={j} {rec['n_ok']}/{rec['n_rows']} min_margin={rec['min_margin']:.3f} "
                  f"ms_row={rec['ms_per_row']:.1f}", flush=True)
            for m in rec["misses"][:6]:
                print(f"   miss {m['q']} {m['top']} {m['a']} -> want {m['q2']} got {m['argmax_role']} "
                      f"({m['argmax']}) margin {m['margin']:.3f} kind {m['kind']}", flush=True)
            if rec["pass"]:
                chosen = j
                break
            del past, logits, frames
            fwd.torch_empty()
        entry = {"tries": tries, "chosen": chosen}
        if chosen is not None:
            cell = M.cell_input(name, M.CELLS[0])
            entry["d8_canonical"] = sf.run_canonical(model, past, spec, cell["tokens"], logits, frames)
            entry["d8_history"] = sf.run_history(model, spec, cell["tokens"])
            inst = M.instances(name, 8, 2)
            entry["naive_B_d8"] = sf.naive_check(model, past, spec, inst[0]["tokens"], frames, "B")
            entry["naive_A_d8"] = sf.naive_check(model, past, spec, inst[0]["tokens"], frames, "A")
            print(f"probe {name} d8 exact={entry['d8_canonical']['exact']} "
                  f"bitwise={entry['d8_canonical']['n_logits_bitwise']}/{entry['d8_canonical']['n_cert_rows']} "
                  f"frames={entry['d8_canonical']['n_frames_bitwise']} ms={entry['d8_canonical']['ms_per_step']:.1f} "
                  f"history_exact={entry['d8_history'].get('exact')} "
                  f"naiveB={entry['naive_B_d8']['by_depth']}", flush=True)
            del past, logits, frames
            fwd.torch_empty()
        res["machines"][name] = entry
        atomic_json(out / "probe.json", res)


# ---------------------------------------------------------------- counted


def counted(out, name, j, adapter2=None):
    import scan_forward as fwd
    model, tok, pool = load(adapter2)
    host = host_record()
    spec, past, rec, logits, frames = setup(model, pool, name, j)
    base = {"seed": M.SEED, "host": host, "machine": name, "assign": j, "adapter2": adapter2}
    atomic_json(out / "cert.json", base | {"cert": public_cert(rec)})
    print(f"cert {name} assign={j} {rec['n_ok']}/{rec['n_rows']} min_margin={rec['min_margin']:.3f}", flush=True)
    if not rec["pass"]:
        sys.exit(3)
    program = spec["program"]

    def canon(tokens):
        return sf.run_canonical(model, past, spec, tokens, logits, frames)

    cells = []
    for c in M.CELLS:
        made = M.cell_input(name, c)
        ref = M.run(program, made["tokens"])
        got = canon(made["tokens"])
        got.update({"cell": c["cell"], "ref_value": M.value_of(program, ref["q"]), "ref_max_depth": ref["max_depth"],
                    "token_sha256": M.token_hash(made["tokens"])})
        got["verdict_ok"] = got["exact"] and got["value"] is got["ref_value"]
        cells.append(got)
        atomic_json(out / "cells.json", base | {"cells": cells})
        print(f"cell {c['cell']} steps={got['n_steps']} exact={got['exact']} depth={got['max_depth']} "
              f"bitwise={got['n_logits_bitwise']}/{got['n_cert_rows']} frames={got['n_frames_bitwise']} "
              f"ms={got['ms_per_step']:.2f}", flush=True)
    malformed = []
    for label, tokens in M.malformed_tokens(name).items():
        got = canon(tokens)
        ref = M.run(program, tokens)
        got.update({"label": label, "ref_final": ref["q"]})
        got["ends_in_ref_sink"] = got["exact"] and got["final_q"] == ref["q"]
        malformed.append(got)
    atomic_json(out / "malformed.json", base | {"malformed": malformed})
    inst_rows = []
    for depth in M.INSTANCE_DEPTHS:
        for x in M.instances(name, depth):
            got = canon(x["tokens"])
            got.update({"depth": depth, "i": x["i"], "ref_value": x["value"], "token_sha256": x["token_sha256"]})
            got["verdict_ok"] = got["exact"] and got["value"] is x["value"]
            inst_rows.append(got)
        atomic_json(out / "instances.json", base | {"instances": inst_rows})
        print(f"instances d{depth} exact={sum(r['exact'] for r in inst_rows if r['depth'] == depth)}/"
              f"{sum(r['depth'] == depth for r in inst_rows)}", flush=True)
    if name == "bool":
        bbh(out, base, model, past, spec, logits, frames)
    naive = {"A": [], "B": []}
    for depth in M.INSTANCE_DEPTHS:
        xs = M.instances(name, depth)
        use = xs if depth < 512 else xs[:2]
        every = 1 if depth < 512 else 4
        for variant in ("B", "A"):
            for x in use:
                got = sf.naive_check(model, past, spec, x["tokens"], frames, variant, every=every)
                got.update({"depth": depth, "i": x["i"]})
                naive[variant].append(got)
        atomic_json(out / "naive.json", base | {"naive": naive})
        print(f"naive d{depth} done", flush=True)
    hist = {"instances": [], "cells": []}
    for depth in M.INSTANCE_DEPTHS:
        for x in M.instances(name, depth):
            got = sf.run_history(model, spec, x["tokens"])
            got.update({"depth": depth, "i": x["i"]})
            hist["instances"].append(got)
        atomic_json(out / "history.json", base | {"history": hist})
        print(f"history d{depth} exact={sum(bool(r.get('exact')) for r in hist['instances'] if r['depth'] == depth)}"
              f"/{sum(r['depth'] == depth for r in hist['instances'])}", flush=True)
    for c in M.CELLS:
        made = M.cell_input(name, c)
        got = sf.run_history(model, spec, made["tokens"])
        got.update({"cell": c["cell"]})
        hist["cells"].append(got)
        atomic_json(out / "history.json", base | {"history": hist})
    atomic_json(out / "run.json", base | {"completed": True})
    del past
    fwd.torch_empty()


def bbh(out, base, model, past, spec, logits, frames):
    examples = json.loads(pathlib.Path(BBH_PATH).read_text())["examples"]
    rows = []
    for i, ex in enumerate(examples):
        tokens, py_val = M.compile_bbh(ex["input"])
        tokens = tokens + ["END"]
        got = sf.run_canonical(model, past, spec, tokens, logits, frames)
        hist = sf.run_history(model, spec, tokens)
        target = ex["target"] == "True"
        rows.append({"i": i, "n_tokens": len(tokens), "target": target, "py": py_val,
                     "canonical_value": got["value"], "canonical_exact": got["exact"],
                     "canonical_correct": got["exact"] and got["value"] is target,
                     "logits_bitwise": got["n_logits_bitwise"], "cert_rows": got["n_cert_rows"],
                     "frames_bitwise": got["n_frames_bitwise"], "ms_per_step": got["ms_per_step"],
                     "max_depth": got["max_depth"], "history_exact": hist.get("exact"),
                     "history_first_error": hist.get("first_error")})
    n_ok = sum(r["canonical_correct"] for r in rows)
    atomic_json(out / "bbh.json", base | {"n": len(rows), "canonical_correct": n_ok,
                                          "history_exact": sum(bool(r["history_exact"]) for r in rows),
                                          "rows": rows})
    print(f"bbh canonical {n_ok}/{len(rows)} history {sum(bool(r['history_exact']) for r in rows)}", flush=True)


# ---------------------------------------------------------------- L4


def l4(out, assign_text):
    import scan_forward as fwd
    model, tok, pool = load()
    host = host_record()
    fixed = parse_assign(assign_text)
