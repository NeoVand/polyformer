+"""Negative controls for the unbounded row-coverage audit. No model/network."""
+
+import unittest
+from unittest.mock import patch
+
+import stack_machine as M
+from stack_validate import closed_cover
+
+
+class CoverTest(unittest.TestCase):
+    def test_closed_covers(self):
+        for name, n in (("dyck2", 50), ("dyck4", 144), ("bool", 294)):
+            self.assertEqual(closed_cover(M.programs()[name])["rows"], n)
+
+    def test_missing_row_is_rejected(self):
+        program = M.bool_program()
+        found = M.stable_rows(program)
+        found["rows"].pop(("F", "NOT", "RP"))
+        with patch.object(M, "stable_rows", return_value=found), self.assertRaises(AssertionError):
+            closed_cover(program)
+
+    def test_uncovered_successor_is_rejected(self):
+        program = M.bool_program()
+        delta = program["delta"]
+        program["delta"] = lambda q, top, a: ("UNKNOWN", ("stay",)) if (q, top, a) == ("F", "NOT", "RP") else delta(q, top, a)
+        with self.assertRaises(AssertionError):
+            closed_cover(program)
+
+
+if __name__ == "__main__":
+    unittest.main()

