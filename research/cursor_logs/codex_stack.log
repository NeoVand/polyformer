        rows.append({k: it[k] for k in it if k != "tokens"} | {
            "n_symbols": len(it["tokens"]) - 1, "answer": ans, "correct": ans is it["value"],
            "response_tokens": len(ids), "hit_max": o.outputs[0].finish_reason == "length",
            "tail": text[-400:]})
    atomic_json(out / "think.json", {"seed": M.SEED, "host": host_record(), "wall": wall, "max_model_len": max_model_len,
                                     "sampling": {"temperature": 0.6, "top_p": 0.95, "top_k": 20}, "rows": rows})
    for name in ("dyck2", "dyck4", "bool"):
