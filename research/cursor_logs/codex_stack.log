"""A short LoRA on stack-shaped random tables (the brief's fallback), on top of merged Savant r3.

Tables use the pin's train name pool, which is disjoint from the test pool the evaluated machines draw from. A table
has disjoint frame, state and event names; each row is ` top q a q2\\n`; a training block is [top][q][a] at the
restarted positions |Π|, |Π|+1, |Π|+2 with a block-diagonal mask, labelled q2 at the event. At most 300 steps.
After training the job certifies the three machines (assignments 0-15, first that passes) with the adapter merged.
"""

from __future__ import annotations

import argparse
import json
import math
import pathlib
import random
import time

import stack_forward as sf
import stack_machine as M
from pb_common import atomic_json, host_record

LORA_TARGETS = ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"]


def random_table(rng, names):
    n_q, n_g, n_a = rng.randint(3, 8), rng.randint(3, 9), rng.randint(4, 9)
    pick = rng.sample(names, n_q + n_g + n_a)
    states, frames, events = pick[:n_q], pick[n_q:n_q + n_g], pick[n_q + n_g:]
    keys = [(g, q, a) for q in states for g in frames for a in events]
    rng.shuffle(keys)
    keys = keys[:min(len(keys), rng.randint(40, 300))]
    sticky = rng.random() * 0.5
    rows = []
    for g, q, a in keys:
        q2 = q if rng.random() < sticky else rng.choice(states)
        rows.append((g, q, a, q2))
    if rng.random() < 0.5:
        rows.sort(key=lambda r: (r[1], r[0], r[2]))
    return rows


def example(rng, pool, blocks):
    rows = random_table(rng, pool["train"])
    io, nl = pool["id_of"], pool["nl"]
    pi = []
    for g, q, a, q2 in rows:
        pi += [io[g], io[q], io[a], io[q2], nl]
    pick = [rng.choice(rows) for _ in range(blocks)]
    return {"pi": pi, "blocks": [(io[g], io[q], io[a]) for g, q, a, _ in pick], "labels": [io[q2] for *_, q2 in pick]}


def packed_batch(exs, pad_id, block_len=3):
    import torch
    seqs = []
    for ex in exs:
        P = len(ex["pi"])
        ids, pos, owner, lab_pos = list(ex["pi"]), list(range(P)), [-1] * P, []
        for b, blk in enumerate(ex["blocks"]):
            ids += list(blk)
            pos += list(range(P, P + block_len))
            owner += [b] * block_len
            lab_pos.append(len(ids) - 1)
        seqs.append((ids, pos, owner, lab_pos))
    L = max(len(s[0]) for s in seqs)
    B = len(seqs)
    ids_t = torch.full((B, L), pad_id, dtype=torch.long)
    pos_t = torch.zeros((B, L), dtype=torch.long)
    allow = torch.zeros((B, 1, L, L), dtype=torch.bool)
    rows, cols, labels = [], [], []
    for i, ((sid, spos, owner, lab_pos), ex) in enumerate(zip(seqs, exs)):
        n = len(sid)
        ids_t[i, :n] = torch.tensor(sid)
        pos_t[i, :n] = torch.tensor(spos)
        own = torch.tensor(owner)
        q = torch.arange(n)
        causal = q[:, None] >= q[None, :]
        same = own[:, None] == own[None, :]
        to_pi = (own[None, :] < 0).expand(n, n)
        allow[i, 0, :n, :n] = causal & (same | to_pi)
        if n < L:
            idx = torch.arange(n, L)
            allow[i, 0, idx, idx] = True
        for p, lab in zip(lab_pos, ex["labels"]):
            rows.append(i)
            cols.append(p)
            labels.append(lab)
    return ids_t, pos_t, allow, torch.tensor(rows), torch.tensor(cols), torch.tensor(labels)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--steps", type=int, default=300)
    ap.add_argument("--rank", type=int, default=16)
    ap.add_argument("--lr", type=float, default=1e-4)
    ap.add_argument("--warmup", type=int, default=20)
    ap.add_argument("--tables", type=int, default=8)
    ap.add_argument("--micro", type=int, default=2)
    ap.add_argument("--blocks", type=int, default=48)
    ap.add_argument("--seed", type=int, default=M.SEED)
    ap.add_argument("--out", required=True)
    a = ap.parse_args()
    if a.steps > 300:
        raise SystemExit("the brief allows at most 300 LoRA steps")
    import torch
    import pb_pin
    import scan_forward as fwd
    from peft import LoraConfig, get_peft_model
    out = pathlib.Path(a.out)
    tok = fwd.load_tokenizer()
    pool = pb_pin.name_pool(tok)
    model = fwd.load_merged()
    torch.manual_seed(a.seed)
    model.gradient_checkpointing_enable(gradient_checkpointing_kwargs={"use_reentrant": False})
    model.enable_input_require_grads()
    model = get_peft_model(model, LoraConfig(r=a.rank, lora_alpha=2 * a.rank, lora_dropout=0.0, bias="none",
                                             task_type="CAUSAL_LM", target_modules=LORA_TARGETS))
    trainable = [p for p in model.parameters() if p.requires_grad]
    opt = torch.optim.AdamW(trainable, lr=a.lr, betas=(0.9, 0.99), weight_decay=0.0)
    core = model.base_model.model
    rng = random.Random(a.seed)
    pad = tok.token_to_id("<|im_end|>")
    log = []
    t0 = time.time()
    model.train()
    for step in range(a.steps):
        lr = a.lr * (step + 1) / a.warmup if step < a.warmup else \
            a.lr * (0.1 + 0.9 * 0.5 * (1 + math.cos(math.pi * (step - a.warmup) / max(1, a.steps - a.warmup))))
        for g in opt.param_groups:
            g["lr"] = lr
        opt.zero_grad(set_to_none=True)
        exs = sorted((example(rng, pool, a.blocks) for _ in range(a.tables)), key=lambda e: len(e["pi"]))
        n = a.tables * a.blocks
        loss_sum, ok = 0.0, 0
        for k in range(0, len(exs), a.micro):
            ids, pos, allow, r, c, lab = packed_batch(exs[k:k + a.micro], pad)
            hidden = core.model(input_ids=ids.cuda(), position_ids=pos.cuda(), attention_mask=allow.cuda()).last_hidden_state
            logits = core.lm_head(hidden[r.cuda(), c.cuda()]).float()
            loss = torch.nn.functional.cross_entropy(logits, lab.cuda(), reduction="sum")
            (loss / n).backward()
            loss_sum += loss.item()
            ok += int((logits.argmax(-1) == lab.cuda()).sum())
            del hidden, logits, loss
        gn = torch.nn.utils.clip_grad_norm_(trainable, 1.0)
        opt.step()
        if step % 10 == 0 or step == a.steps - 1:
            rec = {"step": step, "loss": loss_sum / n, "acc": ok / n, "lr": lr, "grad_norm": float(gn),
                   "elapsed": time.time() - t0}
            log.append(rec)
            print(json.dumps(rec), flush=True)
    model.save_pretrained(str(out / "adapter2"))
    atomic_json(out / "train.json", {"args": vars(a), "log": log, "host": host_record(), "seconds": time.time() - t0})
    model.eval()
    merged = model.merge_and_unload().eval()
    del opt
    torch.cuda.empty_cache()
    res = {"seed": M.SEED, "machines": {}}
    for name in ("dyck2", "dyck4", "bool"):
        tries, chosen = [], None
        for j in range(16):
            spec = sf.machine_spec(pool, name, j)
            past = fwd.prefill(merged, spec["pi"])
            rec, logits, frames = sf.certify(merged, past, spec)
            tries.append({k: rec[k] for k in ("assign", "n_rows", "n_ok", "pass", "min_margin", "kinds", "words")}
                         | {"misses": [{k: m[k] for k in ("q", "top", "a", "q2", "kind", "argmax_role", "margin")}
                                       for m in rec["misses"][:12]]})
            print(f"lora cert {name} assign={j} {rec['n_ok']}/{rec['n_rows']} min_margin={rec['min_margin']:.3f}",
                  flush=True)
            del past, logits, frames
            torch.cuda.empty_cache()
            if rec["pass"]:
                chosen = j
                break
        res["machines"][name] = {"tries": tries, "chosen": chosen}
        atomic_json(out / "lora_cert.json", res)


if __name__ == "__main__":
    main()

