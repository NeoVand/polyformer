from __future__ import annotations

import random
import unittest

import stack_machine as M


class MachineTest(unittest.TestCase):
    def test_dyck_pairs_match_the_hand_set(self):
        for k in (2, 4):
            program = M.dyck_program(k)
            found = M.stable_rows(program)
            self.assertTrue(found["stable"])
            pairs = {(q, top) for (q, top, _parent) in found["witness"]}
            self.assertEqual(pairs, M.dyck_pairs_hand(k))

    def test_dyck_accept_reject_and_transfer(self):
        p = M.dyck_program(2)
        self.assertEqual(M.run(p, ["O0", "O1", "C1", "C0", "END"])["q"], "HA")
        self.assertEqual(M.run(p, ["C0", "END"])["q"], "HR")
        self.assertEqual(M.run(p, ["O0", "C1", "END"])["q"], "HR")
        # matching close while BAD does not restore OK
        out = M.run(p, ["O0", "O1", "C0", "C0", "END"])
        self.assertEqual([step["q2"] for step in out["trace"]], ["OK", "OK", "BAD", "BAD", "HR"])
        self.assertEqual(out["trace"][3]["q"], "BAD")
        self.assertEqual(out["trace"][3]["top"], "F0")
        self.assertEqual(out["trace"][3]["q2"], "BAD")

    def test_bool_return_rows_use_the_child(self):
        rows = {(r["q"], r["top"], r["a"]): r["q2"] for r in M.row_records(M.bool_program())}
        self.assertEqual(rows[("T", "NOT", "RP")], "F")
        self.assertEqual(rows[("F", "NOT", "RP")], "T")
        self.assertEqual(rows[("T", "ANDT", "RP")], "T")
        self.assertEqual(rows[("F", "ANDT", "RP")], "F")
        self.assertEqual(rows[("T", "ANDF", "RP")], "F")
        self.assertEqual(rows[("F", "ANDF", "RP")], "F")
        self.assertEqual(rows[("T", "ORF", "RP")], "T")
        self.assertEqual(rows[("F", "ORF", "RP")], "F")
        self.assertEqual(rows[("F", "ORT", "RP")], "T")
        self.assertEqual(rows[("Z", "BOT", "RP")], "E")
        self.assertEqual(rows[("T", "BOT", "END")], "HT")
        self.assertEqual(rows[("HT", "BOT", "AND")], "HT")

    def test_bool_matches_python_on_nested_and_random(self):
        program = M.bool_program()
        samples = [
            "True",
            "False",
            "not True",
            "not not False",
            "(not False) and True",
            "True and False or True",
            "not ( True ) and ( True )",
            "True and not not ( not False )",
            "False or not ( True ) and False",
            "True or not False and True and False",
        ]
        rng = random.Random(0)
        for _ in range(400):
            samples.append(_random_expr(rng, 4))
        for text in samples:
            tokens, py_val = M.compile_expr(text)
            got = M.run(program, tokens + ["END"])
            self.assertIs(M.value_of(program, got["q"]), py_val, text)
            again, py2 = M.compile_expr(M.tokens_to_expr(tokens))
            self.assertEqual(again, tokens)
            self.assertIs(py2, py_val)
            self.assertIs(M.eval_tokens(tokens), py_val)

    def test_inputs_hit_depth_and_stay_on_witnessed_rows(self):
        for name, program in M.programs().items():
            found = M.stable_rows(program, 8, 12)
            self.assertTrue(found["stable"], name)
            known = set(found["rows"])
            for spec in M.CELLS:
                rec = M.summarize_input(program, spec)
                made = M.cell_input(name, spec)
                self.assertEqual(rec["n_symbols"], len(made["tokens"]) - 1)
                if name != "bool":
                    self.assertEqual(rec["n_symbols"], rec["length_request"])
                if spec["cell"] == "L20000" and name == "bool":
                    self.assertEqual(rec["n_symbols"], 20000)
                    self.assertGreaterEqual(rec["max_depth"], 64)
                    self.assertLessEqual(rec["max_depth"], 512)
                    self.assertTrue({"AND", "OR"} & set(made["tokens"]))
                elif spec["cell"] == "L20000":
                    self.assertEqual(rec["max_depth"], 512)
                else:
                    self.assertEqual(rec["max_depth"], spec["depth"])
                    if name == "bool":
                        self.assertTrue({"AND", "OR"} & set(made["tokens"]))
                if name == "bool":
                    self.assertTrue(rec["expr_matches_machine"])
                    self.assertIsNotNone(rec["value"])
                else:
                    self.assertIs(rec["value"], True)
                out = M.run(program, made["tokens"])
                for step in out["trace"]:
                    self.assertIn((step["q"], step["top"], step["a"]), known)
            for label, tokens in M.malformed_tokens(name).items():
                out = M.run(program, tokens)
                self.assertIn(out["q"], program["halt"], label)
                self.assertIsNot(M.value_of(program, out["q"]), True)
                for step in out["trace"]:
                    self.assertIn((step["q"], step["top"], step["a"]), known)

    def test_random_instances_hit_depth_and_values(self):
        for name, program in M.programs().items():
            known = set(M.stable_rows(program, 8, 12)["rows"])
            for depth in M.INSTANCE_DEPTHS:
                xs = M.instances(name, depth)
                self.assertEqual(len(xs), M.INSTANCE_N)
                for x in xs:
                    self.assertEqual(x["max_depth"], depth)
                    out = M.run(program, x["tokens"])
                    self.assertIn(out["q"], program["halt"])
                    for step in out["trace"]:
                        self.assertIn((step["q"], step["top"], step["a"]), known)
                    if name == "bool":
                        self.assertIs(M.eval_tokens(x["tokens"][:-1]), x["value"])
                    else:
                        self.assertIs(x["value"], x["i"] % 2 == 0)

    def test_bbh_file_if_present(self):
        path = "/tmp/bbh/boolean_expressions.json"
        try:
            audit = M.bbh_audit(path)
        except FileNotFoundError:
            self.skipTest("bbh file not downloaded")
        self.assertEqual(audit["n"], 250)
        self.assertEqual(audit["n_parse"], 250)
        self.assertEqual(audit["n_match"], 250)


def _random_expr(rng, depth):
    if depth <= 1 or rng.random() < 0.3:
        return rng.choice(["True", "False"])
    kind = rng.choice(["not", "and", "or"])
    if kind == "not":
        return f"(not {_random_expr(rng, depth - 1)})"
    return f"({_random_expr(rng, depth - 1)} {kind} {_random_expr(rng, depth - 1)})"


