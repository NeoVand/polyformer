    for i, a in enumerate(tokens):
        if max_steps is not None and i >= max_steps:
            break
        top = stack[-1]
        want_q2, op = delta(q, top, a)
        d = len(stack) - 1
        if i % every == 0:
            stored = frame_at(cache, seq_len(cache) - 1)
            # the 1-token template has the same forward shape as a naive push, so depth 0 is bitwise
            tmpl = spec["templates"][top]
            dk = float((stored[:, 0].float() - tmpl[:, 0].float()).abs().max())
            dv = float((stored[:, 1].float() - tmpl[:, 1].float()).abs().max())
            rel = float((stored.float() - tmpl.float()).norm() / tmpl.float().norm().clamp(min=1e-8))
            qpos = P + 1 if variant == "B" else P + d + 1
            lg_n = forward(model, with_frame(past, stored), [ids[q], ids[a]], [qpos, qpos + 1], P + 1).clone()
            lg_c = forward(model, with_frame(past, tmpl), [ids[q], ids[a]], [P + 1, P + 2], P + 1).clone()
            arg_n, m_n = top2(lg_n)
            arg_c, m_c = top2(lg_c)
            bucket = "0" if d == 0 else "1-7" if d < 8 else "8-63" if d < 64 else "64-511" if d < 512 else "512+"
            b = out["by_depth"].setdefault(bucket, {"n": 0, "kv_bitwise": 0, "max_dk": 0.0, "max_dv": 0.0,
                                                    "max_rel": 0.0, "naive_ok": 0, "control_ok": 0,
                                                    "max_dlogit": 0.0, "argmax_differs": 0})
            b["n"] += 1
            b["kv_bitwise"] += int(dk == 0.0 and dv == 0.0)
            b["max_dk"] = max(b["max_dk"], dk)
            b["max_dv"] = max(b["max_dv"], dv)
            b["max_rel"] = max(b["max_rel"], rel)
            b["naive_ok"] += int(arg_n == ids[want_q2])
            b["control_ok"] += int(arg_c == ids[want_q2])
            b["max_dlogit"] = max(b["max_dlogit"], float((lg_n.float() - lg_c.float()).abs().max()))
            b["argmax_differs"] += int(arg_n != arg_c)
            out["n"] += 1
        # host stack and the KV stack move together
        if op[0] == "push":
            stack.append(op[1])
            push(op[1])
        elif op[0] == "pop":
            stack.pop()
            crop(cache, seq_len(cache) - 1)
        elif op[0] == "rewrite":
            stack[-1] = op[1]
            crop(cache, seq_len(cache) - 1)
            push(op[1])
        elif op[0] == "store_push":
            stack[-1] = op[1]
            crop(cache, seq_len(cache) - 1)
            push(op[1])
            stack.append(op[2])
            push(op[2])
        q = want_q2
    del cache
    return out

