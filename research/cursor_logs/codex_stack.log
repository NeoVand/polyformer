@@ -0,0 +1,110 @@
+"""Offline checks of the finite row cover and collected experimental evidence.
+
+Run with --out to save the audit. No model or network is used.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import stack_machine as M
+
+ROOT = Path(__file__).resolve().parent
+
+
+def closed_cover(program):
+    """Independent upper bound, closed under every possible parent exposed by pop.
+
+    Concrete witnesses provide the lower bound. Equality proves completeness;
+    agreement between two finite search depths alone would not prove it.
+    """
+    if program["name"] == "bool":
+        pairs = {(q, top) for q in ("Z", "T", "F", "E", "HE") for top in M.BOOL_FRAMES}
+        pairs |= {("HT", "BOT"), ("HF", "BOT")}
+    else:
+        pairs = M.dyck_pairs_hand(program["k"])
+    assert (program["start_q"], program["start_top"]) in pairs
+    checked = 0
+    for q, top in pairs:
+        # Any non-bottom symbol may have any parent. Its deeper ancestors are
+        # invisible to delta/apply, and cannot affect the next control pair.
+        stacks = [("BOT",)] if top == "BOT" else [
+            ("BOT", top) if parent == "BOT" else ("BOT", parent, top)
+            for parent in program["frames"]
+        ]
+        for stack in stacks:
+            for event in program["alphabet"]:
+                q2, op = program["delta"](q, top, event)
+                next_stack = M.apply(stack, op)
+                assert next_stack[0] == "BOT" and "BOT" not in next_stack[1:]
+                assert (q2, next_stack[-1]) in pairs, (q, stack, event, q2, next_stack)
+                checked += 1
+    found = M.stable_rows(program)
+    assert pairs == {(q, top) for q, top, _ in found["witness"]}
+    expected = {(q, top, a) for q, top in pairs for a in program["alphabet"]}
+    assert expected == set(found["rows"])
+    return {"pairs": len(pairs), "rows": len(expected), "closure_checks": checked,
+            "closed_for_arbitrary_parent": True, "all_pairs_have_concrete_witness": True}
+
+
+def validate_results():
+    result = {"row_cover": {name: closed_cover(p) for name, p in M.programs().items()}, "jobs": {}}
+    for name, program in M.programs().items():
+        directory = ROOT / "results" / f"stack-counted-{name}-h100"
+        if not (directory / "run.json").exists():
+            result["jobs"][name] = {"complete": False}
+            continue
+        read = lambda file: json.loads((directory / file).read_text())
+        cert = read("cert.json")["cert"]
+        expected = {(r["q"], r["top"], r["a"]): r["q2"] for r in M.row_records(program)}
+        rows = cert["rows"]
+        assert len(rows) == len(expected) == cert["n_ok"] == cert["n_rows"]
+        assert cert["pass"] and cert["assign"] == 0 and cert["min_margin"] > 0
+        assert {(r["q"], r["top"], r["a"]): r["q2"] for r in rows} == expected
+        assert all(r["ok"] and r["argmax"] == cert["ids"][r["q2"]] and r["margin"] > 0 for r in rows)
+        cells = read("cells.json")["cells"]
+        instances = read("instances.json")["instances"]
+        malformed = read("malformed.json")["malformed"]
+        assert [r["cell"] for r in cells] == [c["cell"] for c in M.CELLS]
+        assert len(instances) == len(M.INSTANCE_DEPTHS) * M.INSTANCE_N
+        assert {r["label"] for r in malformed} == set(M.malformed_tokens(name))
+        for c, r in zip(M.CELLS, cells):
+            made = M.cell_input(name, c)
+            ref = M.run(program, made["tokens"])
+            assert r["token_sha256"] == M.token_hash(made["tokens"])
+            assert r["max_depth"] == ref["max_depth"] and r["verdict_ok"]
+        expected_instances = {(x["depth"], x["i"]): x for depth in M.INSTANCE_DEPTHS
+                              for x in M.instances(name, depth)}
+        assert {(r["depth"], r["i"]) for r in instances} == set(expected_instances)
+        for r in instances:
+            assert r["token_sha256"] == expected_instances[r["depth"], r["i"]]["token_sha256"]
+            assert r["verdict_ok"]
+        for r in cells + instances + malformed:
+            assert r["exact"] and r["n_steps"] == r["n_tokens"] == r["n_cert_rows"]
+            assert r["n_steps"] == r["n_logits_bitwise"] == r["n_frames_bitwise"]
+            assert r["max_abs_delta"] == r["max_frame_delta"] == 0 and r["min_margin"] > 0
+        assert all(r["ends_in_ref_sink"] for r in malformed)
+        assert read("run.json")["completed"]
+        if name == "bool":
+            bbh = read("bbh.json")
+            assert bbh["n"] == bbh["canonical_correct"] == len(bbh["rows"]) == 250
+            assert {r["i"] for r in bbh["rows"]} == set(range(250))
+            for r in bbh["rows"]:
+                assert r["canonical_exact"] and r["canonical_correct"] and r["py"] is r["target"]
+                assert r["n_tokens"] == r["cert_rows"] == r["logits_bitwise"] == r["frames_bitwise"]
+        result["jobs"][name] = {"complete": True, "certificate_rows": len(rows),
+                                "cells": len(cells), "instances": len(instances), "malformed": len(malformed)}
+    return result
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", type=Path)
+    args = parser.parse_args()
+    result = validate_results()
+    text = json.dumps(result, indent=2) + "\n"
+    if args.out:
+        args.out.write_text(text)
+    print(text, end="")

