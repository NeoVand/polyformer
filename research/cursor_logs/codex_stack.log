"""
Visibly pushdown machines for the stack pilot, and the inputs the certificate is about.

Nothing here imports torch. The host owns the stack. The model is only asked for the next
control state of a row (q, top, a). The stack operation is a pure function of that same row.

Return-value transfer. A return pops the top frame and the next state is combine(child state, frame),
not a restored parent state. For NOT, the two child states produce opposite results. For AND, both
ANDT and ANDF do. For OR, ORF does (false or the child equals the child); ORT yields true for both
children because the left operand was already true. For Dyck, a matching close in OK stays OK and the
same close in BAD stays BAD, so a failed child is not rewritten to OK.

Bottom-of-stack rows are returns while the top is BOT: the stack stays, the state becomes the error
state. Malformed rows are every other transition the machine rejects. Halting rows are the sinks
HT, HF, HE (boolean) and HA, HR (Dyck): every symbol stays there and the stack is frozen.
"""

from __future__ import annotations

import ast
import hashlib
import json
import pathlib
import random

SEED = 20261029

BOOL_STATES = ("Z", "T", "F", "E", "HT", "HF", "HE")
BOOL_FRAMES = ("BOT", "AND0", "ANDT", "ANDF", "OR0", "ORT", "ORF", "NOT")
BOOL_ALPHABET = ("AND", "OR", "NOT", "TT", "FF", "RP", "END")
BOOL_CALLS = ("AND", "OR", "NOT")
BOOL_RETURNS = ("RP",)
BOOL_INTERNAL = ("TT", "FF", "END")
BOOL_HALT = ("HT", "HF", "HE")

DYCK_STATES = ("OK", "BAD", "HA", "HR")
DYCK_HALT = ("HA", "HR")


def apply(stack, op):
    """One stack operation. `stack` is a non-empty tuple; BOT is stack[0] at the start."""
    kind = op[0]
    if kind == "stay":
        return stack
    if kind == "rewrite":
        return stack[:-1] + (op[1],)
    if kind == "push":
        return stack + (op[1],)
    if kind == "pop":
        if len(stack) < 2:
            raise RuntimeError("pop on the bottom frame")
        return stack[:-1]
    if kind == "store_push":
        return stack[:-1] + (op[1], op[2])
    raise RuntimeError(f"unknown op {op}")


def _blind_bool(top, a):
    """Visible push, pop, or neither, into the error state. Halt entry on END."""
    if a == "END":
        return "HE", ("stay",)
    if a in BOOL_CALLS:
        frame = {"AND": "AND0", "OR": "OR0", "NOT": "NOT"}[a]
        return "E", ("push", frame)
    if a == "RP":
        return "E", (("pop",) if top != "BOT" else ("stay",))
    return "E", ("stay",)


def _bool_good():
    """Transitions whose target is not the error sink. Everything else is malformed or a halt entry."""
    good = {}

    def add(q, top, a, q2, op):
        good[(q, top, a)] = (q2, op)

    for top in BOOL_FRAMES:
        add("Z", top, "AND", "Z", ("push", "AND0"))
        add("Z", top, "OR", "Z", ("push", "OR0"))
        add("Z", top, "NOT", "Z", ("push", "NOT"))
    add("Z", "AND0", "TT", "Z", ("rewrite", "ANDT"))
    add("Z", "AND0", "FF", "Z", ("rewrite", "ANDF"))
    add("Z", "OR0", "TT", "Z", ("rewrite", "ORT"))
    add("Z", "OR0", "FF", "Z", ("rewrite", "ORF"))
    for top in ("ANDT", "ANDF", "ORT", "ORF", "NOT", "BOT"):
        add("Z", top, "TT", "T", ("stay",))
        add("Z", top, "FF", "F", ("stay",))
    # A nested left operand just returned its value into the state, and the right operand is a literal.
    # The literal becomes the state; the frame stores the left value. The following return combines them.
    add("T", "AND0", "TT", "T", ("rewrite", "ANDT"))
    add("T", "AND0", "FF", "F", ("rewrite", "ANDT"))
    add("F", "AND0", "TT", "T", ("rewrite", "ANDF"))
    add("F", "AND0", "FF", "F", ("rewrite", "ANDF"))
    add("T", "OR0", "TT", "T", ("rewrite", "ORT"))
    add("T", "OR0", "FF", "F", ("rewrite", "ORT"))
    add("F", "OR0", "TT", "T", ("rewrite", "ORF"))
    add("F", "OR0", "FF", "F", ("rewrite", "ORF"))
    for q, stored in (("T", "ANDT"), ("F", "ANDF")):
        for a, pushed in (("AND", "AND0"), ("OR", "OR0"), ("NOT", "NOT")):
            add(q, "AND0", a, "Z", ("store_push", stored, pushed))
    for q, stored in (("T", "ORT"), ("F", "ORF")):
        for a, pushed in (("AND", "AND0"), ("OR", "OR0"), ("NOT", "NOT")):
            add(q, "OR0", a, "Z", ("store_push", stored, pushed))
    # Pop rows. The child state is q and the frame holds the operator and any left operand.
    add("T", "NOT", "RP", "F", ("pop",))
    add("F", "NOT", "RP", "T", ("pop",))
    add("T", "ANDT", "RP", "T", ("pop",))
    add("F", "ANDT", "RP", "F", ("pop",))
    add("T", "ANDF", "RP", "F", ("pop",))
    add("F", "ANDF", "RP", "F", ("pop",))
    add("T", "ORT", "RP", "T", ("pop",))
    add("F", "ORT", "RP", "T", ("pop",))
    add("T", "ORF", "RP", "T", ("pop",))
    add("F", "ORF", "RP", "F", ("pop",))
    add("T", "BOT", "END", "HT", ("stay",))
    add("F", "BOT", "END", "HF", ("stay",))
    return good


_BOOL_GOOD = _bool_good()


def bool_delta(q, top, a):
    if q in BOOL_HALT:
        return q, ("stay",)
    if q == "E":
        return _blind_bool(top, a)
    hit = _BOOL_GOOD.get((q, top, a))
    if hit is not None:
        return hit
    if a == "END":
        return "HE", ("stay",)
    return _blind_bool(top, a)


def dyck_symbols(k):
    opens = tuple(f"O{i}" for i in range(k))
    closes = tuple(f"C{i}" for i in range(k))
    frames = ("BOT",) + tuple(f"F{i}" for i in range(k))
    alphabet = opens + closes + ("END",)
    return opens, closes, frames, alphabet


def make_dyck_delta(k):
    opens, closes, _, _ = dyck_symbols(k)
    frame = {f"O{i}": f"F{i}" for i in range(k)}
    close_i = {c: i for i, c in enumerate(closes)}

    def delta(q, top, a):
        if q in DYCK_HALT:
            return q, ("stay",)
        if a == "END":
            if q == "OK" and top == "BOT":
                return "HA", ("stay",)
            return "HR", ("stay",)
        if a in opens:
            return ("OK" if q == "OK" else "BAD"), ("push", frame[a])
        i = close_i[a]
        if top == "BOT":
            return "BAD", ("stay",)
        if q == "OK" and top == f"F{i}":
            return "OK", ("pop",)
        return "BAD", ("pop",)

    return delta


def bool_program():
    return {
        "name": "bool",
        "states": BOOL_STATES,
        "frames": BOOL_FRAMES,
        "alphabet": BOOL_ALPHABET,
        "calls": BOOL_CALLS,
        "returns": BOOL_RETURNS,
        "internal": BOOL_INTERNAL,
        "halt": BOOL_HALT,
        "delta": bool_delta,
        "start_q": "Z",
        "start_top": "BOT",
    }


def dyck_program(k):
    opens, closes, frames, alphabet = dyck_symbols(k)
    return {
        "name": f"dyck{k}",
        "k": k,
        "states": DYCK_STATES,
        "frames": frames,
        "alphabet": alphabet,
        "calls": opens,
        "returns": closes,
        "internal": ("END",),
        "halt": DYCK_HALT,
        "delta": make_dyck_delta(k),
        "start_q": "OK",
        "start_top": "BOT",
    }


def programs():
    return {"dyck2": dyck_program(2), "dyck4": dyck_program(4), "bool": bool_program()}


def run(program, tokens):
    """Reference execution. `tokens` may end with END. Returns the trace and the max frames above BOT."""
    q = program["start_q"]
    stack = (program["start_top"],)
    trace = []
    max_depth = 0
    for a in tokens:
        if a not in program["alphabet"]:
            raise RuntimeError(f"{program['name']} has no symbol {a}")
        top = stack[-1]
        q2, op = program["delta"](q, top, a)
        trace.append({"q": q, "top": top, "a": a, "q2": q2, "op": list(op)})
        stack = apply(stack, op)
        q = q2
        max_depth = max(max_depth, len(stack) - 1)
    return {"q": q, "stack": list(stack), "trace": trace, "max_depth": max_depth, "n": len(tokens)}


def value_of(program, final_q):
    """Boolean T/F, Dyck accept, or None when the machine halted in error / did not halt."""
    if program["name"] == "bool":
        if final_q in ("T", "HT"):
            return True
        if final_q in ("F", "HF"):
            return False
        return None
    if final_q == "HA":
        return True
    if final_q == "HR":
        return False
    return None


# ---------------------------------------------------------------- reachable rows


def reachable(program, stack_limit=8):
    """Rows witnessed by a concrete stack.

    The search state is (q, top, parent). One witness stack is kept per state. Pop uses that
    stack, so the grandparent it reveals is the witness's grandparent. `stack_limit` bounds
    how tall a witness may grow; the pair set is recomputed at two limits by `stable_rows`.
    """
    delta = program["delta"]
    alphabet = program["alphabet"]
    start_q, start_top = program["start_q"], program["start_top"]
    # parent None means the stack is exactly (BOT,)
    witness = {(start_q, start_top, None): (start_top,)}
    rows = {}
    work = [(start_q, start_top, None)]
    head = 0
    while head < len(work):
        q, top, parent = work[head]
        head += 1
        stack = witness[(q, top, parent)]
        for a in alphabet:
            q2, op = delta(q, top, a)
            rows.setdefault((q, top, a), (q2, op))
            stack2 = apply(stack, op)
            if len(stack2) - 1 > stack_limit:
                continue
            parent2 = stack2[-2] if len(stack2) >= 2 else None
            key = (q2, stack2[-1], parent2)
            if key not in witness:
                witness[key] = stack2
                work.append(key)
    return rows, witness


def stable_rows(program, lo=6, hi=10):
    """The witnessed row set once raising the stack limit stops adding (q, top) pairs."""
    rows_lo, wit_lo = reachable(program, lo)
    rows_hi, wit_hi = reachable(program, hi)
    pairs_lo = {(q, top) for q, top, _ in wit_lo}
    pairs_hi = {(q, top) for q, top, _ in wit_hi}

