            print(f"think {name} d{depth} {sum(r['correct'] for r in sel)}/{len(sel)}", flush=True)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--mode", required=True, choices=("probe", "counted", "l4", "think"))
    ap.add_argument("--machine", default="")
    ap.add_argument("--assign", default="")
    ap.add_argument("--adapter2", default="")
    ap.add_argument("--out", required=True)
    a = ap.parse_args()
    out = pathlib.Path(a.out)
    out.mkdir(parents=True, exist_ok=True)
    try:
        if a.mode == "probe":
            probe(out, a.assign)
        elif a.mode == "counted":
            counted(out, a.machine, parse_assign(a.assign)[a.machine], a.adapter2 or None)
        elif a.mode == "l4":
            l4(out, a.assign)
        else:
            think(out)
    except SystemExit:
        raise
    except Exception:
        atomic_json(out / "error.json", {"error": traceback.format_exc()[-4000:]})
        raise


