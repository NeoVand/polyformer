"""Write the Results section of STACK.md from results/. No model, no network.

    python3 research/stack/stack_report.py
"""

from __future__ import annotations

import json
import pathlib

from stack_validate import validate_results

ROOT = pathlib.Path(__file__).resolve().parent
RES = ROOT / "results"
MACHINES = ("dyck2", "dyck4", "bool")
LABEL = {"dyck2": "Dyck-2", "dyck4": "Dyck-4", "bool": "Boolean"}


def load(job, name):
    p = RES / job / name
    return json.loads(p.read_text()) if p.exists() else None


def pct(k, n):
    return f"{k}/{n}" if n else "–"


def fmt(x, nd=3):
    if x is None:
        return "–"
    if isinstance(x, float):
        return f"{x:.{nd}f}".rstrip("0").rstrip(".") if abs(x) < 1e6 else f"{x:.3g}"
    return str(x)


def counted_job(m):
    return f"stack-counted-{m}-h100"


def canonical_steps(m):
    """Every canonical step the counted job ran: cells, malformed, instances, and BBH for the evaluator."""
    job = counted_job(m)
    runs = []
    for fname, key in (("cells.json", "cells"), ("malformed.json", "malformed"), ("instances.json", "instances")):
        d = load(job, fname)
        if d:
            runs += d[key]
    tot = {"steps": 0, "cert": 0, "logit_bit": 0, "frame_bit": 0, "max_delta": 0.0, "max_frame_delta": 0.0,
           "min_margin": None, "depth": 0}
    for r in runs:
        tot["steps"] += r["n_steps"]
        tot["cert"] += r["n_cert_rows"]
        tot["logit_bit"] += r["n_logits_bitwise"]
        tot["frame_bit"] += r["n_frames_bitwise"]
        tot["max_delta"] = max(tot["max_delta"], r["max_abs_delta"])
        tot["max_frame_delta"] = max(tot["max_frame_delta"], r.get("max_frame_delta", 0.0))
        if r["min_margin"] is not None:
            tot["min_margin"] = r["min_margin"] if tot["min_margin"] is None else min(tot["min_margin"], r["min_margin"])
        tot["depth"] = max(tot["depth"], r["max_depth"])
    b = load(job, "bbh.json")
    if b:
        for r in b["rows"]:
            tot["steps"] += r["n_tokens"]
            tot["cert"] += r["cert_rows"]
            tot["logit_bit"] += r["logits_bitwise"]
            tot["frame_bit"] += r["frames_bitwise"]
    return tot


def ledger():
    p = RES / "modal_ledger.json"
    return json.loads(p.read_text()) if p.exists() else {"jobs": {}}


def main():
    audit = validate_results()
    if not all(j["complete"] for j in audit["jobs"].values()):
        raise RuntimeError("collect and validate all counted jobs before writing the final report")
    L = []
    add = L.append
    led = ledger()
    if any(j["status"] in ("reserved", "running") for j in led["jobs"].values()):
        raise RuntimeError("settle all jobs before writing the final report")
    if not load("stack-l4", "l4.json") or not load("stack-think-h100", "think.json"):
        raise RuntimeError("collect L4 and thinking comparisons before writing the final report")
    settled = sum(j.get("settled_usd", 0.0) for j in led["jobs"].values())
    certs = {m: (load(counted_job(m), "cert.json") or {}).get("cert") for m in MACHINES}

    add("## Results")
    add("")
    add("**Kill outcome: survives on the measured H100 execution path.** All 488 reachable rows certify with "
        "positive margins, and every counted canonical step reproduces its certified logits and frame KV "
        "bitwise. The Boolean zero-shot-failure prediction was wrong: no assignment search or LoRA was needed. "
        "This supports the narrowed C1 implementation claim; it does not establish a new verification theorem.")
    add("")
    add("Written by `stack_report.py` from `results/`. The host for counted runs is NVIDIA H100 80GB HBM3 unless "
        "a row says otherwise. Model: Qwen/Qwen3-4B with Savant r3 (`arith-s1r2/adapter_step500`) merged, bf16, "
        "SDPA. No LoRA was trained: every machine certified zero-shot at symbol assignment 0, so the fallback in "
        "`stack_lora.py` was never run.")
    add("")

    # ---------------- certificate
    add("### Certificate (kill test 2)")
    add("")
    add("| machine | Π tokens | rows | rows certified | min margin | min margin by kind | frame slot equal across rows sharing a top |")
    add("| --- | --- | --- | --- | --- | --- | --- |")
    for m in MACHINES:
        c = certs[m]
        if not c:
            add(f"| {LABEL[m]} | – | – | not run | – | – | – |")

