                got["cell"] = c["cell"]
                got["ref_value"] = M.value_of(spec["program"], M.run(spec["program"], made["tokens"])["q"])
                entry["cells"].append(got)
                print(f"l4 {name} {c['cell']} exact={got['exact']} ms={got['ms_per_step']:.2f}", flush=True)
        res["machines"][name] = entry
        atomic_json(out / "l4.json", res)
        del past, logits, frames
        fwd.torch_empty()


