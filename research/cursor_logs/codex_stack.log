def stable_rows(program, lo=6, hi=10):
    """The witnessed row set once raising the stack limit stops adding (q, top) pairs."""
    rows_lo, wit_lo = reachable(program, lo)
    rows_hi, wit_hi = reachable(program, hi)
    pairs_lo = {(q, top) for q, top, _ in wit_lo}
    pairs_hi = {(q, top) for q, top, _ in wit_hi}
    return {
        "rows": rows_hi,
        "witness": wit_hi,
        "pairs_lo": pairs_lo,
        "pairs_hi": pairs_hi,
        "stable": pairs_lo == pairs_hi,
        "lo": lo,
        "hi": hi,
    }


def row_records(program, found=None):
    """One record per witnessed row, with a class: halt, halt_entry, bottom, malformed, return, step."""
    found = found if found is not None else stable_rows(program)
    if not found["stable"]:
        raise RuntimeError(f"{program['name']} reachable pairs grew between stack limits")
    calls, returns = set(program["calls"]), set(program["returns"])
    halt = set(program["halt"])
    out = []
    for (q, top, a), (q2, op) in sorted(found["rows"].items()):
        if q in halt:
            kind = "halt"
        elif a == "END":
            kind = "halt_entry"
        elif a in returns and top == "BOT":
            kind = "bottom"
        elif q2 in ("E", "BAD", "HR") and not (q == "BAD" and a in returns and top != "BOT"):
            kind = "malformed"
        elif a in returns:
            kind = "return"
        elif a in calls:
            kind = "call"
        else:
            kind = "internal"
        out.append({
            "q": q, "top": top, "a": a, "q2": q2, "op": list(op), "kind": kind,
        })
    return out


def dyck_pairs_hand(k):
    """Independent description of the Dyck control pairs, for the stability check."""
    frames = [f"F{i}" for i in range(k)]
    pairs = {("OK", "BOT"), ("BAD", "BOT"), ("HA", "BOT"), ("HR", "BOT")}
    for f in frames:
        pairs.add(("OK", f))
        pairs.add(("BAD", f))
        pairs.add(("HR", f))
    return pairs


# ---------------------------------------------------------------- boolean source language


def emit(node):
    """Prefix tokens for a Python boolean AST. `and` / `or` chains are left-associative."""
    if isinstance(node, ast.Expression):
        return emit(node.body)
    if isinstance(node, ast.Constant) and node.value is True:
        return ["TT"]
    if isinstance(node, ast.Constant) and node.value is False:
        return ["FF"]
    if isinstance(node, ast.UnaryOp) and isinstance(node.op, ast.Not):
        return ["NOT", *emit(node.operand), "RP"]
    if isinstance(node, ast.BoolOp) and isinstance(node.op, (ast.And, ast.Or)):
        call = "AND" if isinstance(node.op, ast.And) else "OR"
        acc = emit(node.values[0])
        for value in node.values[1:]:
            acc = [call, *acc, *emit(value), "RP"]
        return acc
    raise ValueError(f"not a boolean expression node: {type(node).__name__}")


def ast_value(node):
    if isinstance(node, ast.Expression):
        return ast_value(node.body)
    if isinstance(node, ast.Constant) and isinstance(node.value, bool):
        return bool(node.value)
    if isinstance(node, ast.UnaryOp) and isinstance(node.op, ast.Not):
        return not ast_value(node.operand)
    if isinstance(node, ast.BoolOp) and isinstance(node.op, ast.And):
        return all(ast_value(v) for v in node.values)
    if isinstance(node, ast.BoolOp) and isinstance(node.op, ast.Or):
        return any(ast_value(v) for v in node.values)
    raise ValueError(f"not a boolean expression node: {type(node).__name__}")


def compile_expr(text):
    """Tokens for a Python boolean expression. Raises ValueError if it is not one."""
    tree = ast.parse(text.strip(), mode="eval")
    return emit(tree), ast_value(tree)


def compile_bbh(text):
    body = text.strip()
    if body.endswith(" is"):
        body = body[:-3].strip()
    return compile_expr(body)


def eval_tokens(tokens):
    """Value of a prefix token tree. Iterative, so a not-spine of depth 4096 does not recurse."""
    stack = []
    for t in tokens:
        if t == "TT":
            stack.append(True)
        elif t == "FF":
            stack.append(False)
        elif t in ("AND", "OR", "NOT"):
            stack.append(t)
        elif t == "RP":
            if len(stack) >= 2 and stack[-2] == "NOT" and isinstance(stack[-1], bool):
                bit = stack.pop()
                stack.pop()
                stack.append(not bit)
            elif (len(stack) >= 3 and stack[-3] in ("AND", "OR") and isinstance(stack[-1], bool)
                  and isinstance(stack[-2], bool)):
                right = stack.pop()
                left = stack.pop()
                op = stack.pop()
                stack.append((left and right) if op == "AND" else (left or right))
            else:
                raise ValueError("RP does not close an operator")
        else:
            raise ValueError(f"bad token {t}")
    if len(stack) != 1 or not isinstance(stack[0], bool):
        raise ValueError("token tree did not reduce to one boolean")
    return stack[0]


