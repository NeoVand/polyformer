"""Local checks for the carry monoid, both scans, and Light's test. No model and no GPU."""

from __future__ import annotations

import random
import unittest

import scan_algebra as S


class AlgebraTest(unittest.TestCase):
    def test_identity_and_rows(self):
        self.assertEqual(len(S.digit_rows()), 100)
        self.assertEqual(len(S.monoid_rows()), 9)
        self.assertEqual(len(S.adder_rows()), 200)
        for low in S.SYMBOLS:
            self.assertEqual(S.combine(low, S.P), low)
            self.assertEqual(S.combine(S.P, low), low)
        self.assertEqual(S.classify(4, 4), S.K)
        self.assertEqual(S.classify(4, 5), S.P)
        self.assertEqual(S.classify(5, 5), S.G)
        self.assertEqual(S.classify(9, 9), S.G)
        self.assertEqual(S.classify(0, 0), S.K)

    def test_true_monoid_is_associative(self):
        self.assertEqual(S.light_failures(S.combine), [])

    def test_scans_match_sequential_and_bigint(self):
        rng = random.Random(20261028)
        lengths = [1, 2, 3, 7, 8, 9, 16, 17, 31, 32, 64, 100, 4096]
        for n in lengths:
            for _ in range(4 if n < 4096 else 1):
                a, b = S.random_number(rng, n), S.random_number(rng, n)
                pairs = S.columns(a, b)
                blocks = [S.classify(x, y) for x, y in pairs]
