+def settlement_seconds(job, result, entry):
+    """Include interrupted attempts when the call history records a platform restart."""
+    wall = float(result.get("wall", job["max_seconds"]))
+    if entry.get("charge_full_call_elapsed"):
+        start = dt.datetime.fromisoformat(entry["launched_at"])
+        end = dt.datetime.fromisoformat(result.get("remote_completed_at") or stamp())
+        # This conservatively includes queuing and the gap between attempts. Do not cap an
+        # observed cost at the reservation: a restart resets the subprocess's timeout.
+        wall = max(wall, (end - start).total_seconds())
+    else:
+        wall = min(wall, job["max_seconds"] + WRAPPER_SECONDS)
+    return wall + STARTUP_SECONDS
+
+
