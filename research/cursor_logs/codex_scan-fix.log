"""
Modal launcher for the scan pilot. Own app `polyformer-scan`, own volume `polyformer-scan-results`.
The arith volume is mounted read-only at /arvol. Importing never launches work.

    uv run --no-project --with modal modal deploy research/scan/scan_modal.py
    uv run --no-project --with modal python research/scan/scan_modal.py plan --name <name> --jobs <jobs.json>
    uv run --no-project --with modal python research/scan/scan_modal.py spawn --manifest <m.json>
    uv run --no-project --with modal python research/scan/scan_modal.py collect --manifest <m.json>
    uv run --no-project --with modal python research/scan/scan_modal.py status

A job is {"id", "script", "argv", "gpu": "H100" | "L4" | "none", "max_seconds"}. The script runs with `--out /vol/<id>`.
The image matches closeout's packages and model snapshots so the heavy layers can be reused. The source hash is part
of the image, and the call also ships the sources: the job refuses to run if they disagree.
"""

from __future__ import annotations

import argparse
import contextlib
import datetime as dt
import fcntl
import fnmatch
import hashlib
import json
import os
import pathlib
import shutil
import signal
import subprocess
import sys
import time

ROOT = pathlib.Path(__file__).resolve().parent
PB_ROOT = ROOT.parent / "promptbox"
AR_ROOT = ROOT.parent / "arith"
SOURCE_DIRS = (ROOT, AR_ROOT, PB_ROOT)


def stamp():
    return dt.datetime.now(dt.timezone.utc).isoformat()


def sha256_bytes(data):
    return hashlib.sha256(data).hexdigest()


def atomic_json(path, value):
    path = pathlib.Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + f".{os.getpid()}.tmp")
    tmp.write_text(json.dumps(value, indent=1, sort_keys=True, default=str))
    os.replace(tmp, path)


MANIFESTS = ROOT / "manifests"
RESULTS = ROOT / "results"
LEDGER = RESULTS / "modal_ledger.json"
LOCK = RESULTS / "modal_ledger.lock"
CAP_USD = 15.0
APP_NAME, VOLUME_NAME = "polyformer-scan", "polyformer-scan-results"
AR_VOLUME_NAME = "polyformer-arith-results"
GPU_RATE = {"H100": 0.001097, "L4": 0.000222, "none": 0.0}
CPU_RATE, RAM_RATE, CPU_MAX, RAM_GIB_MAX = 0.0000131, 0.00000222, 16, 64
STARTUP_SECONDS, WRAPPER_SECONDS = 150, 30
MODELS = ("Qwen/Qwen3-1.7B", "Qwen/Qwen3-4B")
BBH_COMMIT = "9ee07bd481feebf959a6b59d61ea57bdcf30964d"
SOURCE_GLOB = "*.py"
FN = {"H100": "execute_gpu", "L4": "execute_l4", "none": "execute_cpu"}


def local_files():
    files = [(p.name, p) for d in SOURCE_DIRS for p in sorted(d.glob(SOURCE_GLOB))]
    if len({n for n, _ in files}) != len(files):
        raise ValueError("a file name occurs in more than one source directory")
    return files


def sources(commit=None):
    if commit is None:
        return {n: sha256_bytes(p.read_bytes()) for n, p in local_files()}
    out = {}
    for d in SOURCE_DIRS:
        names = subprocess.check_output(["git", "ls-tree", "-r", "--name-only", commit, "--", "."], cwd=d, text=True)
        for n in names.split():
            if fnmatch.fnmatch(n, SOURCE_GLOB) and "/" not in n:
                out[n] = sha256_bytes(subprocess.check_output(["git", "show", f"{commit}:./{n}"], cwd=d))
    return out


def rate(gpu):
    return GPU_RATE[gpu] + CPU_MAX * CPU_RATE + RAM_GIB_MAX * RAM_RATE


def reservation(job):
    return round(rate(job["gpu"]) * (job["max_seconds"] + WRAPPER_SECONDS + STARTUP_SECONDS), 6)


@contextlib.contextmanager
def locked_ledger():
    LOCK.parent.mkdir(parents=True, exist_ok=True)
    with LOCK.open("a+") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        ledger = json.loads(LEDGER.read_text()) if LEDGER.exists() else {
            "schema": 1, "app": APP_NAME, "volume": VOLUME_NAME, "cap_usd_total": CAP_USD, "cap_history": [
                {"at": stamp(), "cap_usd": CAP_USD,
                 "why": "SCAN brief: cap $15 (Neo, 28 Oct), recorded before any spend"}],
            "jobs": {},
            "cost_basis": "upper-rate estimate (GPU + 16 CPU + 64 GiB) from max_seconds at reservation, "
                          "actual wall at settlement; not an invoice"}
        yield ledger
        atomic_json(LEDGER, ledger)
        fcntl.flock(lock, fcntl.LOCK_UN)


def used(ledger):
    return sum(e.get("settled_usd", e["reserved_usd"]) for e in ledger["jobs"].values())


def normalize(raw, hashes):
    job = {"id": str(raw["id"]), "script": str(raw["script"]), "argv": [str(a) for a in raw.get("argv", [])],
           "gpu": str(raw.get("gpu", "H100")), "max_seconds": int(raw["max_seconds"])}
    if job["gpu"] not in GPU_RATE or not (60 <= job["max_seconds"] <= 86000) or job["script"] not in hashes:
        raise ValueError(f"bad job {job}")
    job["reserved_usd"] = reservation(job)
    return job


def plan(name, jobs_path, at_commit=None):
    hashes = sources(at_commit)
    jobs = [normalize(j, hashes) for j in json.loads(pathlib.Path(jobs_path).read_text())]
    if len({j["id"] for j in jobs}) != len(jobs):
        raise ValueError("duplicate job ids")
    commit = subprocess.check_output(["git", "rev-parse", at_commit or "HEAD"], cwd=ROOT, text=True).strip()
    dirty = subprocess.check_output(["git", "status", "--porcelain", "--", ".", "../promptbox", "../arith"], cwd=ROOT,
                                    text=True).strip()
    dirty = [] if at_commit else [line for line in dirty.splitlines() if line.endswith(".py") or "/data/" in line]
    manifest = {"name": name, "app": APP_NAME, "created_at": stamp(), "commit": commit,
                "uncommitted_sources": bool(dirty), "source_hashes": hashes, "jobs": jobs,
                "reserved_usd": round(sum(j["reserved_usd"] for j in jobs), 4)}
    if at_commit:
        manifest["source_commit"] = commit
    MANIFESTS.mkdir(exist_ok=True)
    path = MANIFESTS / f"{name}.json"
    if path.exists():
        raise ValueError(f"manifest already exists: {path}")
    path.write_text(json.dumps(manifest, indent=1))
    print(json.dumps({"manifest": str(path), "jobs": len(jobs), "commit": commit, "uncommitted_sources": bool(dirty),
                      "reserved_usd": manifest["reserved_usd"]}, indent=1))
    return path


def reserve(job):
    with locked_ledger() as ledger:
        if job["id"] in ledger["jobs"]:
            return ledger["jobs"][job["id"]], False
        cap = ledger.get("cap_usd_total", CAP_USD)
        if used(ledger) + job["reserved_usd"] > cap:
            raise RuntimeError(f"cap: {used(ledger):.3f} USD reserved or settled; {job['id']} needs "
                               f"{job['reserved_usd']:.3f}; cap {cap}")
        entry = {"job_id": job["id"], "script": job["script"], "argv": job["argv"], "gpu": job["gpu"],
                 "reserved_usd": job["reserved_usd"], "max_seconds": job["max_seconds"], "status": "reserved",
                 "reserved_at": stamp()}
        ledger["jobs"][job["id"]] = entry
        return entry, True


def record_call(job_id, call_id):
    with locked_ledger() as ledger:
        ledger["jobs"][job_id].update({"call_id": call_id, "status": "running", "launched_at": stamp()})


def settle(job, result):
    wall = float(result.get("wall", job["max_seconds"]))
    amount = round(rate(job["gpu"]) * (min(wall, job["max_seconds"] + WRAPPER_SECONDS) + STARTUP_SECONDS), 6)
    out = RESULTS / job["id"]
    out.mkdir(parents=True, exist_ok=True)
    written = []
    for name, text in result.get("files", {}).items():
        target = out / name
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(text)
        written.append(name)
    with locked_ledger() as ledger:
        e = ledger["jobs"][job["id"]]
        e.update({"status": "error" if result.get("error") else "complete", "settled_usd": amount, "wall": wall,
                  "settled_at": stamp(), "files": written, "gpu_actual": result.get("gpu_actual"),
                  "cpu_actual": result.get("cpu_actual")})
        if result.get("error"):
            e["error"] = str(result["error"])[-2000:]
    return amount, written


def worker(job, expected_sources, vol_commit, shipped=None):
    started = time.monotonic()
    remote_root = pathlib.Path("/root/pb")
    if shipped:
        for name, text in shipped.items():
            (remote_root / name).write_text(text)
    actual = {str(p.relative_to(remote_root)): sha256_bytes(p.read_bytes())
              for p in sorted(remote_root.glob(SOURCE_GLOB))}
    if actual != expected_sources:
        diff = {"missing": sorted(set(expected_sources) - set(actual)),
                "extra": sorted(set(actual) - set(expected_sources)),
                "differ": sorted(k for k in set(actual) & set(expected_sources) if actual[k] != expected_sources[k])}
        return {"error": f"remote source hash mismatch: {json.dumps(diff)}", "wall": round(time.monotonic() - started, 3)}
    out_dir = pathlib.Path("/vol") / job["id"]
    out_dir.mkdir(parents=True, exist_ok=True)
    log_path = out_dir / "job.log"
    command = [sys.executable, "-u", str(remote_root / job["script"]), *job["argv"], "--out", str(out_dir)]
    env = os.environ.copy()
    env.update({"PB_JOB_ID": job["id"], "TOKENIZERS_PARALLELISM": "false", "HF_HUB_OFFLINE": "1"})
    timed_out, last_commit = False, time.monotonic()
    with log_path.open("w") as fout:
        process = subprocess.Popen(command, cwd=remote_root, stdout=fout, stderr=subprocess.STDOUT, text=True,
                                   start_new_session=True, env=env)
        deadline, offset = time.monotonic() + job["max_seconds"], 0
        while process.poll() is None:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                timed_out = True
                os.killpg(process.pid, signal.SIGKILL)
                process.wait()
                break
            try:
                process.wait(timeout=min(20, remaining))
            except subprocess.TimeoutExpired:
                pass
            with log_path.open() as f:
                f.seek(offset)
                new = f.read()
                offset = f.tell()
            if new.strip():
                print(f"[{job['id']}] {new.strip()[-3000:]}", flush=True)
            if time.monotonic() - last_commit > 600:
                with contextlib.suppress(Exception):
                    vol_commit()
                last_commit = time.monotonic()
    text = log_path.read_text()
    result = {"wall": round(time.monotonic() - started, 3), "log_tail": text[-12000:],
              "python_version": sys.version.split()[0], "remote_completed_at": stamp()}
    if timed_out:
        result["error"] = f"subprocess exceeded {job['max_seconds']} seconds"
    elif process.returncode != 0:
        result["error"] = f"subprocess exit {process.returncode}: {text[-4000:]}"
    files = {}
    for p in sorted(out_dir.rglob("*.json")):
        if p.stat().st_size < 2_000_000:
            files[str(p.relative_to(out_dir))] = p.read_text()
    files["job.log.json"] = json.dumps({"job_id": job["id"], "log": text[-300000:]})
    result["files"] = files
    try:
        result["gpu_actual"] = subprocess.check_output(
            ["nvidia-smi", "--query-gpu=name", "--format=csv,noheader"], text=True, timeout=5).strip()
    except Exception:
        result["gpu_actual"] = "none"
    try:
        info = pathlib.Path("/proc/cpuinfo").read_text()
        cpu = [line.split(":", 1)[1].strip() for line in info.splitlines()
               if line.lower().startswith(("model name", "vendor_id", "cpu family", "model\t"))]
        flags = next((line.split(":", 1)[1].split() for line in info.splitlines() if line.startswith("flags")), [])
        result["cpu_actual"] = " | ".join(cpu[:4]) + f" | avx512f={'avx512f' in flags}"
    except Exception:
        result["cpu_actual"] = "unknown"
    (out_dir / "_result.json").write_text(json.dumps(
        {k: v for k, v in result.items() if k != "files"} | {"file_names": list(files)}))
    return result


try:
    import modal
except ImportError:
    modal = None

if modal is not None:
    app = modal.App(APP_NAME)
    results_vol = modal.Volume.from_name(VOLUME_NAME, create_if_missing=True)
    ar_vol = modal.Volume.from_name(AR_VOLUME_NAME).read_only()
    _download = "; ".join(f"snapshot_download('{m}')" for m in MODELS)
    _datasets = ("from datasets import load_dataset; load_dataset('tatsu-lab/alpaca'); "
                 "load_dataset('databricks/databricks-dolly-15k'); "
                 "load_dataset('Salesforce/wikitext', 'wikitext-2-raw-v1'); "
                 "load_dataset('openai/openai_humaneval'); load_dataset('cais/mmlu', 'all'); "
                 "load_dataset('openai/gsm8k', 'main')")
    image = (modal.Image.debian_slim(python_version="3.12")
             .apt_install("git")
             .pip_install("vllm==0.32.0", "transformers==5.19.0", "peft==0.21.2", "accelerate==1.15.0",
                          "datasets==5.1.0", "numpy", "safetensors", "huggingface_hub")
             .run_commands(f"python -c \"from huggingface_hub import snapshot_download; {_download}\"")
             .run_commands(f"python -c \"{_datasets}\"")
             .run_commands(f"git clone -q https://github.com/suzgunmirac/BIG-Bench-Hard /opt/bbh && "
                           f"git -C /opt/bbh checkout -q {BBH_COMMIT}")
             .run_commands("python -c \"from datasets import load_dataset; "
                           "load_dataset('allenai/ai2_arc', 'ARC-Easy'); load_dataset('allenai/ai2_arc', 'ARC-Challenge')\"")
             .env({"HF_DATASETS_OFFLINE": "1", "VLLM_USE_FLASHINFER_SAMPLER": "0"}))
    image = image.env({"SCAN_SOURCES_SHA256": sha256_bytes(json.dumps(sources(), sort_keys=True).encode())})
    for _name, _path in local_files():
        image = image.add_local_file(_path, f"/root/pb/{_name}")

    def _run(job, expected_sources, shipped=None):
        for stale in pathlib.Path("/tmp").glob("pb_*merged*"):
            shutil.rmtree(stale, ignore_errors=True)
        results_vol.reload()
        result = worker(job, expected_sources, results_vol.commit, shipped)
        with contextlib.suppress(Exception):
            results_vol.commit()
        return result

    @app.function(image=image, gpu="H100", cpu=(8.0, CPU_MAX), memory=(32768, RAM_GIB_MAX * 1024), timeout=86400,
                  startup_timeout=STARTUP_SECONDS + 600, retries=0, volumes={"/vol": results_vol, "/arvol": ar_vol})
    def execute_gpu(job, expected_sources, shipped=None):
        return _run(job, expected_sources, shipped)

    @app.function(image=image, gpu="L4", cpu=(4.0, CPU_MAX), memory=(16384, RAM_GIB_MAX * 1024), timeout=86400,
                  startup_timeout=STARTUP_SECONDS + 600, retries=0, volumes={"/vol": results_vol, "/arvol": ar_vol})
    def execute_l4(job, expected_sources, shipped=None):
        return _run(job, expected_sources, shipped)

    @app.function(image=image, cpu=(4.0, CPU_MAX), memory=(8192, RAM_GIB_MAX * 1024), timeout=86400,
                  startup_timeout=STARTUP_SECONDS + 600, retries=0, volumes={"/vol": results_vol, "/arvol": ar_vol})
    def execute_cpu(job, expected_sources, shipped=None):
        return _run(job, expected_sources, shipped)


def spawn_deployed(manifest):
    spec = json.loads(pathlib.Path(manifest).read_text())
    if spec.get("uncommitted_sources"):
        raise RuntimeError("refusing to spawn: sources were dirty when the manifest was planned")
    if sources(spec.get("source_commit")) != spec["source_hashes"]:
        raise ValueError("sources changed since planning; plan a new manifest (and redeploy)")
    for job in spec["jobs"]:
        fn = modal.Function.from_name(APP_NAME, FN[job["gpu"]])
        entry, created = reserve(job)
        if not created or entry.get("call_id"):
            print(json.dumps({"job_id": job["id"], "status": "already_" + entry["status"]}))
            continue
        shipped = {n: p.read_text() for n, p in local_files()}
        if {n: sha256_bytes(t.encode()) for n, t in shipped.items()} != spec["source_hashes"]:
            raise ValueError("working-tree sources differ from the manifest")
        call = fn.spawn(job, spec["source_hashes"], shipped)
        record_call(job["id"], call.object_id)
        print(json.dumps({"job_id": job["id"], "status": "spawned", "call_id": call.object_id}), flush=True)


def collect(manifest):
    spec = json.loads(pathlib.Path(manifest).read_text())
    with locked_ledger() as ledger:
        known = dict(ledger["jobs"])
    vol = modal.Volume.from_name(VOLUME_NAME)
    for job in spec["jobs"]:
        e = known.get(job["id"], {})
        if e.get("status") != "running" or not e.get("call_id"):
            print(json.dumps({"job_id": job["id"], "status": e.get("status", "not launched")}))
            continue
        try:
            result = modal.FunctionCall.from_id(e["call_id"]).get(timeout=0)
        except TimeoutError:
            print(json.dumps({"job_id": job["id"], "status": "still running"}))
            continue
        except Exception as exc:
            try:
                meta = json.loads(b"".join(vol.read_file(f"{job['id']}/_result.json")))
                files = {}
                for n in meta.get("file_names", []):
                    if n == "job.log.json":
                        files[n] = json.dumps({"log": b"".join(vol.read_file(f"{job['id']}/job.log")).decode()[-300000:]})
                    else:
                        files[n] = b"".join(vol.read_file(f"{job['id']}/{n}")).decode()
                result = dict(meta, files=files)
            except Exception:
                print(json.dumps({"job_id": job["id"], "status": "unresolved",
                                  "error": f"{type(exc).__name__}: {str(exc)[:300]}"}))
                continue
        amount, written = settle(job, result)
        print(json.dumps({"job_id": job["id"], "status": "error" if result.get("error") else "complete", "usd": amount,
                          "files": len(written), "gpu": result.get("gpu_actual"), "cpu": result.get("cpu_actual"),
                          "error": (str(result.get("error"))[-800:] if result.get("error") else None)}), flush=True)


def status():
    with locked_ledger() as ledger:
        counts, open_jobs = {}, []
        for e in ledger["jobs"].values():
            counts[e["status"]] = counts.get(e["status"], 0) + 1
            if e["status"] in ("reserved", "running"):
                open_jobs.append(e["job_id"])
        settled = sum(e.get("settled_usd", 0.0) for e in ledger["jobs"].values())
        print(json.dumps({"app": APP_NAME, "settled_usd": round(settled, 4),
                          "reserved_or_settled_usd": round(used(ledger), 4),
                          "cap_usd": ledger.get("cap_usd_total", CAP_USD), "jobs": counts, "open": open_jobs}, indent=1))


def set_cap(new_cap, why):
    with locked_ledger() as ledger:
        old = float(ledger.get("cap_usd_total", CAP_USD))
        new_cap = float(new_cap)
        spent = used(ledger)
        if new_cap + 1e-9 < spent:
            raise RuntimeError(f"cap {new_cap} is below reserved or settled {spent}")
        ledger["cap_usd_total"] = new_cap
        ledger.setdefault("cap_history", []).append(
            {"at": stamp(), "cap_usd": new_cap, "previous": old, "why": why})
    print(json.dumps({"previous": old, "cap_usd": new_cap, "reserved_or_settled_usd": spent}))


def abandon(job_id, seconds, why):
    with locked_ledger() as ledger:
        e = ledger["jobs"][job_id]
        e.update({"status": "abandoned", "settled_usd": round(rate(e["gpu"]) * float(seconds), 6), "wall": float(seconds),
                  "settled_at": stamp(), "error": why})
    print(json.dumps({"job_id": job_id, "settled_usd": round(rate(e["gpu"]) * float(seconds), 6)}))


def main():
    ap = argparse.ArgumentParser()
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("plan")
    p.add_argument("--name", required=True)
    p.add_argument("--jobs", required=True)
    p.add_argument("--at_commit", default=None)
    sub.add_parser("status")
    sp = sub.add_parser("spawn")
    sp.add_argument("--manifest", required=True)
    co = sub.add_parser("collect")
    co.add_argument("--manifest", required=True)
    ab = sub.add_parser("abandon")
    ab.add_argument("--job", required=True)
    ab.add_argument("--seconds", type=float, required=True)
    ab.add_argument("--why", required=True)
    cap = sub.add_parser("set-cap")
    cap.add_argument("--usd", type=float, required=True)
    cap.add_argument("--why", required=True)
    a = ap.parse_args()
    if a.cmd == "abandon":
        abandon(a.job, a.seconds, a.why)
    elif a.cmd == "set-cap":
        set_cap(a.usd, a.why)
    elif a.cmd == "plan":
        plan(a.name, a.jobs, a.at_commit)
    elif a.cmd == "spawn":
        spawn_deployed(a.manifest)
    elif a.cmd == "collect":
        collect(a.manifest)
    else:
        status()


if __name__ == "__main__":
    main()

