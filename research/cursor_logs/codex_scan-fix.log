PROTOCOL_ID = "audit-retime-1"


def audit_rerun(out, model, tables, host, arch, symbols):
    """Per-row certificate on the deployed mixtures, then one retimed addition at each length.

    The timing protocol is audit-retime-1, registered in SCAN.md before this job is launched.
    """
    timing = dict(getattr(model, "scan_timing", {}))
    plans = {}
    extra = {"D": [], "M": [], "S": []}
    mixtures = {"D": [], "M": [], "S": []}
    seen = {name: set() for name in extra}
    for n in (4096, 100000):
        a, b = alg.draw_instances(SEED, n, 1)[0]
        plan = alg.deployed_lookup_plan(a, b, fwd.chunk_for(2), fwd.chunk_for(2), fwd.chunk_for(4))
        plans[str(n)] = {name: {"n_forwards": plan[name]["n_forwards"], "n_slots": plan[name]["n_slots"],
                                "widths": plan[name]["widths"]} for name in plan}
        for name in extra:
            for width in plan[name]["widths"]:
                if width not in seen[name]:
                    seen[name].add(width)
                    extra[name].append(width)
            mixtures[name].extend(plan[name]["chunks"])
        print(f"plan {n} " + " ".join(f"{name}={plan[name]['n_forwards']}" for name in plan), flush=True)
    base = with_pi(common("audit", host, arch, symbols), tables)
    base["protocol"] = PROTOCOL_ID
    base["merge_seconds"] = timing.get("merge_seconds")
    base["load_seconds"] = timing.get("load_seconds")
    base["deployed_plan"] = plans
    cert = fwd.measure_invariance(model, tables, widths=(1, 8, 32), row_limit=None, include_chunk=True,
                                  extra_widths=extra, mixtures=mixtures)
    cert_rec = dict(base)
    cert_rec["invariance"] = cert
    atomic_json(out / "cert.json", cert_rec)
    print(f"cert decision={cert['decision']} ok={cert['decision_ok']} "
          f"per_row_match={cert.get('per_row_matches_aggregate')} "
          f"max_abs_delta={cert['max_abs_delta']} min_margin={cert['min_margin']}", flush=True)
    floor = margin_floor_of(cert)
    for n, filename in ((4096, "retime_4096.json"), (100000, "retime_100000.json")):
        a, b = alg.draw_instances(SEED, n, 1)[0]
        warmup = fwd.warmup_packed_chunk(model, tables["M"])
        got = addition_record(model, tables, a, b, floor)
        got.update({"seed": SEED, "host": host, "arch": arch, "i": 0, "n_instances": 1,
                    "margin_floor": floor, "protocol": PROTOCOL_ID, "warmup_seconds": warmup,
                    "merge_seconds": timing.get("merge_seconds"), "load_seconds": timing.get("load_seconds")})
        atomic_json(out / filename, got)
        print(f"retime {n} exact={got['hs_exact'] and got['bl_exact']} "
              f"e2e={got['e2e_seconds']:.2f} hs_model={got['hs_model_seconds']:.2f} "
              f"warmup={warmup:.2f}", flush=True)
        fwd.torch_empty()
    if b1_bad(cert):
        sys.exit(2)
    if not cert["decision_ok"]:
        sys.exit(3)


def million(out, model, tables, host, arch, symbols):
    cert = fwd.measure_invariance(model, tables, widths=(1,), row_limit=1, include_chunk=False)
    if b1_bad(cert):
        atomic_json(out / "meta.json", {"seed": SEED, "host": host, "b1_ok": False})
def decide_certificate(report):
    """Both branches require a positive margin and zero target mismatches.

    Bitwise equality of the logit vectors does not by itself make the row correct: the shared vector
    can be a tie, or the wrong token. A margin certificate still also needs min margin > 2 * max |Δ|.
    """
    report["bitwise"] = (
        report["n_compared"] > 0
        and report["n_equal"] == report["n_compared"]
        and report["max_abs_delta"] == 0.0
    )
    bound = 2.0 * report["max_abs_delta"]
    report["margin_bound"] = bound
    report["margin_ok"] = report["min_margin"] is not None and report["min_margin"] > bound
    row_ok = (
        report["n_compared"] > 0
        and report["n_argmax_mismatch"] == 0
        and report["min_margin"] is not None
        and report["min_margin"] > 0
    )
    if report["bitwise"]:
        report["decision"] = "bitwise"
        report["empirical_bound"] = False
        report["decision_ok"] = row_ok
    else:
        report["decision"] = "margin"
        report["empirical_bound"] = True
        report["decision_ok"] = bool(report["margin_ok"]) and row_ok
    if report.get("per_row_matches_aggregate") is False:
        report["decision_ok"] = False
    return report


def _top(logit):
    import torch
    vals, idx = torch.topk(logit.float(), 2)
    return int(idx[0]), float(vals[0] - vals[1])


def _absorb_ends(report, per_row, ends, refs, indices, targets):
    """Each slot against the single-tick reference of its row. bf16->float32 is exact, so a 0 delta is bitwise."""
    import torch
    fails = 0
    for s in range(0, ends.shape[0], 128):
        part = ends[s:s + 128].float()
        vals, idx = torch.topk(part, 2, dim=-1)
        rows_here = indices[s:s + part.shape[0]]
        ref = torch.stack([refs[i] for i in rows_here]).float()
        delta = (part - ref).abs().amax(dim=-1)
        for j in range(part.shape[0]):
            i = rows_here[j]
            arg = int(idx[j, 0])
            margin = float(vals[j, 0] - vals[j, 1])
            d = float(delta[j])
            ok_arg = arg == targets[i]
            ok = ok_arg and margin > 0
            _absorb(report, d == 0.0, d, margin, ok_arg)
            _note_row(per_row[i], d, margin, ok_arg)
            fails += int(not ok)
        del part, ref
    return fails


def measure_invariance(model, tables, widths=None, row_limit=None, include_chunk=True,
                       extra_widths=None, mixtures=None):
    """Largest |Δlogit| across slot, width, mixture, and packed-versus-batched, against the pinned single tick.

    Certifies every touched slot: argmax equals the row and the margin is positive. `row_limit` keeps a smoke
    run small; None means every row. `extra_widths` adds partial chunk lengths. `mixtures` is a map from table
    name to lists of row indices, the packed forwards an addition actually runs. Per-row max |Δ| is saved so
    the aggregate extrema are the max and min of those rows.
    """
    report = {"tables": {}, "n_compared": 0, "n_equal": 0, "max_abs_delta": 0.0, "min_margin": None,
              "n_argmax_mismatch": 0, "widths": None}
    extra_widths = extra_widths or {}
    mixtures = mixtures or {}
    for name in ("D", "M", "S"):
        table = tables[name]
        past = prefill(model, table["pi"])
        P = len(table["pi"])
        queries = table["queries"]
        bl = table["block_len"]
        chunk = chunk_for(bl)
        use = queries if row_limit is None else queries[:row_limit]
        targets = [q_row[bl] for q_row in (table["rows"] if row_limit is None else table["rows"][:row_limit])]
        # targets: D/M row[2] and the query is row[:2], so row[bl] is the output. S row[4] with bl=4.
        refs = [single_lookup(model, past, P, q) for q in use]
        per_row = _fresh_rows(len(use))
        widths_here = list(widths or (1, 8, 32))
        if include_chunk and chunk not in widths_here:
            widths_here.append(chunk)
        added = []
        for w in extra_widths.get(name, ()):
            if w not in widths_here and w > 0:
                widths_here.append(w)
                added.append(w)
        table_rec = {"rows": len(use), "P": P, "chunk": chunk, "widths": widths_here,
                     "partial_widths": added, "b1_argmax_bad": 0, "cert_fail": 0,
                     "n_mixture_forwards": 0, "n_mixture_slots": 0}
        print(f"cert {name} widths={widths_here} mixtures={len(mixtures.get(name, ()))}", flush=True)
        for b in widths_here:
            # every slot of an all-equal forward, for every row, then one cyclic mixture
            for i, q in enumerate(use):
                ends, _ = packed_end_logits(model, past, P, [q] * b)
                fails = _absorb_ends(report, per_row, ends, refs, [i] * b, targets)
                table_rec["cert_fail"] += fails
                if b == 1:
                    table_rec["b1_argmax_bad"] += fails
                del ends
            mixed = [i % len(use) for i in range(b)]
            ends, _ = packed_end_logits(model, past, P, [use[i] for i in mixed])
            table_rec["cert_fail"] += _absorb_ends(report, per_row, ends, refs, mixed, targets)
            del ends
        # batched reference, Π repeated, small width so the repeated prefix stays cheap
        batch_w = min(4, len(use))
        for start in range(0, len(use), batch_w):
            group = use[start:start + batch_w]
            import torch
            device = _device(model)
            rows = [table["pi"] + list(q) for q in group]
            pos = [list(range(P + bl)) for _ in group]
            with torch.inference_mode():
                out = model(input_ids=torch.tensor(rows, device=device),
                            position_ids=torch.tensor(pos, device=device), use_cache=False)
            for j in range(len(group)):
                arg, margin = _top(out.logits[j, -1])
                equal, delta = _logit_delta(out.logits[j, -1], refs[start + j])
                ok_arg = arg == targets[start + j]
                _absorb(report, equal, delta, margin, ok_arg)
                _note_row(per_row[start + j], delta, margin, ok_arg)
                table_rec["cert_fail"] += int(not (ok_arg and margin > 0))
            del out
        mix_widths = set()
        for n_fwd, chunk_rows in enumerate(mixtures.get(name, ())):
            if any(i < 0 or i >= len(use) for i in chunk_rows):
                raise RuntimeError(f"{name} mixture row outside the certified table")
    return value, time.perf_counter() - t0


def warmup_packed_chunk(model, table):
    """One discarded full-chunk packed forward, including its prefill. Not part of a timed addition."""
    _sync()
    t0 = time.perf_counter()
    past = prefill(model, table["pi"])
    blocks = [table["queries"][0]] * chunk_for(table["block_len"])
    packed_lookup(model, past, len(table["pi"]), blocks)
    del past
    _sync()
    return time.perf_counter() - t0


def run_addition(model, tables, a, b, margin_floor=None, m_table=None):
    """One addition. D once, then Hillis–Steele and Blelloch, then S for each schedule's carries.

    `m_table` replaces M (a corrupted prefix). Lookups are scored against that table, so a corrupted row
    matches when the model copies the corrupted prefix.

    `stats[*].seconds` is the sum of model() calls only. `phase_seconds` is the synchronized wall of each
    component, including prefill, mask construction, cache cloning, and argmax extraction. `e2e_seconds`
    is one synchronized interval covering D, both scans, and both S rounds. `margin_holds` is null when
    no bound was supplied.
    """
    sym = tables["symbols"]
    dig = sym["digit_ids"]
    id_to_digit = {i: d for d, i in enumerate(dig)}
    g_id = sym["id"]["G"]
    pairs = alg.columns(a, b)
    n = len(pairs)
    stats = {"D": new_stats(), "HS": new_stats(), "BL": new_stats(), "S_HS": new_stats(), "S_BL": new_stats()}
    phases = {}

    def d_phase():
        d_table = tables["D"]
        past_d = prefill(model, d_table["pi"])
        d_blocks = [[dig[x], dig[y]] for x, y in pairs]
        d_targets = [d_table["expect"].get(tuple(b)) for b in d_blocks]
        got = lookup_blocks(model, past_d, len(d_table["pi"]), d_blocks, d_targets, stats["D"], chunk_for(2))
        del past_d
        return got

    def one_scan(kind, rounds, values):
        m = tables["M"] if m_table is None else m_table
        past = prefill(model, m["pi"])
        padded_n = len(values)
        original = list(values)
        got = run_schedule(model, past, values, rounds, original, sym["id"]["P"], m["expect"], stats[kind], chunk_for(2))
        del past
        return got[:n] if padded_n != n else got

    _sync()
    t_e2e = time.perf_counter()
    d_ids, phases["D"] = _timed(d_phase)
    hs_rounds = alg.hillis_schedule(n)
    hs_ids, phases["HS"] = _timed(lambda: one_scan("HS", hs_rounds, list(d_ids)))
    pad, bl_rounds = alg.blelloch_schedule(n)
    bl_values = list(d_ids) + [sym["id"]["P"]] * (pad - n)
    bl_ids, phases["BL"] = _timed(lambda: one_scan("BL", bl_rounds, bl_values))

    def s_round(prefix_ids, label):
        # The carry into column 0 is 0. The carry into a later column is the scan prefix's carry.
        # The cout token in the S query is the adder row's own cout for that (cin, a, b), so the query
        # addresses a real row. On a correct monoid this cout equals the prefix's carry.
        cin_bits = []
        cin = 0
        scan_cout = []
        for p in prefix_ids:
            cin_bits.append(cin)
            bit = 1 if p == g_id else 0
            scan_cout.append(bit)
            cin = bit
        final = cin
        s = tables["S"]
        past = prefill(model, s["pi"])
        blocks = []
        targets = []
        adder_cout = []
        for i, (x, y) in enumerate(pairs):
            cout = 1 if cin_bits[i] + x + y >= 10 else 0
            adder_cout.append(cout)
            block = [dig[cin_bits[i]], dig[x], dig[y], dig[cout]]
            blocks.append(block)
            targets.append(s["expect"].get(tuple(block)))
        outs = lookup_blocks(model, past, len(s["pi"]), blocks, targets, stats[label], chunk_for(4))
        del past
        text = sum_from_digit_ids(outs, final, id_to_digit)
        return text, final, scan_cout == adder_cout

    (hs_sum, hs_final, hs_carry_ok), phases["S_HS"] = _timed(lambda: s_round(hs_ids, "S_HS"))
    (bl_sum, bl_final, bl_carry_ok), phases["S_BL"] = _timed(lambda: s_round(bl_ids, "S_BL"))
    _sync()
    e2e_seconds = time.perf_counter() - t_e2e
    truth = alg.bigint_sum(a, b)
    margin_holds = None
    if margin_floor is not None:
        margin_holds = True
        for st in stats.values():
            if st["n"] and (st["min_margin"] is None or st["min_margin"] <= margin_floor):
                margin_holds = False
    return {
        "n_digits": n,
        "hs_sum": hs_sum,
        "bl_sum": bl_sum,
        "bigint": truth,
        "hs_exact": hs_sum == truth,
        "bl_exact": bl_sum == truth,
        "hs_carry_matches_adder": hs_carry_ok,
        "bl_carry_matches_adder": bl_carry_ok,
        "schedules_agree": hs_sum == bl_sum and hs_ids == bl_ids,
        "prefixes_agree": hs_ids == bl_ids,
        "hs_rounds": len(alg.model_rounds(hs_rounds)) + 2,
        "bl_rounds": len(alg.model_rounds(bl_rounds)) + 2,
        "stats": stats,
        "margin_holds": margin_holds,
        "model_seconds": sum(st["seconds"] for st in stats.values()),
        "phase_seconds": phases,
        "e2e_seconds": e2e_seconds,
    }


def light_on_model(model, corrupted, sym_ids):
    """27 triples as model lookups against one corrupted M. Two waves: the inner products, then the outer ones."""
    past = prefill(model, corrupted["pi"])
    P = len(corrupted["pi"])
    names = ("K", "P", "G")
    triples = [(x, y, z) for x in names for y in names for z in names]
    id_of = sym_ids
    wave1 = []
    for x, y, z in triples:
        wave1.append([id_of[x], id_of[y]])
        wave1.append([id_of[y], id_of[z]])
    got1, pieces1 = chunked_packed(model, past, P, wave1, chunk_for(2))
    wave2 = []
    for t, (x, y, z) in enumerate(triples):
        wave2.append([got1[2 * t][0], id_of[z]])
        wave2.append([id_of[x], got1[2 * t + 1][0]])
    got2, pieces2 = chunked_packed(model, past, P, wave2, chunk_for(2))
    fails = []
    n_match = 0
    n = 0
    min_margin = None
    for t, (x, y, z) in enumerate(triples):
        left_id = got2[2 * t][0]
        right_id = got2[2 * t + 1][0]
        quads = (
            (got1[2 * t], (id_of[x], id_of[y])),
            (got1[2 * t + 1], (id_of[y], id_of[z])),
            (got2[2 * t], (got1[2 * t][0], id_of[z])),
            (got2[2 * t + 1], (id_of[x], got1[2 * t + 1][0])),
        )
        for (arg, margin), (low, high) in quads:
            n += 1
            min_margin = margin if min_margin is None else min(min_margin, margin)
            target = corrupted["expect"].get((low, high))
            n_match += int(target is not None and arg == target and margin > 0)
        if left_id != right_id:
            fails.append(x + y + z)
    del past

