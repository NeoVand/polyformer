def load_merged(model_name=MODEL_NAME, adapter=ADAPTER):
    """Merge the adapter into a new directory and load it. A warm container must not reuse a previous merge.

    `scan_timing["merge_seconds"]` is only the merge. `load_seconds` is the weight load onto the GPU,
    closed by a synchronize. Neither clock is part of an addition.
    """
    import torch
    from pb_eval import merge_adapter
    from transformers import AutoModelForCausalLM
    if os.path.exists(MERGE_DIR):
        shutil.rmtree(MERGE_DIR)
    t0 = time.perf_counter()
    merge_adapter(model_name, adapter, MERGE_DIR)
    merge_seconds = time.perf_counter() - t0
    t1 = time.perf_counter()
    model = AutoModelForCausalLM.from_pretrained(
        MERGE_DIR, dtype=torch.bfloat16, attn_implementation="sdpa").cuda().eval()
    torch.cuda.synchronize()
    model.scan_timing = {"merge_seconds": merge_seconds, "load_seconds": time.perf_counter() - t1}
    return model


def _device(model):
    return next(model.parameters()).device


def _sync():
    import torch
    torch.cuda.synchronize()


