        f"(min {num(min(hs_times)) if hs_times else None}, max {num(max(hs_times)) if hs_times else None}). "
        "Reason: no result file records a 2.2 s Blelloch time. "
        "End-to-end component times, when the rerun section has them, are that protocol's measurements and are unaudited.",
        "",
    ]
    return "\n".join(lines)


def audit_rerun_section(files, ledger_jobs):
    certs = [(name, rec) for name, rec in find_records(files, "cert.json") if rec.get("protocol") == "audit-retime-1"]
    retimes = [(name, rec) for name, rec in files.items()
               if pathlib.PurePosixPath(name).name.startswith("retime_")]
    if not certs and not retimes:
        return "\n".join([
            "## Audit rerun",
            "",
            "Not collected. The timing protocol above is what the job follows. Its numbers will be unaudited.",
            "",
        ])
    lines = [
        "## Audit rerun",
        "",
        "Unaudited. Protocol audit-retime-1.",
        "",
    ]
    for name, rec in certs:
        inv = rec.get("invariance", {})
        job = name.split("/")[0]
        entry = ledger_jobs.get(job, {})
        lines.append(
            f"`{name}`, seed {rec.get('seed')}, host {host_line(rec.get('host'))}. "
            f"Ledger gpu {entry.get('gpu_actual')}, cpu {entry.get('cpu_actual')}, "
            f"wall {num(entry.get('wall'))} s, settled {num(entry.get('settled_usd'))} USD. "
            f"merge_seconds {num(rec.get('merge_seconds'))}, load_seconds {num(rec.get('load_seconds'))}. "
            f"decision {inv.get('decision')}, decision_ok {inv.get('decision_ok')}, "
            f"max |Δ| {num(inv.get('max_abs_delta'))}, min margin {num(inv.get('min_margin'))}, "
            f"per-row aggregate match {inv.get('per_row_matches_aggregate')}, "
            f"n_compared {inv.get('n_compared')}, n_argmax_mismatch {inv.get('n_argmax_mismatch')}."
        )
        lines.append("")
    for name, rec in sorted(retimes):
        job = name.split("/")[0]
        entry = ledger_jobs.get(job, {})
        phases = rec.get("phase_seconds") or {}
        lines.append(
            f"`{name}`, n_digits {rec.get('n_digits')}, instance {rec.get('i')}, protocol {rec.get('protocol')}, "
            f"host {host_line(rec.get('host'))}. "
            f"Ledger gpu {entry.get('gpu_actual')}, cpu {entry.get('cpu_actual')}, "
            f"wall {num(entry.get('wall'))} s, settled {num(entry.get('settled_usd'))} USD. "
            f"hs_exact {rec.get('hs_exact')}, bl_exact {rec.get('bl_exact')}, "
            f"lookups_ok {rec.get('lookups_ok')}, margin_holds {rec.get('margin_holds')}, "
            f"margin_floor {num(rec.get('margin_floor'))}. "
            f"warmup_seconds {num(rec.get('warmup_seconds'))}, "
            f"merge_seconds {num(rec.get('merge_seconds'))}. "
            f"e2e_seconds {num(rec.get('e2e_seconds'))}. "
            f"phase D {num(phases.get('D'))}, HS {num(phases.get('HS'))}, BL {num(phases.get('BL'))}, "
            f"S_HS {num(phases.get('S_HS'))}, S_BL {num(phases.get('S_BL'))}. "
            f"hs_model_seconds {num(rec.get('hs_model_seconds'))} (model calls only)."
        )
        lines.append("")
    return "\n".join(lines)


def build():
    if not PRED.exists() or not ALGEBRA_PATH.exists():
        raise SystemExit("register predictions before writing SCAN.md")
    algebra = load_json(ALGEBRA_PATH)
    files = job_records()
    led = ledger()
    jobs = (led or {}).get("jobs", {})
    deriv, _ = second_derivations(algebra, files)
    parts = [
        "# SCAN",
        "",
        "## Summary",
        "",
        summary_text(algebra, files, led),
        "",
        resolved_text(algebra),
        "## Registered predictions",
        "",
        PRED.read_text().rstrip(),
    print(json.dumps({"predictions": str(PRED), "scan": str(SCAN_PATH), "handoff": str(HANDOFF_PATH)}))


def amend_symbols():
    files = job_records()
    found = pick_search(files)
    probe = pick_record(files, "probe.json", "probe")
    diag = pick_record(files, "diag.json", "diag")
    if found is None or probe is None or diag is None:
        raise SystemExit("symbol amendment needs search.json, probe.json, and diag.json")
    if found[1].get("partial"):
        raise SystemExit("search record is a checkpoint")
    if found[1].get("chosen") is None:
        raise SystemExit(
            "no triple passed; write the question at the top of SCAN.md and stop. "
            f"stopped_because={found[1].get('stopped_because')} tried={found[1].get('n_tried')}"
        )
    text = symbols_section(files).strip()
    path = RESULTS / "_amend_symbols.txt"
    path.write_text(text + "\n")
    try:
        amend(path)
    finally:
        path.unlink(missing_ok=True)


def amend(path):
    text = pathlib.Path(path).read_text().strip()
    items = load_json(AMEND_PATH).get("items", []) if AMEND_PATH.exists() else []
    items.append({"at": stamp(), "text": text})
    atomic_write(AMEND_PATH, json.dumps({"items": items}, indent=1))
    build()


def main():
    ap = argparse.ArgumentParser()
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("register")
    sub.add_parser("write")
    am = sub.add_parser("amend")
    am.add_argument("--file", required=True)
    sub.add_parser("amend-symbols")
    args = ap.parse_args()
    if args.cmd == "register":
        register()
    elif args.cmd == "amend":
        amend(args.file)
    elif args.cmd == "amend-symbols":
        amend_symbols()
    else:
        build()


if __name__ == "__main__":
    main()
# Packed lookups for a browser

No site change ships with this. A browser that wants the same scan has to run the packed forward itself.

The cached Qwen/Qwen3-4B config agrees with the job record on ('n_layers', 'n_kv_heads', 'head_dim', 'hidden', 'vocab'): True.

Architecture source: the job record. Layers 36, query heads 32, KV heads 8, head dim 128, hidden 2560, vocab 151936, dtype bfloat16, sliding window False.

KV bytes per token are layers × 2 (key and value) × KV heads × head dim × bytes per element: 36 × 2 × 8 × 128 × 2 = 147456.

What the forward does:

- Prefill Π once. Keep that KV. Every later forward clones it and discards the clone, so Π is not rewritten.
- A block is one lookup. D and M blocks are 2 tokens. S blocks are 4 tokens (carry-in, digit, digit, carry-out).
- position ids inside a block restart at |Π|, the same positions as the pinned single tick. The cache itself appends in order. The restarted positions are RoPE positions, not the write index.
- The mask is 4-dimensional, shape (1, 1, query tokens, |Π| + query tokens), boolean, True where attention is allowed. Each query may attend to every Π key and, causally, to the keys of its own block. It may not attend to any other block. One block reproduces the pinned tick.
- The argmax is read at the last token of each block. The logits of the other tokens can be dropped.

Π lengths from the algebra record: D 400 tokens, M 36 tokens, S 1200 tokens. The deployed chunk is 4096 query tokens.

Resident KV is the retained Π cache plus the clone of that cache with one chunk appended. The clone is what the forward writes; the original Π stays allocated.

- D: retained 400 + clone 4496 = 4896 tokens, 721944576 bytes.
- M: retained 36 + clone 4132 = 4168 tokens, 614596608 bytes.
- S: retained 1200 + clone 5296 = 6496 tokens, 957874176 bytes.

A single forward of the widest Hillis–Steele round at 4096 digits holds 4095 lookups × 2 tokens = 8190 query tokens. The clone is that plus the M prefix of 36 tokens (8226 tokens). With the retained Π of 36 tokens the resident set is 8262 tokens, 1218281472 bytes. The run does not do that. It cuts the round into chunks of the deployed width, and the resident set is the chunk line above. The browser can do the same.

