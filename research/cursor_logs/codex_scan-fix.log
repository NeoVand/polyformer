def timing_protocol_text():
    return "\n".join([
        "## Timing protocol",
        "",
        "Registered before the audit rerun. Protocol id audit-retime-1. "
        "Measurements produced by this protocol are unaudited.",
        "",
        "The pinned symbols are token ids 6876, 9039, 23606. One process per GPU.",
        "",
        "- merge_seconds is the adapter merge alone. load_seconds is the weight load onto the GPU, "
        "closed by a synchronize. Neither clock sits inside an addition.",
        "- Certification is next. Widths are 1, 8, 32, and the deployed chunk, plus every partial chunk "
        "length of seed 20261028 instance 0 at 4096 digits and at 100000 digits, separately for D, M, and S. "
        "Each width runs an all-equal forward of every row and one cyclic mixture. Then the packed forwards "
        "of that instance's true Hillis–Steele schedule and true Blelloch schedule are compared, slot by slot, "
        "with the pinned single tick. The record stores each row's maximum absolute logit difference.",
        "- Before each timed addition, one discarded packed forward of a full M chunk, including its prefill, "
        "then a synchronize. warmup_seconds is that interval.",
        "- Each timed addition is instance 0 of seed 20261028, once at 4096 digits and once at 100000 digits. "
        "A synchronize opens the interval. The components are D, the Hillis–Steele scan, the Blelloch scan, "
        "S on the Hillis–Steele carries, and S on the Blelloch carries. Each component is its own synchronized "
        "interval and includes prefill, mask construction, cache cloning, and argmax extraction. "
        "e2e_seconds is the outer synchronized interval covering those five components.",
        "- The model-call clocks in stats are unchanged, so hs_model_seconds stays comparable to the counted records.",
        "- margin_holds applies the certificate bound when the certificate is a margin certificate. "
        "It is null when no bound is checked.",
        "",
    ])


def _smoke_record(files):
    rows = [(name, rec) for name, rec in files.items() if pathlib.PurePosixPath(name).name == "smoke.json"]
    return rows[-1] if rows else None


def audit_corrections_text(algebra, files):
    """Old claim, new claim, one reason. New numbers are an unaudited recount or a recalculation."""
    census = alg.damage_census()
    cases = alg.same_class_counterexamples()
    replay = cases[0]["replay"]
    adds = addition_files(files, "add_4096_")
    hs_times = [r.get("hs_model_seconds") for _, r in adds if r.get("hs_model_seconds") is not None]
    unchecked = [name for name, rec in files.items()
                 if rec.get("margin_holds") is True and rec.get("margin_floor") is None]
    smoke = _smoke_record(files)
    extra = (smoke[1].get("extrapolation_100000") or {}) if smoke else {}
    unit = None
    if smoke and smoke[1].get("chunks"):
        unit = max(smoke[1]["chunks"][name]["seconds"] for name in ("D", "M", "S"))
    chunks = algebra.get("chunk_blocks") or {}
    forwards = alg.hs_model_forwards(100000, int(chunks.get("2", 0)), int(chunks.get("2", 0)), int(chunks.get("4", 0)))
    per = None
    for _, rec in find_records(files, "cert.json"):
        if rec.get("arch"):
            per = kv_per_token(rec["arch"])
            break
    resident = alg.resident_kv_bytes(algebra["pi_tokens"], algebra["query_tokens"], per) if per else {}
    lines = [
        "## Audit corrections",
        "",
        "The numbers in this section are unaudited. Frozen registration text is unchanged. "
        "Each line is the old claim, the replacement, and the reason.",
        "",
        "- Same-class corruption. Old: a K↔P error does not change any sum. "
        f"→ New: the sequential left fold keeps the sum (necessity_same_carry_class_preserves_sum "
        f"{algebra['necessity_same_carry_class_preserves_sum']}); Hillis–Steele and Blelloch can change it. "
        f"Reason: 1009 + 1001 is {replay['bigint']}, the sequential sum is {replay['seq']}, and Hillis–Steele "
        f"with KK→P returns {replay['hs']}.",
        f"- Damage count. Old: {len(carry_split(algebra)[1])} corruptions can change a sum. "
        f"→ New: {census['n_hs']} of {census['n']} change some Hillis–Steele sum and {census['n_bl']} change "
        f"some Blelloch sum, on a word of length at most {census['max_len']}. "
        "Reason: the five same-class mutations are non-associative, so a parallel parenthesization is not the left fold. "
        + " ".join(
            f"{c['name']} HS {c['hs_word']} ({c['hs']['a']}+{c['hs']['b']} → {c['hs']['hs']}, bigint {c['hs']['bigint']}), "
            f"BL {c['bl_word']} ({c['bl']['a']}+{c['bl']['b']} → {c['bl']['bl']}, bigint {c['bl']['bigint']})."
            for c in cases
        ),
        f"- Detection. Old: 14 of 18, read as the corruptions that matter. "
        f"→ New: Light flags {algebra['n_detectable']} of {algebra['n_corruptions']} single-entry substitutions "
        f"and that statement stops there. "
        "Reason: the fault set is each of 9 rows replaced by each of the 2 wrong symbols, not an arbitrary corruption.",
        "- Certificate gate. Old: the bitwise branch set decision_ok true whenever the logit vectors matched. "
        "→ New: both branches require a positive margin and zero target mismatches, and a margin certificate "
        "still requires min margin > 2 × max |Δ|. "
        "Reason: equal logits can be a tie or the wrong token. The recorded margin-branch certificates are not rewritten.",
        "- margin_holds. Old: a missing bound was stored as true. "
        f"→ New: the flag is null unless a bound was checked. Records that stored true with no margin_floor: "
        f"{', '.join(unchecked) if unchecked else 'none'}. "
        "Reason: those true values were the default, not a checked bound. Exact-sum flags are a separate field.",
        "- Extrapolation. Old: "
