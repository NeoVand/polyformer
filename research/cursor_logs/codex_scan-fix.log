+"""CPU-only accounting regression checks; no Modal calls."""
+
+import unittest
+
+import scan_modal as M
+
+
+class SettlementTest(unittest.TestCase):
+    def test_ordinary_settlement_preserves_cost_basis(self):
+        self.assertEqual(M.settlement_seconds({"max_seconds": 1000}, {"wall": 400}, {}), 550)
+
+    def test_preempted_call_counts_all_attempts_without_reservation_clamp(self):
+        entry = {"charge_full_call_elapsed": True, "launched_at": "2026-10-29T05:00:00+00:00"}
+        result = {"wall": 400, "remote_completed_at": "2026-10-29T07:00:00+00:00"}
+        self.assertEqual(M.settlement_seconds({"max_seconds": 1000}, result, entry), 7350)
+
+
+if __name__ == "__main__":
+    unittest.main()
