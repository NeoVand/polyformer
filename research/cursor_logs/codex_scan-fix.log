"""One GPU job: smoke, symbol search, the counted H100 run, the L4 timing run, or the million-digit run.

Reads no secrets. Writes JSON under --out. A fresh process merges the adapter itself.
"""

from __future__ import annotations

import argparse
import sys
import time
import traceback

import scan_algebra as alg
import scan_forward as fwd
from pb_common import atomic_json, host_record

SEED = 20261028


def public_stats(stats):
    out = {}
    for name, st in stats.items():
        out[name] = {
            "n": st["n"],
            "n_match": st["n_match"],
            "min_margin": st["min_margin"],
            "seconds": st["seconds"],
            "n_missing": st["n_missing"],
            "bad": st["bad"],
            "chunk_seconds": st.get("chunk_seconds", []),
        }
    return out


def hs_model_seconds(stats):
    return stats["D"]["seconds"] + stats["HS"]["seconds"] + stats["S_HS"]["seconds"]


def lookups_ok(stats, margin_holds):
    matched = all(st["n"] == st["n_match"] and st["n_missing"] == 0 for st in stats.values())
    if margin_holds is None:
        return matched
    return matched and bool(margin_holds)


def arch_of(model):
    cfg = model.config
    head = getattr(cfg, "head_dim", None) or (cfg.hidden_size // cfg.num_attention_heads)
    return {
        "n_layers": int(cfg.num_hidden_layers),
        "n_heads": int(cfg.num_attention_heads),
        "n_kv_heads": int(cfg.num_key_value_heads),
        "head_dim": int(head),
        "hidden": int(cfg.hidden_size),
        "vocab": int(cfg.vocab_size),
        "dtype": "bfloat16",
        "bytes_per_elem": 2,
        "use_sliding_window": bool(getattr(cfg, "use_sliding_window", False)),
        "query_tokens": fwd.QUERY_TOKENS,
        "model": fwd.MODEL_NAME,
        "adapter": fwd.ADAPTER,
    }


def load_runtime():
    t0 = time.perf_counter()
    tok = fwd.load_tokenizer()
    model = fwd.load_merged()
    host = host_record()
    arch = arch_of(model)
    checked = fwd.spot_check_mask(fwd._device(model))
    print(f"loaded in {time.perf_counter() - t0:.1f}s mask_checks={checked}", flush=True)
    return model, tok, host, arch


def common(mode, host, arch, symbols):
    return {"seed": SEED, "mode": mode, "host": host, "arch": arch, "symbols": symbols,
            "query_tokens": fwd.QUERY_TOKENS}


def with_pi(record, tables):
    record["pi_tokens"] = {name: len(tables[name]["pi"]) for name in ("D", "M", "S")}
    record["n_rows"] = {name: len(tables[name]["rows"]) for name in ("D", "M", "S")}
    return record


def addition_record(model, tables, a, b, margin_floor, m_table=None):
    got = fwd.run_addition(model, tables, a, b, margin_floor=margin_floor, m_table=m_table)
    stats = got.pop("stats")
    got["stats"] = public_stats(stats)
    got["hs_model_seconds"] = hs_model_seconds(stats)
    got["lookups_ok"] = lookups_ok(stats, got["margin_holds"])
    got["a"] = a
    got["b"] = b
    return got


def time_chunk(model, table):
    """One packed forward of a full chunk, every slot the same row. Returns seconds and whether every slot hit."""
    past = fwd.prefill(model, table["pi"])
    q = table["queries"][0]
    target = table["rows"][0][table["block_len"]]
    blocks = [q] * fwd.chunk_for(table["block_len"])
    summary, seconds = fwd.packed_lookup(model, past, len(table["pi"]), blocks)
    n_match = sum(arg == target and margin > 0 for arg, margin in summary)
    min_margin = min(margin for _, margin in summary) if summary else None
    del past
    return {"seconds": seconds, "n": len(summary), "n_match": n_match, "min_margin": min_margin,
            "block_len": table["block_len"], "P": len(table["pi"])}


def extrapolate(chunk_seconds):
    """Hillis–Steele model forwards at 100000 digits, using one measured full-chunk forward as the unit.

    Each dependent round is packed separately. One ceil over the sum of the scan lookups under-counts.
    """
    counts = alg.hs_model_forwards(100000, fwd.chunk_for(2), fwd.chunk_for(2), fwd.chunk_for(4))
    unit = max(chunk_seconds)
    return {"unit_seconds": unit, "forwards": counts["total"], "rounds": counts,
            "extrapolated_hs_seconds": unit * counts["total"],
            "threshold_seconds": 1.25 * unit * counts["total"]}


