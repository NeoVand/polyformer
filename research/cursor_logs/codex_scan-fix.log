new file mode 100644
index 0000000000000000000000000000000000000000..09e1c9e4dfa0668ecdd069d800cbeca50a36e23f
--- /dev/null
+++ b/research/scan/verify_scan_fix.py
@@ -0,0 +1,116 @@
+"""CPU-only checks of collected audit records; never launches Modal work.
+
+    nice -n 19 python3 research/scan/verify_scan_fix.py
+
+Checks saved extrema and coverage, not the underlying unsaved logit vectors.
+"""
+
+import hashlib
+import json
+import math
+from datetime import datetime
+from pathlib import Path
+import subprocess
+import sys
+
+import scan_algebra as alg
+
+ROOT = Path(__file__).resolve().parent
+RESULTS = ROOT / "results"
+
+
+def read(path):
+    return json.loads(path.read_text())
+
+
+def check_job(gpu):
+    job = f"scan-fix-{gpu}"
+    cert = read(RESULTS / job / "cert.json")
+    inv = cert["invariance"]
+    rows = [r for t in inv["tables"].values() for r in t["per_row"]]
+    assert len(rows) == 309
+    assert sum(r["n_compared"] for r in rows) == inv["n_compared"]
+    assert max(r["max_abs_delta"] for r in rows) == inv["max_abs_delta"]
+    assert min(r["min_margin"] for r in rows) == inv["min_margin"]
+    assert sum(r["n_argmax_mismatch"] for r in rows) == inv["n_argmax_mismatch"] == 0
+    assert inv["margin_bound"] == 2 * inv["max_abs_delta"] >= 0
+    margin_ok = inv["min_margin"] > inv["margin_bound"]
+    assert inv["decision_ok"] == inv["margin_ok"] == margin_ok
+    assert inv["per_row_matches_aggregate"]
+    plans = []
+    timings = []
+    for n in (4096, 100000):
+        rec = read(RESULTS / job / f"retime_{n}.json")
+        a, b = alg.draw_instances(20261028, n, 1)[0]
+        assert (rec["a"], rec["b"]) == (a, b)
+        truth = str(int(a) + int(b))
+        assert rec["hs_sum"] == rec["bl_sum"] == rec["bigint"] == truth
+        assert rec["hs_exact"] and rec["bl_exact"] and rec["prefixes_agree"]
+        assert rec["protocol"] == cert["protocol"] == "audit-retime-1"
+        assert rec["margin_floor"] == inv["margin_bound"]
+        runtime_margin_ok = all(s["min_margin"] > rec["margin_floor"] for s in rec["stats"].values())
+        assert rec["margin_holds"] == rec["lookups_ok"] == runtime_margin_ok
+        for name, st in rec["stats"].items():
+            assert st["n"] == st["n_match"] and st["n_missing"] == 0 and not st["bad"]
+            assert st["min_margin"] > 0
+            assert math.isclose(sum(st["chunk_seconds"]), st["seconds"], abs_tol=1e-6)
+            assert rec["phase_seconds"][name] >= st["seconds"] > 0
+        assert rec["e2e_seconds"] >= sum(rec["phase_seconds"].values()) > 0
+        assert math.isclose(rec["hs_model_seconds"], sum(
+            rec["stats"][k]["seconds"] for k in ("D", "HS", "S_HS")), abs_tol=1e-6)
+        for key in ("warmup_seconds", "merge_seconds", "load_seconds"):
+            assert rec[key] > 0
+        plan = alg.deployed_lookup_plan(a, b, 2048, 2048, 1024)
+        for table, p in plan.items():
+            assert cert["deployed_plan"][str(n)][table] == {
+                k: p[k] for k in ("n_forwards", "n_slots", "widths")}
+        plans.append(plan)
+        timings.append({"n_digits": n, "both_exact": True, "e2e_seconds": rec["e2e_seconds"]})
+    for table, t in inv["tables"].items():
+        slots = sum(p[table]["n_slots"] for p in plans)
+        forwards = sum(p[table]["n_forwards"] for p in plans)
+        widths = sorted({w for p in plans for w in p[table]["widths"]})
+        assert t["n_mixture_slots"] == slots and t["n_mixture_forwards"] == forwards
+        assert t["mixture_widths"] == widths and set(widths) <= set(t["widths"])
+        expected = (t["rows"] + 1) * sum(t["widths"]) + t["rows"] + slots
+        assert sum(r["n_compared"] for r in t["per_row"]) == expected
+        assert t["pass"] and t["cert_fail"] == t["b1_argmax_bad"] == 0
+    manifest = read(ROOT / "manifests" / f"fix-{gpu}.json")
+    assert manifest["uncommitted_sources"] is False
+    # Verify the actual launch revision, not subsequently edited reporting code.
+    for name, digest in manifest["source_hashes"].items():
+        paths = [d / name for d in (ROOT, ROOT.parent / "arith", ROOT.parent / "promptbox")]
+        path = next(p for p in paths if p.exists())
+        relative = path.relative_to(ROOT.parents[1])
+        content = subprocess.check_output(["git", "show", f"{manifest['commit']}:{relative}"], cwd=ROOT)
+        assert hashlib.sha256(content).hexdigest() == digest, name
+    return {"job": job, "certificate_passed": inv["decision_ok"],
+            "n_compared": inv["n_compared"], "max_abs_delta": inv["max_abs_delta"],
+            "min_margin": inv["min_margin"], "timings": timings}
+
+
+def main():
+    sys.set_int_max_str_digits(0)
+    jobs = [check_job(gpu) for gpu in ("h100", "l4")]
+    ledger = read(RESULTS / "modal_ledger.json")
+    assert not any(e["status"] in ("running", "reserved") for e in ledger["jobs"].values())
