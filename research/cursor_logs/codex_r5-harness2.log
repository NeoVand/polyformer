/** A lazy token trie over question substrings. Byte edges preserve split UTF-8/BPE tokens and JSON escapes. */
import type { Tok } from './pb.ts';
interface Node {
	next: Map<number, Node>;
	ids: number[];
}
interface State {
	program: boolean;
	line: string;
	positions: number[] | null;
}
const node = (): Node => ({ next: new Map(), ids: [] });
const utf8 = new TextEncoder();

export class QuestionAnchorMask {
	private root = node();
	private bytes: number[] = [];
	private boundaries = new Set<number>();
	private tokens = new Map<number, Uint8Array>();
	private quoted: number[] = [];
	private state: State = { program: false, line: '', positions: null };
	constructor(question: string, tok: Tok, vocab: number) {
		for (const char of question) {
			this.boundaries.add(this.bytes.length);
			this.bytes.push(...utf8.encode(JSON.stringify(char).slice(1, -1)));
		}
		this.boundaries.add(this.bytes.length);
		for (let id = 0; id < vocab; id++) {
