export function piecesOf(c: ReasonFixtureCase): number[][] {
	const out: number[][] = [];
	let at = 0;
	for (const call of c.calls) {
		out.push(c.response_ids.slice(at, call.end));
		at = call.end + call.final_ids.length;
	}
	out.push(c.response_ids.slice(at));
	return out;
}
