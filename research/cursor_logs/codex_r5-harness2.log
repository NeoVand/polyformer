describe('library generation and durable certification', () => {
	it.each(['adder', 'subtracter'] as const)(
		'splices %s before any row decoding; keeps the final/continuation cache aligned',
		async (id) => {
			const s = setup(id);
			const trace = await s.engine.ask(
				s.question,
				{ id: 'x', multiCall: true, harness: HARNESS },
				() => {}
			);
			const call = trace.reason!.calls[0];
			expect(call.program).toBe(s.program);
			expect(call.error).toBeNull();
			expect(call.run.library).toEqual({ id, certified: true });
			expect(call.run.registers[0].program.rows).toHaveLength(200);
			expect(trace.answer).toBe('Done.');
			expect(trace.compile.tokens).toBe(tok.encode(s.header).length + 5);
			expect(s.generatedSteps()).toBeLessThan(s.header.length + 10);
			expect(s.store.data.size).toBe(1);
			s.engine.dispose();
			expect(s.script.live.size).toBe(0);
		}
	);
	it('masks a higher-logit training typo in the real generation loop', async () => {
		const s = setup('adder', undefined, undefined, true);
		const trace = await s.engine.ask(
			s.question,
			{ id: 'x', multiCall: true, harness: HARNESS },
			() => {}
		);
		expect(trace.reason!.calls[0].error).toBeNull();
		expect(trace.reason!.calls[0].value).toBe('10000012');
		s.engine.dispose();
		expect(s.script.live.size).toBe(0);
	});
	it('restores all row evidence across engine reloads, while real ticks still compare fingerprints', async () => {
		const s = setup('adder');
		await s.engine.ask(s.question, { id: 'x', multiCall: true, harness: HARNESS }, () => {});
		const cold = s.script.ticks;
		s.engine.dispose();
		const warm = setup('adder', s.store);
		const t = await warm.engine.ask(
			warm.question,
			{ id: 'y', multiCall: true, harness: HARNESS },
			() => {}
		);
		expect(cold - warm.script.ticks).toBe(400);
		expect(t.reason!.calls[0].run.registers[0].steps.every((s) => s.eq)).toBe(true);
		warm.engine.dispose();
		expect(warm.script.live.size).toBe(0);
		const changed = setup('adder', s.store, 'device/runtime/model/v2');
		await changed.engine.ask(
			changed.question,
			{ id: 'z', multiCall: true, harness: HARNESS },
			() => {}
		);
		expect(changed.script.ticks).toBe(cold);
		changed.engine.dispose();
	});
	it('recertifies corrupt records and refuses a bitwise mismatch with cached evidence', async () => {
		const s = setup('adder');
		await s.engine.ask(s.question, { id: 'x', multiCall: true, harness: HARNESS }, () => {});
		s.engine.dispose();
		const record = [...s.store.data.values()][0];
		record.rows[0].ok = false;
		const repair = setup('adder', s.store);
		await repair.engine.ask(
			repair.question,
			{ id: 'y', multiCall: true, harness: HARNESS },
			() => {}
		);
		expect(repair.script.ticks).toBe(s.script.ticks);
		repair.engine.dispose();
		for (const c of s.store.data.values()) for (const b of c.bits) b[1] = ['stale', 'stale'];
		const stale = setup('adder', s.store);
		const t = await stale.engine.ask(
			stale.question,
			{ id: 'z', multiCall: true, harness: HARNESS },
			() => {}
		);
		expect(t.reason!.calls[0].certified).toBe(false);
		expect(t.reason!.calls[0].value).toBeNull();
		expect(t.reason!.calls[0].run.library?.certified).toBe(false);
		expect(s.store.data.size).toBe(0);
		stale.engine.dispose();
		expect(stale.script.live.size).toBe(0);
		expect(out.reason!.calls[1].run.registers).toEqual([]);
		expect(out.answer).toBe('');
	});
	it('counts generated tokens across rounds and leaves no partial answer', async () => {
		const c = caseNamed('chain_add_add_sub');
		// The library rows are prefills now; only the model-written header consumes generation budget.
		const prefix = c.response_ids.slice(0, c.calls[0].end);
		const headerEnd = prefix.findIndex((_, i) =>
			tok.decode(prefix.slice(0, i + 1)).includes('register')
		);
		const budget = headerEnd + 5;
		const out = await engineFor(lmFor(c)).ask(
			c.question,
			{ id: 'x', multiCall: true, harness: { ...HARNESS, maxTokens: budget } },
			() => {}
		);
		expect(out.reason!.end).toBe('tokens');
		expect(out.compile.tokens).toBe(budget);
		expect(out.reason!.calls).toHaveLength(1);
		expect(out.answer).toBe('');
	});
});
<script lang="ts">
	/** Panel 1: the program, as its rules and as a machine (automaton) or as its listing (REGS). */
	import type { Attachment } from 'svelte/attachments';
	import MachineDiagram from './MachineDiagram.svelte';
	import MealyDiagram from './MealyDiagram.svelte';
	import { mealyWords } from './mealy.ts';
	import Pane from './Pane.svelte';
	import { int, programLines, ruleLine, type Trace, type TraceStep } from './trace.ts';

	let { trace, cur, stuck }: { trace: Trace; cur: TraceStep; stuck: string | null } = $props();

	const lines = $derived(programLines(trace.program.text));
	const isRegs = $derived(trace.kind === 'regs');
	const isLlm = $derived(trace.kind === 'llm');
	const lit = $derived(
		isRegs
			? cur.row
			: stuck !== null
				? -1
				: isLlm
					? (trace.program.row_lines?.[cur.row] ?? -1)
					: ruleLine(lines, cur.event)
	);
	const next = $derived(isRegs ? Number(cur.t) : -1);
	const index = $derived(new Map(trace.program.states.map((s, i) => [s, i])));
	const from = $derived(index.get(stuck ?? cur.s) ?? 0);
	const to = $derived(index.get(stuck ?? cur.t) ?? 0);
	const mealy = $derived(!!trace.program.mealy);
	const size = $derived(
		mealy
			? `${trace.program.states.length} ${mealyWords(trace).states} × ${trace.program.events.length} digit pairs`
			: `${trace.program.states.length} states × ${trace.program.events.length} events`
	);
	const llmFile = $derived(trace.llm?.file);
	const library = $derived(llmFile?.library);
	const short = $derived(
		library
			? library.certified
				? 'library table, certified on this device'
				: 'library table, certification pending'
			: isRegs
				? `hand-written listing, ${trace.program.lines} lines`
				: isLlm
					? `written by the model, ${size}`
					: `reference program, ${size}`
	);

	/** Scrolls the text (not the page) so the lit line sits in the middle. */
	const centre =
		(k: number): Attachment<HTMLElement> =>
		(list) => {
			const el = list.children[k] as HTMLElement | undefined;
			if (el)
				list.scrollTop = Math.max(0, el.offsetTop - list.clientHeight / 2 + el.offsetHeight / 2);
		};
</script>

<Pane n={1} title="The program" source={trace.panels.program} {short}>
	<div class="wrap">
		<div class={['program', isRegs && 'regs']}>
			<ol class="text" {@attach centre(lit)} aria-label="Program text">
				{#each lines as line, i (i)}
					<li class={[i === lit && 'lit', i === next && i !== lit && 'next']}>
						{#if isRegs}<span class="mark" aria-hidden="true"
								>{i === lit ? '▸' : i === next ? '·' : ''}</span
							>{/if}{line || ' '}
					</li>
				{/each}
			</ol>
			{#if mealy && trace.program.states.length === 2}
				<div class="diagram">
					<MealyDiagram
						{trace}
						{from}
						{to}
						pair={stuck === null ? (cur.pair ?? null) : null}
						output={cur.o ?? null}
					/>
				</div>
			{:else if !isRegs && trace.program.diagram}
				<div class="diagram">
					<MachineDiagram
						{trace}
						{from}
						{to}
						event={stuck === null
							? cur.o !== undefined
								? `${cur.event} / ${cur.o}`
								: cur.event
							: isLlm
								? 'adapter off'
								: 'head off'}
					/>
				</div>
			{/if}
		</div>
		{#if llmFile}
			{@const which =
				trace.program.registers && trace.program.registers.length > 1
					? `; this is register ${llmFile.registers[trace.llm?.register ?? 0]?.name} of ${trace.program.registers.join(', ')}`
					: ''}
			<p class="caveat">
				{#if library}
					{llmFile.model.name} chose the {library.id} and wrote the input anchors and quotes. The library
					supplied the identical table rows. The model generated
					{int(llmFile.compile.tokens)} tokens. The clock runs the table one column per tick, two forwards
					each, on the same weights.
				{:else if mealy}
					Written by {llmFile.model.name}{llmFile.where === 'browser' ? ' in this browser' : ''} in
					{int(llmFile.compile.tokens)} tokens and read back from those tokens: where the two numbers
					? {
							segments: ev.trace.reason.segments,
							calls: ev.trace.reason.calls,
							current: null
						}
					: run.reason
			};
		case 'error':
			return { ...run, stage: 'error', error: ev.error };
	}
}

/** The run so far as a trace the panels can read (the finished trace once there is one). */
export function liveTrace(run: LiveRun): LlmTrace {
	if (run.trace) return run.trace;
	return {
		schema: 'polyformer.trace/0',
		source: 'savant-browser',
		// a call's run has its own id, so the panels start afresh for each call (as the finished run's calls do)
		...(run.library
			? {
					library: {
						...run.library,
						certified:
							run.registers.length > 0 &&
							run.registers.every(
								(r) => r.certificate.all_ok && r.steps.every((s) => s.lookup || s.eq)
							)
					}
				}
			: {}),
		id: run.reason?.current ? `${run.id}/call-${run.reason.current.k}` : run.id,
		kind: 'llm',
		title: run.title,
		family: run.family,
		live: true,
		where: 'browser',
		model: run.model,
		host: run.host,
		at: new Date(run.started).toISOString(),
		prompt: run.question,
		answer: run.answer,
		final_text: null,
		note: null,
		truth: null,
		base_answer: null,
		base_answer_meta: null,
		compile: {
			text: run.compile.text,
			tokens: run.compile.tokens,
			finish: run.compile.finish ?? '',
			seconds: run.compile.seconds
		},
		panels: browserPanels(),
		input: {
			events: run.tape?.events ?? null,
			char_spans: run.tape?.char_spans ?? null,
			anchors: null,
			error: null
		},
