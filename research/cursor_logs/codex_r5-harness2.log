			if ("'!bytes?.length) continue; // special and nonexistent ids cannot emit characters
			this.tokens.set(id, bytes);
			if (bytes.includes(34)) this.quoted.push(id);
			let at = this.root;
			for (const b of bytes) {
				if (!at.next.has(b)) at.next.set(b, node());
				at = at.next.get(b)!;
			}
			at.ids.push(id);
		}
	}
