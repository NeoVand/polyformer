/** Times vary run to run. */
function normalise(t: LlmTrace): LlmTrace {
	const out: LlmTrace = JSON.parse(JSON.stringify(t));
	const fix = (x: LlmTrace) => {
		x.at = '2026-10-28T00:00:00.000Z';
		x.compile.seconds = 0.5;
		x.timing = Object.fromEntries(Object.keys(x.timing ?? {}).map((k) => [k, 0.5]));
		for (const r of x.registers) {
			r.ticks.seconds = 0.05;
			r.ticks.ms_per_tick = 10;
		}
	};
	fix(out);
	for (const c of out.reason?.calls ?? []) fix(c.run);
	return out;
}

describe('R5 page harness', { timeout: 120_000 }, () => {
	it('stops a repeated program before any second execution', async () => {
		const c = caseNamed('chain_add_add_sub');
		const one = c.calls[0];
		const lm = lmFor(c, [
			c.response_ids.slice(0, one.end),
			c.response_ids.slice(one.start, one.end)
		]);
		const engine = engineFor(lm);
		const out = await engine.ask(
			c.question,
			{ id: 'x', multiCall: true, harness: HARNESS },
			() => {}
		);
		expect(out.reason!.end).toBe('repeat');
		expect(out.reason!.calls[1].final_ids).toBeNull();
		expect(out.reason!.calls[1].run.registers).toEqual([]);
		expect(out.harness!.stop).toMatchObject({ kind: 'repeat', call: 2, of: 1 });
		expect(out.answer).toBe('');
		engine.dispose();
		expect(lm.live.size).toBe(0);
	});
	it('allows at most two retries even for calls without programs', async () => {
		const c = caseNamed('chain_add_add_sub');
		const exec = c.response_ids.slice(c.calls[0].end - 3, c.calls[0].end);
		const lm = lmFor(c, Array(8).fill(exec));
		const engine = engineFor(lm);
		const out = await engine.ask(
			c.question,
			{ id: 'x', multiCall: true, harness: HARNESS },
			() => {}
		);
		expect(out.reason!.end).toBe('retries');
		expect(out.reason!.calls).toHaveLength(3);
		expect(lm.ticks).toBe(0);
		expect(verdictOf(out)).toMatchObject({ kind: 'none', failure: { kind: 'compile' } });
		engine.dispose();
		expect(lm.live.size).toBe(0);
	});
	it('caps calls without executing the next call', async () => {
		const c = caseNamed('chain_add_add_sub');
		const out = await engineFor(lmFor(c)).ask(
			c.question,
			{ id: 'x', multiCall: true, harness: { ...HARNESS, maxCalls: 1 } },
			() => {}
		);
		expect(out.reason!.end).toBe('calls');
		expect(out.reason!.calls[1].run.registers).toEqual([]);
		expect(out.answer).toBe('');
