/**
 * A run in progress, rebuilt from the engine's events, in the shapes the page's panels read. Each event returns a
 * new object (the page keeps it as raw state), so panels update as the program streams in, the certificate fills,
 * and the ticks advance. When the run finishes, its `trace` is the engine's own record of it.
 */
import type { EngineEvent, ModelInfo, HostInfo, Stage } from './engine.ts';
import { exactSum } from './arith.ts';
import { browserPanels, ring, rowLines } from './engine.ts';
import type { LlmRegister, LlmTrace, ProgramRow, ReasonCall, ReasonSegment } from '../trace.ts';

/**
 * A response with calls in the middle (REASON_FORMAT), as far as it has gone: the text and the finished calls in
 * order, and the call the clock has now. The run's own fields (compile, tape, registers, at) are the current call's
 * while the clock has one, and the text being written between calls otherwise.
 */
export interface LiveReason {
	segments: ReasonSegment[];
	calls: ReasonCall[];
	/** the call being read, certified or run */
	current: { k: number; program: string } | null;
}

export interface LiveRun {
	id: string;
	question: string;
	title: string;
	family: string | null;
	stage: Stage | 'queued' | 'done' | 'error' | 'stopped';
	prefill: { done: number; total: number };
	compile: {
		text: string;
		tokens: number;
		seconds: number;
		finish: string | null;
		exec: boolean | null;
	};
	tape: {
		events: string[];
		span: [number, number];
		char_spans: [number, number][] | null;
		/** number mode: the two numbers the clock read, and where */
		numbers?: [string, string];
		spans?: [[number, number], [number, number]];
	} | null;
	registers: LlmRegister[];
	/** the register being certified or run, and how far it is */
	at: { register: number; rows: number; ticks: number } | null;
	answer: string;
	error: string | null;
	trace: LlmTrace | null;
	/** REASON: set at the first call */
	reason: LiveReason | null;
	started: number;
	/** seconds per stage as they finish */
	model: ModelInfo;
	host: HostInfo;
}

export function startRun(
	id: string,
	question: string,
	opts: { title?: string; family?: string | null; model: ModelInfo; host: HostInfo }
): LiveRun {
	return {
		id,
		question,
		title: opts.title ?? 'Your question',
		family: opts.family ?? null,
		stage: 'queued',
		prefill: { done: 0, total: 0 },
		compile: { text: '', tokens: 0, seconds: 0, finish: null, exec: null },
		tape: null,
		registers: [],
		at: null,
		answer: '',
		error: null,
		trace: null,
		reason: null,
		started: Date.now(),
		model: opts.model,
		host: opts.host
	};
}

const PENDING = Number.NaN;

