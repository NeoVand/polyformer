			// A delimiter can close only at a complete character/escape boundary. Empty anchors are legal.
			if (byte === 34 && state.positions.some((p) => this.boundaries.has(p)))
				return { ...state, line: state.line + '"'\"\"', positions: null };
			const positions = state.positions.filter((p) => this.bytes[p] === byte).map((p) => p + 1);
			return positions.length ? { ...state, positions } : null;
		}
