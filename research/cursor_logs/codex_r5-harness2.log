	constructor(question: string, tok: Tok, vocab: number) {
		for (const char of question) {
			this.boundaries.add(this.bytes.length);
			this.bytes.push(...utf8.encode(JSON.stringify(char).slice(1, -1)));
		}
		this.boundaries.add(this.bytes.length);
		for (let id = 0; id < vocab; id++) {
