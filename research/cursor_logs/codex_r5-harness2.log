/**
 * The worker that holds Savant-4B: it loads the weights with transformers.js on WebGPU, runs the pinned loop
 * (engine.ts) one question at a time, and posts every event to the page, which stays free to draw.
 */
import { gpuLabel } from './config.ts';
import { Cancelled, Engine, PROMPTBOX_COMMIT, type HostInfo, type ModelInfo } from './engine.ts';
import type { FromWorker, ToWorker } from './protocol.ts';
import { loadTransformers } from './transformers-lm.ts';

declare const self: DedicatedWorkerGlobalScope;

let engine: Engine | null = null;
let loading = false;
const controllers = new Map<number, AbortController>();
const post = (m: FromWorker) => self.postMessage(m);
const message = (e: unknown) => (e instanceof Error ? e.message : String(e));

/** The GPU as the browser names it (vendor and architecture; some browsers hide more). */
export async function gpuName(): Promise<string | null> {
	const a = await navigator.gpu?.requestAdapter({ powerPreference: 'high-performance' });
	const i = a?.info;
	if (!i) return null;
	return gpuLabel(i);
}

/**
 * One short pass through every shape the loop uses (a prefill, a one-token step, a two-token block over a small
 * cache), so the runtime compiles its GPU kernels while the page still says "preparing" and the first question
 * does not pay for it.
 */
async function warm(lm: Awaited<ReturnType<typeof loadTransformers>>) {
	const ids = warmIds(lm).slice(0, 24);
	const a = await lm.lm.forward(ids, null, true);
	const b = await lm.lm.forward([ids[0]], a.past, true);
	await lm.lm.forward([ids[1], ids[2]], b.past, false);
	a.past?.dispose();
	b.past?.dispose();
}
const warmIds = (m: Awaited<ReturnType<typeof loadTransformers>>) =>
	m.tok.encode('<|im_start|>user\nWhich spot hides the ball after the swaps AB BC AC?<|im_end|>\n');

async function load(m: Extract<ToWorker, { type: 'load' }>) {
	if (engine || loading) return;
	loading = true;
	const t0 = performance.now();
	try {
		const loaded = await loadTransformers({
			base: m.base,
			device: m.device,
			dtype: m.dtype,
			onProgress: (progress) => post({ type: 'progress', progress })
		});
		await warm(loaded).catch(() => {});
		const gpu = m.device === 'webgpu' ? await gpuName().catch(() => null) : null;
		const model: ModelInfo = {
			name: m.model.name,
			compile_adapter: m.model.adapter,
			executor_adapter: m.model.adapter,
			adapter_sha256: { compile: '', executor: '' },
			tokenizer_sha256: '',
			promptbox_commit: PROMPTBOX_COMMIT,
			about: m.model.about
		};
		const host: HostInfo = {
			gpu: gpu ?? (m.device === 'webgpu' ? 'this browser’s GPU' : 'CPU'),
			cpu: null,
			avx512f: null,
			platform: navigator.platform || null,
			runtime: `transformers.js 4.3.1, ONNX Runtime Web, ${m.device === 'webgpu' ? 'WebGPU' : 'CPU'}`,
			dtype: m.dtype
		};
		engine = new Engine(loaded.lm, loaded.tok, { nl: loaded.nl, stop: loaded.stop }, model, host);
		post({
			type: 'loaded',
			loaded: {
				model,
				host,
				device: loaded.device,
				dtype: loaded.dtype,
				lastOnly: loaded.lm.lastOnly,
				seconds: Math.round(performance.now() - t0) / 1000
			}
		});
	} catch (e) {
		post({ type: 'load-error', error: message(e) });
	} finally {
		loading = false;
	}
}

self.onmessage = async (ev: MessageEvent<ToWorker>) => {
	const m = ev.data;
	if (m.type === 'load') return load(m);
	if (m.type === 'cancel') return controllers.get(m.rid)?.abort();
	if (!engine) {
		post({ type: 'failed', rid: m.rid, error: 'the model is not loaded', cancelled: false });
		return;
	}
	const ctl = new AbortController();
	controllers.set(m.rid, ctl);
	try {
		if (m.type === 'ask') {
			const trace = await engine.ask(m.question, { ...m.opts, signal: ctl.signal }, (event) =>
				post({ type: 'event', rid: m.rid, event })
			);
			post({ type: 'answered', rid: m.rid, trace });
		} else if (m.type === 'poke') {
			const poke = await engine.poke(
				m.question,
				m.ctx,
				m.register,
				m.step,
				m.forced,
				{ truth: m.truth, signal: ctl.signal, from: m.from, lookupAfter: m.lookupAfter },
				(event) => post({ type: 'event', rid: m.rid, event })
			);
			post({ type: 'poked', rid: m.rid, poke });
		}
	} catch (e) {
		post({ type: 'failed', rid: m.rid, error: message(e), cancelled: e instanceof Cancelled });
	} finally {
		controllers.delete(m.rid);
	}
};
<script lang="ts">
	/** Panel 1: the program, as its rules and as a machine (automaton) or as its listing (REGS). */
	import type { Attachment } from 'svelte/attachments';
	import MachineDiagram from './MachineDiagram.svelte';
	import MealyDiagram from './MealyDiagram.svelte';
	import { mealyWords } from './mealy.ts';
	import Pane from './Pane.svelte';
	import { int, programLines, ruleLine, type Trace, type TraceStep } from './trace.ts';

	let { trace, cur, stuck }: { trace: Trace; cur: TraceStep; stuck: string | null } = $props();

	const lines = $derived(programLines(trace.program.text));
	const isRegs = $derived(trace.kind === 'regs');
	const isLlm = $derived(trace.kind === 'llm');
	const lit = $derived(
		isRegs
			? cur.row
			: stuck !== null
				? -1
				: isLlm
					? (trace.program.row_lines?.[cur.row] ?? -1)
					: ruleLine(lines, cur.event)
	);
	const next = $derived(isRegs ? Number(cur.t) : -1);
	const index = $derived(new Map(trace.program.states.map((s, i) => [s, i])));
	const from = $derived(index.get(stuck ?? cur.s) ?? 0);
	const to = $derived(index.get(stuck ?? cur.t) ?? 0);
	const mealy = $derived(!!trace.program.mealy);
	const size = $derived(
		mealy
			? `${trace.program.states.length} ${mealyWords(trace).states} × ${trace.program.events.length} digit pairs`
			: `${trace.program.states.length} states × ${trace.program.events.length} events`
	);
	const short = $derived(
		isRegs
			? `hand-written listing, ${trace.program.lines} lines`
			: isLlm
				? `written by the model, ${size}`
				: `reference program, ${size}`
	);
	const llmFile = $derived(trace.llm?.file);

	/** Scrolls the text (not the page) so the lit line sits in the middle. */
	const centre =
		(k: number): Attachment<HTMLElement> =>
		(list) => {
			const el = list.children[k] as HTMLElement | undefined;
			if (el)
				list.scrollTop = Math.max(0, el.offsetTop - list.clientHeight / 2 + el.offsetHeight / 2);
		};
</script>

<Pane n={1} title="The program" source={trace.panels.program} {short}>
	<div class="wrap">
		<div class={['program', isRegs && 'regs']}>
			<ol class="text" {@attach centre(lit)} aria-label="Program text">
				{#each lines as line, i (i)}
					<li class={[i === lit && 'lit', i === next && i !== lit && 'next']}>
						{#if isRegs}<span class="mark" aria-hidden="true"
								>{i === lit ? '▸' : i === next ? '·' : ''}</span
							>{/if}{line || ' '}
					</li>
				{/each}
			</ol>
			{#if mealy && trace.program.states.length === 2}
				<div class="diagram">
					<MealyDiagram
						{trace}
						{from}
						{to}
						pair={stuck === null ? (cur.pair ?? null) : null}
						output={cur.o ?? null}
					/>
				</div>
			{:else if !isRegs && trace.program.diagram}
				<div class="diagram">
					<MachineDiagram
						{trace}
						{from}
						{to}
						event={stuck === null
							? cur.o !== undefined
								? `${cur.event} / ${cur.o}`
								: cur.event
							: isLlm
								? 'adapter off'
								: 'head off'}
					/>
				</div>
			{/if}
		</div>
		{#if llmFile}
			{@const which =
				trace.program.registers && trace.program.registers.length > 1
					? `; this is register ${llmFile.registers[trace.llm?.register ?? 0]?.name} of ${trace.program.registers.join(', ')}`
					: ''}
			<p class="caveat">
				{#if mealy}
					Written by {llmFile.model.name}{llmFile.where === 'browser' ? ' in this browser' : ''} in
					{int(llmFile.compile.tokens)} tokens and read back from those tokens: where the two numbers
					are in the question, and a register with an output, five digits a row ({mealyWords(trace)
						.state}, the two digits, the next {mealyWords(trace).state}, the digit written). The
					clock runs it one column per tick, two forwards each, on the same weights.
				{:else if llmFile.where === 'browser'}
					Written by {llmFile.model.name} in this browser in {int(llmFile.compile.tokens)} tokens and
					read back from those tokens. The table runs one tick per event on the same weights{which}.
				{:else}
					Written by {llmFile.model.name} with the compile adapter in {int(llmFile.compile.tokens)} tokens
					and read back from those tokens. The table runs one tick per event on the executor adapter{which}.
				{/if}
			</p>
		{:else if trace.panels.program.mock}
			<p class="caveat">
				Mock: a stand-in for the step where the model writes the program. Written by the question's
				generator, not by a model; the run that follows is real.
			</p>
		{:else if isRegs}
			<p class="caveat">
				Hand-written in REGS, not written by a model. Each instruction runs as 18 lookups of the
				same frozen core.
			</p>
		{/if}
	</div>
</Pane>

