import type { Tok } from './pb.ts';
interface Node { next: Map<number, Node>; ids: number[] }
interface State { program: boolean; line: string; positions: number[] | null }
const node = (): Node => ({ next: new Map(), ids: [] });
const utf8 = new TextEncoder();

