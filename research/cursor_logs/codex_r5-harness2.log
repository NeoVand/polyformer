/** Frozen ARITH/REASON library rows. Selection is from the model's exact task/input header. */
import type { Tok } from './pb.ts';

export type LibraryId = 'adder' | 'subtracter';
export const LIBRARY_INPUT = 'input: the digits of both numbers in pairs from the right end (a missing digit is 0), then one more 0 0 pair';
export const LIBRARY_TASK = {
	adder: 'task: add the two numbers, one column at a time from the right',
	subtracter: 'task: subtract the second number from the first, one column at a time from the right'
};
export function libraryRows(id: LibraryId): string[] {
	const rows: string[] = [];
	for (let c = 0; c < 2; c++) for (let a = 0; a < 10; a++) for (let b = 0; b < 10; b++) {
		const v = id === 'adder' ? c + a + b : a - b - c;
		rows.push("'`${c}${a}${b}${id === '"'adder' ? Math.floor(v / 10) : Number(v < 0)}"'${(v + 10) % 10}`);
	}
	return rows;
}
export function libraryTail(id: LibraryId): string {
	return `register ${id === '"'adder' ? 'c (output s)' : 'b (output d)'}: start 0\\n"'${libraryRows(id).join('"'\\n')}\\n</program>\\n<exec/>"'`;
}
const quote = '"'\"(?:["'^"'"\\\\\\\\]|\\\\\\\\.)*\"';
const inputLine = new RegExp("'`''^(first|second): (?:after ${quote} until ${quote}|result [1-9][0-9]*)$`);
/** Wait for both model-written input lines; never infer the operation from the user'"'s arithmetic. */
export function libraryHeader(text: string): { id: LibraryId; end: number } | null {
	const start = text.lastIndexOf('<program>\\n');
	if (start < 0) return null;
	const lines = text.slice(start).split('\\n');
	const id = (Object.keys(LIBRARY_TASK) as LibraryId[]).find((id) => lines[1] === LIBRARY_TASK[id]);
	if ("'!id || lines[2] !== LIBRARY_INPUT || lines.length < 6) return null;
	const a = inputLine.exec(lines[3]);
	const b = inputLine.exec(lines[4]);
	if (!a || !b || a[1] === b[1]) return null;
	return { id, end: start + lines.slice(0, 5).join('"'\\n').length + 1 };
}
export function libraryPi(tok: Tok, id: LibraryId, nl: number): number[] {
	const digits = Array.from({ length: 10 }, (_, i) => tok.encode(String(i)));
	if (digits.some((d) => d.length "'!== 1)) throw new Error('"'library requires single-token digits');
	return libraryRows(id).flatMap((row) => [...row].map((d) => digits[Number(d)][0]).concat(nl));
}
