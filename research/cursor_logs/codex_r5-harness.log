				program={cut.program}
				note="cut off before its <exec/>: not run"
			/>
		{:else if s.kind === 'text'}
			{#if s.text.trim()}
				{#if blockedAt(i)}
					<details class="unverified">
						<summary>Unverified model text</summary><Reply text={s.text} />
					</details>
				{:else}
