/**
 * The R5 harness (briefs/R5_HARNESS_BRIEF.md): what the page does around the model so that it never presents an
 * answer it cannot stand behind. The clock (webgpu/pb.ts, reason.ts, arith.ts) keeps the reference's rules; the
 * engine applies these limits only when the page asks for them (`AskOptions.harness`), and the page reads every run
 * through `verdictOf` before it shows an answer.
 */
import { PLAIN_NOTE, RULE_STYLE_NOTE, STOPPED_BEFORE_RUN } from './webgpu/notes.ts';
import type { HarnessStop, LlmTrace, ReasonCall, ReasonRecord } from './trace.ts';

// ------------------------------------------------------------------ the limits

export interface Harness {
	/** failed calls the model may follow with another try; one failure more stops the reply */
	retries: number;
	/** calls one reply may run; the next `<exec/>` stops the reply */
	maxCalls: number;
	/** tokens the model may write in one reply, over all its rounds (the clock's lines not counted) */
	maxTokens: number;
}

/** What the page sends with every question. */
export const HARNESS: Harness = { retries: 2, maxCalls: 6, maxTokens: 8000 };

/** Token-for-token equality of two id lists (the loop guard's test for a repeated program). */
export const sameIds = (a: readonly number[], b: readonly number[]) =>
	a.length === b.length && a.every((x, i) => x === b[i]);

/** The error a call gets when the page stops the reply at it (no line is appended: the reply ends there). */
export const capError = (limit: number) => `over the page's cap of ${limit} calls`;
export const repeatError = (of: number) => `repeats call ${of} token for token`;
const HARNESS_STOP = [/^over the page's cap of \d+ calls$/, /^repeats call \d+ token for token$/];

/** A call the page refused because it stopped the reply there (the cap on calls, or a repeat). */
export const isHarnessStop = (error: string | null) =>
	error !== null && HARNESS_STOP.some((re) => re.test(error));

// ------------------------------------------------------------------ what failed

/**
 * compile: the program does not parse or is not a table the clock runs; reading: the clock could not read its input
 * from the question, the notes or a result; certificate: some row's argmax is not what the row wrote; limit: a cap,
 * a repeat or the clock's own call limit; check: the answer disagrees with the page's independent check.
 */
export type FailureKind = 'compile' | 'reading' | 'certificate' | 'limit' | 'check';

export interface Failure {
	kind: FailureKind;
	/** the call it happened in (null: a reply with one program, or the whole reply) */
	call: number | null;
	/** the clock's message, or the page's */
	message: string;
}

const READING = [
	/anchors not found/,
	/not a number/,
	/no result \d+/,
	/a digit is not an event of the table/,
	/not an event or separator/,
	/crosses the span edge/,
	/not the question's/,
	/part of a number/
];
const LIMIT = [/^too many calls$/, /^hard stop$/, ...HARNESS_STOP];

/** The kind of a clock error (a call's error line, or the note of a run that stopped before its run). */
export function failureKind(error: string): 'compile' | 'reading' | 'limit' {
	if (LIMIT.some((re) => re.test(error))) return 'limit';
	if (READING.some((re) => re.test(error))) return 'reading';
	return 'compile';
}

/** A call's failure: its error line, or a certificate with rows wrong; null for a call that ran certified. */
export function callFailure(c: ReasonCall): Failure | null {
	if (c.error) return { kind: failureKind(c.error), call: c.k, message: c.error };
	if (c.certified === false) {
		const regs = c.run.registers;
		const rows = regs.reduce((a, r) => a + r.program.rows.length, 0);
		const wrong = regs.reduce((a, r) => a + (r.certificate.rows_wrong ?? 0), 0);
		return { kind: 'certificate', call: c.k, message: `${wrong} of ${rows} rows wrong` };
	}
	return null;
}

/**
 * The failure a reply with calls is left with: the last failed call that no later call ran past, certified. A
 * failure the model repaired (an error line, then a call that ran) does not stand.
 */
export function outstanding(calls: readonly ReasonCall[]): Failure | null {
	let f: Failure | null = null;
	for (const c of calls) {
		const x = callFailure(c);
		if (x) f = x;
		else if (c.certified) f = null;
	}
	return f;
}

/** One plain clause for a failure: what failed, and the clock's words for it. */
export function failureSentence(f: Failure): string {
	const who = f.call === null ? 'the program' : `call ${f.call}`;
	switch (f.kind) {
		case 'compile':
			return `${who} did not compile (${f.message})`;
		case 'reading':
			return `${f.call === null ? 'the clock' : who} could not read ${f.call === null ? 'the input' : 'its input'} (${f.message})`;
		case 'certificate':
			return `${who} failed its certificate (${f.message}), so its run carries no guarantee`;
		case 'check':
			return f.message;
		case 'limit':
			return f.message;
	}
}

// ------------------------------------------------------------------ why a reply stopped

/** Why a reply with calls ended without an answer, as a clause; null for a finished reply. */
export function stopSentence(end: ReasonRecord['end'], stop: HarnessStop | null = null): string | null {
	switch (end) {
		case 'stop':
			return null;
		case 'hard stop':
			return 'the 12th call ended it';
		case 'length':
			return 'the token budget cut it off';
		case 'context':
			return 'the context filled up';
		case 'retries':
			return `the page allows ${stop?.limit ?? HARNESS.retries} retries after a failed call, and call ${stop?.call ?? '?'} failed again, so it stopped the reply`;
		case 'repeat':
			return `call ${stop?.call ?? '?'} repeated call ${stop?.of ?? '?'} token for token, so the page stopped the reply`;
		case 'calls':
			return `the reply reached the page's cap of ${stop?.limit ?? HARNESS.maxCalls} calls`;
		case 'tokens':
			return `the reply reached the page's cap of ${(stop?.limit ?? HARNESS.maxTokens).toLocaleString('en-US')} tokens`;
	}
}

/** The ends where the reply stops at a call, with no words after it. */
export const ENDS_AT_CALL: ReadonlySet<ReasonRecord['end']> = new Set([
	'hard stop',
	'retries',
	'repeat',
	'calls'
]);

// ------------------------------------------------------------------ the verdict on a reply

/**
 * What the page may say about a finished run before it shows the answer:
 * - verified: every program that ran was certified and nothing failed that the model did not repair;
 * - plain: no program, an answer in words;
 * - unverified: there are words, but a failure stands (they are shown only as the model's, unchecked);
 * - none: no answer at all: the program stopped before its run, or the reply was stopped or cut off (`why`), with
 *   the failure that stands when there is one.
 */
export type Verdict =
	| { kind: 'verified' }
	| { kind: 'plain' }
	| { kind: 'unverified'; failure: Failure }
	| { kind: 'none'; failure: Failure | null; why: string | null };

export function verdictOf(t: LlmTrace): Verdict {
	if (t.reason) {
		const r = t.reason;
		const f = outstanding(r.calls);
		const why = stopSentence(r.end, t.harness?.stop ?? null);
		if (why) return { kind: 'none', failure: f, why };
		if (f) return { kind: 'unverified', failure: f };
		return r.calls.some((c) => c.certified) ? { kind: 'verified' } : { kind: 'plain' };
	}
	if (t.note === PLAIN_NOTE) return { kind: 'plain' };
	if (t.note === RULE_STYLE_NOTE)
		return {
			kind: 'none',
			failure: {
				kind: 'compile',
				call: null,
				message: 'a rule-style program, which this clock cannot run'
			},
			why: null
		};
	if (!t.registers.length) {
		const msg = (t.note ?? 'the model wrote no table that could run').replace(
			STOPPED_BEFORE_RUN,
			''
		);
		return {
			kind: 'none',
			failure: { kind: failureKind(msg), call: null, message: msg },
			why: null
		};
	}
	const bad = t.registers.filter((r) => !r.certificate.all_ok);
	if (bad.length) {
		const rows = t.registers.reduce((a, r) => a + r.program.rows.length, 0);
		const wrong = t.registers.reduce((a, r) => a + (r.certificate.rows_wrong ?? 0), 0);
		return {
			kind: 'unverified',
			failure: { kind: 'certificate', call: null, message: `${wrong} of ${rows} rows wrong` }
		};
	}
	return { kind: 'verified' };
}
/**
 * The notes a run carries when it has no run of its own (engine.ts re-exports them). They live here so that the
 * page's harness (../harness.ts) can read a run without importing the engine.
 */

/** A reply with no program at all: the model answered in words (since the language repair, ordinary questions). */
export const PLAIN_NOTE = 'the model answered without writing a program';
/** What the page says when the model falls back to its older rule-style programs (arithmetic, for one). */
export const RULE_STYLE_NOTE =
	"the model wrote a rule-style program, the older format it learned for arithmetic, and this preview's clock runs only literal tables, so there is no run. Arithmetic in the runnable format comes with the next model";
/** The prefix of a note for a program that stopped before its run (a parse or a reading error follows). */
export const STOPPED_BEFORE_RUN = 'the loop stopped before the run: ';

