<script lang="ts">
	/** The stored execution evidence, reachable directly from an answer without replaying its program. */
	import { int, isLlm, type TraceFile, type LlmRegister, type Trace } from './trace.ts';

	let { file, expanded = false }: { file: TraceFile; expanded?: boolean } = $props();
	const groups = $derived.by(() => {
		const entries: { label: string; register: LlmRegister | Trace }[] = isLlm(file)
			? file.reason
				? file.reason.calls.flatMap((c) =>
						c.run.registers.map((register) => ({
							label: `call ${c.k}, register ${register.name}`,
							register
						}))
					)
				: file.registers.map((register) => ({ label: `register ${register.name}`, register }))
			: [{ label: file.title, register: file }];
		return entries
			.filter(({ register: r }) => r.certificate.certified && r.certificate.all_ok)
			.map(({ label, register: r }) => {
				const uses: Record<number, number> = {};
				for (const step of r.steps)
					if (r.program.rows[step.row]) uses[step.row] = (uses[step.row] ?? 0) + 1;
				return {
					label,
					checked: r.certificate.pairs_checked ?? r.program.rows.length,
					minimum: r.certificate.min_margin,
					rows: r.program.rows.flatMap((row, k) =>
						uses[k] !== undefined ? [{ row, k, uses: uses[k] }] : []
					),
					real: 'ticks' in r ? r.ticks.real : r.certificate.ticks_real,
					equal: 'ticks' in r ? r.ticks.bitwise_equal_to_certified_row : r.certificate.ticks_equal,
					lookup: 'ticks' in r ? (r.ticks.lookup ?? 0) : 0,
					mealy: !!r.program.mealy
				};
			});
	});
	const margin = (n: number | undefined) =>
		n !== undefined && Number.isFinite(n) ? n.toFixed(2) : 'not recorded';
</script>

