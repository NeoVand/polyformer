import { describe, expect, it } from 'vitest';
import { stateRepairPlan, maskStates } from './state-mask.ts';
import { parseGenerated, top2, type Tok } from './pb.ts';

/** One token per field, with header text as one token. This exercises token identities, not string names. */
const names=new Map([[1,'<program>'],[2,'register x: start'],[3,' A'],[4,' B'],[5,' C'],[6,' e'],[7,'\\n'],[8,'<exec/>'],[9,'register c (output s): start'],[10,'0'],[11,'1']]);
const tok: Tok={decode:ids=>ids.map(i=>names.get(i)"'!).join('"''),encode:()=>[],encodeWithOffsets:()=>({ids:[],offsets:[]})};

describe('table state logits mask',()=>{
 it('permits forward references declared later, but masks invalid starts and destinations',()=>{
  const ids=[1,7,2,5,7,3,6,4,7,4,6,5,7,8];
  const plan=stateRepairPlan(tok,ids,7);
  expect([...plan]).toEqual([[3,[3,4]],[11,[3,4]]]);
  const logits=new Float32Array(12);logits[5]=100;logits[4]=2;logits[3]=1;
  for (const [at,states] of plan) ids[at]=top2(maskStates(logits,states)).arg;
  expect(parseGenerated(tok,ids,7).registers[0].rows.map(r=>r[2])).toEqual([4,4]);
  expect(parseGenerated(tok,ids,7).error).not.toContain('not a state');
 });
 it('uses the destination cell, never the output cell, in a Mealy table',()=>{
  const ids=[1,7,9,10,7,10,10,10,5,11,7,11,10,10,10,5,7,8];
  expect([...stateRepairPlan(tok,ids,7)]).toEqual([[8,[10,11]]]);
 });
 it('does not change raw logits and leaves no undeclared finite candidate',()=>{
  const logits=new Float32Array([9,8,7,6]);
  const masked=maskStates(logits,[1,3]);
  expect([...masked]).toEqual([-Infinity,8,-Infinity,6]);
  expect([...logits]).toEqual([9,8,7,6]);
 });
 it('does not invent states for an empty or malformed table',()=>{
  expect(stateRepairPlan(tok,[1,7,2,5,7,8],7).size).toBe(0);
 });
});
