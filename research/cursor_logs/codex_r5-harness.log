	/** The whole pinned loop for one question. Emits events as it goes; resolves with the run. */
	async ask(
		question: string,
		opts: AskOptions,
		emit: (ev: EngineEvent) => void
	): Promise<LlmTrace> {
		if (this.busy) throw new Error('the model is busy with another question');
