import { describe, expect, it } from 'vitest';
import runs from '../../../e2e/fixtures/reason-runs.json';
import type { LlmTrace } from './trace.ts';
import { callFailure, failureKind, outstanding, sameIds, verdictOf } from './harness.ts';
const run = () => structuredClone(runs[0]) as LlmTrace;

describe('honest failure', () => {
 it('classifies compile and reading errors', () => {
  expect(failureKind('a destination or the start is not a state')).toBe('compile');
  expect(failureKind('first number: anchors not found')).toBe('reading');
 });
 it('withholds a confident answer after a failed call, even if a previous call passed', () => {
  const t = run(); t.reason"'!.calls.at(-1)!.error = '"'not a number';
  expect(verdictOf(t)).toMatchObject({kind:'unverified',failure:{kind:'reading'}});
 });
 it('a successful repair clears a failed parse', () => {
  const t = run(); t.reason"'!.calls[0].error = '"'table is not total';
  expect(outstanding(t.reason"'!.calls)).toBeNull();
  expect(verdictOf(t)).toEqual({kind:'"'verified'});
 });
 it('a failed certificate never gives an answer a guarantee', () => {
  const t = run(); const c = t.reason"'!.calls.at(-1)!; c.certified = false;
  expect(callFailure(c)?.kind).toBe('"'certificate');
  expect(verdictOf(t).kind).toBe('unverified');
 });
 it('compares programs by token ids, not decoded text or prefixes', () => {
  expect(sameIds([1,2],[1,2])).toBe(true);
  expect(sameIds([1,2],[1,2,3])).toBe(false);
  expect(sameIds([1,2],[2,1])).toBe(false);
 });
 it('a token cap also withholds a single-call or plain partial answer', () => {
  const t = run(); delete t.reason; t.harness={stop:{kind:'tokens',limit:8000}};
  expect(verdictOf(t)).toMatchObject({kind:'none',why:expect.stringContaining('8,000')});
 });
});
