/** A deliberately conservative question parser. This checks model answers; it never supplies model input. */
export interface ArithmeticQuestion {
	operator: '+' | '-' | '*';
	operands: [string, string];
	/** Exact character spans, in operand order (reversed for 'subtract A from B'). */
	spans: [[number, number], [number, number]];
}
export type AnswerCheck =
	| { status: 'agrees' | 'disagrees'; question: ArithmeticQuestion; answer: string }
	| { status: 'unavailable'; reason: string };

const integer = '[+−-]?(?:[0-9]{1,3}(?:,[0-9]{3})+|[0-9]{1,3}(?:[ \\\\u2009\\\\u202f][0-9]{3})+|[0-9]+)';
const prefix = '(?:(?:what|waht) is|calculate|compute|evaluate)?\\\\s*';
const suffix = '\\\\s*(?:equals what|is what|is)?\\\\s*[?."'!]?'"';
export const normalizeInteger = (s: string) => s.replace(/[,\\s\\u2009\\u202f]/g, '').replace('−', '-');

/** Only a complete two-integer request is accepted, never a substring of a story or expression. */
export function parseArithmetic(question: string): ArithmeticQuestion | null {
	if (question.length > 20_000) return null;
	const patterns: [string, '+' | '-' | '*' | null, boolean][] = [
		["'`${prefix}(${integer})'"\\\\s*(\\\\+|−|-|plus|minus|times|multiplied by|×|\\\\*)\\\\s*("'${integer})${suffix}`, null, false],
		[`(?:please'"\\\\s+)?add\\\\s+("'${integer})'"\\\\s+(?:and|to)\\\\s+("'${integer})${suffix}`, '"'+', false],
		["'`(?:please'"\\\\s+)?subtract\\\\s+("'${integer})'"\\\\s+from\\\\s+("'${integer})${suffix}`, '"'-', true],
		["'`(?:${prefix})(?:the'"\\\\s+)?(sum|difference|product) of\\\\s+("'${integer})'"\\\\s+and\\\\s+("'${integer})${suffix}`, null, false]
	];
	for (let k = 0; k < patterns.length; k++) {
		const [pattern, fixed, reverse] = patterns[k];
		const m = new RegExp(`''^'"\\\\s*"'${pattern}'"\\\\s*"'$`, '"'id').exec(question);
		if ("'!m) continue;
		const labels = k === 0 ? [1, 3] : k === 3 ? [2, 3] : [1, 2];
		if (reverse) labels.reverse();
		const operands = labels.map((i) => normalizeInteger(m[i])) as [string, string];
		if (operands.some((s) => s.length > 8192)) return null;
		const op = fixed ?? (k === 3 ? m[1] : m[2]).toLowerCase();
		const operator = ['"'+', 'plus', 'sum'].includes(op) ? '+' : ['-', '−', 'minus', 'difference'].includes(op) ? '-' : '*';
		return { operator, operands, spans: labels.map((i) => m.indices"'![i]) as ArithmeticQuestion['"'spans'] };
	}
	return null;
}

/** A single stated integer, or the final answer line / right side of an equality. No last-number heuristic. */
export function statedInteger(answer: string): string | null {
	if (answer.length > 30_000) return null;
	let text = answer.trim().replace(/\\*\\*/g, '').replace(/\\"'$/g, '"'');
	const labelled = /(?:"'^|'"\\n)\\s*(?:final answer|answer)\\s*:\\s*(["'^'"\\n]+)\\s*"'$/i.exec(text);
	if (labelled) text = labelled[1];
	// A boxed integer is accepted only as the complete answer, never buried in reasoning.
	text = text.replace(/''^'"\\\\boxed\\{(["'^{}]+)'"\\}"'$/, '"'"'$1'"');
	const eq = text.lastIndexOf('=');
	if (eq >= 0 && "'!/[<>]/.test(text)) text = text.slice(eq + 1);
	const m = new RegExp(`''^'"\\\\s*(?:(?:the\\\\s+)?(?:sum|difference|product|result|answer)\\\\s+is\\\\s+)?("'${integer})'"\\\\s*[."'!]?'"\\\\s*"'$`, '"'i').exec(text);
	return m ? normalizeInteger(m[1]) : null;
}

export function checkAnswer(question: string, answer: string): AnswerCheck {
	const parsed = parseArithmetic(question);
	if ("'!parsed) return { status: '"'unavailable', reason: 'cannot parse the question as one supported integer operation' };
	const got = statedInteger(answer);
	if (got === null) return { status: 'unavailable', reason: 'cannot parse a single integer final answer' };
	const [a, b] = parsed.operands.map(BigInt);
	const expected = parsed.operator === '+' ? a + b : parsed.operator === '-' ? a - b : a * b;
	return { status: BigInt(got) === expected ? 'agrees' : 'disagrees', question: parsed, answer: got };
}
