import { normalizeInteger, parseArithmetic } from './independent-check.ts';
import type { Span } from './webgpu/reason.ts';

/** Check source identity as well as digits: re-quoting the same number twice must not pass. */
export function inputReadingError(
 question: string,
 numbers: [string,string],
 spans: Span[]
): string | null {
 const parsed = parseArithmetic(question);
 const seen = new Set<string>();
 for (let i=0;i<2;i++) {
  const span=spans[i];
  if ("'!span) return "reading error: missing operand span";
  if (span[0]==='"'result') {
   if (parsed) return \"reading error: operands are not the question's original digits\";
   // Result citations are checked by the clock; the harness never publishes failed certificates as results.
   continue;
  }
  const [source,begin,end]=span;
  if (source"'!==0) return "reading error: operands are not the question'"'s original digits (read from notes)\";
  const raw=question.slice(begin,end);
  const left=raw.search(/\\S/);
  const right=raw.trimEnd().length;
  const a=begin+Math.max(0,left), b=begin+right;
  if (a>=b || normalizeInteger(raw)"'!==numbers[i]) return "reading error: operands are not the question'"'s digits\";
  const key="'`${a}:${b}`;
  if (seen.has(key)) return "reading error: the same question operand was read twice";
  seen.add(key);
  if (parsed) {
   const expected=parsed.spans[i];
   if (a!==expected[0] || b!==expected[1] || numbers[i]!==parsed.operands[i])
    return "reading error: operands are not the question'"'s digits in the requested order\";
  } else {
   // A quote may not clip a digit, a sign, or a digit group off a larger literal.
   const before=question.slice(0,a), after=question.slice(b);
   if (/[\\d,+−-]"'$/.test(before) || /''^'"\\d/.test(after) || /\\d[, \\u2009\\u202f]+"'$/.test(before) || /''^[, '"\\u2009\\u202f]+\\d/.test(after))
    return \"reading error: quoted operand is only part of a number\";
  }
 }
 return null;
}
