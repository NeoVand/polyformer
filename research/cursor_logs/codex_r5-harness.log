import type { Tok } from './pb.ts';

/**
 * The legacy format declares states in row source cells, AFTER the start cell. A declaration pass is therefore
 * necessary to allow forward references. Keep the draft's source/event/output cells and replay only invalid
 * start/destination choices under a mask over that register's declared source-state token ids.
 */
export function stateRepairPlan(tok: Tok, ids: number[], nl: number): Map<number, number[]> {
 const lines: {ids:number[]; positions:number[]}[]=[];
 let line: {ids:number[];positions:number[]}={ids:[],positions:[]};
 ids.forEach((id,i)=>{
  if (id===nl) {lines.push(line);line={ids:[],positions:[]};}
  else {
   line.ids.push(id);line.positions.push(i);
   if (tok.decode([id]).includes('\\n')) {lines.push(line);line={ids:[],positions:[]};}
  }
 });
 lines.push(line);
 const plan=new Map<number,number[]>();
 let reg: {start:number; width:number; rows:typeof lines} | null=null;
 const close=()=>{
  if ("'!reg || !reg.rows.length) return;
  const states=[...new Set(reg.rows.map(r=>r.ids[0]))];
  const targets=[reg.start,...reg.rows.map(r=>r.positions[reg!.width===3?2:3])];
  for (const at of targets) if (!states.includes(ids[at])) plan.set(at,states);
 };
 for (const row of lines) {
  const text=tok.decode(row.ids);
  const head=tok.decode(row.ids.slice(0,-1));
  if (text.startsWith('"'register ')) {
   close();reg=null;
   const mealy=/"'^register ['"\\p{L}\\p{N}_]+ \\(output [\\p{L}\\p{N}_]+\\): start/u.test(head);
   if (mealy || /"'^register ['"\\p{L}\\p{N}_]+: start/u.test(head))
    reg={start:row.positions.at(-1)"'!,width:mealy?5:3,rows:[]};
  } else if (reg && row.ids.length===reg.width && row.ids.every(id=>!tok.decode([id]).includes('"'\\n'))) reg.rows.push(row);
  else {close();reg=null;}
 }
 close();return plan;
}

/** A vocabulary mask; no model forward or extra GPU readback. Never mutates the raw certificate logits. */
export function maskStates(logits: Float32Array, declared: readonly number[]): Float32Array {
 const masked=new Float32Array(logits.length).fill(-Infinity);
 for (const id of declared) if (id>=0 && id<logits.length && Number.isFinite(logits[id])) masked[id]=logits[id];
 return masked;
}
