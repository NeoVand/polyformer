#"'!/usr/bin/env python3
"""Check result coverage and generate the final numerical summary (stdlib only)."""
import argparse
import hashlib
import json
import pathlib

HERE=pathlib.Path(__file__).resolve().parent

def number(x):return float('"'inf') if x=='infinity' else x

def candidate_gap(r):return max(number(g['forced_over_allowed']) for g in r['gaps'])

def main():
    ap=argparse.ArgumentParser();ap.add_argument('--partial',action='store_true');args=ap.parse_args()
    records=[]
    for kind,n in [('lean',10),('s5',20)]:
        for seed in range(n):
            f=HERE/f'results/{kind}_{seed}.json'
            if not f.exists():
                assert args.partial, f'missing {f}'
                continue
            d=json.loads(f.read_text())
            assert d['kind']==kind and d['seed']==seed and d['verdict']=='KILL_SEARCH'
            assert {(r['k'],r['power']) for r in d['results']}=={(k,p) for k in range(1,7) for p in (0.,-.5,.5)}
            assert len(d['results'])==18
            for r in d['results']:
                assert r['status']=='REJECT'
                assert number(r['radius_iteration'][-1][r['failed_state']])>r['caps'][r['failed_state']]
                assert candidate_gap(r)>1, 'need a multi-iterate gap report for this candidate'
                for g in r['gaps']:
                    assert 0<=g['accepted_input_radius']<=g['rejected_input_radius']
            records.append(d)
    print(f'Completed {len(records)}/30 checkpoints, {sum(len(d[\"results\"]) for d in records)}/540 shape/block candidates')
    summary={'verdict':'KILL' if len(records)==30 else 'IN_PROGRESS','checkpoints':len(records),'candidate_count':len(records)*18,
             'largest_certified_invariant_radius':0,'scope':'Specified centers, three Jacobian-derived shapes, sufficient Taylor inequalities and readout caps; not an impossibility theorem.'}
    for kind in ['lean','s5']:
        ds=[d for d in records if d['kind']==kind]
        if not ds:continue
        rows=[]
        for k in range(1,7):
            d,r=min(((d,r) for d in ds for r in d['results'] if r['k']==k),key=lambda pair:candidate_gap(pair[1]))
            g=max(r['gaps'],key=lambda g:number(g['forced_over_allowed']))
            row=dict(k=k,seed=d['seed'],power=r['power'],gap=candidate_gap(r),**g,
                     target_readout_cap=r['caps'][g['target']],source_readout_cap=r['caps'][g['source']],
                     block_jacobian_norm=r['block_jacobian_norm_upper'][g['source']],
                     landing_miss_metric=r['centre_miss_metric'][g['source']],
                     raw_return_miss_max=d['return_miss_max'],raw_selected_cell_caps=d['raw_cell_caps'],
                     linearized_subset=r['linearized_subset'])
            rows.append(row)
        summary[kind]=dict(checkpoints=len(ds),best_by_k=rows,best=min(rows,key=lambda r:r['gap']),
                           centre_readout_errors=sum(d['centre_readout_errors'] for d in ds),
                           linearized_feasible_candidates=sum(r['linearized_subset']=='feasible_subset' for d in ds for r in d['results']))
        print(kind, json.dumps(summary[kind]['best'],sort_keys=True))
    if not args.partial:
        summary['result_sha256']={f.name:hashlib.sha256(f.read_bytes()).hexdigest() for kind in ['lean','s5'] for f in sorted((HERE/'results').glob(f'{kind}_*.json'))}
        (HERE/'results/summary.json').write_text(json.dumps(summary,indent=2,allow_nan=False)+'\\n')
        print('All coverage and rejection checks passed; wrote results/summary.json')

if __name__=='__main__':main()
