def tree_classes(n_atoms, width):
    """Class table of tier 1: every tree over the first n_atoms atoms -> (its padded Polish token row, its class id).
    Returns (rows [C, width] int, lookup dict from the row's tuple to the id)."""
    trees = all_trees(ATOMS[:n_atoms])
    rows = np.array([encode_state(t, width) for t in trees], np.int16)
    return rows, {tuple(int(x) for x in r): i for i, r in enumerate(rows)}


def n_trees(n, n_ops=2):
    """The number of trees over n distinct atoms: Catalan(n - 1) shapes x n! leaf orders x n_ops^(n - 1)."""
    return math.comb(2 * (n - 1), n - 1) // n * math.factorial(n) * n_ops ** (n - 1)


