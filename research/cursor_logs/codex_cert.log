def on_sphere(c, u, r):
    """a point of the sphere |w| = R at distance r from c along the tangent direction u (unit, tangent at c)."""
    th = 2 * np.arcsin(np.minimum(r / (2 * R), 1.0))
    return c * np.cos(th)[:, None] + R * u * np.sin(th)[:, None] - c


