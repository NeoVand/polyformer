import lean_chains as lc  # noqa: E402
import validation_models as vm  # noqa: E402
import validation_run as vr  # noqa: E402

ROOT = pathlib.Path(__file__).parent
OUT = ROOT / "results" / "lean_s1"
DATA = OUT / "data"
PARTNER_OFFSET = 10_000
PAD = lc.TOK["PAD"]
EXPR_TOK = 2                    # UNIFY block H: the first token of an expression event (lean_chains.encode_expr_event)
DEC = lc.TOK["DEC"]


@dataclass
class Cfg:
    model: str = "rec"
    head: str = "dec"           # dec: the autoregressive decoder; cls: one class per tree of tier 1's finite state space;
                                # pos: a linear position-wise probe of LayerNorm(state), one softmax per token of the Polish string
    n_cls: int = 0
    d: int = 128
    heads: int = 4
    mlp_mult: int = 4
    ticks: int = 4              # rec: applications of the shared block per event
    layers: int = 4             # tf: causal blocks over events
    dec_layers: int = 2
    vocab: int = lc.VOCAB
    L: int = 12                 # tokens per event
    width: int = 11             # tokens per decoded state
    nl_hidden: int = 0          # NextLat latent dynamics MLP hidden size (0: no NextLat parameters)
    fixed_norm: bool = False    # rec (LEAN_S 2.10, the ablation's closure): the slot rescaled to norm sqrt(d) after every event
    centred_norm: bool = False  # rec (LEAN_S 2.11, review 2 A1): the slot centred and rescaled, h <- sqrt(d) (h - mean h) / |h - mean h|


# ----------------------------------------------------------------------------- parameters
def init(key, cfg):
    import jax
    ks = iter(jax.random.split(key, 16 + 4 * (cfg.layers + cfg.dec_layers)))
    d = cfg.d
    p = {"emb": jax.random.normal(next(ks), (cfg.vocab, d)) * 0.5, "pos": jax.random.normal(next(ks), (cfg.L, d)) * 0.5, "ln_e": vm.ln_init(d),
         "xattn": vm.attn_init(next(ks), d, cfg.heads), "lnf": vm.ln_init(d)}
    if cfg.model == "rec":
        p.update({"w0": jax.random.normal(next(ks), (d,)) * 0.5, "ln_w": vm.ln_init(d), "ln2": vm.ln_init(d),
                  "mlp": vm.mlp_init(next(ks), d, cfg.mlp_mult, 0.5)})
    elif cfg.model == "tf":
        p["q0"] = jax.random.normal(next(ks), (d,)) * 0.5
        p["layers"] = [{"ln1": vm.ln_init(d), "attn": vm.attn_init(next(ks), d, cfg.heads), "ln2": vm.ln_init(d),
                        "mlp": vm.mlp_init(next(ks), d, cfg.mlp_mult, 0.5)} for _ in range(cfg.layers)]
    else:
        raise ValueError(cfg.model)
    if cfg.head == "cls":
        p["cls"] = vm.dense(next(ks), d, cfg.n_cls)       # the S5-style readout: a linear probe of LayerNorm(state) over the trees
    elif cfg.head == "pos":
        p["pos_head"] = vm.dense(next(ks), d, cfg.width * cfg.vocab)   # linear, factorised over positions: cannot amplify tiny differences
    else:
        p["dec"] = {"emb": jax.random.normal(next(ks), (cfg.vocab, d)) * 0.5, "pos": jax.random.normal(next(ks), (cfg.width, d)) * 0.5,
                    "cond": vm.dense(next(ks), d, d), "lnf": vm.ln_init(d), "head": vm.dense(next(ks), d, cfg.vocab),
                    "layers": [{"ln1": vm.ln_init(d), "attn": vm.attn_init(next(ks), d, cfg.heads), "ln2": vm.ln_init(d),
                                "mlp": vm.mlp_init(next(ks), d, cfg.mlp_mult, 0.5)} for _ in range(cfg.dec_layers)]}
    if cfg.nl_hidden > 0:
        # the latent dynamics model of NextLat (reference: NextLatDynamicsModel; Linear layers without bias, N(0, 0.02));
        # drawn from a folded key so that every other parameter equals the base arm's on the same seed
        k1, k2, k3 = jax.random.split(jax.random.fold_in(key, 7919), 3)
        H = cfg.nl_hidden
        p["nl"] = {"ln": vm.ln_init(2 * d), "w1": jax.random.normal(k1, (2 * d, H)) * 0.02, "w2": jax.random.normal(k2, (H, H)) * 0.02,
                   "w3": jax.random.normal(k3, (H, d)) * 0.02}
    return p


# ----------------------------------------------------------------------------- encoders
def event_tokens(p, cfg, ev):
    """ev [..., L] int -> (x [..., L, d], mask [..., L]): token features of an event; PAD tokens are masked out of
    the cross-attention except the first (the event's marker, so that an all-PAD event still has one key)."""
    import jax.numpy as jnp
    x = vm.ln(p["ln_e"], p["emb"][ev] + p["pos"])
    mask = (ev != PAD) | (jnp.arange(ev.shape[-1]) == 0)
    return x, mask


def kv(p, x, heads):
    """x [B, N, d] -> k, v [B, h, N, dh]."""
    B, N, d = x.shape
    dh = d // heads
    k = vm.lin(p["k"], x).reshape(B, N, heads, dh).transpose(0, 2, 1, 3)
    v = vm.lin(p["v"], x).reshape(B, N, heads, dh).transpose(0, 2, 1, 3)
    return k, v


def attend(p, q_in, k, v, mask, heads):
    """q_in [B, d] against cached keys/values [B, h, N, dh], mask [B, N] -> [B, d]."""
    import jax
    import jax.numpy as jnp
    B, d = q_in.shape
    dh = d // heads
    q = vm.lin(p["q"], q_in).reshape(B, heads, 1, dh)
    s = jnp.einsum("bhmc,bhnc->bhmn", q, k) / math.sqrt(dh)
    s = jnp.where(mask[:, None, None, :], s, -1e9)
    y = jnp.einsum("bhmn,bhnc->bhmc", jax.nn.softmax(s, -1), v)
    return vm.lin(p["o"], y.reshape(B, d))


def rec_forward(p, cfg, ev):
    """ev [B, E, L] -> states [B, E, d]: the slot after every event (the readout reads ln(lnf, state))."""
    import jax
    import jax.numpy as jnp
    B = ev.shape[0]
    w0 = jnp.broadcast_to(p["w0"], (B, cfg.d))

    def step(w, ev_t):
        x, mask = event_tokens(p, cfg, ev_t)                   # [B, L, d]
        k, v = kv(p["xattn"], x, cfg.heads)
        for _ in range(cfg.ticks):
            w = w + attend(p["xattn"], vm.ln(p["ln_w"], w), k, v, mask, cfg.heads)
            w = w + vm.mlp(p["mlp"], vm.ln(p["ln2"], w))
        if cfg.fixed_norm:
            w = w * (math.sqrt(cfg.d) / jnp.maximum(jnp.linalg.norm(w, axis=-1, keepdims=True), 1e-6))
        if cfg.centred_norm:
            c = w - w.mean(-1, keepdims=True)
            w = c * (math.sqrt(cfg.d) / jnp.maximum(jnp.linalg.norm(c, axis=-1, keepdims=True), 1e-6))
        return w, w

    _, ws = jax.lax.scan(step, w0, jnp.moveaxis(ev, 0, 1))
    return jnp.moveaxis(ws, 0, 1)


def rec_step(p, cfg, w, ev_t):
    """UNIFY: one event of the recurrence from the raw slot w [B, d] (ticks, then the arm's closure), as rec_forward."""
    import jax.numpy as jnp
    x, mask = event_tokens(p, cfg, ev_t)
    k, v = kv(p["xattn"], x, cfg.heads)
    for _ in range(cfg.ticks):
        w = w + attend(p["xattn"], vm.ln(p["ln_w"], w), k, v, mask, cfg.heads)
        w = w + vm.mlp(p["mlp"], vm.ln(p["ln2"], w))
    return closure(cfg, w)


def closure(cfg, w):
    import jax.numpy as jnp
    if cfg.fixed_norm:
        w = w * (math.sqrt(cfg.d) / jnp.maximum(jnp.linalg.norm(w, axis=-1, keepdims=True), 1e-6))
    if cfg.centred_norm:
        c = w - w.mean(-1, keepdims=True)
        w = c * (math.sqrt(cfg.d) / jnp.maximum(jnp.linalg.norm(c, axis=-1, keepdims=True), 1e-6))
def load_params(path, cfg):
    """THEORY_DEEP's loader (one array per leaf, named by key path)."""
    import jax
    import jax.numpy as jnp
    like = init(jax.random.PRNGKey(0), cfg)
    flat, tree = jax.tree_util.tree_flatten_with_path(like)
    z = np.load(path)
    leaves = []
    for kk, v in flat:
        arr = z[jax.tree_util.keystr(kk)]
        if arr.shape != v.shape:
            raise ValueError(f"{jax.tree_util.keystr(kk)}: saved shape {arr.shape} != {v.shape}")
        leaves.append(jnp.asarray(arr))
    if len(z.files) != len(leaves):
        raise ValueError("saved parameters have leaves the configuration does not")
    return jax.tree_util.tree_unflatten(tree, leaves)


def tf_forward(p, cfg, ev):
def build(a, data, meta):
    import jax
    import jax.numpy as jnp
    a = with_defaults(a)
    if a.nextlat > 0 and a.model != "rec":
        raise ValueError("NextLat is run on the recurrence here")
    cfg = Cfg(model=a.model, head=a.head, d=a.d, heads=a.heads, mlp_mult=4, ticks=a.ticks, layers=a.layers, dec_layers=a.dec_layers, L=meta["L"], width=meta["width"],
              nl_hidden=nl_hidden(a), fixed_norm=bool(a.fixed_norm), centred_norm=bool(a.centred_norm))
    if (a.fixed_norm or a.centred_norm) and a.model != "rec":
        raise ValueError("--fixed_norm / --centred_norm close the recurrence's slot")
    if a.fixed_norm and a.centred_norm:
        raise ValueError("one closure at a time")
    tr = data["train"]
    classes = None
    if a.head == "cls":
        if meta["config"]["tier"] != 1:
            raise ValueError("the classification head enumerates tier 1's finite state space only")
        rows, lookup = lc.tree_classes(meta["config"]["n_atoms"], meta["width"])
        cfg.n_cls = len(rows)
        classes = lambda tg: np.array([[lookup[tuple(int(x) for x in row)] if int(row[0]) != PAD else 0 for row in seq] for seq in tg], np.int32)
        tr = dict(tr)
        tr["classes"] = classes(tr["targets"])
    params = init(jax.random.PRNGKey(a.seed), cfg)
    N = tr["events"].shape[0]
    K = tr["p_events"].shape[1]
    use_inv = a.mu > 0
    use_nl = a.nextlat > 0
"""
Runs the arms of INVARIANCE.md (the invariance term of EXACTNESS.md on the S5 word problem over events) and
writes one JSON per run to research/results/invariance/; `plot` draws the figures, the tables and the verdicts
from every record present.

    uv run --no-project --with "jax[cpu]" --with optax --with numpy python research/invariance_run.py run --model k1 --seed 0        # base
    ... run --model k1 --pair reduced --mu 1 --seed 0                                                                               # the term
    ... run --model k1 --pair random --mu 1 | --pair distract --mu 1 | --pair every --mu 1 | --pair reduced --mu 1 --dist cos
    ... run --model ortho --ds 5 [--pair reduced --mu 1]                                                                            # ENERGY E2's state
    ... run --model k1 --pair reduced --mu 1 --e_train 8                                                                            # the brave variant
    ... plot

Registered settings are the defaults (4000 steps, batch 64, d = 128, lr 1e-3, trained at e <= 16, the schedule of
VALIDATION V2 and SELFSTATE S2; with mu = 0 the base arm is S2's base arm bit for bit, test_invariance.py); other
values are tagged "unregistered". Evaluation: 512 fixed sequences at e in {16, 32, 64, 256} (V2's sets, seed 777 + e)
plus e = 1024 (reported only); the held-out invariance distance on fresh pairs (seed 4242 + e); the per-event
invariance distance along e = 256 against the canonical word of every prefix's product.
"""

import argparse
import json
import math
import pathlib
import sys
import time

import numpy as np

sys.path.insert(0, str(pathlib.Path(__file__).parent))
import groups  # noqa: E402
import invariance as inv  # noqa: E402
import validation_run as vr  # noqa: E402
import validation_tasks as vt  # noqa: E402

OUT = pathlib.Path(__file__).parent / "results" / "unify_s5"
EVAL_SEED = 777                 # V2's and S2's accuracy sets, identical sequences
PAIR_SEED = 4242                # held-out pairs for the invariance distance
PARTNER_OFFSET = 10_000         # the partner stream's rng; the main stream stays S2's
TUBE_OFFSET = 20_000            # UNIFY: the tube term's stream (positions and noise); unused by every earlier arm
KICK_SEED = 5151                # UNIFY: the kick-decay probe's sequences and directions
E_EVAL = (16, 32, 64, 256, 1024)
N_EVAL = 512
L = 4


def arm_name(a):
    ns = getattr(a, "ns", 0.0)
    if a.model == "k1":
        name = ("base" if ns <= 0 else f"ns{ns:g}") if a.mu <= 0 else f"inv_{a.pair}_m{a.mu:g}"
    else:
        name = f"ortho{a.ds}" + ("" if a.mu <= 0 else f"_inv_{a.pair}_m{a.mu:g}")
    if a.mu > 0 and a.dist == "cos":
        name += "_cos"
    if a.mu > 0 and a.mu_warmup > 0:
        name += f"_w{a.mu_warmup}"
        if a.mu_delay > 0:
            name += f"_d{a.mu_delay}"
    if a.mu > 0 and ns > 0:
        name += f"_ns{ns:g}"
    if ns > 0 and getattr(a, "ns_kl", -1.0) >= 0 and a.ns_kl != ns:
        name += f"_k{a.ns_kl:g}"
    if getattr(a, "rms", 0) and a.model == "k1":
        name += "_rms"
    if getattr(a, "rmsc", 0) and a.model == "k1":
        name += "_rmsc"
    if a.e_train != 16:
        name += f"_e{a.e_train}"
    if getattr(a, "tube_k", 0) > 0:                                     # UNIFY: the contraction part of the tube term
        name += f"_{'aim' if getattr(a, 'tube_aim', 0) else 'tube'}{a.tube_k}s{a.tube_sigma:g}m{a.tube_mu:g}"
    if getattr(a, "ns_sg_event", 0) and ns > 0:
        name += "_nssgev"
    if getattr(a, "synonyms", 0) > 0:
        name += f"_syn{a.synonyms}"
    if getattr(a, "ns_hidden", 0) and ns > 0 and a.ns_hidden != inv.NS_HIDDEN:
        name += f"_nsh{a.ns_hidden}"
    return name


def ns_kl_of(a):
    ns = getattr(a, "ns", 0.0)
    return (ns if getattr(a, "ns_kl", -1.0) < 0 else a.ns_kl) if ns > 0 else 0.0


def registered(a):
    return a.steps == 4000 and a.batch == 64 and a.d == 128 and a.lr == 1e-3 and a.a_scale == 0.1 and not a.tag


def build(a):
    """The model, its parameters, a forward (logits, flat states), the loss and the batch stream of one arm."""
    import jax
    import jax.numpy as jnp
    import validation_models as vm
    vocab = vt.v2_vocab()
    if a.model == "k1":
        cfg = vm.K1Config(d=a.d, vocab=vocab, L=L, n_cls=120)
        params = vm.k1_init(jax.random.PRNGKey(a.seed), cfg)
        if getattr(a, "ns", 0.0) > 0:                                        # review R1: next-state prediction
            params["ns"] = inv.ns_init(jax.random.PRNGKey(a.seed), a.d, hidden=getattr(a, "ns_hidden", 0) or inv.NS_HIDDEN)   # UNIFY B': hidden size

        if getattr(a, "rmsc", 0) and getattr(a, "rms", 0):
            raise ValueError("--rms and --rmsc are exclusive")

        def forward(p, tok):
            if getattr(a, "rmsc", 0):                                                           # second review A1: centred sphere
                return inv.k1_forward_centred(p, cfg, tok, return_state=True)
            return vm.k1_forward(p, cfg, tok, rms=bool(getattr(a, "rms", 0)), return_state=True)   # review R2: fixed norm sqrt(d)
    else:
        cfg = inv.OrthoConfig(d=a.d, vocab=vocab, L=L, ds=a.ds, a_scale=a.a_scale)
        params = inv.ortho_init(jax.random.PRNGKey(a.seed), cfg)

        def forward(p, tok):
            lg, Q = inv.ortho_forward(p, cfg, tok, return_state=True)
            return lg, Q.reshape(Q.shape[0], Q.shape[1], -1)

    def closure(w):
        if a.model != "k1":
            return w
        if getattr(a, "rmsc", 0):
            return inv.centred_sphere(w)
        if getattr(a, "rms", 0):
            return w * math.sqrt(cfg.d) / jnp.maximum(jnp.linalg.norm(w, axis=-1, keepdims=True), 1e-6)
        return w

    def tick(p, w, ev_t):                                                # one event, with the arm's closure (K1 only)
        return closure(vm.k1_tick(p, cfg, w, ev_t))

    tube_k = getattr(a, "tube_k", 0)

    def perturb(h, xi, sigma):
        """h [B, d] raw states, xi [B, d] Gaussian: move the view by a chord of about sigma along a random direction
        tangent to the centred sphere at h (centred, orthogonal to the centred h), then apply the arm's closure."""
        c = h - h.mean(-1, keepdims=True)
        nc = jnp.linalg.norm(c, axis=-1, keepdims=True)
        chat = c / jnp.maximum(nc, 1e-6)
        xc = xi - xi.mean(-1, keepdims=True)
        xp = xc - (xc * chat).sum(-1, keepdims=True) * chat
        xp = xp / jnp.maximum(jnp.linalg.norm(xp, axis=-1, keepdims=True), 1e-6)
        return closure(h + sigma * nc * xp)

    def aim_dirs(p, tok, hs, xi):
        """UNIFY block K: the top Lyapunov direction along each training trajectory, by power iteration of the tangent map
        (jvp of one closed event) from a random tangent start; parameters and states stop-gradient. Returns [e, B, d]: the
        unit direction at the state after each event."""
        ps = jax.lax.stop_gradient(p)
        ev = vm.events_of(tok, L)
"""
Models for the validation ladder (VALIDATION.md). JAX, CPU, d = 32-128.

    Transformer (fixed depth; loops > 1 gives K0, the synchronous looped control)   tf_init / tf_forward
    K2 energy-descent block (V4)                                                     k2_init / k2_forward
    K1 one-slot event workspace (V2)                                                 k1_init / k1_forward
    K1 m-slot workspace with hash routing for reachability (V3)                      reach_init / reach_forward
    K1 with PonderNet halting and a broadcast gate (V1)                              gk1_init / gk1_forward

Every parameter tree is a dict; every config a small dataclass. LayerNorm, RoPE and the MLP are shared.
"""

import math
from dataclasses import dataclass

import jax
import jax.numpy as jnp
import numpy as np


# ----------------------------------------------------------------------------- shared pieces
def dense(key, i, o, scale=1.0):
    return {"w": jax.random.normal(key, (i, o)) * scale / math.sqrt(i), "b": jnp.zeros(o)}


def lin(p, x):
    return x @ p["w"] + p["b"]


def ln_init(d):
    return {"g": jnp.ones(d), "b": jnp.zeros(d)}


def ln(p, x):
    mu = x.mean(-1, keepdims=True)
    var = ((x - mu) ** 2).mean(-1, keepdims=True)
    return (x - mu) / jnp.sqrt(var + 1e-5) * p["g"] + p["b"]


def mlp_init(key, d, mult=4, scale=1.0):
    k1, k2 = jax.random.split(key)
    return {"fc1": dense(k1, d, mult * d), "fc2": dense(k2, mult * d, d, scale)}


def mlp(p, x):
    return lin(p["fc2"], jax.nn.gelu(lin(p["fc1"], x)))


def rope(x, pos):
    """x: [..., T, dh], pos: [T] -> rotary embedding on pairs of channels."""
    dh = x.shape[-1]
    half = dh // 2
    freqs = 1.0 / (10000 ** (jnp.arange(half) / half))
    ang = pos[:, None] * freqs[None]                        # [T, half]
    c, s = jnp.cos(ang), jnp.sin(ang)
    x1, x2 = x[..., :half], x[..., half:]
    return jnp.concatenate([x1 * c - x2 * s, x1 * s + x2 * c], -1)


def attn_init(key, d, heads):
    ks = jax.random.split(key, 4)
    return {"q": dense(ks[0], d, d), "k": dense(ks[1], d, d), "v": dense(ks[2], d, d), "o": dense(ks[3], d, d, 0.5)}


def causal_attention(p, x, heads, use_rope=True):
    B, T, d = x.shape
    dh = d // heads
    split = lambda t: t.reshape(B, T, heads, dh).transpose(0, 2, 1, 3)
    q, k, v = split(lin(p["q"], x)), split(lin(p["k"], x)), split(lin(p["v"], x))
    if use_rope:
        pos = jnp.arange(T).astype(jnp.float32)
        q, k = rope(q, pos), rope(k, pos)
    s = jnp.einsum("bhic,bhjc->bhij", q, k) / math.sqrt(dh)
    s = jnp.where(jnp.tril(jnp.ones((T, T), bool)), s, -1e9)
    y = jnp.einsum("bhij,bhjc->bhic", jax.nn.softmax(s, -1), v)
    return lin(p["o"], y.transpose(0, 2, 1, 3).reshape(B, T, d))


def cross_attention(p, q_in, kv_in, heads, kv_mask=None):
    """q_in: [B, M, d] queries, kv_in: [B, N, d] keys/values, kv_mask: [B, N] (1 = attend)."""
    B, M, d = q_in.shape
    N = kv_in.shape[1]
    dh = d // heads
    q = lin(p["q"], q_in).reshape(B, M, heads, dh).transpose(0, 2, 1, 3)
    k = lin(p["k"], kv_in).reshape(B, N, heads, dh).transpose(0, 2, 1, 3)
    v = lin(p["v"], kv_in).reshape(B, N, heads, dh).transpose(0, 2, 1, 3)
    s = jnp.einsum("bhmc,bhnc->bhmn", q, k) / math.sqrt(dh)
    if kv_mask is not None:
        s = jnp.where(kv_mask[:, None, None, :] > 0, s, -1e9)
    y = jnp.einsum("bhmn,bhnc->bhmc", jax.nn.softmax(s, -1), v)
    return lin(p["o"], y.transpose(0, 2, 1, 3).reshape(B, M, d))


# ----------------------------------------------------------------------------- transformer (fixed, K0)
@dataclass
class TransformerConfig:
    d: int = 128
    vocab: int = 32
    layers: int = 2
    heads: int = 4
    n_cls: int = 120
    loops: int = 1              # > 1: the synchronous looped control K0 (shared weights, input injection)
    mlp_mult: int = 4
    rope: bool = True


def tf_init(key, cfg):
    ks = iter(jax.random.split(key, 4 + 4 * cfg.layers))
    p = {"emb": jax.random.normal(next(ks), (cfg.vocab, cfg.d)) * 0.5, "lnf": ln_init(cfg.d),
         "head": dense(next(ks), cfg.d, cfg.n_cls), "layers": []}
    for _ in range(cfg.layers):
        p["layers"].append({"ln1": ln_init(cfg.d), "attn": attn_init(next(ks), cfg.d, cfg.heads),
                            "ln2": ln_init(cfg.d), "mlp": mlp_init(next(ks), cfg.d, cfg.mlp_mult, 0.5)})
    return p


def tf_forward(p, cfg, tok, return_hidden=False, hidden_layer=None):
    """return_hidden also returns the residual state: after every block (pre-readout) by default, or after
    hidden_layer blocks (SELFSTATE.md's layer ablation; counted through the loops)."""
    x0 = p["emb"][tok]
    x = x0
    captured, n = None, 0
    for loop in range(cfg.loops):
        if loop > 0:
            x = x + x0                                      # input injection
        for L in p["layers"]:
            x = x + causal_attention(L["attn"], ln(L["ln1"], x), cfg.heads, cfg.rope)
            x = x + mlp(L["mlp"], ln(L["ln2"], x))
            n += 1
            if hidden_layer is not None and n == hidden_layer:
                captured = x
    logits = lin(p["head"], ln(p["lnf"], x))
    return (logits, x if captured is None else captured) if return_hidden else logits


def tf_flops_per_token(cfg, T):
    """Forward multiply-adds per token (attention over T/2 keys on average)."""
    d = cfg.d
    per_layer = 4 * d * d + 2 * cfg.mlp_mult * d * d + 2 * (T / 2) * d
    return cfg.loops * cfg.layers * per_layer + d * cfg.n_cls


# ----------------------------------------------------------------------------- K2: energy descent (V4)
@dataclass
class K2Config:
    d: int = 64
    vocab: int = 13
    heads: int = 4
    n_pat: int = 4              # stored patterns (hypotheses)
    n_hid: int = 32             # softplus units of the MLP energy
    eta: float = 0.2            # descent step
    steps_train: int = 8        # unrolled steps per token in training
    cap: int = 32               # step cap at evaluation
    eps_rel: float = 0.02       # stop when ||grad E|| <= eps_rel * sqrt(d)
    F: str = "exp"              # "exp": log-sum-exp (modern Hopfield); "cubic": rectified x^3, descent projected onto the ball ||h|| <= sqrt(d)
    n_cls: int = 2


def k2_init(key, cfg):
    ks = iter(jax.random.split(key, 12))
    d = cfg.d
    return {"emb": jax.random.normal(next(ks), (cfg.vocab, d)) * 0.5, "ln1": ln_init(d),
            "attn": attn_init(next(ks), d, cfg.heads),
            "energy": {"xi": jax.random.normal(next(ks), (cfg.n_pat, d)) / math.sqrt(d),
                       "log_beta": jnp.log(jnp.array(2.0)),
                       "W": jax.random.normal(next(ks), (d, d)) / math.sqrt(d),
                       "a": jax.random.normal(next(ks), (cfg.n_hid, d)) / math.sqrt(d) * 0.5,
                       "b": jnp.zeros(cfg.n_hid)},
            "lnh": ln_init(d), "head": dense(next(ks), d, cfg.n_cls)}


def k2_energy(e, h, c, cfg):
    """E(h; c) = -F-term(Xi h) + 1/2 ||h - W c||^2 + sum_u softplus(a_u . h + b_u); h, c: [B, d] -> [B]."""
    logits = h @ e["xi"].T                                  # [B, n_pat]
    if cfg.F == "exp":
        beta = jnp.exp(e["log_beta"])
        mem = -jax.scipy.special.logsumexp(beta * logits, -1) / beta
    else:
        mem = -(jax.nn.relu(logits) ** 3).sum(-1) / 3                # bounded below on the ball (amendment A2)
    quad = 0.5 * ((h - c @ e["W"]) ** 2).sum(-1)
    unit = jax.nn.softplus(h @ e["a"].T + e["b"]).sum(-1)
    return mem + quad + unit


def k2_grad(e, h, c, cfg):
    return jax.grad(lambda hh: k2_energy(e, hh, c, cfg).sum())(h)


def k2_project(h, cfg):
    """Identity for F = exp; for F = cubic the projection onto the ball ||h|| <= sqrt(d)."""
    if cfg.F != "cubic":
        return h
    r = math.sqrt(cfg.d)
    nrm = jnp.linalg.norm(h, axis=-1, keepdims=True)
    return h * jnp.minimum(1.0, r / jnp.maximum(nrm, 1e-9))


def k2_step(e, h, c, cfg):
    return k2_project(h - cfg.eta * k2_grad(e, h, c, cfg), cfg)


def k2_stationarity(e, h, c, cfg):
    """||grad E|| for F = exp; the projected-gradient norm ||h - P(h - eta grad E)|| / eta for F = cubic."""
    if cfg.F != "cubic":
        return jnp.linalg.norm(k2_grad(e, h, c, cfg), axis=-1)
    return jnp.linalg.norm(h - k2_step(e, h, c, cfg), axis=-1) / cfg.eta


def k2_context(p, cfg, tok):
    """The context vector per position: token embedding plus one causal attention layer (the fast stream)."""
    x = p["emb"][tok]
    return x + causal_attention(p["attn"], ln(p["ln1"], x), cfg.heads)


def k2_descend_fixed(e, h, c, cfg, steps):
    def body(_, hh):
        return k2_step(e, hh, c, cfg)
    return jax.lax.fori_loop(0, steps, body, h)



