        trajectories.append(tr)
    results=[]
    for k in range(1,7):
        trs=[tr[k-1] for tr in trajectories]
        dest=[0] if len(states)==1 else ([1,0] if k%2 else [0,1])
        for power in (0.,-0.5,0.5):
            progress(f'{label}: k={k}, shape power={power}, continuous radius search')
            result=trial(v,trs,c[states],auto['rows'][states],dest,power)
            result['k']=k;results.append(result)
            progress(f\"{label}: k={k}, shape={power}: {result['status']}\")
            if result['status']"'!='"'REJECT':
                # Never turn subset survival into PASS or a complete-search KILL.
                raise RuntimeError('Candidate survives rejection phase; universal expansion required')
    decoded=np.asarray(logits(c)).argmax(-1)
    rec=dict(kind=kind,seed=seed,checkpoint=provenance,verdict='KILL_SEARCH',states=len(c),
             selected_states=states,selected_events=root[states].tolist(),selected_target_states=tgt[states].tolist(),
             selected_centres=c[states].tolist(),centre_readout_errors=int(np.any(decoded"'!=auto['"'rows'],axis=-1).sum()),
             entry_offset_max=float(np.linalg.norm(h0-c,axis=1).max()),
             return_miss_max=float(residual.max()),return_miss_median=float(np.median(residual)),
             selected_one_event_miss=np.linalg.norm(f[states]-c[tgt[states]],axis=-1).tolist(),
             raw_cell_caps=[v.cell(c[s],auto['rows'][s],mat(np.eye(v.d)))[0] for s in states],
             results=results,elapsed_seconds=time.monotonic()-T0)
    (HERE/f'results/{kind}_{seed}.json').write_text(json.dumps(rec,indent=2,allow_nan=False)+'\\n')
    return rec


def main():
    ap=argparse.ArgumentParser();ap.add_argument('--kind',choices=['lean','s5','all'],default='all');ap.add_argument('--seeds',type=int,nargs='*');ap.add_argument('--resume',action='store_true');args=ap.parse_args()
    threading.Thread(target=heartbeat,daemon=True).start()
    progress(f'CPU devices {jax.devices()}; niceness {os.getpriority(os.PRIO_PROCESS,0)}')
    assert all(d.platform=='cpu' for d in jax.devices())
    assert os.getpriority(os.PRIO_PROCESS,0)>=19
    progress('verifying global GELU derivative enclosures')
    gelu=verify_gelu_bounds();progress(f'GELU bound verified: {gelu}')
