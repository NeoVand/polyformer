#"'!/usr/bin/env python3
"""Registered CPU search. Run with run_search.sh; all outputs stay in CERT."""
import os
os.environ['"'JAX_PLATFORMS']='cpu'
os.environ['OPENBLAS_NUM_THREADS']='1'
os.environ['OMP_NUM_THREADS']='1'
os.environ['VECLIB_MAXIMUM_THREADS']='1'
os.environ['PYTHONDONTWRITEBYTECODE']='1'
import argparse
import hashlib
import json
import math
import pathlib
import platform
import threading
import time

import jax
import numpy as np
import scipy
import flint
from models import load, functions, automaton, centres
from verified import Verifier, mat, norm, frob, mid, upper, lower, arb, verify_gelu_bounds

HERE=pathlib.Path(__file__).resolve().parent
T0=time.monotonic();PHASE='startup'
def progress(s):
    global PHASE
    PHASE=s
    print(f'[{time.monotonic()-T0:8.1f}s] {s}',flush=True)
def heartbeat():
    while True:
        time.sleep(20)
        print(f'[{time.monotonic()-T0:8.1f}s] heartbeat: {PHASE}',flush=True)


def shape(J,power):
    if not power:return np.eye(J.ncols())
    a=mid(J);v,Q=np.linalg.eigh(np.eye(len(a))+a.T@a)
    axes=v**power;axes/=axes.max()
    return (Q*axes)@Q.T


def trial(v,trs,cs,rows,dest,power):
    Bs=[mat(shape(tr['J'],power)) for tr in trs]
    inv=[b.inv() for b in Bs]
    caps=[v.cell(c,row,B)[0] for c,row,B in zip(cs,rows,Bs)]
    bounds=[]
    for i,tr in enumerate(trs):
        t=dest[i]
        b=upper(frob(inv[t]*(tr['F']-mat(cs[t]))))
        g=upper(norm(inv[t]*tr['J']*Bs[i]))
        ni=upper(norm(inv[t]));profile=v.profile(tr,Bs[i])
        bounds.append((b,g,ni,profile))
    def rhs(i,r):
        b,g,ni,p=bounds[i]
        lo,hi=v.remainder(p,float(r))
        if not math.isfinite(lo):return math.inf,math.inf
        val=arb(b)+arb(g)*arb(float(r))+arb(ni)*arb(lo)
        # Lower endpoint supports monotone infeasibility; upper evaluation is independent.
        high=arb(b)+arb(g)*arb(float(r))+arb(ni)*arb(hi)
        return max(0.,lower(val)),upper(high)
    rs=np.zeros(len(trs));history=[];failed=None
    for iteration in range(128):
        nxt=rs.copy()
        for i,t in enumerate(dest):
            lo,_=rhs(i,rs[i]);nxt[t]=max(nxt[t],lo)
        history.append([float(r) if math.isfinite(r) else 'infinity' for r in nxt])
        bad=[i for i in range(len(rs)) if nxt[i]>caps[i]]
        if bad:
            failed=bad[0];break
        if np.max(abs(nxt-rs))<1e-12:
            return dict(status='SURVIVES_SUBSET',power=power,caps=caps,radii=nxt.tolist())
        rs=nxt
    if failed is None:return dict(status='UNRESOLVED',power=power)
    # Each incoming centre residual forces a radius already at the first monotone iterate.
    forced=np.zeros(len(trs))
    for i,t in enumerate(dest):forced[t]=max(forced[t],bounds[i][0])
    # Maximal per-edge source radius accepted against the target readout cap.
    # Separate brackets: low is accepted using an upper bound; high is rejected using a lower bound.
    gaps=[]
    for i,t in enumerate(dest):
        lo=0.;hi=caps[i]
        if bounds[i][0]>caps[t]:hi=0.
        else:
            for _ in range(32):
                test=(lo+hi)/2;a,b=rhs(i,test)
                if b<=caps[t]:lo=test
                elif a>caps[t]:hi=test
                else:raise ArithmeticError('radius bisection unresolved at 100 bits')
        gaps.append(dict(source=i,target=t,forced_radius=float(forced[i]),accepted_input_radius=lo,
                         rejected_input_radius=hi,forced_over_allowed=float(forced[i]/hi) if hi else 'infinity'))
    # Linearized relaxed feasibility is a diagnostic only.
    lin=np.zeros(len(trs));lin_status='not_converged'
