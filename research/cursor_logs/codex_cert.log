              arb_precision_bits=flint.ctx.prec,gelu=gelu,devices=[str(d) for d in jax.devices()],nice=os.getpriority(os.PRIO_PROCESS,0),
              source_sha256={p.name:hashlib.sha256(p.read_bytes()).hexdigest() for p in [HERE/'search.py',HERE/'verified.py',HERE/'models.py']})
    (HERE/'results/environment.json').write_text(json.dumps(meta,indent=2)+'\\n')
    for kind in (['lean','s5'] if args.kind=='all' else [args.kind]):
        for seed in (args.seeds if args.seeds is not None else range(10 if kind=='lean' else 20)):
