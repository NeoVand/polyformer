class K1Config:
    d: int = 128
    vocab: int = 28
    L: int = 4                  # tokens per event
    heads: int = 4
    n_cls: int = 120
    mlp_mult: int = 4


def k1_init(key, cfg):
    ks = iter(jax.random.split(key, 8))
    d = cfg.d
    return {"emb": jax.random.normal(next(ks), (cfg.vocab, d)) * 0.5, "pos": jax.random.normal(next(ks), (cfg.L, d)) * 0.5,
            "w0": jax.random.normal(next(ks), (d,)) * 0.5, "ln_w": ln_init(d), "ln_e": ln_init(d),
            "xattn": attn_init(next(ks), d, cfg.heads), "ln2": ln_init(d), "mlp": mlp_init(next(ks), d, cfg.mlp_mult, 0.5),
            "lnf": ln_init(d), "head": dense(next(ks), d, cfg.n_cls)}


def events_of(tok, L):
    """tok [B, 1 + e L] -> [B, e, L] (BOS dropped)."""
    B, T = tok.shape
    e = (T - 1) // L
    return tok[:, 1:1 + e * L].reshape(B, e, L)


def k1_tick(p, cfg, w, ev):
    """One application of the shared block: cross-attend from the slot to the event's tokens, then the MLP."""
    x = ln(p["ln_e"], p["emb"][ev] + p["pos"][None])      # [B, L, d]
    w = w + cross_attention(p["xattn"], ln(p["ln_w"], w)[:, None], x, cfg.heads)[:, 0]
    return w + mlp(p["mlp"], ln(p["ln2"], w))


def k1_forward(p, cfg, tok, rms=False, return_state=False):
    """rms: the carried state is projected to the sphere of radius sqrt(d) after every event (ENERGY E2's
    euclid_rms control). return_state also returns the slot state after every event [B, e, d] (SELFSTATE.md)."""
    ev = events_of(tok, cfg.L)                              # [B, e, L]
# ----------------------------------------------------------------------------- centred closure (second review, A1)
def centred_sphere(w, eps=1e-6):
    """h <- sqrt(d) (h - mean h) / ||h - mean h||: fixes both the mean (to 0) and the centred scale (to sqrt(d))."""
    import jax.numpy as jnp
    c = w - w.mean(-1, keepdims=True)
    return c * jnp.sqrt(w.shape[-1]) / jnp.maximum(jnp.linalg.norm(c, axis=-1, keepdims=True), eps)


def k1_forward_centred(p, cfg, tok, return_state=False):
    """validation_models.k1_forward with the carried slot projected to the centred sphere after every event."""
    import jax
    import jax.numpy as jnp
    ev = vm.events_of(tok, cfg.L)
    B = tok.shape[0]
    w0 = jnp.broadcast_to(p["w0"], (B, cfg.d))

    def step(w, ev_t):
        w = centred_sphere(vm.k1_tick(p, cfg, w, ev_t))
        return w, (vm.lin(p["head"], vm.ln(p["lnf"], w)), w)

    _, (logits, ws) = jax.lax.scan(step, w0, jnp.moveaxis(ev, 0, 1))
    logits = jnp.moveaxis(logits, 0, 1)
    return (logits, jnp.moveaxis(ws, 0, 1)) if return_state else logits
G = groups.get("S5")
GENS = vt.S5_GENS                       # element index of generator token g (0..9 transpositions, 10 identity)
N_GEN = vt.V2_NGEN
ID_GEN = N_GEN - 1                      # the identity token's generator index
MAX_LEN = 16
DIAMETER = 4                            # every element of S5 is a product of at most 4 transpositions


# ----------------------------------------------------------------------------- words, reduction, sampling
def bfs_distances():
    """[120] distance from the identity in the Cayley graph of the 10 transpositions (0 for the identity)."""
    dist = np.full(G.n, -1)
    dist[G.e] = 0
    frontier = [G.e]
    while frontier:
        nxt = []
        for x in frontier:
            for g in range(N_GEN - 1):
                y = G.mul[x, GENS[g]]
                if dist[y] < 0:
                    dist[y] = dist[x] + 1
                    nxt.append(y)
        frontier = nxt
    return dist


def canonical_words():
    """The canonical reduced word of every element: the lexicographically smallest shortest word over the 10
    transpositions, by enumeration in lexicographic order; the identity element gets the identity token.
    Returns (words [120, DIAMETER] padded with -1, lengths [120])."""
    words = np.full((G.n, DIAMETER), -1, np.int64)
    lengths = np.zeros(G.n, np.int64)
    words[G.e, 0], lengths[G.e] = ID_GEN, 1
    done = np.zeros(G.n, bool)
    done[G.e] = True
    for k in range(1, DIAMETER + 1):
        for w in itertools.product(range(N_GEN - 1), repeat=k):
            x = G.e
            for g in w:
                x = G.mul[x, GENS[g]]
            if not done[x]:
                done[x] = True
                words[x, :k], lengths[x] = w, k
        if done.all():
            break
    assert done.all()
    return words, lengths

# ----------------------------------------------------------------------------- V2: S5 over events
def s5_generators():
    """The 10 transpositions of S5 and the identity, as element indices of groups.get('S5')."""
    G = groups.get("S5")
    idx = {p: i for i, p in enumerate(G.perms)}
    gens = []
    for a, b in itertools.combinations(range(5), 2):
        p = list(range(5))
        p[a], p[b] = b, a
        gens.append(idx[tuple(p)])
    gens.append(G.e)
    return np.array(gens)


S5_GENS = s5_generators()
V2_BOS, V2_GEN0, V2_NGEN = 0, 1, len(S5_GENS)
V2_DISTRACT0 = V2_GEN0 + V2_NGEN


SYNONYMS = 0                    # UNIFY block D: > 0 writes each generator as one of SYNONYMS tokens (ids from SYN0), chosen per event


def syn0(n_distract=16):
    return V2_DISTRACT0 + n_distract


def gen_token(rng, gi):
    """The token of generator index gi: V2_GEN0 + gi, or with SYNONYMS one of its synonyms uniformly at random."""
    gi = np.asarray(gi)
    if SYNONYMS <= 0:
        return V2_GEN0 + gi
    return syn0() + gi * SYNONYMS + rng.integers(0, SYNONYMS, gi.shape)


def v2_vocab(n_distract=16):
    return V2_DISTRACT0 + n_distract + (V2_NGEN * SYNONYMS if SYNONYMS > 0 else 0)


def task_s5_events(rng, B, e, L=4, n_distract=16):
    """
    BOS, then e events of L tokens. Each event holds one generator token (uniform over the 10
    transpositions and the identity, token id 1 + index into S5_GENS) at a uniform position within the
    event and distractors (ids V2_DISTRACT0 + U[0, n_distract)) elsewhere. Label at the last token of
    event i (position i * L): the element index of g_1 g_2 ... g_i in groups.get('S5'). Returns tokens
    [B, 1 + e L], labels, mask (1 at event ends), and info with the generator indices [B, e] and the event
    of every position [B, 1 + e L] (-1 for BOS).
    """
    G = groups.get("S5")
    gi = rng.integers(0, V2_NGEN, (B, e))
    elements = S5_GENS[gi]
    prod = groups.prefix_products(G, elements)            # [B, e]
    T = 1 + e * L
    tok = V2_DISTRACT0 + rng.integers(0, n_distract, (B, T))
    tok[:, 0] = V2_BOS
    where = 1 + np.arange(e)[None] * L + rng.integers(0, L, (B, e))
    np.put_along_axis(tok, where, gen_token(rng, gi), 1)
    label = np.zeros((B, T), np.int32)
    ends = 1 + np.arange(e) * L + (L - 1)
    label[:, ends] = prod
    msk = np.zeros((B, T), np.float32)
    msk[:, ends] = 1
    event = np.concatenate([[-1], np.repeat(np.arange(e), L)])
    return tok, label, msk, {"gens": gi, "event": event, "ends": ends}


# ----------------------------------------------------------------------------- V3: reachability
def task_reach(rng, B, n=128, b_choices=(1, 2, 3, 4, 5, 6), D=3, b=None):
    """
    Random directed graphs on n nodes. Per graph b_max is uniform over b_choices (or fixed to b); every
    node has an out-degree uniform in {1, ..., b_max}, its out-neighbours distinct and other than itself
    (amendment A1 of VALIDATION.md: the earlier exact-degree version left the frontier sizes in four
    clumps). The edge list [B, n * max(b_choices), 2] is shuffled and padded with (n, n) rows (edge_mask 0).
"""
Certified rewrite chains over natural-number expressions: the generator, the rewrite engine and the Lean 4
certifier of LEAN_PLAN.md section 2 (stage one of the Lean program). Registration and results in LEAN_S1.md; the
runner is lean_run.py; checks in test_lean_chains.py. Importing this never runs Lean.

Expressions are full binary trees over a fixed multiset of distinct atoms (a..h) with the operations + and *,
written as nested tuples (op, left, right) with atoms as strings. The state after a step is the tree itself,
linearised in Polish (prefix) notation, which is a bijection between trees and token strings and keeps the tree's
own left-to-right order (nothing is normalised across commutativity or associativity: the state is the particular
tree). A rewrite step is one core Lean lemma at one explicit instance, with the semantics of Lean's `rw`: every
occurrence of the instantiated left-hand side in the expression is replaced (with distinct atoms there is exactly
one occurrence; after a distributivity step an atom can appear twice and the engine replicates `rw`):

    tier 1 (size-preserving)   Nat.add_comm x y, Nat.add_assoc x y z (and <-), Nat.mul_comm x y, Nat.mul_assoc x y z (and <-)
    tier 2 (changes size)      + Nat.left_distrib x y z (and <-), Nat.right_distrib x y z (and <-)

Every step is emitted as a Lean example and compiled by `lean` (core only, no mathlib, no imports), each as a named
theorem followed by `#print axioms`, so that a step counts as certified only on a positive confirmation that its proof
uses no axiom (a failed proof is admitted with sorryAx; Lean stops reporting errors after about 100 per file, so the
absence of an error is not read as success):

    example (a b c d e f : Nat) : e_k = e_{k+1} := by conv => lhs; rw [Nat.add_assoc a b c]

The rewrite is confined to the left-hand side (`conv => lhs`) because a plain `rw` on the equation rewrites both
sides, and in tier 2 that certifies a step that rewrote one of two occurrences (probed on Lean 4.35.0: with the goal
`a * (c + d) + b * (c + d) = a * (d + c) + b * (c + d)`, `rw [Nat.add_comm c d]` succeeds and `conv => lhs; rw` fails
as it should). A step whose example fails to compile is dropped and counted. Equivalent partners are different
certified chains that end at the same tree, built by a reverse random walk from the end tree (so the partner has its
own start expression and length), by a detour (comm; comm) or by swapping two adjacent steps at disjoint
positions; the equality of the end trees is certified by syntactic identity of the Polish strings and by a second
