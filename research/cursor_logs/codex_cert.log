| 0 | 0.273 / 0.902 | 0.945 / 1.383 | 0.237 / 0.267 | 0.332 | 0.000768 |
| 1 | 0.214 / 0.870 | 0.914 / 1.396 | 0.210 / 0.210 | 0.604 | 0.000498 |
