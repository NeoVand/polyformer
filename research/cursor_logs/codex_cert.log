lin_eq = np.array([grid[np.where(EPSG[e] <= An[e] * grid)[0].max()] if (EPSG[e] <= An[e] * grid).any() else 0.0 for e in range(NE)])
fin = np.array([grid[np.where(np.isfinite(EPSG[e]))[0].max()] if np.isfinite(EPSG[e]).any() else 0.0 for e in range(NE)])
summary.update({"rho_10pct_median": float(np.median(lin_ok)), "rho_10pct_min": float(lin_ok.min()), "rho_100pct_median": float(np.median(lin_eq)),
                "rho_finite_median": float(np.median(fin)), "rho_finite_max": float(fin.max())})
print(f"  sound remainder <= 10% of the linear term up to rho (raw): median {np.median(lin_ok):.3g}, min {lin_ok.min():.3g}; "
      f"<= 100% up to median {np.median(lin_eq):.3g}; finite up to median {np.median(fin):.3g}, max {fin.max():.3g}", flush=True)
