import os
os.environ['JAX_PLATFORMS']='cpu'
os.environ['OPENBLAS_NUM_THREADS']='1'
os.environ['VECLIB_MAXIMUM_THREADS']='1'
import sys
import numpy as np
import jax
import jax.numpy as jnp
from models import load,functions,automaton,ROOT
from verified import Verifier,mat,mid,norm,upper

kind=sys.argv[1]
p,_=load(kind,0);a=automaton(kind);step,_,_=functions(p,kind)
if kind=='lean':
    import lean_run as lr
    cfg=lr.Cfg(d=128,L=8,width=7,head='pos',fixed_norm=True)
    original=jax.jit(lambda x,ev:lr.rec_step(p,cfg,x[None],ev[None])[0])
else:
    import validation_models as vm
    import invariance as inv
    cfg=vm.K1Config()
    original=jax.jit(lambda x,ev:inv.centred_sphere(vm.k1_tick(p,cfg,x[None],ev[None]))[0])
ev=a['root_ev'][0];x=np.asarray(p['w0']);f=step(x,ev)
assert np.max(abs(f-original(x,ev)))<1e-12
print(kind,'original checkpoint recurrence agrees',flush=True)
v=Verifier(p,kind);tr=v.trajectory(x,[ev],print)[0]
assert np.max(abs(mid(tr['F']).ravel()-f))<1e-11
J=np.asarray(jax.jacfwd(step)(x,jnp.array(ev)))
assert np.max(abs(mid(tr['J'])-J))<1e-10
print(kind,'Arb recurrence and analytic Jacobian agree with independent JAX autodiff',flush=True)
# A non-normal matrix checks the SVD residual enclosure, not just a diagonal case.
A=np.array([[1,100,0],[0,1,100],[0,0,1.]])
assert upper(norm(mat(A)))>=np.linalg.norm(A,2)*(1-1e-14)
assert upper(norm(mat(A)))<np.linalg.norm(A,2)*(1+1e-10)
profile=v.profile(tr,mat(np.eye(128)));rng=np.random.default_rng(0)
for r in [1e-8,1e-6,1e-4]:
    lo,hi=v.remainder(profile,r)
    assert np.isfinite(hi)
    for _ in range(4):
        delta=rng.normal(size=128);delta*=r/np.linalg.norm(delta)
        rem=np.linalg.norm(np.asarray(step(x+delta,ev))-np.asarray(f)-J@delta)
        # Independent float64 replay cannot resolve remainders below its rounding error.
        assert rem<=hi+1e-12
    print(kind,'radius',r,'verified remainder enclosure',lo,hi,flush=True)
print(kind,'QA passed',flush=True)
