                block_jacobian_norm_upper=[b[1] for b in bounds],inverse_shape_norm_upper=[b[2] for b in bounds],
                radius_iteration=history,failed_state=failed,gaps=gaps,linearized_subset=lin_status)


def run(kind,seed):
    label=f'{kind} seed {seed}';progress(f'{label}: loading checkpoint')
    p,provenance=load(kind,seed);auto=automaton(kind)
    step,batch,logits=functions(p,kind)
    c,h0=centres(p,kind,auto,batch,lambda s:progress(f'{label}: {s}'))
