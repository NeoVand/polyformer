#"'!/usr/bin/env python3
"""Read-only inventory of the authorized original UNIFY artifacts."""
import argparse
import hashlib
import json
import pathlib

HERE=pathlib.Path(__file__).resolve().parent

def main():
    ap=argparse.ArgumentParser();ap.add_argument('"'--require-results',action='store_true');args=ap.parse_args()
    source=(HERE/'.local/unify').resolve(strict=True)
    inventory=[dict(path=str(p.relative_to(source)),bytes=p.stat().st_size) for p in sorted(source.rglob('*.npz'))]
    checked=[]
    for kind,count,arm in [('lean',10,'RI_aim3s0.1m10_fnp_a4x512'),('s5',20,'inv_random_m1_cos_rmsc_aim4s0.1m10')]:
        for seed in range(count):
            rel=f'{kind}/results/unify_{kind}/params/{arm}_s{seed}.npz'
            p=source/rel;digest=hashlib.sha256(p.read_bytes()).hexdigest()
            result=HERE/f'results/{kind}_{seed}.json'
            if args.require_results:assert result.exists(),result
            if result.exists():
                d=json.loads(result.read_text());assert d['checkpoint']['sha256']==digest
                assert pathlib.Path(d['checkpoint']['path'])==p
            metadata=HERE.parent/'unify'/kind/f'results/unify_{kind}/{arm}_s{seed}.json'
            m=json.loads(metadata.read_text())
            if kind=='lean':
                a=m['args'];assert a['ticks']==4 and a['heads']==4 and a['d']==128
                assert a['fixed_norm'] and not a['centred_norm'] and a['head']=='pos' and a['nextlat']==0
            else:
                assert m['d']==128 and m['rmsc'] and not m['rms'] and m['model']=='k1'
            checked.append(dict(kind=kind,seed=seed,path=rel,bytes=p.stat().st_size,sha256=digest,
                                metadata_sha256=hashlib.sha256(metadata.read_bytes()).hexdigest()))
            print(f'{kind} seed {seed}: fixed weights and model configuration checked',flush=True)
    out=dict(source=str(source),npz_count=len(inventory),npz_bytes=sum(f['bytes'] for f in inventory),
             used_checkpoints=checked,inventory=inventory,all_results_matched=args.require_results,
             data_note='Fresh deterministic centers avoid needing m2k.npz; no training archive is required by this search.')
    (HERE/'results/recovered_inputs.json').write_text(json.dumps(out,indent=2)+'\\n')
    print(f'{len(inventory)} NPZ files, {out[\"npz_bytes\"]} bytes; all 30 registered weights present; source read only',flush=True)

if __name__=='__main__':main()
