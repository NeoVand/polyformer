# ----------------------------------------------------------------------------- trees
def is_atom(t):
    return isinstance(t, str)


def leaves(t):
    return [t] if is_atom(t) else leaves(t[1]) + leaves(t[2])


def n_leaves(t):
    return 1 if is_atom(t) else n_leaves(t[1]) + n_leaves(t[2])


def depth(t):
    return 0 if is_atom(t) else 1 + max(depth(t[1]), depth(t[2]))


def polish(t):
    """The canonical linearisation: Polish (prefix) notation, a bijection between trees and token lists."""
    return [t] if is_atom(t) else [t[0]] + polish(t[1]) + polish(t[2])


def parse_polish(tokens):
    it = iter(tokens)

    def rec():
        tok = next(it)
        if tok in OPS:
            left = rec()
            right = rec()
            return (tok, left, right)
        return tok

    t = rec()
    rest = list(it)
    if rest:
        raise ValueError(f"trailing tokens {rest}")
    return t


def lean_str(t, top=True):
    """Fully parenthesised Lean syntax (the outer parentheses dropped at the top)."""
    if is_atom(t):
        return t
    s = f"{lean_str(t[1], False)} {t[0]} {lean_str(t[2], False)}"
    return s if top else f"({s})"

