def k1_flops_per_token(cfg):
    d, L = cfg.d, cfg.L
    per_event = (2 + 2 * L) * d * d + 2 * L * d + 2 * cfg.mlp_mult * d * d + d * cfg.n_cls
    return per_event / L


# ----------------------------------------------------------------------------- K1 m slots, hash routing (V3)
@dataclass
class ReachConfig:
    d: int = 64
    n: int = 128                # nodes
    m: int = 4                  # slots
    D: int = 3                  # iterations = hops
    heads: int = 4
    mlp_mult: int = 4


def reach_init(key, cfg):
    ks = iter(jax.random.split(key, 12))
    d = cfg.d
    return {"node": jax.random.normal(next(ks), (cfg.n + 1, d)) * 0.5, "slot_id": jax.random.normal(next(ks), (cfg.m, d)) * 0.5,
            "ln_in": ln_init(d), "w_in": dense(next(ks), d, d), "ln_w": ln_init(d), "ln_src": ln_init(d), "ln_dst": ln_init(d),
            "xattn": attn_init(next(ks), d, cfg.heads), "ln2": ln_init(d), "mlp": mlp_init(next(ks), d, cfg.mlp_mult, 0.5),
            "ln_q": ln_init(d), "w_t": dense(next(ks), d, d), "read": {"fc1": dense(next(ks), 3 * d, 4 * d), "fc2": dense(next(ks), 4 * d, 1)}}


def route_blocks(r):
    """r: [B, m_slots, m_hash, c] retrieved content per slot, split by target hash -> [B, m, c]: slot g
    receives every slot's block destined to hash g (the fixed, exact form of slot self-attention)."""
    return r.sum(1)


def reach_iteration(p, cfg, w, edges, emask):
    """w: [B, m, d]. Each slot queries the edge list with its own frontier; retrieved targets are routed to
    the slot of their hash (node id mod m); then the shared MLP."""
    B, m, d = w.shape
    heads, dh = cfg.heads, d // cfg.heads
    E = edges.shape[1]
    src = ln(p["ln_src"], p["node"][edges[..., 0]])       # [B, E, d]
    dst = ln(p["ln_dst"], p["node"][edges[..., 1]])
    a = p["xattn"]
    q = lin(a["q"], ln(p["ln_w"], w)).reshape(B, m, heads, dh).transpose(0, 2, 1, 3)       # [B, h, m, dh]
    k = lin(a["k"], src).reshape(B, E, heads, dh).transpose(0, 2, 1, 3)                    # [B, h, E, dh]
    v = lin(a["v"], dst).reshape(B, E, heads, dh).transpose(0, 2, 1, 3)
    s = jnp.einsum("bhmc,bhec->bhme", q, k) / math.sqrt(dh)
    s = jnp.where(emask[:, None, None, :] > 0, s, -1e9)
    A = jax.nn.softmax(s, -1) * (emask[:, None, None, :] > 0)
    hash_oh = jax.nn.one_hot(jnp.minimum(edges[..., 1], cfg.n) % m, m)                     # [B, E, m]
    r = jnp.einsum("bhme,beg,bhec->bmghc", A, hash_oh, v)                                   # [B, m, g, h, dh]
    routed = route_blocks(r).reshape(B, m, heads * dh)
    w = w + lin(a["o"], routed)
    return w + mlp(p["mlp"], ln(p["ln2"], w))


def reach_forward(p, cfg, edges, emask, s, t):
    B = edges.shape[0]
    m = cfg.m
    es = lin(p["w_in"], ln(p["ln_in"], p["node"][s]))                                      # [B, d]
    init_oh = jax.nn.one_hot(s % m, m)                                                      # [B, m]
    w = p["slot_id"][None] + init_oh[..., None] * es[:, None]
    for _ in range(cfg.D):
        w = reach_iteration(p, cfg, w, edges, emask)
    wt = w[jnp.arange(B), t % m]                                                            # [B, d]
    et = lin(p["w_t"], ln(p["ln_q"], p["node"][t]))
    feat = jnp.concatenate([wt, et, wt * et], -1)
    return lin(p["read"]["fc2"], jax.nn.gelu(lin(p["read"]["fc1"], feat)))[:, 0]


