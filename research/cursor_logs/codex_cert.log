    print(f"  sound block check at the smallest linear radii: {viol} of {len(Pth)} paths violate; worst bound / radius {worst:.3g}", flush=True)

# ---- (ii) empirical remainder: random and projected-gradient perturbations on the sphere at the needed radius
def one_event(w, e):
    x, mask = lr.event_tokens(params, cfg, e[None]); k, v = lr.kv(xa, x, H_); w = w[None]
    for _ in range(cfg.ticks):
        w = w + lr.attend(xa, vm.ln(params["ln_w"], w), k, v, mask, H_)
        w = w + vm.mlp(params["mlp"], vm.ln(params["ln2"], w))
    return (w * (R / jnp.linalg.norm(w, axis=-1, keepdims=True)))[0]


def rem_norm(delta, c, e, Jm):
    return jnp.linalg.norm(one_event(c + delta, e) - one_event(c, e) - Jm @ delta)


rem_v = jax.jit(jax.vmap(rem_norm)); rem_g = jax.jit(jax.vmap(jax.grad(rem_norm)))
