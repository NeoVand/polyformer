    Pth = pp["P"]
    # first event of every block, at the block's start radius: the remainder against the slack the linear bound leaves
    e1 = np.unique(Pth[:, 0])
    rem1 = eps_up(e1, rs[src[e1]]) + a_rad[e1] * rs[src[e1]] ** 2 / (2 * R)
    summary["first_event_remainder_over_r_median"] = float(np.median(rem1 / rs[src[e1]]))
    # the full block bound with remainders, suffix products bounded by their one-step norms (sound, loose)
    viol, worst = 0, 0.0
    for c0 in range(0, len(Pth), 2000):
        Pc = Pth[c0:c0 + 2000]; s0 = src[Pc[:, 0]]; r0 = rs[s0]
        Mv = np.zeros((len(Pc), d)); Tm = np.broadcast_to(np.eye(d), (len(Pc), d, d)).copy(); errs = np.zeros(len(Pc))
        rho = r0.copy()
        for j in range(KB):
            ej = Pc[:, j]
            err_j = eps_up(ej, rho) + a_rad[ej] * rho ** 2 / (2 * R)
            Mv = miss[ej] + np.einsum("kij,kj->ki", Aall[ej], Mv) if j else miss[ej].copy()
