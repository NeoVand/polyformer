import json,pathlib
from flint import arb,ctx
ctx.prec=768
min_overlap=arb(1);previous=None
for i in range(-16000,16000):
 z=arb((2*i+1)/2000,arb(1)/2000)
 assert z.lower()<=arb(i)/1000,(i,'left')
 assert z.upper()>=arb(i+1)/1000,(i,'right')
 if previous is not None:
  overlap=previous-z.lower()
  assert overlap>0
  if overlap<min_overlap:min_overlap=overlap
 previous=z.upper()
print('All 32000 Arb cells enclose their exact rational cells; minimum overlap:',min_overlap,flush=True)
p=pathlib.Path('research/cert/results/gelu_cover.json')
p.write_text(json.dumps(dict(cells=32000,precision_bits=ctx.prec,exact_rational_cell_inclusions=True,minimum_overlap_lower=str(min_overlap.lower()),reason='Arb outward radius rounding exceeds the midpoint float rounding; every exact rational cell is explicitly enclosed.'),indent=2)+'\\n')
