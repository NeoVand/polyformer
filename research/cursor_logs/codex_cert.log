rad_path = S / "results/unify_lean" / f"cert_radii_{ARM}_s{SEED}_k{KB}{TAG}.npy"
summary = {"arm": ARM, "seed": SEED, "k": KB, "Hf_att_median": float(np.median(Hf_att)), "subD_max": float(Dn.max())}
grid = np.geomspace(1e-8, 20, 100)
EPSG = np.stack([eps_of(r) for r in grid], 1)                              # [NE, grid]
print(f"  eps(rho) median over edges at rho = 1e-3, 1e-2, 0.1, 1 (raw): "
      + ", ".join(f"{np.median(EPSG[:, np.searchsorted(grid, r)]):.3g}" for r in (1e-3, 1e-2, 0.1, 1.0)) + f"; {time.time()-t0:.0f}s", flush=True)


def eps_up(e_idx, rho):
    """sound: eps at the next grid point at or above rho (eps is non-decreasing in rho)."""
    gi = np.searchsorted(grid, rho)
    out = np.full(len(e_idx), np.inf)
    ok = gi < len(grid)
    out[ok] = EPSG[e_idx[ok], gi[ok]]
    return out


