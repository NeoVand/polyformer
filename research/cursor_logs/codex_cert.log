"""UNIFY §9.4: sound remainder bounds (Taylor models through the sub-layers), an empirical remainder check, and interval bound
propagation (IBP) through one event, for the continuous certificate of cert_bounds.py. float64.

Per edge (class s, event x), along the centre's own trajectory through the 4 ticks (attention sub-layer, MLP sub-layer) and the
RMS closure, with deviation radius rho at the input:
  delta_{l+1} = D_l delta_l + R_l,  ||R_l|| <= 1/2 H_l(rho_l) rho_l^2,  rho_l <= ||L_l|| rho + e_l,  e_{l+1} = ||D_l|| e_l + 1/2 H_l rho_l^2,
with H_l a bound on the second derivative over the ball:
  layer norm nu(w) = sqrt(d) C w / sqrt(|C w|^2 + d eps):  |D nu| <= sqrt(d)/n_min, |D^2 nu[h,h]| <= (2/sqrt(3)) sqrt(d)/n_min^2 |h|^2;
  attention against the event's fixed keys and values: |D^2| <= sum_h range_h^2 nu_h / 2, |D| <= sum_h |U_c,h| |M_c,h| / 2;
  GELU MLP: |D^2| <= |W2| min(max g2 |W1^|^2, max_i(g2_i |w1_i|) |W1^|), |D| <= |W1^ diag(sqrt b)| |diag(sqrt b) W2|, with g2_i, b_i
  the sup of |gelu''|, |gelu'| over neuron i's pre-activation interval;
  closure R w/|w|: |D^2| <= (2/sqrt(3)) R/(|w| - rho)^2;
  composite sub-layer w + f(nu(w)): H = H_f L_nu^2 + L_f H_nu.
eps(rho) = e_final bounds |F(c + delta) - F(c) - J delta| for |delta| <= rho (raw ball, which contains the sphere's).

    python cert_sound.py <lean dir> <ARM> <SEED> <K>
"""
import json, sys, time, math, pathlib, argparse
import numpy as np
S = pathlib.Path(sys.argv[1]); ARM = sys.argv[2]; SEED = int(sys.argv[3]); KB = int(sys.argv[4])
TAG = f"_ref{sys.argv[5]}" if len(sys.argv) > 5 and int(sys.argv[5]) else ""
sys.path.insert(0, str(S))
import jax
jax.config.update("jax_enable_x64", True)
import jax.numpy as jnp
import lean_run as lr, lean_chains as lc, validation_models as vm
t0 = time.time()
rec = json.loads((S / "results/unify_lean" / f"{ARM}_s{SEED}.json").read_text())
a = argparse.Namespace(**rec["args"]); data, meta = lr.load_data(a.data); cfg = lr.build(a, data, meta)[0]
params = lr.load_params(S / "results/unify_lean/params" / f"{ARM}_s{SEED}.npz", cfg)
params = jax.tree_util.tree_map(lambda x: jnp.asarray(x, jnp.float64), params)
d = cfg.d; R = math.sqrt(d); H_ = cfg.heads; dh = d // H_; EPS = 1e-5; C23 = 2 / math.sqrt(3)
ed = np.load(S / "results/unify_lean" / f"cert_edges_{ARM}_s{SEED}{TAG}.npz")
Wp, src, tgt, E_all, J, miss, rO, e0 = ed["Wp"], ed["src"], ed["tgt"], ed["E_all"], ed["J"], ed["miss"], ed["rO"], ed["e0"]
NE, NC = len(src), len(Wp)
P_ = lambda x: np.asarray(x, np.float64)
xa = params["xattn"]; Wq, bq = P_(xa["q"]["w"]), P_(xa["q"]["b"]); Wo = P_(xa["o"]["w"])
gw, bw = P_(params["ln_w"]["g"]), P_(params["ln_w"]["b"]); g2, b2l = P_(params["ln2"]["g"]), P_(params["ln2"]["b"])
W1, b1 = P_(params["mlp"]["fc1"]["w"]), P_(params["mlp"]["fc1"]["b"]); W2 = P_(params["mlp"]["fc2"]["w"])
W1h = g2[:, None] * W1; b1h = b2l @ W1 + b1                                 # the MLP's first layer acting on nu
W1h_col = np.linalg.norm(W1h, axis=0); W1h_n = np.linalg.norm(W1h, 2); W2_n = np.linalg.norm(W2, 2)

# ---- GELU (tanh approximation, as jax.nn.gelu) derivative tables and range-max queries
gelu = lambda x: jax.nn.gelu(x)
g1f = jax.vmap(jax.grad(gelu)); g2f = jax.vmap(jax.grad(jax.grad(gelu))); g3f = jax.vmap(jax.grad(jax.grad(jax.grad(gelu))))
hgrid = 1e-3; XG = np.arange(-30, 30 + hgrid / 2, hgrid)
G1, G2, G3 = (np.abs(np.asarray(f(jnp.asarray(XG)))) for f in (g1f, g2f, g3f))
# sup over a grid cell <= max of its end values + (h/2) * sup |next derivative| (sup |g''| <= 0.8, sup |g'''| <= 2.5, |g''''| <= 8
# bounded on the grid by its own table; a 2x safety factor on the next-derivative term)
up1 = np.maximum(G1[:-1], G1[1:]) + hgrid * G2.max()
up2 = np.maximum(G2[:-1], G2[1:]) + hgrid * G3.max()
TAIL1, TAIL2 = 1.0 + 1e-6, float(G2[[0, -1]].max()) + 1e-9                # beyond |x| = 30: |g'| -> 1 or 0 (bounded by 1.0), |g''| ~ 0


def sparse_table(arr):
    st = [arr]
    j = 1
    while (1 << j) <= len(arr):
        prev = st[-1]; st.append(np.maximum(prev[:-(1 << (j - 1))], prev[(1 << (j - 1)):])); j += 1
    return st


ST1, ST2 = sparse_table(up1), sparse_table(up2)


def range_max(st, lo, hi, tail):
    """sup over [lo, hi] (arrays) of the tabulated function, from cells [floor((lo+30)/h), ceil((hi+30)/h)]."""
    n = len(st[0])
    li = np.floor((lo + 30) / hgrid).astype(np.int64); ri = np.ceil((hi + 30) / hgrid).astype(np.int64) - 1
    out_tail = (li < 0) | (ri >= n)
    li = np.clip(li, 0, n - 1); ri = np.clip(ri, 0, n - 1); ri = np.maximum(ri, li)
    j = np.floor(np.log2(ri - li + 1)).astype(np.int64)
    res = np.empty(lo.shape)
    for jj in np.unique(j):
        m = j == jj
        res[m] = np.maximum(st[jj][li[m]], st[jj][ri[m] - (1 << jj) + 1])
    return np.where(out_tail, np.maximum(res, tail), res)


# ---- per-edge attention constants (the event's keys and values are fixed)
ev_tok = jax.jit(lambda e: lr.event_tokens(params, cfg, e))
kvf = jax.jit(lambda x: lr.kv(xa, x, H_))
x_all, m_all = ev_tok(jnp.asarray(E_all)); k_all, v_all = kvf(x_all)
k_all, v_all, m_all = np.asarray(k_all), np.asarray(v_all), np.asarray(m_all)    # [NE, h, L, dh], mask [NE, L]
Hf_att = np.zeros(NE); Lf_att = np.zeros(NE)
for e in range(NE):
    tok = np.where(m_all[e])[0]
    for h in range(H_):
        sl = slice(h * dh, (h + 1) * dh)
        Mh = (gw[:, None] * (Wq[:, sl] @ k_all[e, h, tok].T)).T / math.sqrt(dh)   # [n_tok, d]: score coefficient on nu
        Uh = v_all[e, h, tok] @ Wo[sl, :]                                          # [n_tok, d]: value rows after the output map
        Mc = Mh - Mh.mean(0); Uc = Uh - Uh.mean(0)
        rng_h = max(np.linalg.norm(Mh[i] - Mh[j]) for i in range(len(tok)) for j in range(len(tok))) if len(tok) > 1 else 0.0
        nu_h = np.linalg.norm(Uc, axis=1).max()
        Hf_att[e] += rng_h ** 2 * nu_h / 2
        Lf_att[e] += np.linalg.norm(Uc, 2) * np.linalg.norm(Mc, 2) / 2
print(f"{ARM} s{SEED}: attention H_f median {np.median(Hf_att):.2f} max {Hf_att.max():.2f}, L_f median {np.median(Lf_att):.2f}; {time.time()-t0:.0f}s", flush=True)


# ---- the centre trajectory through the sub-layers, Jacobians and their norms
def sub_attn(w, k, v, mask):
    return w + lr.attend(xa, vm.ln(params["ln_w"], w[None]), k[None], v[None], mask[None], H_)[0]


def sub_mlp(w):
    return w + vm.mlp(params["mlp"], vm.ln(params["ln2"], w[None]))[0]


def closure(w):
    return w * (R / jnp.linalg.norm(w))


def traj(w, k, v, mask):
    """inputs to the 9 maps (4 x (attn, mlp), closure), their Jacobians, and the MLP pre-activations at the centre."""
    xs, Js, zs = [], [], []
    for _ in range(cfg.ticks):
        xs.append(w); Js.append(jax.jacfwd(sub_attn)(w, k, v, mask)); w = sub_attn(w, k, v, mask)
        xs.append(w); Js.append(jax.jacfwd(sub_mlp)(w))
        c = w - w.mean(); nu = c * R / jnp.sqrt(c @ c + d * EPS); zs.append(nu @ W1h + b1h)
        w = sub_mlp(w)
    xs.append(w); Js.append(jax.jacfwd(closure)(w))
    return jnp.stack(xs), jnp.stack(Js), jnp.stack(zs), closure(w)


trajv = jax.jit(jax.vmap(traj))
NL = 2 * cfg.ticks + 1
Xn = np.zeros((NE, NL)); Cn = np.zeros((NE, NL)); Dn = np.zeros((NE, NL)); Ln = np.zeros((NE, NL)); Zs = np.zeros((NE, cfg.ticks, W1.shape[1]))
