    x = min(min(xs), 2.0)
    th = 2 * math.asin(x / 2)                                              # largest angle whose chord is x
    return n * (math.sin(th) if th < math.pi / 2 else 1.0)                 # raw radius whose worst angle is th (|C dh| <= |dh|)


rO = np.array([cell_radius(Wp[s], rows[s]) for s in range(NC)])
print(f"  cell radius r_O (raw): min {rO.min():.4f} median {np.median(rO):.4f}; view units / {R:.2f}: min {rO.min()/R:.4f}", flush=True)
# start states
ev0 = np.stack([lc.encode_expr_event(tr, cfg.L) for tr in TREES])[:, None]
H0 = np.asarray(fwd(params, jnp.asarray(ev0.astype(np.int32))))[:, 0]
e0 = np.linalg.norm(H0 - Wp, axis=1)
print(f"  start offsets: median {np.median(e0):.4f} max {e0.max():.4f}", flush=True)

out_of = [[] for _ in range(NC)]
for k in range(NE): out_of[src[k]].append(k)
np.savez_compressed(S / "results/unify_lean" / f"cert_edges_{ARM}_s{SEED}{TAG}.npz", F=F, J=J, miss=miss, Wp=Wp, src=src, tgt=tgt, E_all=E_all, rO=rO, e0=e0, H0=H0)


def paths(k):
    """yield (start edges a0, arrays) per first edge: for every path of length k starting with edge a0, the edge list."""
    for a0 in range(NE):
        P = np.array([[a0]])
        for _ in range(k - 1):
            nxt = [(q, b) for q in range(len(P)) for b in out_of[tgt[P[q, -1]]]]
            P = np.array([np.append(P[q], b) for q, b in nxt])
        yield a0, P


def path_bounds(k):
    """for all paths of length exactly k: (start class, end class, ||M||, ||T||, edges)."""
    out = []
    for a0, P in paths(k):
        T = A[P[:, 0]].copy(); M = miss[P[:, 0]].copy()
        for j in range(1, k):
            e = P[:, j]
            M = miss[e] + np.einsum("kij,kj->ki", A[e], M)
            T = np.matmul(A[e], T)
        out.append((src[P[:, 0]], tgt[P[:, -1]], np.linalg.norm(M, axis=1), np.linalg.norm(T, 2, axis=(1, 2)), P))
    s0 = np.concatenate([o[0] for o in out]); t1 = np.concatenate([o[1] for o in out])
    return s0, t1, np.concatenate([o[2] for o in out]), np.concatenate([o[3] for o in out]), np.concatenate([o[4] for o in out])


def roll_check(P):
    """exact float64 roll-out of every path from its start class's start state: distance at the end to the end class's centre,
    and whether every state on the way (the start state included) decodes to its class."""
    hd = jax.jit(lambda h: lr.pos_logits(params, cfg, lr.readout_view(params, h)).argmax(-1))
    def roll(h, evs):
        def body(w, e):
            w2 = step(w, e); return w2, w2
        _, ws = jax.lax.scan(body, h, evs); return ws
    rollv = jax.jit(jax.vmap(roll))
    dist = np.zeros(len(P)); ok = np.ones(len(P), bool)
    ok0 = (np.asarray(hd(jnp.asarray(H0))) == rows).all(-1)
    for c0 in range(0, len(P), 4096):
        Pc = P[c0:c0 + 4096]
        ws = np.asarray(rollv(jnp.asarray(H0[src[Pc[:, 0]]]), jnp.asarray(E_all[Pc])))       # [n, k, d]
        dist[c0:c0 + 4096] = np.linalg.norm(ws[:, -1] - Wp[tgt[Pc[:, -1]]], axis=1)
        pr = np.asarray(hd(jnp.asarray(ws.reshape(-1, d)))).reshape(len(Pc), Pc.shape[1], -1)
        ok[c0:c0 + 4096] = (pr == rows[tgt[Pc]]).all(-1).all(-1) & ok0[src[Pc[:, 0]]]
    return dist, ok


def solve_lp(blocks, inner, start="ball", use_inner=True, use_cell=True, prefix_lb=None, phi_fixed=None):
    """variables r_0..r_{NC-1}, phi. maximise phi (or, with phi_fixed, minimise the sum of the radii at that phi).
    start: 'ball' (r_{s0} >= phi e0), 'prefix' (r_t >= phi * the exact start-prefix distances landing in t), or 'none'."""
    from scipy.optimize import linprog
    from scipy.sparse import coo_matrix, vstack
    nv = NC + 1
    rows_, b_ = [], []
    s0, t1, Mn, Tn, _ = blocks                                             # phi Mn + Tn r_s - r_t <= 0
    nb = len(s0); ii = np.arange(nb)
    same = s0 == t1
    data = np.concatenate([Tn - same * 1.0, -np.ones(int((~same).sum())), Mn])
    r = np.concatenate([ii, ii[~same], ii]); c = np.concatenate([s0, t1[~same], np.full(nb, NC)])
    rows_.append(coo_matrix((data, (r, c)), shape=(nb, nv))); b_.append(np.zeros(nb))
    if use_inner:
        for (si, ti, Mi, Ti, _) in inner:                                  # phi Mi + Ti r_s <= rO[t]
            ni = len(si); ii = np.arange(ni)
            rows_.append(coo_matrix((np.concatenate([Ti, Mi]), (np.concatenate([ii, ii]), np.concatenate([si, np.full(ni, NC)]))), shape=(ni, nv)))
            b_.append(rO[ti])
    lbv = None
    if start == "ball":
        lbv = e0
    elif start == "prefix":
        lbv = prefix_lb
    if lbv is not None:
        ii = np.arange(NC)                                                 # phi lb - r_s <= 0
        rows_.append(coo_matrix((np.concatenate([-np.ones(NC), lbv]), (np.concatenate([ii, ii]), np.concatenate([ii, np.full(NC, NC)]))), shape=(NC, nv)))
        b_.append(np.zeros(NC))
    Aub = vstack(rows_).tocsr(); bub = np.concatenate(b_)
    bounds = [(0, rO[s] if use_cell else None) for s in range(NC)] + ([(0, 1e3)] if phi_fixed is None else [(phi_fixed, phi_fixed)])
    cobj = np.zeros(nv)
    if phi_fixed is None:
        cobj[-1] = -1.0
    else:
        cobj[:NC] = 1.0
    return linprog(cobj, A_ub=Aub, b_ub=bub, bounds=bounds, method="highs")


summary = {"arm": ARM, "seed": SEED, "centres": "snapped" if not REFINE else f"refined x{REFINE}", "edges": NE,
           "raw_miss_median": float(np.median(np.linalg.norm(miss, axis=1))), "raw_miss_max": float(np.linalg.norm(miss, axis=1).max()),
           "one_step_norm_max": float(np.linalg.norm(A, 2, axis=(1, 2)).max()), "radial_col_max": float(a_rad.max()),
           "rO_min": float(rO.min()), "rO_median": float(np.median(rO)),
           "start_offset_max": float(e0.max()), "start_offset_median": float(np.median(e0)), "start_offset_over_rO_max": float((e0 / rO).max())}
inner = []
for j in range(1, KB):
    inner.append(path_bounds(j))
    print(f"  inner length {j}: {len(inner[-1][0])} paths, max ||T|| {inner[-1][3].max():.3f}, max ||M|| {inner[-1][2].max():.4f}; {time.time()-t0:.0f}s", flush=True)
blocks = path_bounds(KB)
print(f"  blocks k = {KB}: {len(blocks[0])} paths, max ||T|| {blocks[3].max():.4f}, max ||M|| {blocks[2].max():.4f}, "
      f"max ||M|| / (1 - ||T||) {np.max(blocks[2] / np.maximum(1 - blocks[3], 1e-9)):.4f}; {time.time()-t0:.0f}s", flush=True)
summary.update({"k": KB, "block_paths": int(len(blocks[0])), "block_T_max": float(blocks[3].max()), "block_M_max": float(blocks[2].max())})
dist, okp = roll_check(blocks[4])
plb = np.zeros(NC); np.maximum.at(plb, tgt[blocks[4][:, -1]], dist)
print(f"  exact start prefixes ({len(dist)} paths of {KB} events from the start states): decode on every step {okp.sum()} of {len(okp)}; "
      f"end distance max {dist.max():.4f}; {time.time()-t0:.0f}s", flush=True)
summary.update({"prefix_decode_ok": int(okp.sum()), "prefix_paths": int(len(okp)), "prefix_dist_max": float(dist.max())})
variants = {"registered (start in the ball)": dict(start="ball"),
            "no start clause (diagnostic)": dict(start="none"),
            "no inner clause (diagnostic)": dict(start="ball", use_inner=False),
            "start by exact prefix (not registered)": dict(start="prefix", prefix_lb=plb)}
best = None
for name, kw in variants.items():
    res = solve_lp(blocks, inner, **kw)
    phi = float(-res.fun) if res.status == 0 else None
    print(f"  linearised LP, {name}: status {res.status}; phi_max = {phi}", flush=True)
    summary[f"phi_max[{name}]"] = phi
    if name.startswith("registered") and res.status == 0:
        rs_reg = res.x[:NC]                                                # the radii at phi_max (misses scaled by phi_max)
    if phi is not None and phi >= 1 and best is None and "diagnostic" not in name:
        best = (name, kw)
if best is not None:
    res2 = solve_lp(blocks, inner, phi_fixed=1.0, **best[1])               # the smallest radii that certify at phi = 1
    rs = res2.x[:NC]
    summary.update({"radii_from": best[0], "r_min": float(rs.min()), "r_median": float(np.median(rs)), "r_max": float(rs.max()),
                    "r_over_rO_max": float(np.max(rs / np.maximum(rO, 1e-12)))})
    print(f"  smallest radii at phi = 1 ({best[0]}; raw): min {rs.min():.4f} median {np.median(rs):.4f} max {rs.max():.4f}", flush=True)
    np.save(S / "results/unify_lean" / f"cert_radii_{ARM}_s{SEED}_k{KB}{TAG}.npy", rs)
else:                                                                      # no certificate: keep the registered problem's radii at phi_max
    summary.update({"radii_from": "registered LP at phi_max", "r_min": float(rs_reg.min()), "r_median": float(np.median(rs_reg)), "r_max": float(rs_reg.max())})
    np.save(S / "results/unify_lean" / f"cert_radii_{ARM}_s{SEED}_k{KB}{TAG}.npy", rs_reg)
np.savez_compressed(S / "results/unify_lean" / f"cert_paths_{ARM}_s{SEED}_k{KB}{TAG}.npz", P=blocks[4], Mn=blocks[2], Tn=blocks[3])
summary["secs"] = round(time.time() - t0)
print(json.dumps(summary), flush=True)
(S / "results/unify_lean" / f"cert_lin_{ARM}_s{SEED}_k{KB}{TAG}.json").write_text(json.dumps(summary, indent=1))

