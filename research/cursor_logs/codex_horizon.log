def _corrupt_value(rng, prog, rows, idx):
    name, _deps, e, new = rows[idx]
    reg = prog.registers[0] if name == "each" else prog.reg(name)
    choices = []
    neighbours = [r[3] for r in rows if r[0] == name and r[3] != new]
    if neighbours:
        choices.append(rng.choice(neighbours))
    if reg.kind == "num" and new not in reg.extras:
        i = reg.index(new)
        for j in (i - 1, i + 1):
