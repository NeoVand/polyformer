index 0000000000000000000000000000000000000000..87da8e71978b6c635c6b95c0b1bc16b3398161ea
--- /dev/null
+++ b/research/horizon/hz_stats.py
@@ -0,0 +1,87 @@
+"""Supplementary, post-fit short-tape score/value measurements; never used to refit.
+
+Twelve fresh L=256 tapes (two per trained family, seed 7071), five reading queries,
+and the eight heads named before HORIZON. Saves actual value vectors as well as
+scores. This cannot retroactively validate the registered prediction.
+"""
+import argparse
+import json
+import pathlib
+import sys
+
+import numpy as np
+
+HERE = pathlib.Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE.parent / "bridge"))
+import br_core as C
+
+HEADS = {23: [4, 5, 30], 24: [23, 22, 20, 5, 13]}
+STEPS = [16, 32, 64, 128, 255]
+
+
+def main(out):
+    import torch
+    from transformers.modeling_utils import ALL_ATTENTION_FUNCTIONS
+
+    tok = C.tokenizer()
+    examples, skipped = C.examples(tok, C.TRAINED, [256], 2, 7071)
+    assert len(examples) == 12 and not skipped
+    model = C.load_model()
+    original = ALL_ATTENTION_FUNCTIONS["sdpa"]
+    rows, target_values, baths, means = [], [], [], []
+    current = {}
+
+    def wrapped(module, query, key, value, attention_mask, **kw):
+        layer = module.layer_idx
+        if layer in HEADS:
+            lay = current["lay"]
+            groups = query.shape[1] // key.shape[1]
+            for head in HEADS[layer]:
+                for step in STEPS:
+                    pos = lay["run_start"] + step * lay["stride"] - 1
+                    target = lay["tape_pos"][step]
+                    q = query[0, head, pos].float()
+                    keys = key[0, head // groups, :pos + 1].float()
+                    values = value[0, head // groups, :pos + 1].float()
+                    scores = keys @ q * module.scaling
+                    mask = torch.arange(pos + 1, device=q.device) != target
+                    bg = scores[mask]
+                    bath = bg.softmax(0) @ values[mask]
+                    mean = values[mask].mean(0)
+                    target_v = values[target]
+                    target_values.append(target_v.cpu().numpy())
+                    baths.append(bath.cpu().numpy())
+                    means.append(mean.cpu().numpy())
+                    rows.append(dict(family=current["family"], example=current["i"], step=step,
+                        head=f"L{layer}.H{head}", background_n=int(mask.sum()), target_score=float(scores[target]),
+                        background_score_mean=float(bg.mean()), background_score_std=float(bg.std(unbiased=False)),
+                        target_attention=float(scores.softmax(0)[target]), target_value_norm=float(target_v.norm()),
+                        weighted_bath_norm=float(bath.norm()), target_bath_distance=float((target_v-bath).norm()),
+                        weighted_unweighted_distance=float((bath-mean).norm())))
+        return original(module, query, key, value, attention_mask, **kw)
+
+    ALL_ATTENTION_FUNCTIONS["sdpa"] = wrapped
+    try:
+        with torch.no_grad():
+            for i, example in enumerate(examples):
+                current.update(lay=example["lay"], family=example["family"], i=i)
+                h = C.hidden(model, example["lay"]["ids"])
+                del h
+                print(json.dumps(dict(done=i+1, total=12)), flush=True)
+    finally:
+        ALL_ATTENTION_FUNCTIONS["sdpa"] = original
+    assert len(rows) == 12 * 8 * 5
+    numeric = [k for k in rows[0] if k not in ("family", "example", "step", "head")]
+    summary = {head: {k: float(np.mean([r[k] for r in rows if r["head"] == head])) for k in numeric}
+               for head in sorted({r["head"] for r in rows})}
+    out.mkdir(parents=True, exist_ok=True)
+    (out / "short_stats.json").write_text(json.dumps(dict(unaudited=True, role="post-fit descriptive supplement",
+        seed=7071, L=256, n_tapes=12, queries_per_head=60, summary=summary, records=rows), indent=1))
+    np.savez_compressed(out / "short_values.npz", target=np.stack(target_values),
+                        weighted_bath=np.stack(baths), unweighted_mean=np.stack(means))
+
+
+if __name__ == "__main__":
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--out", type=pathlib.Path, required=True)
+    main(ap.parse_args().out)
