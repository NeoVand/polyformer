def _finish(family, phrasing, fmt, question, program_text, items, n_phr, fmts, meta=None):
    prog = parse_program(program_text)
    steps, final = run_program(prog, items)
    held_p = family in TRAIN_FAMILIES and (phrasing == "bbh" or phrasing >= n_phr - 2)
    held_f = family in TRAIN_FAMILIES and len(fmts) > 1 and fmt == fmts[-1]
