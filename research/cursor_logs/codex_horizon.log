def family_example(rng, family, L=None, split="train", phrasing=None, fmt=None, max_L=2048, **kw):
    if L is None:
        L = _loguniform_int(rng, 1, min(max_L, FAMILY_MAX_L.get(family, max_L)))
    inst = make(family, rng, L, split=split, phrasing=phrasing, fmt=fmt, **kw)
    return {"kind": "family", "prompt": chat_prompt(inst.question), "question": inst.question,
            "prog_text": inst.program_text, "program_in_prompt": False, "items": inst.items, "L": inst.length,
            "family": family, "phrasing": inst.phrasing, "fmt": inst.fmt, "heldout_phrasing": inst.heldout_phrasing,
            "heldout_format": inst.heldout_format, "answer": inst.answer, "final": inst.final}


