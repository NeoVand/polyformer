"""
Modal launcher for HORIZON. Own app `polyformer-horizon`, own volume `polyformer-horizon` (outputs, at /out), PROMPTBOX's
volume mounted read-only at /pb (Savant r2's adapter, the self-distilled chat data). Cap $15, recorded in
results/ledger.json before any spend. Every job is reserved at its upper-bound cost before it is spawned and settled at
its wall time after; the GPU and the host CPU are recorded in every record.

    uv run --no-project --with modal modal deploy research/horizon/hz_modal.py
    uv run --no-project --with modal python research/horizon/hz_modal.py spawn --id <id> --gpu L4 --max_seconds 1800 \
        -- br_tf.py --mode tf ...
    uv run --no-project --with modal python research/horizon/hz_modal.py collect
    python3 research/horizon/hz_modal.py status

Prices are Modal's list prices per second (upper bounds): the GPU, plus the requested CPU cores and memory.
"""

from __future__ import annotations

import argparse
import contextlib
import datetime as dt
import fcntl
