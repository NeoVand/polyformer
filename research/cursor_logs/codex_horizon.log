new file mode 100644
index 0000000000000000000000000000000000000000..80b2d93fb32ea2c2a669a7561dbd075e3430372d
--- /dev/null
+++ b/research/horizon/hz_report.py
@@ -0,0 +1,68 @@
+"""Settle the registered intervention metrics from the frozen manifest and raw outcomes."""
+import json
+import pathlib
+
+import numpy as np
+
+import hz_intervene as I
+import hz_lib as H
+
+HERE = pathlib.Path(__file__).resolve().parent
+
+
+def summarize(manifest, result, estimate):
+    assert result["manifest_sha256"] == I.digest(manifest)
+    assert manifest["estimate_sha256"] == I.digest(estimate)
+    assert not result["smoke"]
+    planned = {r["id"]: r for r in manifest["rows"]}
+    observed = {r["id"]: r for r in result["records"]}
+    assert len(observed) == len(result["records"]) and observed.keys() == planned.keys()
+    scores, cells = {}, {}
+    for name, row in planned.items():
+        actual = observed[name]
+        assert all(actual[k] == row[k] for k in ("regime", "L", "i", "n_tokens"))
+        fe = actual["first_error"]
+        assert actual["exact"] == (fe is None)
+        for model, h in I.hazards(row["events"], estimate).items():
+            scores.setdefault(model, []).append(H.log_score(h, None if fe is None else fe["step"]))
+    for regime in ("Z", "H", "F"):
+        for L in (2048, manifest["long"]):
+            rs = [r for r in result["records"] if r["regime"] == regime and r["L"] == L]
+            failed = sum(not r["exact"] for r in rs)
+            cells[f"{regime}-{L}"] = dict(n=len(rs), failed=failed, failure_rate=failed/len(rs),
+                wilson95=H.wilson(failed, len(rs)), first_read=sum(r["first_error"] is not None and
+                r["first_error"]["kind"] == "read" for r in rs),
+                first_state=sum(r["first_error"] is not None and r["first_error"]["kind"] == "state" for r in rs))
+    rate = lambda regime, L: cells[f"{regime}-{L}"]["failure_rate"]
+    delta_c = {str(L): rate("H", L)-rate("Z", L) for L in (2048, manifest["long"])}
+    delta_l = {regime: rate(regime, manifest["long"])-rate(regime, 2048) for regime in ("Z", "H", "F")}
+    collision = all(x >= .25 for x in delta_c.values())
+    length = all(x >= .25 for x in delta_l.values())
+    if collision and all(abs(x) <= .25 for x in delta_l.values()):
+        reading = "collisions, not length"
+    elif all(x <= .125 for x in delta_c.values()) and length:
+        reading = "length, not collisions"
+    elif collision and length:
+        reading = "both"
+    else:
+        reading = "mixed"
+    conclusive = all(cells[f"{regime}-{L}"]["n"] >= minimum
+        for regime, minimum in (("Z", 16), ("H", 12), ("F", 8)) for L in (2048, manifest["long"]))
+    means = {name: float(np.mean(vals)) for name, vals in scores.items()}
+    gaps = {name: means["collision"]-val for name, val in means.items() if name != "collision"}
+    prospective = all(gap >= .05 for gap in gaps.values())
+    return dict(unaudited=True, n=len(observed), cells=cells, delta_collision=delta_c,
+                delta_length=delta_l, numerical_reading=reading, conclusive=conclusive,
+                causal_pass=conclusive and reading == "collisions, not length",
+                mean_log_scores=means, collision_score_gaps=gaps, prospective_pass=prospective,
+                overall_pass=estimate["prediction_verdict"]["passes"] and conclusive and
+                reading == "collisions, not length" and prospective)
+
+
+if __name__ == "__main__":
+    base = HERE / "results"
+    result = summarize(json.loads((base / "intervention_manifest.json").read_text()),
+                       json.loads((base / "intervention/records.json").read_text()),
+                       json.loads((base / "estimate.json").read_text()))
+    (base / "intervention_summary.json").write_text(json.dumps(result, indent=2))
+    print(json.dumps(result, indent=2))
