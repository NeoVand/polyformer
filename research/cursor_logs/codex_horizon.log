"""
BRIDGE Part 1 (and Part 2's scorer): teacher-forced anatomy of plain-mode runs.

Modes (all on true contexts unless stated; every example is rebuilt from (families, lengths, n, seed) by br_core):

  tf        one forward per example over prompt + true program + true run. At every run token: the greedy choice,
            its margin over the whole vocabulary and among the register's states (or the events). Greedy
            free-running decoding is exact iff every choice is right, so this scores plain-mode exactness.
            --probe_examples k adds attention probes on the first k examples of each cell: per layer and head, the
            attention mass of state queries (and reading queries) on named segments of the context.
  corrupt   one wrong state at step j, everything else as written (A), or a consistent branch from that wrong state
            (B); the change in every later step's logits. Pinned mode has no earlier run tokens, so this is 0 there.
  filler    G tokens of ordinary text between `<exec/>` and `<run>`: the gap to Π without old run tokens.
  kickcal   gradients of a 16-step window's next-state loss with respect to the input embeddings of the old run
            tokens (lag >= 2 from every window label), and the window loss under aimed and random perturbations of
            those embeddings at several sizes. This is the kick's measurement on the model as trained.

    python br_tf.py --mode tf --adapter /pb/rlg-ours/adapter_iter60 --families cups,parity --lengths 1024,4096 \
        --n 16 --seed 4040 --out /out/<id>
"""

from __future__ import annotations

import argparse
import json
import pathlib
import random
import sys
import time

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import br_core as C  # noqa: E402

SEGS = ["sink", "prompt", "tape_cur", "tape_prev", "tape_other", "pi_match_t", "pi_match_se", "pi_other", "prog_text",
        "run_recent", "run_old_same", "run_old"]


def atomic_json(path, obj):
    path = pathlib.Path(path)
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(obj, indent=1, default=str))
    tmp.replace(path)


def log(**kw):
    print(json.dumps(kw), flush=True)


def true_states(lay, ids):
    """states[k][r] written at step k (as ids), and the events."""
    T, R, st, r0 = lay["T"], lay["R"], lay["stride"], lay["run_start"]
    ev = [ids[r0 + k * st] for k in range(T)]
    s = [[ids[r0 + k * st + 1 + r] for r in range(R)] for k in range(T)]
    return ev, s


def score(model, lay, ids, h=None):
    """Teacher-forced choices at every run token (and the closing newline-token): dict of numpy arrays."""
    import numpy as np
    import torch
    if h is None:
        with torch.no_grad():
            h = C.hidden(model, ids)
    toks = C.run_tokens(lay)
    pos = [p - 1 for p, _, _, _ in toks]
    tgt = [ids[p] for p, _, _, _ in toks]
    cand = [lay["events"] if kind == "e" else lay["states"][r] for _, kind, _, r in toks]
    mg, mc, am = C.chunked_margins(model, h, pos, tgt, cand)
    out = {"kind": np.array([0 if k == "e" else 1 for _, k, _, _ in toks], dtype=np.int8),
           "step": np.array([s for _, _, s, _ in toks], dtype=np.int32),
           "reg": np.array([r for _, _, _, r in toks], dtype=np.int8),
           "margin": mg.astype(np.float32), "margin_cand": mc.astype(np.float32), "argmax": am.astype(np.int32),
           "ok": (am == np.array(tgt)).astype(np.int8)}
    return out, h


def segment_labels(lay, ids, queries):
    """(nq, n) segment index of every key for every probe query. queries: list of (pos, kind, step, reg)."""
    import numpy as np
    n = len(ids)
    T, R, st, r0 = lay["T"], lay["R"], lay["stride"], lay["run_start"]
    base = np.full(n, SEGS.index("prog_text"), dtype=np.int64)
    base[:lay["prompt_len"]] = SEGS.index("prompt")
    base[0] = SEGS.index("sink")
    tape = np.array(lay["tape_pos"])
    base[tape] = SEGS.index("tape_other")
    for rr in lay["rows"]:
        for x in rr:
            base[x["pos"]:x["pos"] + 4] = SEGS.index("pi_other")
    base[lay["prog_start"] + lay["prog_len"]:] = SEGS.index("run_old")   # opener, run, closer
    ev, s = true_states(lay, ids)
    out = []
    for qpos, kind, k, r in queries:
        lab = base.copy()
        if kind == "s":
            # state query at e_k (r = 0) or at s_k^{r-1}: the step reads s_{k-1}^r and e_k
            prev = s[k - 1][r] if k > 0 else lay["starts"][r]
            row = next((x for x in lay["rows"][r] if x["s"] == prev and x["e"] == ev[k]), None)
            if row is not None:
                lab[row["pos"]:row["pos"] + 2] = SEGS.index("pi_match_se")
                lab[row["pos"] + 2] = SEGS.index("pi_match_t")
            lab[tape[k]] = SEGS.index("tape_cur")
            if k > 0:
                lab[tape[k - 1]] = SEGS.index("tape_prev")
            # earlier visits of the same row: the state written after them
            for j in range(1, k - 1):
                if s[j - 1][r] == prev and ev[j] == ev[k]:
                    lab[r0 + j * st + 1 + r] = SEGS.index("run_old_same")
            lo = r0 + (k - 1) * st if k > 0 else r0
        else:
            # reading query at the last token of step k-1: the next event is tape[k]
            lab[tape[k]] = SEGS.index("tape_cur")
            if k > 0:
                lab[tape[k - 1]] = SEGS.index("tape_prev")
            lo = r0 + (k - 1) * st if k > 0 else r0
        lab[lo:qpos + 1] = SEGS.index("run_recent")
        lab[qpos + 1:] = -1
        out.append(lab)
    return np.stack(out)


def probe(model, prb, lay, ids, n_state=32, n_read=16):
    """Attention mass per (layer, head, query, segment), float16, plus the query table."""
    import numpy as np
    import torch
    toks = C.run_tokens(lay)
    T = lay["T"]
    steps_s = sorted(set(np.linspace(1, T - 1, n_state).round().astype(int).tolist()))
    steps_r = sorted(set(np.linspace(1, T - 1, n_read).round().astype(int).tolist()))
    q = []
    for p, kind, k, r in toks:
        if kind == "s" and r == 0 and k in steps_s:
            q.append((p - 1, "s", k, 0))
        if kind == "e" and k in steps_r:
            q.append((p - 1, "e", k, -1))
    labels = segment_labels(lay, ids, q)
    lab_t = torch.as_tensor(labels, device=C._dev())
    keep = lab_t >= 0
    lab_t = lab_t.clamp(min=0)
    S = len(SEGS)

    def reduce(w):
        w = w * keep[None]
        out = torch.zeros(w.shape[0], w.shape[1], S, device=w.device)
        out.scatter_add_(2, lab_t[None].expand(w.shape[0], -1, -1), w)
        return out.half()

    prb.queries, prb.reduce, prb.w = [x[0] for x in q], reduce, {}
    with torch.no_grad():
        h = C.hidden(model, ids)
    mass = torch.stack([prb.w[L] for L in sorted(prb.w)]).cpu().numpy()       # (layers, H, nq, S)
    prb.queries, prb.reduce, prb.w = None, None, {}
    qt = np.array([(p, 1 if kind == "s" else 0, k) for p, kind, k, _ in q], dtype=np.int32)
    return mass, qt, h


def mode_tf(a, model, tok):
    import numpy as np
    exs, skipped = C.examples(tok, a.families.split(","), [int(x) for x in a.lengths.split(",")], a.n, a.seed)
    log(examples=len(exs), skipped=skipped)
    prb = C.AttnProbe(model) if a.probe_examples else None
    arrays, recs, probes, per_cell = {}, [], {}, {}
    t0 = time.time()
    for i, e in enumerate(exs):
        lay, ids = e["lay"], e["lay"]["ids"]
        h = None
        if prb is not None and per_cell.get(e["cell"], 0) < a.probe_examples:
            mass, qt, h = probe(model, prb, lay, ids)
            probes[f"mass_{i}"], probes[f"q_{i}"] = mass, qt
            per_cell[e["cell"]] = per_cell.get(e["cell"], 0) + 1
        sc, _ = score(model, lay, ids, h)
        for k, v in sc.items():
            arrays.setdefault(k, []).append(v)
        bad = np.nonzero(sc["ok"] == 0)[0]
        first = int(bad[0]) if len(bad) else None
        recs.append({"i": i, "cell": e["cell"], "family": e["family"], "L": e["L"], "T": lay["T"], "R": lay["R"],
                     "n_tokens": lay["n"], "exact": first is None, "errors": int(len(bad)),
                     "first_error": None if first is None else {
                         "step": int(sc["step"][first]), "kind": "read" if sc["kind"][first] == 0 else "step",
                         "reg": int(sc["reg"][first]), "margin": float(sc["margin"][first]),
                         "argmax": tok.decode([int(sc["argmax"][first])]),
                         "argmax_in_cand": int(sc["argmax"][first]) in (
                             lay["events"] if sc["kind"][first] == 0 else lay["states"][int(sc["reg"][first])])},
                     "min_margin_state": float(sc["margin"][sc["kind"] == 1].min()),
                     "min_margin_read": float(sc["margin"][sc["kind"] == 0].min()),
                     "fragile_state_lt_0p5": int(((sc["margin"] < 0.5) & (sc["kind"] == 1)).sum()),
                     "fragile_read_lt_0p5": int(((sc["margin"] < 0.5) & (sc["kind"] == 0)).sum())})
        if i % 10 == 0:
            log(done=i, of=len(exs), cell=e["cell"], exact=first is None, seconds=round(time.time() - t0))
    lens = np.array([len(x) for x in arrays["margin"]])
    np.savez_compressed(pathlib.Path(a.out) / f"{a.tag}_tf.npz", offsets=np.concatenate([[0], np.cumsum(lens)]),
                        **{k: np.concatenate(v) for k, v in arrays.items()})
    if probes:
        np.savez_compressed(pathlib.Path(a.out) / f"{a.tag}_probe.npz", segs=np.array(SEGS), **probes)
    cells = {}
    for r in recs:
        c = cells.setdefault(r["cell"], {"n": 0, "exact": 0, "first_read": 0, "first_step": 0})
        c["n"] += 1
        c["exact"] += r["exact"]
        if r["first_error"]:
            c["first_" + r["first_error"]["kind"]] += 1
    return {"records": recs, "cells": cells, "skipped": skipped}


def mode_corrupt(a, model, tok):
    """Per example and per cut fraction: A (one wrong state, rest as written) and B (consistent branch)."""
    import numpy as np
    import torch
    exs, skipped = C.examples(tok, a.families.split(","), [int(x) for x in a.lengths.split(",")], a.n, a.seed)
    rng = random.Random(a.seed + 1)
    out_arr, recs = {}, []
    for i, e in enumerate(exs):
        lay, ids = e["lay"], list(e["lay"]["ids"])
        clean, h = score(model, lay, ids)
        del h
        ev, s = true_states(lay, ids)
        T, st, r0 = lay["T"], lay["stride"], lay["run_start"]
        for frac in [float(x) for x in a.fracs.split(",")]:
            j = max(1, min(T - 3, int(frac * T)))
            wrong = rng.choice([x for x in lay["states"][0] if x != s[j][0]])
            for kind in ("A", "B"):
                ids2 = list(ids)
                ids2[r0 + j * st + 1] = wrong
                tgt_states = [list(x) for x in s]
                if kind == "B":
                    cur = wrong
                    tgt_states[j][0] = wrong
                    for k in range(j + 1, T):
                        cur = lay["table"][0][(cur, ev[k])]
                        tgt_states[k][0] = cur
                        ids2[r0 + k * st + 1] = cur
                with torch.no_grad():
                    h2 = C.hidden(model, ids2)
                sc2, _ = score(model, lay, ids2, h2)
                del h2
                sel = (sc2["kind"] == 1) & (sc2["reg"] == 0) & (sc2["step"] > j)
                selc = (clean["kind"] == 1) & (clean["reg"] == 0) & (clean["step"] > j)
                steps = sc2["step"][sel]
