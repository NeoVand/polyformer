+def test_conflicts_match_bruteforce():
+    for seed in range(10):
+        rng = random.Random(seed)
+        events = [rng.randrange(4) for _ in range(40)]
+        for k in (1, 2, 5):
+            c, n = H.conflicts(events, k)
+            for t in range(k, len(events)):
+                want = sum(events[j-k:j] == events[t-k:t] and events[j] != events[t]
+                           for j in range(k, len(events)))
+                assert n[t] == want and c[t] == bool(want)
+
+
+def test_intervention_distinct_draws_and_frozen_pairs():
+    import hz_intervene as I
+    rows, duplicates = I.tapes(1, 8192)
+    assert len(rows) == 78
+    assert all(len(v) == 5 for v in duplicates.values())
+    for regime, expected in (("Z", 16), ("H", 11), ("F", 12)):
+        for length in (2048, 8192):
+            cell = [r for r in rows if r["regime"] == regime and r["L"] == length]
+            assert len(cell) == len({tuple(r["events"]) for r in cell}) == expected
+    for i in range(12):
+        pair = [r for r in rows if r["regime"] == "F" and r["i"] == i]
+        assert len({int(H.conflicts(r["events"], 1)[0].sum()) for r in pair}) == 1
+
+
+def test_intervention_summary_requires_complete_unique_outcomes():
+    import copy
+    import json
+    import pytest
+    import hz_intervene as I
+    import hz_report as R
+    root = pathlib.Path(__file__).resolve().parent / "results"
+    manifest = json.loads((root / "intervention_manifest.json").read_text())
+    estimate = json.loads((root / "estimate.json").read_text())
+    records = [{key: r[key] for key in ("id", "regime", "L", "i", "n_tokens")} |
+               {"exact": True, "first_error": None} for r in manifest["rows"]]
+    result = {"manifest_sha256": I.digest(manifest), "smoke": False, "records": records}
+    summary = R.summarize(manifest, result, estimate)
+    assert summary["n"] == 78 and not summary["conclusive"]
+    assert not summary["causal_pass"] and not summary["overall_pass"]
+    incomplete = copy.deepcopy(result)
+    incomplete["records"].pop()
+    with pytest.raises(AssertionError):
+        R.summarize(manifest, incomplete, estimate)
+    duplicate = copy.deepcopy(result)
+    duplicate["records"].append(duplicate["records"][0])
+    with pytest.raises(AssertionError):
+        R.summarize(manifest, duplicate, estimate)
+
+
 def test_z_tapes_have_no_conflicts_and_are_distinct():
     for k in (1, 4, 24):
         tapes = H.z_tapes(length=300, n=16)

