    """states[k][r] written at step k (as ids), and the events."""
    T, R, st, r0 = lay["T"], lay["R"], lay["stride"], lay["run_start"]
    ev = [ids[r0 + k * st] for k in range(T)]
    s = [[ids[r0 + k * st + 1 + r] for r in range(R)] for k in range(T)]
    return ev, s


