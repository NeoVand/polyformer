+"""Build the registered tapes, freeze predictions, and score them without refitting.
+
+Local: --prepare. Remote: --smoke or --run (uses the committed manifest).
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import pathlib
+import sys
+import time
+
+import numpy as np
+
+HERE = pathlib.Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE.parent / "bridge"))
+import br_core as C
+import hz_lib as H
+from pb_data import family_example
+
+
+def digest(obj):
+    return hashlib.sha256(json.dumps(obj, sort_keys=True).encode()).hexdigest()
+
+
+class FixedCups:
+    """Supply exactly the fixed shell and the registered events to pb_families.cups."""
+    def __init__(self, events):
+        self.choices = iter(["ABC", "A", *events])
+
+    def choice(self, choices):
+        result = next(self.choices)
+        assert result in choices
+        return result
+
+
+def layout(tok, events):
+    ex = family_example(FixedCups(events), "cups", L=len(events), phrasing=0, fmt="space")
+    lit, why = C.pb_lit.literal(ex, tok)
+    assert lit is not None, why
+    lay = C.layout(tok, ex, lit)
+    assert len(lay["tape_pos"]) == len(events) == lay["T"]
+    assert [lay["ids"][lay["run_start"] + t * lay["stride"]] for t in range(len(events))] == [
+        C.pb_lit.name_id(tok, e) for e in events]
+    return lay
+
+
+def hazards(events, estimate):
+    a = estimate["alternatives"]
+    t = np.arange(len(events))
+    return {
+        "collision": estimate["q"]["q"] * H.conflicts(events, estimate["k"])[0],
+        "dilution_log": np.minimum(1, a["dilution_log_a"] * np.log(t + 1)),
+        "dilution_inv_t": np.minimum(1, a["dilution_inv_t_b"] / (t + 1)),
+        "position": H.logistic_h(t, a["position_alpha"], a["position_beta"]),
+        "fitted_curve": H.hazard_from_lognormal(len(events), a["fitted_curve"]["mu"], a["fitted_curve"]["sigma"]),
+    }
+
+
+def tapes(k, long):
+    rows, duplicate_h = [], {}
+    for L in (H.SHORT_L, long):
+        for i, events in enumerate(H.z_tapes(length=L)):
+            rows.append(dict(id=f"Z-{L}-{i}", regime="Z", L=L, i=i, events=events))
+        seen = set()
+        duplicate_h[str(L)] = []
+        for r in H.h_tapes(k, L):
+            key = tuple(r["events"])
+            if key in seen:
+                duplicate_h[str(L)].append(r["i"])
+                continue
+            seen.add(key)
+            rows.append(dict(id=f"H-{L}-{r['i']}", regime="H", L=L, **r))
+    for pair in H.f_pairs(k, long=long):
+        if not H.pair_conflict_ok(pair, k)[0]:
+            continue
+        for label, L in (("short", H.SHORT_L), ("long", long)):
+            rows.append(dict(id=f"F-{L}-{pair['i']}", regime="F", L=L, i=pair["i"], events=pair[label]))
+    return rows, duplicate_h
+
+
+def prepare(out):
+    estimate = json.loads((HERE / "results/estimate.json").read_text())
+    tok = C.tokenizer()
+    checks = []
+    for long in (8192, 4096, 3072, 2048):
+        rows, duplicates = tapes(estimate["k"], long)
+        for row in rows:
+            lay = layout(tok, row["events"])
+            row["n_tokens"] = lay["n"]
+            row["ids_sha256"] = digest(lay["ids"])
+        maximum = max(r["n_tokens"] for r in rows)
+        checks.append(dict(long=long, max_tokens=maximum, fits=maximum <= C.CONTEXT - 64))
+        if maximum <= C.CONTEXT - 64:
+            break
+    assert long > 2048, "No distinct long length fits; intervention inconclusive"
+    for row in rows:
+        row["n_conflict"] = int(H.conflicts(row["events"], estimate["k"])[0].sum())
+        row["predicted_survival"] = {name: H.survival_prob(h) for name, h in hazards(row["events"], estimate).items()}
+    manifest = dict(unaudited=True, estimate_sha256=digest(estimate), k=estimate["k"], q=estimate["q"]["q"],
+                    long=long, token_checks=checks, duplicate_H_draw_indices=duplicates, rows=rows,
+                    note="Distinct tapes only, in registered draw order; duplicate H draws omitted without replacement.")
+    out.mkdir(parents=True, exist_ok=True)
+    (out / "intervention_manifest.json").write_text(json.dumps(manifest, separators=(",", ":")))
+    summary = {f"{regime}-{L}": dict(n=len(cell), conflicts=sorted(set(r["n_conflict"] for r in cell)),
+                predicted_survival={name: float(np.mean([r["predicted_survival"][name] for r in cell]))
+                                    for name in cell[0]["predicted_survival"]})
+               for regime in ("Z", "H", "F") for L in (2048, long)
+               if (cell := [r for r in rows if r["regime"] == regime and r["L"] == L])}
+    (out / "intervention_plan.json").write_text(json.dumps(dict(token_checks=checks, cells=summary,
+                  duplicate_H_draw_indices=duplicates, manifest_sha256=digest(manifest)), indent=2))
+    print(json.dumps(summary, indent=2))
+
+
+def run(out, smoke):
+    import br_tf
+    tok = C.tokenizer()
+    manifest = json.loads((HERE / "results/intervention_manifest.json").read_text())
+    rows = manifest["rows"] if not smoke else [dict(id="smoke-Z-256", regime="Z", L=256, i=0,
+                                                  events=H.z_tapes(length=256, n=1)[0])]
+    model = C.load_model()
+    out.mkdir(parents=True, exist_ok=True)
+    records = []
+    started = time.monotonic()
+    for row in rows:
+        lay = layout(tok, row["events"])
+        if not smoke:
+            assert digest(lay["ids"]) == row["ids_sha256"]
+        sc, hidden = br_tf.score(model, lay, lay["ids"])
+        del hidden
+        bad = np.flatnonzero(sc["ok"] == 0)
+        first = int(bad[0]) if len(bad) else None
+        record = {key: row[key] for key in ("id", "regime", "L", "i")}
+        record.update(n_tokens=lay["n"], exact=first is None, errors=int(len(bad)),
+                      first_error=None if first is None else dict(step=int(sc["step"][first]),
+                        kind="read" if sc["kind"][first] == 0 else "state", margin=float(sc["margin"][first]),
+                        argmax=int(sc["argmax"][first])),
+                      min_margin_read=float(sc["margin"][sc["kind"] == 0].min()),
+                      min_margin_state=float(sc["margin"][sc["kind"] == 1].min()))
+        np.savez_compressed(out / (row["id"] + ".npz"), **sc)
+        records.append(record)
+        br_tf.atomic_json(out / "records.json", dict(unaudited=True, smoke=smoke,
+                          manifest_sha256=digest(manifest), records=records))
+        print(json.dumps(dict(done=len(records), total=len(rows), seconds=round(time.monotonic()-started), **record)), flush=True)
+
+
+if __name__ == "__main__":
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--prepare", action="store_true")
+    ap.add_argument("--smoke", action="store_true")
+    ap.add_argument("--run", action="store_true")
+    ap.add_argument("--out", type=pathlib.Path, default=HERE / "results")
+    args = ap.parse_args()
+    if args.prepare:
+        prepare(args.out)
+    else:
+        assert args.run or args.smoke
+        run(args.out, args.smoke)
