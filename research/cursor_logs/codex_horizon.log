                # at step j+1 under A: does the model follow the written (wrong) state or the true history?
                p_next = r0 + (j + 1) * st                   # e_{j+1}; logits there predict s_{j+1}
                local = lay["table"][0][(wrong, ev[j + 1])]
                am = int(sc2["argmax"][(sc2["kind"] == 1) & (sc2["reg"] == 0) & (sc2["step"] == j + 1)][0])
                key = f"{i}_{frac}_{kind}"
                out_arr[f"d_{key}"] = d.astype(np.float16)
                out_arr[f"ok_{key}"] = sc2["ok"][sel]
                out_arr[f"okc_{key}"] = clean["ok"][selc]
                out_arr[f"rd_{key}"] = (sc2["margin"][(sc2["kind"] == 0) & (sc2["step"] > j)]
                                        - clean["margin"][(clean["kind"] == 0) & (clean["step"] > j)]).astype(np.float16)
                lag2 = steps >= j + 2
"""
BRIDGE core: plain-mode examples with their token layout, model loading, and the hooks the anatomy needs.

A plain-mode sequence (PROMPTBOX §3.6, pb_loop plain mode) is

    prompt (chat template, question with the tape)  |  program (literal table Π, ends `<exec/>`)  |  `\\n<run>\\n`
    |  run: e_1 s_1 [s_1' …] e_2 s_2 …  |  `\\n</run>\\n`

where the program is the true literal program (`pb_lit.program_ids`, the "oracle" program: PROMPTBOX's model writes
exactly this table in 98.7% of gate cases), and the run is the true trace. The model writes the run itself in plain
mode: it copies each event from the prompt (reading) and writes each register's next value (stepping).

Teacher forcing on the true sequence gives, at every run token, the model's greedy choice given a correct history.
Greedy free-running decoding equals the true run if and only if every one of those choices is right (induction on
the position), so one forward pass decides whether the greedy run of that input is exact, up to floating-point
differences between the two code paths at near-ties (measured by br_free.py).

Torch is imported only inside functions that need it.
"""

from __future__ import annotations

import pathlib
import random
import sys

for _p in ("/root/pb", str(pathlib.Path(__file__).resolve().parent.parent / "promptbox")):
    if pathlib.Path(_p).exists() and _p not in sys.path:
        sys.path.insert(0, _p)

import pb_lit  # noqa: E402
from pb_data import family_example  # noqa: E402

MODEL = "Qwen/Qwen3-4B"
SAVANT = "/pb/rlg-ours/adapter_iter60"
TRAINED = ("parity", "cups", "robot", "compass", "cycle", "prose")
CONTEXT = 40960


def _dev():
    import torch
    return "cuda" if torch.cuda.is_available() else "cpu"


def enc(tok, s):
    return list(tok.encode(s, add_special_tokens=False).ids)


def tokenizer(model=MODEL):
    import glob
    from tokenizers import Tokenizer
    local = glob.glob(str(pathlib.Path.home() / ".cache/huggingface/hub/models--Qwen--Qwen3-4B/snapshots/*/tokenizer.json"))
    if local:
        return Tokenizer.from_file(local[0])
    from huggingface_hub import snapshot_download
    return Tokenizer.from_file(str(pathlib.Path(snapshot_download(model)) / "tokenizer.json"))


def _tape_positions(tok, prompt, question, lit):
    """Token indices (in the encoded prompt) of the tape's events, by the clock's own walk (pb_lit.walk)."""
    q0 = prompt.find(question)
    assert q0 >= 0
    a, b = pb_lit.find_span(question, *lit["anchors"])
    a, b = a + q0, b + q0
    e = tok.encode(prompt, add_special_tokens=False)
    names = set(lit["events"])
    out = []
    for i, (s, t) in enumerate(e.offsets):
        raw = prompt[s:t]
        s2, t2 = s + len(raw) - len(raw.lstrip()), t - (len(raw) - len(raw.rstrip()))
        if t2 <= a or s2 >= b:
            continue
        if prompt[s2:t2] in names:
            out.append(i)
    return out


def layout(tok, ex, lit):
    """ids of the whole plain-mode sequence and the index of every part. Run step k (0-based) has its event at
    run_start + k*stride and register r's value at run_start + k*stride + 1 + r."""
    prompt = enc(tok, ex["prompt"])
    prog = pb_lit.program_ids(tok, lit)
    # Π positions, rebuilt piece by piece exactly as pb_lit.program_ids builds the ids
    nl = enc(tok, "\n")
    import json as _json
    head = enc(tok, f"<program>\ntask: {lit['task']}\ninput: {lit['input']}\n")
    before, after = lit["anchors"]
    head += enc(tok, "tape: after " + _json.dumps(before, ensure_ascii=False) + " until "
                + _json.dumps(after, ensure_ascii=False) + "\n")
    pos = len(prompt) + len(head)
    rows, rebuilt = [], list(head)
    for r in lit["registers"]:
        reg_head = enc(tok, f"register {r['name']}: start") + [pb_lit.name_id(tok, r["start"])] + nl
        rebuilt += reg_head
        pos += len(reg_head)
        rr = []
        for s, e, t in r["rows"]:
            ids = [pb_lit.name_id(tok, s), pb_lit.name_id(tok, e), pb_lit.name_id(tok, t)]
            rr.append({"pos": pos, "s": ids[0], "e": ids[1], "t": ids[2]})
            rebuilt += ids + nl
            pos += 4
        rows.append(rr)
    rebuilt += enc(tok, f"answer: {lit['answer_line']}\n</program>\n<exec/>")
    assert rebuilt == prog, "program layout does not match pb_lit.program_ids"
    opener = enc(tok, "\n<run>\n")
    run = pb_lit.run_ids(tok, lit)
    closer = enc(tok, "\n</run>\n")
    ids = prompt + prog + opener + run + closer
    R = len(lit["registers"])
    tape_pos = _tape_positions(tok, ex["prompt"], ex["question"], lit)
    reg_states = [sorted({pb_lit.name_id(tok, v) for v in r["name_of"].values()}) for r in lit["registers"]]
    events = sorted({pb_lit.name_id(tok, e) for e in lit["events"]})
    table = [{(x["s"], x["e"]): x["t"] for x in rr} for rr in rows]
    starts = [pb_lit.name_id(tok, r["start"]) for r in lit["registers"]]
    return {"ids": ids, "prompt_len": len(prompt), "prog_start": len(prompt), "prog_len": len(prog),
            "run_start": len(prompt) + len(prog) + len(opener), "T": len(lit["tape"]), "R": R, "stride": 1 + R,
            "rows": rows, "tape_pos": tape_pos, "states": reg_states, "events": events, "table": table,
            "starts": starts, "n": len(ids)}


def run_tokens(lay):
    """(index, kind, step, register) for every run token; kind 'e' (read) or 's' (step)."""
    out = []
    for k in range(lay["T"]):
        p = lay["run_start"] + k * lay["stride"]
        out.append((p, "e", k, -1))
        for r in range(lay["R"]):
            out.append((p + 1 + r, "s", k, r))
    return out


def examples(tok, families, lengths, n, seed, split="train", max_tokens=CONTEXT - 64):
    """n examples per (family, length), drawn as pb_loop draws its gate cells; skipped if unpinnable or over context.
    Each cell has its own generator, seeded by (seed, family, length), so a cell's examples do not depend on which
    other cells a job draws."""
    out, skipped = [], {}
    for fam in families:
        for L in lengths:
            rng = random.Random(f"{seed}|{fam}|{L}")
            made, tries = 0, 0
            while made < n and tries < 20 * n:
                tries += 1
                ex = family_example(rng, fam, L=L, split=split)
                lit, why = pb_lit.literal(ex, tok)
                if lit is None:
                    skipped[f"{fam}|L{L}"] = skipped.get(f"{fam}|L{L}", 0) + 1
                    continue
                lay = layout(tok, ex, lit)
                if lay["n"] > max_tokens:
                    skipped[f"{fam}|L{L}|over_context"] = skipped.get(f"{fam}|L{L}|over_context", 0) + 1
                    continue
                assert len(lay["tape_pos"]) == lay["T"], (fam, L, len(lay["tape_pos"]), lay["T"])
                out.append({"family": fam, "L": L, "cell": f"{fam}|L{L}", "ex": ex, "lit": lit, "lay": lay})
                made += 1
    return out, skipped


# ------------------------------------------------------------------ model

def load_model(adapter=SAVANT, model=MODEL):
    """bf16 on the GPU, adapter merged in memory into a fresh copy (never a cached merge: PROMPTBOX §3.10)."""
    import torch
    from transformers import AutoModelForCausalLM
    m = AutoModelForCausalLM.from_pretrained(model, dtype=torch.bfloat16, attn_implementation="sdpa").to(_dev())
    if adapter:
        from peft import PeftModel
        m = PeftModel.from_pretrained(m, adapter).merge_and_unload()
    m.eval()
    for p in m.parameters():
        p.requires_grad_(False)
    return m


def hidden(model, ids=None, embeds=None):
    """Final-normed hidden states (n, d) of one causal sequence."""
    import torch
    kw = {"input_ids": torch.tensor([ids], device=_dev())} if embeds is None else {"inputs_embeds": embeds[None]}
    return model.model(**kw, use_cache=False).last_hidden_state[0]


def logits_at(model, h, positions, chunk=1024):
    """Full-vocabulary logits (float32) of the next token at the given positions (small position sets only)."""
    import torch
    out = []
    for i in range(0, len(positions), chunk):
        idx = torch.tensor(positions[i:i + chunk], device=h.device)
        out.append(model.lm_head(h[idx]).float())
    return torch.cat(out) if out else None


def margins(lg, targets, cand=None):
    """Per row: target logit minus the best other logit (full vocabulary), argmax, and the margin among `cand`
    (a list of candidate id lists, one per row) if given."""
    import torch
    t = torch.as_tensor(targets, device=lg.device)
    tl = lg.gather(1, t[:, None])[:, 0]
    other = lg.scatter(1, t[:, None], float("-inf")).max(1).values
    res = {"margin": (tl - other), "argmax": lg.argmax(1)}
    if cand is not None:
        width = max(len(c) for c in cand)
        ci = torch.tensor([list(c) + [c[0]] * (width - len(c)) for c in cand], device=lg.device)
        cl = lg.gather(1, ci)
        cl = cl.masked_fill(ci == t[:, None], float("-inf"))
        res["margin_cand"] = tl - cl.max(1).values
    return res


def chunked_margins(model, h, positions, targets, cand, chunk=512):
    """margins() over many positions without holding all the logits: numpy arrays margin, margin_cand, argmax."""
    import numpy as np
    import torch
    m, mc, am = [], [], []
    with torch.no_grad():
        for i in range(0, len(positions), chunk):
            idx = torch.tensor(positions[i:i + chunk], device=h.device)
            lg = model.lm_head(h[idx]).float()
            r = margins(lg, targets[i:i + chunk], cand[i:i + chunk])
            m.append(r["margin"].cpu().numpy())
            mc.append(r["margin_cand"].cpu().numpy())
            am.append(r["argmax"].cpu().numpy())
            del lg, r
    return np.concatenate(m), np.concatenate(mc), np.concatenate(am)


class AttnProbe:
    """Wraps the sdpa attention function; when `queries` is set, stores the attention weights of those query rows
    (post-RoPE scores, causal, softmax in float32) per layer, per head: probe.w[layer] = (H, nq, n)."""

    def __init__(self, model):
        import transformers.integrations.sdpa_attention as S

