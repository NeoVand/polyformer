"""
Modal launcher for BRIDGE. Own app `polyformer-bridge`, own volume `polyformer-bridge` (outputs, at /out), PROMPTBOX's
volume mounted read-only at /pb (Savant r2's adapter, the self-distilled chat data). Cap $35, recorded in
results/ledger.json before any spend. Every job is reserved at its upper-bound cost before it is spawned and settled at
its wall time after; the GPU and the host CPU are recorded in every record.

    uv run --no-project --with modal modal deploy research/bridge/br_modal.py
    uv run --no-project --with modal python research/bridge/br_modal.py spawn --id <id> --gpu L4 --max_seconds 1800 \
        -- br_tf.py --mode tf ...
    uv run --no-project --with modal python research/bridge/br_modal.py collect
    python3 research/bridge/br_modal.py status

Prices are Modal's list prices per second (upper bounds): the GPU, plus the requested CPU cores and memory.
"""

from __future__ import annotations

import argparse
import contextlib
import datetime as dt
import fcntl
import json
import os
import pathlib
import subprocess
import sys
import time

ROOT = pathlib.Path(__file__).resolve().parent
PB = ROOT.parent / "promptbox"
LEDGER = ROOT / "results" / "ledger.json"
APP, VOLUME, PB_VOLUME = "polyformer-bridge", "polyformer-bridge", "polyformer-promptbox-results"
CAP_USD = 35.0
GPU_RATE = {"L4": 0.000222, "A10G": 0.000306, "H100": 0.001097}
CPU_RATE, MEM_RATE = 0.0000131, 0.00000222
SHAPES = {"L4": (4, 32), "A10G": (4, 32), "H100": (8, 64)}   # cores, GiB requested
STARTUP = 180


JOB_FILES = ("br_core.py", "br_tf.py", "br_free.py", "br_kick.py", "br_p3.py", "br_pilot.py")   # what jobs run; analysis and figures stay local


def source_hashes(root_br=ROOT, root_pb=PB):
    import hashlib
    files = [root_br / f for f in JOB_FILES] + sorted(root_pb.glob("pb_*.py"))
    return {f.name: hashlib.sha256(f.read_bytes()).hexdigest() for f in files}


def stamp():
    return dt.datetime.now(dt.timezone.utc).isoformat()


def rate(gpu):
    cores, gib = SHAPES[gpu]
    return GPU_RATE[gpu] + cores * CPU_RATE + gib * MEM_RATE


@contextlib.contextmanager
def ledger():
    LEDGER.parent.mkdir(parents=True, exist_ok=True)
    lock = LEDGER.with_suffix(".lock")
    with lock.open("a+") as lk:
        fcntl.flock(lk, fcntl.LOCK_EX)
        led = json.loads(LEDGER.read_text()) if LEDGER.exists() else {
            "app": APP, "volume": VOLUME, "cap_usd": CAP_USD,
            "cap_history": [{"at": stamp(), "cap_usd": CAP_USD, "why": "BRIDGE brief: cap $35 recorded before spend"}],
            "cost_basis": f"Modal list price upper bound: GPU + requested cores and memory per second {SHAPES}, wall time "
                          f"plus {STARTUP} s startup; not an invoice", "jobs": {}}
        yield led
        tmp = LEDGER.with_suffix(".tmp")
        tmp.write_text(json.dumps(led, indent=1))
        os.replace(tmp, LEDGER)
        fcntl.flock(lk, fcntl.LOCK_UN)


def used(led):
    return sum(j.get("settled_usd", j["reserved_usd"]) for j in led["jobs"].values())


try:
    import modal
except ImportError:
    modal = None

if modal is not None:
    app = modal.App(APP)
    out_vol = modal.Volume.from_name(VOLUME, create_if_missing=True)
    pb_vol = modal.Volume.from_name(PB_VOLUME).read_only()
    arith_vol = modal.Volume.from_name("polyformer-arith-results").read_only()   # Savant r3 (ARITH), read-only
    _datasets = ("from datasets import load_dataset; "
                 "load_dataset('Salesforce/wikitext', 'wikitext-2-raw-v1'); "
                 "load_dataset('openai/openai_humaneval'); load_dataset('cais/mmlu', 'all'); "
                 "load_dataset('openai/gsm8k', 'main')")
    image = (modal.Image.debian_slim(python_version="3.12")
             .pip_install("vllm==0.32.0", "transformers==5.19.0", "peft==0.21.2", "accelerate==1.15.0",
                          "datasets==5.1.0", "numpy", "safetensors", "huggingface_hub", "tokenizers")
             .run_commands("python -c \"from huggingface_hub import snapshot_download; "
