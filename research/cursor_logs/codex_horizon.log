    def _run(job):
        t0 = time.monotonic()
        have = source_hashes(pathlib.Path("/root/br"), pathlib.Path("/root/pb"))
        if have != job.get("sources"):
            bad = sorted(k for k in set(have) | set(job.get("sources", {})) if have.get(k) != job["sources"].get(k))
            return {"wall": round(time.monotonic() - t0, 1), "returncode": -2, "log_tail": f"source mismatch: {bad}",
                    "gpu_actual": "not started", "cpu_actual": "not started"}
        out_vol.reload()
        for stale in pathlib.Path("/tmp").glob("*merged*"):
            subprocess.run(["rm", "-rf", str(stale)])
        out = pathlib.Path("/out") / job["id"]
        out.mkdir(parents=True, exist_ok=True)
        where = "/root/pb" if job["argv"][0].startswith("pb_") else "/root/br"
        cmd = [sys.executable, "-u", f"{where}/{job['argv'][0]}", *job["argv"][1:], "--out", str(out)]
        last = time.monotonic()
        with (out / "job.log").open("w") as f:
            p = subprocess.Popen(cmd, stdout=f, stderr=subprocess.STDOUT, cwd=where,
                                 env=dict(os.environ, BR_JOB_ID=job["id"]))
            deadline = time.monotonic() + job["max_seconds"]
            while p.poll() is None:
                if time.monotonic() > deadline:
                    p.kill()
                    p.wait()
                    break
                time.sleep(10)
                if time.monotonic() - last > 600:
                    with contextlib.suppress(Exception):
                        out_vol.commit()
                    last = time.monotonic()
        log = (out / "job.log").read_text()
        try:
            gpu = subprocess.check_output(["nvidia-smi", "--query-gpu=name", "--format=csv,noheader"], text=True).strip()
        except Exception:
            gpu = "none"
        info = pathlib.Path("/proc/cpuinfo").read_text()
        cpu = " | ".join([ln.split(":", 1)[1].strip() for ln in info.splitlines()
                          if ln.lower().startswith(("model name", "vendor_id", "cpu family", "model\t"))][:4]) or "unknown"
        flags = next((ln.split(":", 1)[1].split() for ln in info.splitlines() if ln.startswith("flags")), [])
        res = {"wall": round(time.monotonic() - t0, 1), "returncode": p.returncode, "log_tail": log[-8000:],
               "gpu_actual": gpu, "cpu_actual": f"{cpu} | avx512f={'avx512f' in flags}"}
        (out / "_result.json").write_text(json.dumps(res))
        out_vol.commit()
        return res

    def _kw(gpu):
        cores, gib = SHAPES[gpu]
        return dict(image=image, cpu=float(cores), memory=gib * 1024, timeout=8 * 3600,
                    volumes={"/out": out_vol, "/pb": pb_vol, "/arith": arith_vol}, retries=0)

    @app.function(gpu="L4", **_kw("L4"))
    def run_l4(job):
        return _run(job)

    @app.function(gpu="A10G", **_kw("A10G"))
    def run_a10g(job):
        return _run(job)

    @app.function(gpu="H100", **_kw("H100"))
    def run_h100(job):
        return _run(job)


def spawn(job_id, gpu, max_seconds, argv, note=""):
    job = {"id": job_id, "gpu": gpu, "max_seconds": max_seconds, "argv": argv, "sources": source_hashes()}
    reserved = round(rate(gpu) * (max_seconds + STARTUP), 4)
    commit = subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=ROOT, text=True).strip()
    dirty = subprocess.check_output(["git", "status", "--porcelain", "--", "."], cwd=ROOT, text=True)
    dirty_src = [ln for ln in dirty.splitlines() if ln.strip().endswith(".py")]
    with ledger() as led:
        if job_id in led["jobs"]:
            raise SystemExit(f"job {job_id} exists")
        if used(led) + reserved > led["cap_usd"]:
            raise SystemExit(f"cap: {used(led):.2f} used + {reserved:.2f} > {led['cap_usd']}")
        led["jobs"][job_id] = {"argv": argv, "gpu": gpu, "max_seconds": max_seconds, "reserved_usd": reserved,
                               "status": "reserved", "reserved_at": stamp(), "commit": commit,
                               "uncommitted_sources": dirty_src, "note": note}
    fn = modal.Function.from_name(APP, f"run_{gpu.lower()}")
    call = fn.spawn(job)
    with ledger() as led:
        led["jobs"][job_id].update(call_id=call.object_id, status="running", launched_at=stamp())
    print(json.dumps({"id": job_id, "call": call.object_id, "reserved_usd": reserved, "commit": commit[:10],
                      "dirty": dirty_src}))


def collect(only=None):
    with ledger() as led:
        running = {k: dict(v) for k, v in led["jobs"].items() if v["status"] == "running" and (not only or k in only)}
    for jid, j in running.items():
        try:
            res = modal.FunctionCall.from_id(j["call_id"]).get(timeout=0)
        except TimeoutError:
            print(json.dumps({"id": jid, "status": "running"}))
            continue
        except Exception as exc:  # noqa: BLE001
            # a local network error is not a job failure: settle only from the job's own _result.json on the volume
            try:
                vol = modal.Volume.from_name(VOLUME)
                res = json.loads(b"".join(vol.read_file(f"{jid}/_result.json")))
            except Exception:  # noqa: BLE001
                print(json.dumps({"id": jid, "status": "unresolved", "error": f"{type(exc).__name__}: {str(exc)[:200]}"}))
                continue
        amount = round(rate(j["gpu"]) * (min(res["wall"], j["max_seconds"] + 60) + STARTUP), 4)
        status = "complete" if res["returncode"] == 0 else "error"
        with ledger() as led:
            led["jobs"][jid].update(status=status, settled_usd=amount, wall=res["wall"], gpu_actual=res["gpu_actual"],
                                    cpu_actual=res["cpu_actual"], settled_at=stamp())
        print(json.dumps({"id": jid, "status": status, "usd": amount, "gpu": res["gpu_actual"],
                          "cpu": res["cpu_actual"]}))
        print(res["log_tail"][-3000:])


def abandon(job_id, seconds, why):
    with ledger() as led:
        j = led["jobs"][job_id]
        j.update(status="abandoned", settled_usd=round(rate(j["gpu"]) * (float(seconds) + STARTUP), 4),
                 wall=float(seconds), settled_at=stamp(), error=why)
    print(json.dumps({"id": job_id, "abandoned": why}))


def status():
    with ledger() as led:
        print(json.dumps({"cap": led["cap_usd"], "used_or_reserved": round(used(led), 3),
                          "settled": round(sum(j.get("settled_usd", 0) for j in led["jobs"].values()), 3),
                          "jobs": {k: (v["status"], v.get("settled_usd", v["reserved_usd"])) for k, v in
                                   led["jobs"].items()}}, indent=1))


if __name__ == "__main__":
    ap = argparse.ArgumentParser()
    sub = ap.add_subparsers(dest="cmd", required=True)
    sp = sub.add_parser("spawn")
    sp.add_argument("--id", required=True)
    sp.add_argument("--gpu", default="L4", choices=sorted(GPU_RATE))
    sp.add_argument("--max_seconds", type=int, default=1800)
    sp.add_argument("--note", default="")
    sp.add_argument("argv", nargs=argparse.REMAINDER)
    co = sub.add_parser("collect")
    co.add_argument("--only", nargs="*")
    ab = sub.add_parser("abandon")
    ab.add_argument("--id", required=True)
    ab.add_argument("--seconds", type=float, required=True)
    ab.add_argument("--why", required=True)
    sub.add_parser("status")
    sub.add_parser("init")
    a = ap.parse_args()
    if a.cmd == "spawn":
        argv = a.argv[1:] if a.argv[:1] == ["--"] else a.argv
        spawn(a.id, a.gpu, a.max_seconds, argv, a.note)
    elif a.cmd == "collect":
        collect(a.only)
    elif a.cmd == "abandon":
        abandon(a.id, a.seconds, a.why)
    elif a.cmd == "init":
        with ledger() as led:
            pass
        status()
    else:
        status()

