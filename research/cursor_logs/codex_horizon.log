"""Collision indicators, hazards and tape constructors for HORIZON.

The definitions are the ones locked in HORIZON.md §2. This module does not read
held-out failures and does not choose parameters.
"""

from __future__ import annotations

import itertools
import math
import random
from collections import defaultdict

import numpy as np

K_GRID = (1, 2, 3, 4, 6, 8, 12, 16, 24)
MIN_CONFLICTS = 30
TIE_NATS = 0.01
LOG_FLOOR = 1e-12
ALPHABET = ("AB", "BC", "AC")
SHORT_L, LONG_L = 2048, 8192


def conflicts(events, k):
    """C_t, N_t for a question tape. Matches anywhere in the tape, including after t.

    C_t = 1 when some other occurrence of the k-suffix continues with a different symbol.
    """
    ev = list(events)
    T = len(ev)
    C = np.zeros(T, dtype=np.int8)
    N = np.zeros(T, dtype=np.int32)
    if k < 1 or T <= k:
        return C, N
    counts = defaultdict(lambda: defaultdict(int))
    suffixes = [None] * T
    for t in range(k, T):
        suf = tuple(ev[t - k:t])
        suffixes[t] = suf
        counts[suf][ev[t]] += 1
    for t in range(k, T):
        true = ev[t]
        bucket = counts[suffixes[t]]
        # every continuation except this position's own symbol; the position itself is not a disagreement
        disagree = sum(n for sym, n in bucket.items() if sym != true)
        N[t] = disagree
        C[t] = 1 if disagree else 0
    return C, N


def conflicts_causal(tokens, k):
    """C_t on a single emitted stream: only earlier occurrences. tokens[t] is the token at step t."""
    tok = list(tokens)
    T = len(tok)
    C = np.zeros(T, dtype=np.int8)
    if k < 1 or T <= k:
        return C
    buckets = defaultdict(list)
    for t in range(k, T):
        suf = tuple(tok[t - k:t])
        prev = buckets.get(suf)
        if prev:
            C[t] = 1 if any(x != tok[t] for x in prev) else 0
        buckets[suf].append(tok[t])
    return C


def bernoulli_ll(err, h):
    """Sum of Bernoulli log-likelihoods. err is True where the read was wrong. -inf if a zero-probability event."""
    err = np.asarray(err, dtype=bool)
    h = np.asarray(h, dtype=np.float64)
    if h.shape != err.shape:
        raise ValueError("shape")
    if np.any(err & (h <= 0)) or np.any(~err & (h >= 1)):
        return -math.inf
    hh = np.clip(h, 1e-15, 1 - 1e-15)
    return float(np.sum(np.where(err, np.log(hh), np.log(1 - hh))))


def scale_grid():
    return np.concatenate([np.array([0.0, 1.0]), np.geomspace(1e-8, 1.0, 200)])


def fit_scale(err, feature):
    """MLE of h = min(1, a * feature), a on the locked grid, plus endpoints 0 and 1."""
    err = np.asarray(err, dtype=bool)
    feature = np.asarray(feature, dtype=np.float64)
    best_a, best_ll = 0.0, -math.inf
    for a in scale_grid():
        h = np.minimum(1.0, a * feature)
        ll = bernoulli_ll(err, h)
        if ll > best_ll:
            best_a, best_ll = float(a), ll
    return best_a, best_ll


def fit_logistic(steps, err):
    """h = sigmoid(α + β log(t+1)), NLL + 1e-4 (α² + β²). Several starts; keep the best."""
    from scipy.optimize import minimize

    steps = np.asarray(steps, dtype=np.float64)
    err = np.asarray(err, dtype=bool)
    x = np.log(steps + 1.0)

    def nll(theta):
        a, b = float(theta[0]), float(theta[1])
        z = np.clip(a + b * x, -60, 60)
        h = 1.0 / (1.0 + np.exp(-z))
        h = np.clip(h, 1e-12, 1 - 1e-12)
        ll = np.where(err, np.log(h), np.log(1 - h)).sum()
        return float(-ll + 1e-4 * (a * a + b * b))

    best = None
    for init in ((0, 0), (-5, 0), (-8, 0.5), (-2, 1), (0, -1), (-4, -0.5), (2, -1)):
        res = minimize(nll, np.array(init, dtype=float), method="Nelder-Mead")
        if best is None or res.fun < best[0]:
            best = (float(res.fun), (float(res.x[0]), float(res.x[1])))
    return best[1], -best[0] + 1e-4 * (best[1][0] ** 2 + best[1][1] ** 2)


def logistic_h(steps, alpha, beta):
    z = np.clip(alpha + beta * np.log(np.asarray(steps, dtype=np.float64) + 1.0), -60, 60)
    return 1.0 / (1.0 + np.exp(-z))


def _phi(z):
    return 0.5 * (1.0 + math.erf(z / math.sqrt(2.0)))


def lognormal_survival(t, mu, sigma):
    """P(T > t) for 1-based T, t ≥ 0. P(T > 0) = 1."""
    if t <= 0:
        return 1.0
    return 1.0 - _phi((math.log(t) - mu) / sigma)


def lognormal_pmf(step, mu, sigma):
    """P(first error at 0-based step)."""
    return max(0.0, lognormal_survival(step, mu, sigma) - lognormal_survival(step + 1, mu, sigma))


def lognormal_grid():
    mus = np.linspace(math.log(10), math.log(1e6), 80)
    sigs = np.linspace(0.2, 5.0, 40)
    return mus, sigs


def fit_lognormal(observations):
    """observations: list of ('event', step) or ('censor', limit) with limit the largest 1-based T known to be exceeded.

    A tape censored at 0-based step 512 contributes ('censor', 512), i.e. P(T > 512).
    """
    mus, sigs = lognormal_grid()
    best = None
    for mu in mus:
        for sigma in sigs:
            ll = 0.0
            dead = False
            for kind, value in observations:
                if kind == "event":
                    p = lognormal_pmf(value, mu, sigma)
                else:
                    p = lognormal_survival(value, mu, sigma)
                if p <= 0:
                    dead = True
                    break
                ll += math.log(p)
            if dead:
                continue
            if best is None or ll > best[0]:
                best = (ll, float(mu), float(sigma))
    if best is None:
        raise RuntimeError("lognormal grid has no finite likelihood")
    return {"ll": best[0], "mu": best[1], "sigma": best[2]}


def hazard_from_lognormal(length, mu, sigma):
    h = np.zeros(length, dtype=np.float64)
    for t in range(length):
        denom = lognormal_survival(t, mu, sigma)
        num = lognormal_pmf(t, mu, sigma)
        h[t] = 0.0 if denom <= 0 else min(1.0, num / denom)
    return h


def log_score(h, step):
    """Natural log score of a first error at `step`, or survival if step is None. Floored at 1e-12."""
    h = np.asarray(h, dtype=np.float64)
    log1m = np.log(np.clip(1.0 - h, 1e-300, 1.0))
    if step is None:
        lp = float(log1m.sum())
    else:
        t = int(step)
        prev = float(log1m[:t].sum()) if t else 0.0
        lp = math.log(max(float(h[t]), 1e-300)) + prev
    return max(lp, math.log(LOG_FLOOR))


def survival_prob(h):
    h = np.clip(np.asarray(h, dtype=np.float64), 0.0, 1.0)
    return float(np.exp(np.sum(np.log(np.clip(1.0 - h, 1e-300, 1.0)))))


def wilson(errors, n, z=1.96):
    if n <= 0:
        return None
    p = errors / n
    den = 1 + z * z / n
    centre = (p + z * z / (2 * n)) / den
    half = z * math.sqrt(p * (1 - p) / n + z * z / (4 * n * n)) / den
    return [max(0.0, centre - half), min(1.0, centre + half)]


def choose_k(per_k):
    """per_k: list of dicts with k, eligible, ll, n_tokens. Returns the frozen k or None."""
    eligible = [r for r in per_k if r["eligible"]]
    if not eligible:
        return None
    finite = [r["ll"] for r in eligible if math.isfinite(r["ll"])]
    best = max(finite) if finite else -math.inf
    n = eligible[0]["n_tokens"]
    band = TIE_NATS * n

    def tied(r):
        if not math.isfinite(best):
            return not math.isfinite(r["ll"])
        return math.isfinite(r["ll"]) and r["ll"] >= best - band

    winners = [r for r in eligible if tied(r)]
    if not winners:
        winners = eligible
    return min(winners, key=lambda r: r["k"])["k"]


# ---------------------------------------------------------------- tapes (intervention)


def z_tapes(alphabet=ALPHABET, length=SHORT_L, n=16):
    """First n distinct order-1 deterministic strings, functions and starts in lex order."""
    symbols = list(alphabet)
    a = len(symbols)
    out, seen = [], set()
    for img in itertools.product(range(a), repeat=a):
        for s0 in range(a):
            s = s0
            seq = []
            for _ in range(length):
                seq.append(symbols[s])
                s = img[s]
            key = tuple(seq)
            if key in seen:
                continue
            seen.add(key)
            out.append(seq)
            if len(out) >= n:
                return out
    return out


def h_tape(alphabet, k, length, rng, redraws=20):
    """Repeated random k-mer with two continuations. None if 20 draws have fewer than 10 conflicts."""
    symbols = list(alphabet)
    for _ in range(redraws):
        w = [rng.choice(symbols) for _ in range(k)]
        c0 = rng.choice(symbols)
        c1 = rng.choice([s for s in symbols if s != c0])
        seq = []
        flip = False
        while len(seq) < length:
            seq.extend(w)
            seq.append(c1 if flip else c0)
            flip = not flip
        seq = seq[:length]
        n_c = int(conflicts(seq, k)[0].sum())
        if n_c >= 10:
            return seq, n_c
    return None


def h_tapes(k, length, n=16, alphabet=ALPHABET):
    out = []
    for i in range(n):
        rng = random.Random(f"7070|H|{length}|{i}")
        made = h_tape(alphabet, k, length, rng)
        if made is not None:
            seq, n_c = made
            out.append({"i": i, "events": seq, "n_conflict": n_c})
    return out


def f_pairs(k, n=16, alphabet=ALPHABET, short=SHORT_L, long=LONG_L):
    """XY prefix, then a constant tail of the third symbol, on both lengths.

    The prefix ends k + 1 symbols before the short tape does, so the short tape already
    contains the tail k-mer. Further copies of that k-mer, on the long tape, continue as
    themselves. The first tail symbol would otherwise give the prefix's last k-mer a new
    continuation and flip every earlier copy of it (HORIZON.md amendment before the fit).
    """
    if short <= k + 1:
        raise ValueError("short tape cannot hold the tail k-mer")
    symbols = list(alphabet)
    cut = short - (k + 1)
    out, seen = [], set()
    phases = range(k) if k > 1 else (0,)
    for perm in itertools.permutations(symbols):
        X, Y, Z = perm
        for first_y in (True, False):
            for r in phases:
                body = []
                b = 0
                while len(body) < cut:
                    cont = Y if (b % 2 == 0) == first_y else X
                    body.extend([X] * k + [cont])
                    b += 1
                shared = ([Y] * r + body)[:cut]
                if Z in shared or len(shared) < k or tuple(shared) in seen:
                    continue
                seen.add(tuple(shared))
                out.append({
                    "i": len(out), "X": X, "Y": Y, "Z": Z,
                    "prefix": shared,
                    "short": shared + [Z] * (short - len(shared)),
                    "long": shared + [Z] * (long - len(shared)),
                })
                if len(out) >= n:
                    return out
    return out


def pair_conflict_ok(pair, k, slack=None):
    slack = k + 5 if slack is None else slack
    c_short = int(conflicts(pair["short"], k)[0].sum())
    c_long = int(conflicts(pair["long"], k)[0].sum())
    return abs(c_long - c_short) <= slack, c_short, c_long
"""Checks for the locked definitions. No model, no held-out failures."""

import random
import sys
import pathlib

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import hz_lib as H


def test_unique_continuation_is_not_a_conflict():
    # 010101... every suffix has one continuation
    ev = ["0" if t % 2 == 0 else "1" for t in range(200)]
    for k in (1, 2, 5, 8):
        C, N = H.conflicts(ev, k)
        assert C.sum() == 0, k
        assert N.sum() == 0


def test_two_continuations_conflict():
    # 000 then 1, and 000 then 0. k=3, suffix 000 continues both ways.
    ev = list("00010000")
    C, N = H.conflicts(ev, 3)
    # positions t where address is 000: t=3 (events[0:3]=000, next 1) and t=7 (events[4:7]=000, next 0)
    assert C[3] == 1 and C[7] == 1
    assert N[3] == 1 and N[7] == 1
    assert C.sum() == 2


def test_same_continuation_is_harmless():
    ev = list("00010001")
    C, _ = H.conflicts(ev, 3)
    assert C.sum() == 0


def test_causal_ignores_the_future():
    ev = list("00010000")
    C = H.conflicts_causal(ev, 3)
    # at t=3 the other occurrence is still in the future
    assert C[3] == 0 and C[7] == 1


def test_z_tapes_have_no_conflicts_and_are_distinct():
    for k in (1, 4, 24):
        tapes = H.z_tapes(length=300, n=16)
        assert len(tapes) == 16
        assert len({tuple(t) for t in tapes}) == 16
        for tape in tapes:
            assert H.conflicts(tape, k)[0].sum() == 0


def test_h_tapes_clear_the_floor():
    for k in (1, 8, 24):
        tapes = H.h_tapes(k, 512, n=16)
        assert len(tapes) >= 12
        for tape in tapes:
            assert tape["n_conflict"] >= 10
            assert tape["n_conflict"] == int(H.conflicts(tape["events"], k)[0].sum())


def test_f_pairs_do_not_grow_with_the_tail():
    for k in (1, 2, 7, 24):
        pairs = H.f_pairs(k, n=16)
        assert len(pairs) >= 8, k
        for pair in pairs:
            ok, c_s, c_l = H.pair_conflict_ok(pair, k)
            assert ok, (k, c_s, c_l)
            assert c_s > 0
            assert pair["Z"] not in pair["prefix"]
            assert pair["short"][: len(pair["prefix"])] == pair["prefix"]
            assert pair["long"][: len(pair["prefix"])] == pair["prefix"]
            assert set(pair["short"][len(pair["prefix"]):]) == {pair["Z"]}
            assert set(pair["long"][len(pair["prefix"]):]) == {pair["Z"]}
            assert c_s == c_l


def test_log_score_floor_and_certain_survival():
    h = [0.0, 0.0, 0.0]
    assert abs(H.log_score(h, None) - 0.0) < 1e-9
    floored = H.log_score(h, 1)
    assert abs(floored - __import__("math").log(1e-12)) < 1e-9


def test_choose_k_prefers_finite_and_breaks_ties_downward():
    rows = [
        {"k": 1, "eligible": True, "ll": -10.0, "n_tokens": 100},
        {"k": 2, "eligible": True, "ll": -10.0, "n_tokens": 100},  # within 0.01*100 = 1 nat
        {"k": 4, "eligible": False, "ll": 0.0, "n_tokens": 100},
    ]
    assert H.choose_k(rows) == 1
    rows[0]["ll"] = float("-inf")
    assert H.choose_k(rows) == 2
    assert H.choose_k([{"k": 1, "eligible": False, "ll": 0.0, "n_tokens": 10}]) is None


def test_scale_fit_recovers_a_constant_hazard_shape():
    # errors exactly where feature is large: feature = log(t+1), errors on the top half
    steps = list(range(400))
    feature = [__import__("math").log(t + 1) for t in steps]
    # plant errors with probability proportional to feature, fixed seed, then fit
    rng = random.Random(0)
    err = [rng.random() < min(0.5, 0.15 * f) for f in feature]
    a, ll = H.fit_scale(err, feature)
    assert ll > float("-inf")
    assert 0 < a < 1


