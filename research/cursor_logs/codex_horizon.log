def general_prompt_pool():
    """Instruction prompts (Alpaca and Dolly, no extra input) split once: training self-distillation vs evaluation."""
    from datasets import load_dataset
    rows = [r["instruction"].strip() for r in load_dataset("tatsu-lab/alpaca", split="train") if not r["input"]]
    rows += [r["instruction"].strip() for r in load_dataset("databricks/databricks-dolly-15k", split="train")
             if not r["context"]]
    rows = sorted({r for r in rows if 10 <= len(r) <= 1500})
    random.Random(99).shuffle(rows)
    return {"train": rows[:-2000], "eval": rows[-2000:]}


