diff --git a/research/horizon/hz_plot.py b/research/horizon/hz_plot.py
new file mode 100644
index 0000000000000000000000000000000000000000..9d66af675a6fd1f53c29d56a4824be9167cfa558
--- /dev/null
+++ b/research/horizon/hz_plot.py
@@ -0,0 +1,50 @@
+"""Static research figure from frozen predictions and settled outcomes. No fitting."""
+import json
+import pathlib
+
+import matplotlib
+matplotlib.use("Agg")
+import matplotlib.pyplot as plt
+import numpy as np
+
+HERE = pathlib.Path(__file__).resolve().parent
+
+
+def main():
+    root = HERE / "results"
+    estimate = json.loads((root / "estimate.json").read_text())
+    result = json.loads((root / "intervention_summary.json").read_text())
+    plan = json.loads((root / "intervention_plan.json").read_text())
+    plt.rcParams.update({"font.size": 10, "axes.spines.top": False, "axes.spines.right": False,
+                         "svg.fonttype": "none"})
+    fig, axes = plt.subplots(1, 2, figsize=(10, 3.8), layout="constrained")
+    ax = axes[0]
+    cells = estimate["heldout"]["collision"]["by_length"]
+    x = np.array([int(L) for L in cells]) / 1000
+    ax.plot(x, [c["predicted_survival"] for c in cells.values()], "o--", color="#b25436", label="Frozen collision model")
+    ax.plot(x, [c["observed_exact"] for c in cells.values()], "o-", color="#265c73", label="Recorded exact runs")
+    ax.set(xlabel="Events (thousands)", ylabel="Exact-run fraction", ylim=(-.04, 1.04),
+           title="A   Held-out calibration: fail")
+    ax.legend(frameon=False, fontsize=9)
+    ax = axes[1]
+    keys = [f"{regime}-{L}" for regime in ("Z", "H", "F") for L in (2048, 8192)]
+    for i, key in enumerate(keys):
+        c = result["cells"][key]
+        p = c["failure_rate"]
+        lo, hi = c["wilson95"]
+        ax.errorbar(i, p, yerr=[[max(0, p-lo)], [max(0, hi-p)]], fmt="o", color="#265c73", capsize=3,
+                    label="Observed (Wilson interval)" if i == 0 else None)
+        ax.scatter(i, 1-plan["cells"][key]["predicted_survival"]["collision"], marker="x", s=65,
+                   color="#b25436", label="Frozen prediction" if i == 0 else None)
+    labels = [f"{key.split('-')[0]} · {int(key.split('-')[1])//1024}k\nn={result['cells'][key]['n']}" for key in keys]
+    ax.set(xticks=range(6), xticklabels=labels, ylabel="First-error fraction", ylim=(-.04, 1.04),
+           title="B   Intervention (H below registered sample floor)")
+    ax.legend(frameon=False, fontsize=8, loc="best")
+    fig.suptitle("HORIZON · unaudited", fontsize=12)
+    fig.savefig(root / "horizon.png", dpi=180)
+    fig.savefig(root / "horizon.svg")
+    plt.close(fig)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/research/horizon/hz_report.py b/research/horizon/hz_report.py
new file mode 100644
index 0000000000000000000000000000000000000000..80b2d93fb32ea2c2a669a7561dbd075e3430372d
--- /dev/null
+++ b/research/horizon/hz_report.py
@@ -0,0 +1,68 @@
+"""Settle the registered intervention metrics from the frozen manifest and raw outcomes."""
+import json
+import pathlib
+
+import numpy as np
+
+import hz_intervene as I
+import hz_lib as H
+
+HERE = pathlib.Path(__file__).resolve().parent
+
+
+def summarize(manifest, result, estimate):
+    assert result["manifest_sha256"] == I.digest(manifest)
+    assert manifest["estimate_sha256"] == I.digest(estimate)
+    assert not result["smoke"]
+    planned = {r["id"]: r for r in manifest["rows"]}
+    observed = {r["id"]: r for r in result["records"]}
+    assert len(observed) == len(result["records"]) and observed.keys() == planned.keys()
+    scores, cells = {}, {}
+    for name, row in planned.items():
+        actual = observed[name]
+        assert all(actual[k] == row[k] for k in ("regime", "L", "i", "n_tokens"))
+        fe = actual["first_error"]
+        assert actual["exact"] == (fe is None)
+        for model, h in I.hazards(row["events"], estimate).items():
+            scores.setdefault(model, []).append(H.log_score(h, None if fe is None else fe["step"]))
+    for regime in ("Z", "H", "F"):
+        for L in (2048, manifest["long"]):
+            rs = [r for r in result["records"] if r["regime"] == regime and r["L"] == L]
+            failed = sum(not r["exact"] for r in rs)
+            cells[f"{regime}-{L}"] = dict(n=len(rs), failed=failed, failure_rate=failed/len(rs),
+                wilson95=H.wilson(failed, len(rs)), first_read=sum(r["first_error"] is not None and
+                r["first_error"]["kind"] == "read" for r in rs),
+                first_state=sum(r["first_error"] is not None and r["first_error"]["kind"] == "state" for r in rs))
+    rate = lambda regime, L: cells[f"{regime}-{L}"]["failure_rate"]
+    delta_c = {str(L): rate("H", L)-rate("Z", L) for L in (2048, manifest["long"])}
+    delta_l = {regime: rate(regime, manifest["long"])-rate(regime, 2048) for regime in ("Z", "H", "F")}
+    collision = all(x >= .25 for x in delta_c.values())
+    length = all(x >= .25 for x in delta_l.values())
+    if collision and all(abs(x) <= .25 for x in delta_l.values()):
+        reading = "collisions, not length"
+    elif all(x <= .125 for x in delta_c.values()) and length:
+        reading = "length, not collisions"
+    elif collision and length:
+        reading = "both"
+    else:
+        reading = "mixed"
+    conclusive = all(cells[f"{regime}-{L}"]["n"] >= minimum
+        for regime, minimum in (("Z", 16), ("H", 12), ("F", 8)) for L in (2048, manifest["long"]))
+    means = {name: float(np.mean(vals)) for name, vals in scores.items()}
+    gaps = {name: means["collision"]-val for name, val in means.items() if name != "collision"}
+    prospective = all(gap >= .05 for gap in gaps.values())
+    return dict(unaudited=True, n=len(observed), cells=cells, delta_collision=delta_c,
+                delta_length=delta_l, numerical_reading=reading, conclusive=conclusive,
+                causal_pass=conclusive and reading == "collisions, not length",
+                mean_log_scores=means, collision_score_gaps=gaps, prospective_pass=prospective,
+                overall_pass=estimate["prediction_verdict"]["passes"] and conclusive and
+                reading == "collisions, not length" and prospective)
+
+
+if __name__ == "__main__":
+    base = HERE / "results"
+    result = summarize(json.loads((base / "intervention_manifest.json").read_text()),
+                       json.loads((base / "intervention/records.json").read_text()),
+                       json.loads((base / "estimate.json").read_text()))
+    (base / "intervention_summary.json").write_text(json.dumps(result, indent=2))
+    print(json.dumps(result, indent=2))
diff --git a/research/horizon/hz_stats.py b/research/horizon/hz_stats.py
new file mode 100644
index 0000000000000000000000000000000000000000..87da8e71978b6c635c6b95c0b1bc16b3398161ea
--- /dev/null
+++ b/research/horizon/hz_stats.py
@@ -0,0 +1,87 @@
+"""Supplementary, post-fit short-tape score/value measurements; never used to refit.
+
+Twelve fresh L=256 tapes (two per trained family, seed 7071), five reading queries,
+and the eight heads named before HORIZON. Saves actual value vectors as well as
+scores. This cannot retroactively validate the registered prediction.
+"""
+import argparse
+import json
+import pathlib
+import sys
+
+import numpy as np
+
+HERE = pathlib.Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE.parent / "bridge"))
+import br_core as C
+
+HEADS = {23: [4, 5, 30], 24: [23, 22, 20, 5, 13]}
+STEPS = [16, 32, 64, 128, 255]
+
+
+def main(out):
+    import torch
+    from transformers.modeling_utils import ALL_ATTENTION_FUNCTIONS
+
+    tok = C.tokenizer()
+    examples, skipped = C.examples(tok, C.TRAINED, [256], 2, 7071)
+    assert len(examples) == 12 and not skipped
+    model = C.load_model()
+    original = ALL_ATTENTION_FUNCTIONS["sdpa"]
+    rows, target_values, baths, means = [], [], [], []
+    current = {}
+
+    def wrapped(module, query, key, value, attention_mask, **kw):
+        layer = module.layer_idx
+        if layer in HEADS:
+            lay = current["lay"]
+            groups = query.shape[1] // key.shape[1]
+            for head in HEADS[layer]:
+                for step in STEPS:
+                    pos = lay["run_start"] + step * lay["stride"] - 1
+                    target = lay["tape_pos"][step]
+                    q = query[0, head, pos].float()
+                    keys = key[0, head // groups, :pos + 1].float()
+                    values = value[0, head // groups, :pos + 1].float()
+                    scores = keys @ q * module.scaling
+                    mask = torch.arange(pos + 1, device=q.device) != target
+                    bg = scores[mask]
+                    bath = bg.softmax(0) @ values[mask]
+                    mean = values[mask].mean(0)
+                    target_v = values[target]
+                    target_values.append(target_v.cpu().numpy())
+                    baths.append(bath.cpu().numpy())
+                    means.append(mean.cpu().numpy())
+                    rows.append(dict(family=current["family"], example=current["i"], step=step,
+                        head=f"L{layer}.H{head}", background_n=int(mask.sum()), target_score=float(scores[target]),
+                        background_score_mean=float(bg.mean()), background_score_std=float(bg.std(unbiased=False)),
+                        target_attention=float(scores.softmax(0)[target]), target_value_norm=float(target_v.norm()),
+                        weighted_bath_norm=float(bath.norm()), target_bath_distance=float((target_v-bath).norm()),
+                        weighted_unweighted_distance=float((bath-mean).norm())))
+        return original(module, query, key, value, attention_mask, **kw)
+
+    ALL_ATTENTION_FUNCTIONS["sdpa"] = wrapped
+    try:
+        with torch.no_grad():
+            for i, example in enumerate(examples):
+                current.update(lay=example["lay"], family=example["family"], i=i)
+                h = C.hidden(model, example["lay"]["ids"])
+                del h
+                print(json.dumps(dict(done=i+1, total=12)), flush=True)
+    finally:
+        ALL_ATTENTION_FUNCTIONS["sdpa"] = original
+    assert len(rows) == 12 * 8 * 5
+    numeric = [k for k in rows[0] if k not in ("family", "example", "step", "head")]
+    summary = {head: {k: float(np.mean([r[k] for r in rows if r["head"] == head])) for k in numeric}
+               for head in sorted({r["head"] for r in rows})}
+    out.mkdir(parents=True, exist_ok=True)
+    (out / "short_stats.json").write_text(json.dumps(dict(unaudited=True, role="post-fit descriptive supplement",
+        seed=7071, L=256, n_tapes=12, queries_per_head=60, summary=summary, records=rows), indent=1))
+    np.savez_compressed(out / "short_values.npz", target=np.stack(target_values),
+                        weighted_bath=np.stack(baths), unweighted_mean=np.stack(means))
+
+
+if __name__ == "__main__":
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--out", type=pathlib.Path, required=True)
+    main(ap.parse_args().out)
diff --git a/research/horizon/test_hz.py b/research/horizon/test_hz.py
index 17071c0f6b40486c06779d8cb6e2860d7a6be109..d80ef7e6357730bd93284c844d2c71ba5b9d6127
--- a/research/horizon/test_hz.py
+++ b/research/horizon/test_hz.py
@@ -40,6 +40,57 @@
     assert C[3] == 0 and C[7] == 1
 
 
+def test_conflicts_match_bruteforce():
+    for seed in range(10):
+        rng = random.Random(seed)
+        events = [rng.randrange(4) for _ in range(40)]
+        for k in (1, 2, 5):
+            c, n = H.conflicts(events, k)
+            for t in range(k, len(events)):
+                want = sum(events[j-k:j] == events[t-k:t] and events[j] != events[t]
+                           for j in range(k, len(events)))
+                assert n[t] == want and c[t] == bool(want)
+
+
+def test_intervention_distinct_draws_and_frozen_pairs():
+    import hz_intervene as I
+    rows, duplicates = I.tapes(1, 8192)
+    assert len(rows) == 78
+    assert all(len(v) == 5 for v in duplicates.values())
+    for regime, expected in (("Z", 16), ("H", 11), ("F", 12)):
+        for length in (2048, 8192):
+            cell = [r for r in rows if r["regime"] == regime and r["L"] == length]
+            assert len(cell) == len({tuple(r["events"]) for r in cell}) == expected
+    for i in range(12):
+        pair = [r for r in rows if r["regime"] == "F" and r["i"] == i]
+        assert len({int(H.conflicts(r["events"], 1)[0].sum()) for r in pair}) == 1
+
+
+def test_intervention_summary_requires_complete_unique_outcomes():
+    import copy
+    import json
+    import pytest
+    import hz_intervene as I
+    import hz_report as R
+    root = pathlib.Path(__file__).resolve().parent / "results"
+    manifest = json.loads((root / "intervention_manifest.json").read_text())
+    estimate = json.loads((root / "estimate.json").read_text())
+    records = [{key: r[key] for key in ("id", "regime", "L", "i", "n_tokens")} |
+               {"exact": True, "first_error": None} for r in manifest["rows"]]
+    result = {"manifest_sha256": I.digest(manifest), "smoke": False, "records": records}
+    summary = R.summarize(manifest, result, estimate)
+    assert summary["n"] == 78 and not summary["conclusive"]
+    assert not summary["causal_pass"] and not summary["overall_pass"]
+    incomplete = copy.deepcopy(result)
+    incomplete["records"].pop()
+    with pytest.raises(AssertionError):
+        R.summarize(manifest, incomplete, estimate)
+    duplicate = copy.deepcopy(result)
+    duplicate["records"].append(duplicate["records"][0])
+    with pytest.raises(AssertionError):
+        R.summarize(manifest, duplicate, estimate)
+
+
 def test_z_tapes_have_no_conflicts_and_are_distinct():
     for k in (1, 4, 24):
         tapes = H.z_tapes(length=300, n=16)

