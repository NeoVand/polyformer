font.family: sans-serif
font.sans-serif: Helvetica Neue, Helvetica, Arial, DejaVu Sans
font.size: 7
axes.titlesize: 7
axes.labelsize: 7
xtick.labelsize: 6
ytick.labelsize: 6
legend.fontsize: 6
axes.edgecolor: 1F2A44
axes.labelcolor: 1F2A44
axes.facecolor: FFFFFF
axes.linewidth: 0.5
axes.spines.top: False
axes.spines.right: False
axes.grid: False
axes.prop_cycle: cycler('color', ['D6336C', '2557A7', '4C5B78', '7D8BA8', '7A5BA8', 'BAC5D9'])
xtick.color: 1F2A44
ytick.color: 1F2A44
xtick.major.width: 0.5
ytick.major.width: 0.5
xtick.major.size: 2.5
ytick.major.size: 2.5
xtick.direction: out
ytick.direction: out
lines.linewidth: 1.0
lines.markersize: 3
legend.frameon: False
image.cmap: viridis
figure.facecolor: FFFFFF
savefig.facecolor: FFFFFF
savefig.dpi: 600
savefig.bbox: tight
pdf.fonttype: 42
svg.fonttype: none
